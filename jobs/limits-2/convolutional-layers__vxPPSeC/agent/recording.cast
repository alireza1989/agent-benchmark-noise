[29.183268, "o", "    x = np.asarray(x, dtype=np.float64)\r\n\u001b[?2004l\r\u001b[?2004h>     if pad == 0:\r\n\u001b[?2004l\r"]
[29.183349, "o", "\u001b[?2004h> "]
