[30.570401, "o", "        self.stride = int(stride) if stride is not None else self.kernel_size\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def _patches(self, x):\r\n\u001b[?2004l\r\u001b[?2004h>         x = np.asarray(x, dtype=np.float64)\r\n\u001b[?2004l\r\u001b[?2004h>         N, H, W, C = x.shape\r\n\u001b[?2004l\r\u001b[?2004h>         k, s = self.kernel_size, self.stride\r\n\u001b[?2004l\r\u001b[?2004h>         oh = (H - k) // s + 1\r\n\u001b[?2004l\r\u001b[?2004h>         ow = (W - k) // s + 1\r\n\u001b[?2004l\r\u001b[?2004h>         patches = []\r\n\u001b[?2004l\r\u001b[?2004h>         for i in range(k):\r\n\u001b[?2004l\r\u001b[?2004h>             for j in range(k):\r\n\u001b[?2004l\r\u001b[?2004h>                 patches.append(x[:, i:i + s * (oh - 1) + 1:s, j:j + s * (ow - 1) + 1:s, :])\r\n\u001b[?2004l\r\u001b[?2004h>         return np.stack(patches, axis=0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class MaxPool2D(_Pool2D):\r\n\u001b[?2004l\r\u001b[?2004h>     def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.570655, "o", "        return self._patches(x).max(axis=0).astype(np.float64)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class AvgPool2D(_Pool2D):\r\n\u001b[?2004l\r\u001b[?2004h>     def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h>         return self._patches(x).mean(axis=0).astype(np.float64)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[30.571628, "o", "\u001b[?2004hroot@eff861eb58c8:/app# "]
[30.911158, "i", "cat > /app/src/normalization.py << 'EOF'\nimport numpy as np\n\nfrom .base import BaseLayer\n\n\nclass BatchNorm2D(BaseLayer):\n    def __init__(self, num_features, eps=1e-5, momentum=0.1):\n        super().__init__()\n        self.num_features = int(num_features)\n        self.eps = float(eps)\n        self.momentum = float(momentum)\n        self.gamma = np.ones(self.num_features, dtype=np.float64)\n        self.beta = np.zeros(self.num_features, dtype=np.float64)\n        self.running_mean = np.zeros(self.num_features, dtype=np.float64)\n        self.running_var = np.ones(self.num_features, dtype=np.float64)\n\n    def forward(self, x, training=True):\n        x = np.asarray(x, dtype=np.float64)\n        axes = (0, 1, 2)\n        if training:\n            mean = x.mean(axis=axes)\n            var = x.var(axis=axes)\n            m = self.momentum\n            self.running_mean = (1 - m) * self.running_mean + m * mean\n            self.running_var = (1 - m) * self.running_var + m * var\n        else:\n            mean = self.running_m"]
[30.911275, "i", "ean\n            var = self.running_var\n        x_hat = (x - mean) / np.sqrt(var + self.eps)\n        return (self.gamma * x_hat + self.beta).astype(np.float64)\nEOF\n"]
