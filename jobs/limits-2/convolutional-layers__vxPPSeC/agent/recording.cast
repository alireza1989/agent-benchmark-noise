[29.481798, "o", ">         pass\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def __call__(self, x, *args, **kwargs):\r\n\u001b[?2004l\r\u001b[?2004h"]
