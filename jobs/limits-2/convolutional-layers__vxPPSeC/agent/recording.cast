[29.48132, "i", "cat > /app/src/base.py << 'EOF'\nfrom abc import ABC, abstractmethod\n\n\nclass BaseLayer(ABC):\n    def __init__(self):\n        pass\n\n    def __call__(self, x, *args, **kwargs):\n        return self.forward(x, *args, **kwargs)\n\n    @abstractmethod\n    def forward(self, x):\n        raise NotImplementedError\nEOF\n"]
[29.481478, "o", "cat > /app/src/base.py << 'EOF'\r\n\u001b[?2004l\r"]
[29.4815, "o", "\u001b[?2004h> "]
[29.481589, "o", "from abc import ABC, abstractmethod\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.481659, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
