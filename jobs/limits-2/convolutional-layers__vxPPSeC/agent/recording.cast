[30.56908, "i", "cat > /app/src/pooling.py << 'EOF'\nimport numpy as np\n\nfrom .base import BaseLayer\n\n\nclass _Pool2D(BaseLayer):\n    def __init__(self, kernel_size, stride=None):\n        super().__init__()\n        self.kernel_size = int(kernel_size)\n        self.stride = int(stride) if stride is not None else self.kernel_size\n\n    def _patches(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        N, H, W, C = x.shape\n        k, s = self.kernel_size, self.stride\n        oh = (H - k) // s + 1\n        ow = (W - k) // s + 1\n        patches = []\n        for i in range(k):\n            for j in range(k):\n                patches.append(x[:, i:i + s * (oh - 1) + 1:s, j:j + s * (ow - 1) + 1:s, :])\n        return np.stack(patches, axis=0)\n\n\nclass MaxPool2D(_Pool2D):\n    def forward(self, x):\n        return self._patches(x).max(axis=0).astype(np.float64)\n\n\nclass AvgPool2D(_Pool2D):\n    def forward(self, x):\n        return self._patches(x).mean(axis=0).astype(np.float64)\nEOF\n"]
[30.569222, "o", "cat > /app/src/pooling.py << 'EOF'\r\n\u001b[?2004l\r"]
