[29.876488, "i", "cat > /app/src/conv.py << 'EOF'\nimport numpy as np\n\nfrom .base import BaseLayer\nfrom .padding import zero_pad, get_output_shape\n\n\nclass Conv2D(BaseLayer):\n    def __init__(self, in_channels, out_channels, kernel_size, stride=1, padding=0, dilation=1):\n        super().__init__()\n        self.in_channels = int(in_channels)\n        self.out_channels = int(out_channels)\n        self.kernel_size = int(kernel_size)\n        self.stride = int(stride)\n        self.padding = int(padding)\n        self.dilation = int(dilation)\n        fan_in = self.in_channels * self.kernel_size * self.kernel_size\n        fan_out = self.out_channels * self.kernel_size * self.kernel_size\n        limit = np.sqrt(6.0 / (fan_in + fan_out))\n        self.weights = np.random.uniform(-limit, limit, (self.out_channels, self.in_channels, self.kernel_size, self.kernel_size)).astype(np.float64)\n        self.bias = np.zeros(self.out_channels, dtype=np.float64)\n\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        N, H, W, C ="]
[29.876754, "i", " x.shape\n        k, s, d = self.kernel_size, self.stride, self.dilation\n        xp = zero_pad(x, self.padding)\n        oh, ow = get_output_shape((H, W), k, s, self.padding, d)\n        out = np.zeros((N, oh, ow, self.out_channels), dtype=np.float64)\n        for i in range(k):\n            for j in range(k):\n                hs = i * d\n                ws = j * d\n                patch = xp[:, hs:hs + s * (oh - 1) + 1:s, ws:ws + s * (ow - 1) + 1:s, :]\n                out += np.einsum('nhwc,oc->nhwo', patch, self.weights[:, :, i, j])\n        out += self.bias\n        return out\nEOF\n"]
