[31.881962, "i", "cd /app && python3 -c \"import numpy as np; from src import *; from src.padding import get_output_shape; np.random.seed(0); x=np.random.randn(2,9,9,3); c=Conv2D(3,4,3,stride=2,padding=1,dilation=2); y=c(x); print('conv',y.shape,y.dtype); ref=np.zeros_like(y); xp=zero_pad(x,1); [ref.__setitem__((slice(None),a,b,slice(None)), sum(np.einsum('nc,oc->no',xp[:,a*2+i*2,b*2+j*2,:],c.weights[:,:,i,j]) for i in range(3) for j in range(3))+c.bias) for a in range(y.shape[1]) for b in range(y.shape[2])]; print('dil ok', np.allclose(ref,y)); t=Conv2DTranspose(3,5,3,stride=2,padding=1); print('convT',t(np.random.randn(2,4,4,3)).shape); print('pool',MaxPool2D(2)(x).shape, AvgPool2D(3,stride=2)(x).shape); b=BatchNorm2D(3); o=b(x); print('bn',np.allclose(o.mean(axis=(0,1,2)),0,atol=1e-8), b.running_mean.shape); print('relu',ReLU()(np.array([-1.,2.])), LeakyReLU(0.1)(np.array([-1.,2.])), Sigmoid()(np.array([-1000.,0.,1000.]))); print(get_output_shape((9,9),3,2,1,2)); print(BaseLayer.__abstractmethods__)\"\n"]
[31.883075, "o", "cd /app && python3 -c \"import numpy as np; from src import *; from src.padding import get_output_shape; np.random.seed(0); x=np.random.randn(2,9,9,3); c=Conv2D(3,4,3,stride=2,padding=1,dilation=2); y=c(x); print('conv',y.shape,y.dtype); ref=np.zeros_like(y); xp=zero_pad(x,1); [ref.__setitem__((slice(None),a,b,slice(None)), sum(np.einsum('nc,oc->no',xp[:,a*2+i*2,b*2+j*2,:],c.weights[:,:,i,j]) for i in range(3) for j in range(3))+c.bias) for a in range(y.shape[1]) for b in range(y.shape[2])]; print('dil ok', np.allclose(ref,y)); t=Conv2DTranspose(3,5,3,stride=2,padding=1); print('convT',t(np.random.randn(2,4,4,3)).shape); print('pool',MaxPool2D(2)(x).shape, AvgPool2D(3,stride=2)(x).shape); b=BatchNorm2D(3); o=b(x); print('bn',np.allclose(o.mean(axis=(0,1,2)),0,atol=1e-8), b.running_mean.shape); print('relu',ReLU()(np.array([-1.,2.])), LeakyReLU(0.1)(np.array([-1.,2.])), Sigmoid()(np.array([-1000.,0.,1000.]))); print(get_output_shape((9,9),3,2,1,2)); print(BaseLayer.__abstractmethods__)\"\r\n\u001b[?2004l\r"]
