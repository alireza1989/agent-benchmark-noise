[29.184098, "o", "    oh = (h + 2 * padding - dilation * (kernel_size - 1) - 1) // stride + 1\r\n\u001b[?2004l\r\u001b[?2004h>     ow = (w + 2 * padding - dilation * (kernel_size - 1) - 1) // stride + 1\r\n\u001b[?2004l\r\u001b[?2004h>     return (int(oh), int(ow))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
