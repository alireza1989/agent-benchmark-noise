[?2004l[?2004h> class BatchNorm2D(BaseLayer):
[?2004l[?2004h>     def __init__(self, num_features, eps=1e-5, momentum=0.1):
[?2004l[?2004h>         super().__init__()
[?2004l[?2004h>         self.num_features = int(num_features)
[?2004l[?2004h>         self.eps = float(eps)
[?2004l[?2004h>         self.momentum = float(momentum)
[?2004l[?2004h>         self.gamma = np.ones(self.num_features, dtype=np.float64)
[?2004l[?2004h>         self.beta = np.zeros(self.num_features, dtype=np.float64)
[?2004l[?2004h>         self.running_mean = np.zeros(self.num_features, dtype=np.float64)
[?2004l[?2004h>         self.running_var = np.ones(self.num_features, dtype=np.float64)
[?2004l[?2004h> 
[?2004l[?2004h>     def forward(self, x, training=True):
[?2004l[?2004h>         x = np.asarray(x, dtype=np.float64)
[?2004l[?2004h>         axes = (0, 1, 2)
[?2004l[?2004h>         if training:
[?2004l[?2004h>             mean = x.mean(axis=axes)
[?2004l[?2004h>             var = x.var(axis=axes)
[?2004l[?2004h>             m = self.momentum
[?2004l[?2004h>             self.running_mean = (1 - m) * self.running_mean + m * mean
[?2004l[?2004h>             self.running_var = (1 - m) * self.running_var + m * var
[?2004l[?2004h>         else:
[?2004l[?2004h>             mean = self.running_mean
[?2004l[?2004h>             var = self.running_var
[?2004l[?2004h>         x_hat = (x - mean) / np.sqrt(var + self.eps)
