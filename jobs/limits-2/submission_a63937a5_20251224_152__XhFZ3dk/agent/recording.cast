[5.255324, "o", "#!/bin/bash\r\nexec python3 /app/bandit.pyc \"$@\"\r\n"]
[5.255577, "o", "\u001b[?2004hroot@df2e5ef760d7:/app# "]
[5.597625, "i", "/app/bandit --help 2>&1 | head -30\n"]
[5.598038, "o", "/app/bandit --help 2>&1 | head -30\r\n\u001b[?2004l\r"]
[5.715583, "o", "BANDIT n_arms=10 horizon=1500 seed=42\r\nREADY\r\nTURN 1\r\n"]
[20.504708, "i", "\u0003"]
[20.508121, "o", "^C"]
[20.526539, "o", "\r\n"]
[20.526832, "o", "\u001b[?2004hroot@df2e5ef760d7:/app# "]
[21.012429, "i", "clear\n"]
[21.012708, "o", "clear\r\n\u001b[?2004l\r"]
[21.014038, "o", "\u001b[H\u001b[J\u001b[3J"]
[21.014214, "o", "\u001b[?2004hroot@df2e5ef760d7:/app# "]
[21.398126, "i", "cat > /tmp/play.py << 'EOF'\nimport subprocess, sys, math\nW = int(sys.argv[1])\nC = float(sys.argv[2])\n\ndef play(seed):\n    p = subprocess.Popen(['/app/bandit', '--seed', str(seed)], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, bufsize=1)\n    obs = [[] for _ in range(10)]\n    done = None\n    while True:\n        line = p.stdout.readline()\n        if not line:\n            break\n        line = line.strip()\n        if line.startswith('TURN'):\n            counts = [len(o[-W:]) for o in obs]\n            if 0 in counts:\n                arm = counts.index(0)\n            else:\n                tot = sum(counts)\n                vals = []\n                for i in range(10):\n                    w = obs[i][-W:]\n                    m = sum(w) / len(w)\n                    vals.append(m + C * math.sqrt(math.log(tot) / len(w)))\n                arm = vals.index(max(vals))\n            p.stdin.write(str(arm) + '\\n')\n            p.stdin.flush()\n            r = p.stdout.readline().strip()\n            obs[arm].append(float(r.split()[1]))\n        elif line.startswith('DONE'):\n            done = line\n            break\n    p.stdin.close()\n    p.wait()\n    return done\n\nres = []\nfor s in [42, 43, 44]:\n    d = play(s)\n    print('seed', s, d)\n    kv = dict(x.split('=') for x in d.split()[1:])\n    res.append((float(kv['total_reward']), float(kv['regret'])))\navg_t = sum(r[0] for r in res) / 3\navg_r = sum(r[1] for r in res) / 3\nprint('avg total_reward=%.3f regret=%.3f' % (avg_t, avg_r))\nwith open('/app/answer.txt', 'w') as f:\n    f.write('total_reward=%.3f\\nregret=%.3f\\n' % (avg_t, avg_r))\nEOF\n"]
