[8.413729, "o", "\u001b[?2004hroot@e8a70dcb0707:/app# "]
[22.002843, "i", "cat > solve.py << 'EOF'\nimport math\nS=[list(map(int,l.split())) for l in open('signs.txt') if l.strip()]\ny=list(map(float,open('sum.txt').read().split()))\nn=len(S); d=len(y)\ndef solve(A,b):\n    m=len(b); M=[row[:]+[b[i]] for i,row in enumerate(A)]\n    for c in range(m):\n        p=max(range(c,m),key=lambda r:abs(M[r][c])); M[c],M[p]=M[p],M[c]\n        for r in range(m):\n            if r!=c and M[c][c]!=0:\n                f=M[r][c]/M[c][c]\n                for k in range(c,m+1): M[r][k]-=f*M[c][k]\n    return [M[i][m]/M[i][i] for i in range(m)]\nsel=[]; r=y[:]\nfor step in range(16):\n    best=None; bv=-1\n    for j in range(n):\n        if j in sel: continue\n        v=abs(sum(S[j][t]*r[t] for t in range(d)))\n        if v>bv: bv=v; best=j\n    sel.append(best)\n    cols=[S[j] for j in sel]\n    G=[[sum(a[t]*b[t] for t in range(d)) for b in cols] for a in cols]\n    bb=[sum(a[t]*y[t] for t in range(d)) for a in cols]\n    x=solve(G,bb)\n    r=[y[t]-sum(x[i]*cols[i][t] for i in range(len(sel))) for t in range(d)]\n    print(step, best+1, round(math.sqrt(sum(v*v for v in r)),6))\nprint('coef', [round(v,4) for v in x])\nprint('final', sorted(i+1 for i in sel))\nopen('players.txt','w').write('\\n'.join(str(i+1) for i in sorted(sel))+'\\n')\nEOF\n"]
