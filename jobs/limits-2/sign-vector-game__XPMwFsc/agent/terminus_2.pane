[?2004hroot@e8a70dcb0707:/app# cat > solve.py << 'EOF'
[?2004l[?2004h> import math
[?2004l[?2004h> S=[list(map(int,l.split())) for l in open('signs.txt') if l.strip()]
[?2004l[?2004h> y=list(map(float,open('sum.txt').read().split()))
[?2004l[?2004h> n=len(S); d=len(y)
[?2004l[?2004h> def solve(A,b):
[?2004l[?2004h>     m=len(b); M=[row[:]+[b[i]] for i,row in enumerate(A)]
[?2004l[?2004h>     for c in range(m):
[?2004l[?2004h>         p=max(range(c,m),key=lambda r:abs(M[r][c])); M[c],M[p]=M[p],M[c]
[?2004l[?2004h>         for r in range(m):
[?2004l[?2004h>             if r!=c and M[c][c]!=0:
[?2004l[?2004h>                 f=M[r][c]/M[c][c]
[?2004l[?2004h>                 for k in range(c,m+1): M[r][k]-=f*M[c][k]
[?2004l[?2004h>     return [M[i][m]/M[i][i] for i in range(m)]
[?2004l[?2004h> sel=[]; r=y[:]
[?2004l[?2004h> for step in range(16):
[?2004l[?2004h>     best=None; bv=-1
[?2004l[?2004h>     for j in range(n):
[?2004l[?2004h>         if j in sel: continue
[?2004l[?2004h>         v=abs(sum(S[j][t]*r[t] for t in range(d)))
[?2004l[?2004h>         if v>bv: bv=v; best=j
[?2004l[?2004h>     sel.append(best)
[?2004l[?2004h>     cols=[S[j] for j in sel]
[?2004l[?2004h>     G=[[sum(a[t]*b[t] for t in range(d)) for b in cols] for a in cols]
[?2004l[?2004h>     bb=[sum(a[t]*y[t] for t in range(d)) for a in cols]
[?2004l[?2004h>     x=solve(G,bb)
[?2004l[?2004h>     r=[y[t]-sum(x[i]*cols[i][t] for i in range(len(sel))) for t in range(d)]
[?2004l[?2004h>     print(step, best+1, round(math.sqrt(sum(v*v for v in r)),6))
[?2004l[?2004h> print('coef', [round(v,4) for v in x])
[?2004l[?2004h> print('final', sorted(i+1 for i in sel))
[?2004l[?2004h> open('players.txt','w').write('\n'.join(str(i+1) for i in sorted(sel))+'\n')
