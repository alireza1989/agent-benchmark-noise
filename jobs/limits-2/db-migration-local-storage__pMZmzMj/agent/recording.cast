[28.329772, "o", "    return {\"status\": \"healthy\", \"message\": \"Service is running\"}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
