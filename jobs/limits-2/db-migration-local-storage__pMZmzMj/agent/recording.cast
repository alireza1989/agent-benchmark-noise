[28.329986, "o", "> "]
[28.330078, "o", "    type1: str = Query(..., description=\"Type1 value to filter by\"),\r\n\u001b[?2004l\r"]
[28.330156, "o", "\u001b[?2004h> "]
[28.330249, "o", "    type2: str = Query(..., description=\"Type2 value to filter by\")"]
[28.330346, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> ) -> List[Record]:\r\n\u001b[?2004l\r"]
[28.330433, "o", "\u001b[?2004h>     \"\"\""]
[28.330529, "o", "\r\n\u001b[?2004l\r"]
[28.330605, "o", "\u001b[?2004h"]
[28.330628, "o", "> "]
[28.330827, "o", "    Query records by Type1 and Type2.\r\n\u001b[?2004l\r"]
[28.330844, "o", "\u001b[?2004h> "]
[28.330973, "o", "    Both parameters are required. Only the matching chunk is loaded.\r\n\u001b[?2004l\r"]
[28.331049, "o", "\u001b[?2004h"]
[28.331071, "o", "> "]
[28.33119, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.331446, "o", "    global last_loaded_type1_values, last_loaded_type2_values"]
[28.331575, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[28.33177, "o", "> "]
[28.331847, "o", "    if not type1 or not type2:\r\n\u001b[?2004l\r"]
[28.331951, "o", "\u001b[?2004h"]
[28.332118, "o", "> "]
[28.332383, "o", "        raise HTTPException(status_code=400, detail=\"Both type1 and type2 are required\")"]
[28.33252, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[28.33266, "o", "\u001b[?2004h> "]
