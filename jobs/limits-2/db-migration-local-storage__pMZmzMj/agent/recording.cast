[28.324768, "o", "    # Group rows by combination (transient, used only during startup)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.324897, "o", "    groups: Dict[Tuple[str, str], List[dict]] = {}\r\n\u001b[?2004l\r\u001b[?2004h>     with open(DATA_PATH, 'r', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.32504, "o", "        reader = csv.DictReader(f)\r\n\u001b[?2004l\r\u001b[?2004h>         for row in reader:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.325131, "o", "            record = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.32517, "o", "                \"Type1\": row[\"Type1\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.325244, "o", "                \"Type2\": row[\"Type2\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.325332, "o", "                \"Text\": row[\"Text\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.325413, "o", "                \"ID\": int(row[\"ID\"]),\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.325519, "o", "            key = (record[\"Type1\"], record[\"Type2\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.325607, "o", "            groups.setdefault(key, []).append(record)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.325696, "o", "            all_type1_values.add(record[\"Type1\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.325786, "o", "            all_type2_values.add(record[\"Type2\"])\r\n\u001b[?2004l\r\u001b[?2004h>             total_records += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.325867, "o", "> \r\n\u001b[?2004l\r"]
[28.325896, "o", "\u001b[?2004h> "]
[28.325985, "o", "    for n, key in enumerate(sorted(groups.keys())):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.326125, "o", "        rows = sorted(groups[key], key=lambda r: r[\"ID\"])"]
[28.326189, "o", "\r\n"]
[28.326303, "o", "\u001b[?2004l\r\u001b[?2004h"]
[28.326474, "o", "> "]
[28.326875, "o", "        path = os.path.join(CHUNK_DIR, f\"chunk_{n}.csv\")\r\n\u001b[?2004l\r"]
[28.326977, "o", "\u001b[?2004h> "]
[28.327201, "o", "        with open(path, 'w', newline='') as f:"]
[28.327234, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.327345, "o", "> "]
[28.327614, "o", "            writer = csv.DictWriter(f, fieldnames=CSV_FIELDS)\r\n\u001b[?2004l\r"]
[28.327774, "o", "\u001b[?2004h> "]
[28.327887, "o", "            writer.writeheader()\r\n\u001b[?2004l\r"]
[28.328016, "o", "\u001b[?2004h> "]
