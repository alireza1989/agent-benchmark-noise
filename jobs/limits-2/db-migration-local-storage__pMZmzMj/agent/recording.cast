[28.333626, "o", "                Type1=row[\"Type1\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.333699, "o", "                Type2=row[\"Type2\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.333799, "o", "                Text=row[\"Text\"],\r\n\u001b[?2004l\r\u001b[?2004h>                 ID=int(row[\"ID\"]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.333822, "o", "            ))\r\n\u001b[?2004l\r"]
[28.333891, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.333913, "o", "    last_loaded_type1_values = {type1}\r\n\u001b[?2004l\r"]
[28.334033, "o", "\u001b[?2004h>     last_loaded_type2_values = {type2}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.334147, "o", "    return results\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[28.334177, "o", "\u001b[?2004h> "]
[28.334196, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
