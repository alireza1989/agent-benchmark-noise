[77.864457, "i", "python3 - << 'EOF'\nimport json, urllib.request, itertools, time\nB='http://localhost:8000'\ndef g(p):\n    with urllib.request.urlopen(B+p) as r:\n        return json.loads(r.read())\nslowest=0\ndef timed(p):\n    global slowest\n    t=time.time(); v=g(p); slowest=max(slowest,time.time()-t); return v\nprint('root', timed('/'))\nprint('stats', timed('/stats'))\nprint('loaded before any query', timed('/get_all_loaded_types_and_subtypes'))\nr = timed('/query?type1=electronics&type2=laptops')\nprint('query count', len(r))\nprint('loaded after query', timed('/get_all_loaded_types_and_subtypes'))\nprint('missing-combo', timed('/query?type1=nope&type2=x'))\nprint('loaded after missing', timed('/get_all_loaded_types_and_subtypes'))\navail = timed('/get_all_available_types_and_subtypes')\ntotal=0; ids=set(); combos=0\nfor t1, t2 in itertools.product(avail['type1_values'], avail['type2_values']):\n    rows = timed('/query?type1=%s&type2=%s' % (t1, t2))\n    if rows:\n        combos += 1; total += len(rows); ids.update(x['ID'] for x in rows)\n        assert all(x['Type1']==t1 and x['Type2']==t2 for x in rows)\n        lt = timed('/get_all_loaded_types_and_subtypes')\n        assert lt == {'type1_values':[t1],'type2_values':[t2]}, lt\nprint('non-empty combos', combos, 'total', total, 'unique ids', len(ids))\nprint('slowest request seconds', round(slowest,4))\nEOF\n"]
