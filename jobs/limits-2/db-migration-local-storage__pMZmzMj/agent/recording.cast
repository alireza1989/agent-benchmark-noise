[28.333132, "o", "    if path is None:\r\n\u001b[?2004l\r\u001b[?2004h>         return []\r\n"]
[28.333198, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.333277, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
