[36.813815, "i", "cat > /app/check.py << 'EOF'\nimport json, csv\nfrom kiln_firmware import run_firing_cycle\nres = run_firing_cycle('/app/firing_schedule.csv', '/app/kiln_specs.json')\ns = json.load(open('/app/kiln_specs.json'))\ntg = [float(r['target_temp']) for r in csv.DictReader(open('/app/firing_schedule.csv'))]\nT = tg[0]\ngs = []\nerr = 0.0\nmaxdrop = 0.0\nfor t in range(1000):\n    g = res[t]['gas']\n    d = res[t]['damper']\n    gs.append(g)\n    g1 = gs[t-1] if t >= 1 else 0\n    g2 = gs[t-2] if t >= 2 else 0\n    eff = 0.1*g + 0.3*g1 + 0.6*g2\n    Tn = T + eff*s['gas_burner_power_c'] - (d*s['damper_cooling_c'] + s['ambient_loss_c'])\n    maxdrop = max(maxdrop, T - Tn)\n    T = Tn\n    if t + 1 < 1000:\n        err += abs(T - tg[t+1])\nprint('len', len(res), 'gas', sum(gs), 'err', round(err, 3), 'maxdrop', round(maxdrop, 3))\nEOF\ncd /app && python3 kiln_firmware.py && python3 check.py\n"]
