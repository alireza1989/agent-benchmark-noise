[36.858802, "o", "\u001b[?2004hroot@05660e803bc5:/app# "]
[63.495578, "i", "cat > /app/kiln_firmware.py << 'EOF'\nimport csv, json\n\ndef run_firing_cycle(schedule_path, specs_path):\n    specs = json.load(open(specs_path))\n    gp = float(specs['gas_burner_power_c'])\n    dc = float(specs['damper_cooling_c'])\n    al = float(specs['ambient_loss_c'])\n    with open(schedule_path) as f:\n        targets = [float(r['target_temp']) for r in csv.DictReader(f)]\n    n = len(targets)\n    K = 200\n    GP = 0.05\n    DP = 0.02\n    beam = [(0.0, targets[0], 0, 0)]\n    layers = []\n    for t in range(n):\n        nxt = targets[t + 1] if t + 1 < n else targets[t]\n        cands = []\n        for bi, (cost, T, g1, g2) in enumerate(beam):\n            base = T + (0.3 * g1 + 0.6 * g2) * gp\n            for g in range(6):\n                Tg = base + 0.1 * g * gp\n                for d in range(6):\n                    Tn = Tg - (d * dc + al)\n                    if Tn < T - 4.9:\n                        continue\n                    c = cost + abs(Tn - nxt) + GP * g + DP * d\n                    cands.append((c, bi, g, d, Tn))\n        cands.sort()\n        new = []\n        layer = []\n        seen = set()\n        for c, bi, g, d, Tn in cands:\n            old_g1 = beam[bi][2]\n            key = (g, old_g1, round(Tn, 2))\n            if key in seen:\n                continue\n            seen.add(key)\n            new.append((c, Tn, g, old_g1))\n            layer.append((bi, g, d))\n            if len(new) >= K:\n                break\n        beam = new\n        layers.append(layer)\n    bi = min(range(len(beam)), key=lambda i: beam[i][0])\n    out = [None] * n\n    for t in range(n - 1, -1, -1):\n        parent, g, d = layers[t][bi]\n        out[t] = {'gas': int(g), 'damper': int(d)}\n        bi = parent\n    return out\n\nif __name__ == '__main__':\n    r = run_firing_cycle('/app/firing_schedule.csv', '/app/kiln_specs.json')\n    print(r[:3], len(r))\nEOF\ncd /app && time python3 kiln_firmware.py && python3 check.py\n"]
[63.496182, "o", "cat > /app/kiln_firmware.py << 'EOF'\r\n\u001b[?2004l\r"]
