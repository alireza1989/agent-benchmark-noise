[118.980194, "i", "cat > /app/api_test.py << 'EOF'\nimport json\n\nimport numpy as np\nimport pandas as pd\nimport requests\nfrom sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n\nFEATURES = ['MedInc', 'HouseAge', 'AveRooms', 'AveBedrms', 'Population', 'AveOccup', 'Latitude', 'Longitude']\nURL = 'http://localhost:8000'\n\ndf = pd.read_csv('/app/data/train.csv').reset_index(drop=True)\nsplit = json.load(open('/app/output/split_info.json'))\nval = df.iloc[split['validation_indices']]\n\nrows = []\nfor i, (_, r) in enumerate(val.iterrows()):\n    feats = [float(r[c]) for c in FEATURES]\n    resp = requests.post(f'{URL}/predict', json={'features': feats})\n    resp.raise_for_status()\n    y_pred = resp.json()['prediction']\n    y_true = float(r['target'])\n    rows.append({'sample_index': i, 'y_true': y_true, 'y_pred': y_pred, 'absolute_error': abs(y_true - y_pred)})\n\nout = pd.DataFrame(rows)\nout.to_csv('/app/output/api_predictions.csv', index=False)\n\ny_true = out['y_true'].values\ny_pred = out['y_pred'].values\nmse = mean_square"]
[118.981553, "o", "cat > /app/api_test.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import requests\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.981615, "i", "d_error(y_true, y_pred)\nmetrics = {\n    'sample_count': int(len(out)),\n    'mae': float(mean_absolute_error(y_true, y_pred)),\n    'mse': float(mse),\n    'rmse': float(np.sqrt(mse)),\n    'r2_score': float(r2_score(y_true, y_pred)),\n}\nwith open('/app/output/api_metrics.json', 'w') as f:\n    json.dump(metrics, f, indent=2)\nprint(metrics)\n\n# Batch endpoint check against direct model predictions\nimport pickle\nmodel = pickle.load(open('/app/models/best_model.pkl', 'rb'))\nsample = val[FEATURES].iloc[:5]\nbatch = requests.post(f'{URL}/predict-batch', json={'features_list': sample.values.tolist()}).json()\ndirect = model.predict(sample)\nprint('batch count:', batch['count'], 'model:', batch['model_name'])\nprint('max abs diff batch vs direct:', float(np.max(np.abs(np.array(batch['predictions']) - direct))))\nEOF\npython3 /app/api_test.py && head -3 /app/output/api_predictions.csv && python3 -c \"import json; json.load(open('/app/output/api_metrics.json')); json.load(open('/app/output/split_info.json')); json.load(open('/app/"]
