[93.50606, "o", "\u001b[?2004h> state = {}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.506081, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.506296, "o", "@asynccontextmanager\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.506322, "o", "> "]
[93.506431, "o", "async def lifespan(app):\r\n\u001b[?2004l\r"]
[93.506696, "o", "\u001b[?2004h>     with open(MODEL_PATH, 'rb') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         state['model'] = pickle.load(f)\r\n\u001b[?2004l\r\u001b[?2004h>     with open(COMPARISON_PATH) as f:\r\n\u001b[?2004l\r\u001b[?2004h>         state['name'] = json.load(f)['best_model_name']\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.506717, "o", ">     yield\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.50704, "o", "    state.clear()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> app = FastAPI(title='California Housing Price API', lifespan=lifespan)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.507082, "o", "class PredictRequest(BaseModel):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.507122, "o", "    features: List[float]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[93.507139, "o", "\u001b[?2004h> "]
[93.50735, "o", "class PredictBatchRequest(BaseModel):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.507512, "o", "    features_list: List[List[float]]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @app.post('/predict')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.507625, "o", "def predict(req: PredictRequest):\r\n\u001b[?2004l\r\u001b[?2004h>     if len(req.features) != 8:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.507854, "o", "        raise HTTPException(status_code=422, detail='features must contain exactly 8 values')\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.507882, "o", "> "]
[93.50802, "o", "    X = pd.DataFrame([req.features], columns=FEATURES)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.508156, "o", "    pred = float(state['model'].predict(X)[0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.508294, "o", "    return {'prediction': pred, 'model_name': state['name']}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[93.508322, "o", "\u001b[?2004h> "]
[93.508361, "o", "@app.get('/health')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.508429, "o", "def health():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.508562, "o", "    return {'status': 'healthy', 'model_loaded': 'model' in state}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[93.508721, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @app.get('/model-info')\r\n\u001b[?2004l\r\u001b[?2004h> def model_info():\r\n\u001b[?2004l\r\u001b[?2004h>     return {\r\n\u001b[?2004l\r"]
[93.508848, "o", "\u001b[?2004h>         'model_name': state['name'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.508968, "o", "        'model_type': type(state['model']).__name__,\r\n\u001b[?2004l\r\u001b[?2004h>         'features_count': 8,\r\n\u001b[?2004l\r"]
[93.508992, "o", "\u001b[?2004h"]
[93.50907, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.509085, "o", "> \r\n"]
[93.509102, "o", "\u001b[?2004l\r"]
[93.509193, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.509284, "o", "@app.post('/predict-batch')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.509318, "o", "def predict_batch(req: PredictBatchRequest):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.509404, "o", "    for row in req.features_list:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.509442, "o", "        if len(row) != 8:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.509588, "o", "            raise HTTPException(status_code=422, detail='each inner list must contain exactly 8 values')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.509688, "o", "    if not req.features_list:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.509811, "o", "        return {'predictions': [], 'model_name': state['name'], 'count': 0}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.509844, "o", "    X = pd.DataFrame(req.features_list, columns=FEATURES)\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.509904, "o", "> "]
[93.509994, "o", "    preds = [float(p) for p in state['model'].predict(X)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.510113, "o", "    return {'predictions': preds, 'model_name': state['name'], 'count': len(preds)}\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
