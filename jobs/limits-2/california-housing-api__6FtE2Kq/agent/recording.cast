[93.504065, "i", "cat > /app/api/app.py << 'EOF'\nimport json\nimport pickle\nfrom contextlib import asynccontextmanager\nfrom typing import List\n\nimport pandas as pd\nfrom fastapi import FastAPI, HTTPException\nfrom pydantic import BaseModel\n\nMODEL_PATH = '/app/models/best_model.pkl'\nCOMPARISON_PATH = '/app/output/model_comparison.json'\nFEATURES = ['MedInc', 'HouseAge', 'AveRooms', 'AveBedrms', 'Population', 'AveOccup', 'Latitude', 'Longitude']\n\nstate = {}\n\n\n@asynccontextmanager\nasync def lifespan(app):\n    with open(MODEL_PATH, 'rb') as f:\n        state['model'] = pickle.load(f)\n    with open(COMPARISON_PATH) as f:\n        state['name'] = json.load(f)['best_model_name']\n    yield\n    state.clear()\n\n\napp = FastAPI(title='California Housing Price API', lifespan=lifespan)\n\n\nclass PredictRequest(BaseModel):\n    features: List[float]\n\n\nclass PredictBatchRequest(BaseModel):\n    features_list: List[List[float]]\n\n\n@app.post('/predict')\ndef predict(req: PredictRequest):\n    if len(req.features) != 8:\n        raise HTTPException(status_code"]
[93.505312, "o", "cat > /app/api/app.py << 'EOF'\r\n\u001b[?2004l\r"]
[93.505521, "i", "=422, detail='features must contain exactly 8 values')\n    X = pd.DataFrame([req.features], columns=FEATURES)\n    pred = float(state['model'].predict(X)[0])\n    return {'prediction': pred, 'model_name': state['name']}\n\n\n@app.get('/health')\ndef health():\n    return {'status': 'healthy', 'model_loaded': 'model' in state}\n\n\n@app.get('/model-info')\ndef model_info():\n    return {\n        'model_name': state['name'],\n        'model_type': type(state['model']).__name__,\n        'features_count': 8,\n    }\n\n\n@app.post('/predict-batch')\ndef predict_batch(req: PredictBatchRequest):\n    for row in req.features_list:\n        if len(row) != 8:\n            raise HTTPException(status_code=422, detail='each inner list must contain exactly 8 values')\n    if not req.features_list:\n        return {'predictions': [], 'model_name': state['name'], 'count': 0}\n    X = pd.DataFrame(req.features_list, columns=FEATURES)\n    preds = [float(p) for p in state['model'].predict(X)]\n    return {'predictions': preds, 'model_name': state['name"]
[93.505572, "o", "\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import pickle\r\n\u001b[?2004l\r\u001b[?2004h> from contextlib import asynccontextmanager\r\n\u001b[?2004l\r\u001b[?2004h> from typing import List\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> from fastapi import FastAPI, HTTPException\r\n\u001b[?2004l\r\u001b[?2004h> from pydantic import BaseModel\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> MODEL_PATH = '/app/models/best_model.pkl'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.505588, "i", "'], 'count': len(preds)}\nEOF\ncd /app && nohup uvicorn api.app:app --host 0.0.0.0 --port 8000 > /app/output/server.log 2>&1 &\nfor i in $(seq 1 40); do curl -s http://localhost:8000/health && break; sleep 1; done; echo\ncurl -s http://localhost:8000/model-info; echo\n"]
