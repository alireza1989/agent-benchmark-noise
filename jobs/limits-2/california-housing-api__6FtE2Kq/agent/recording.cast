[22.140539, "i", "cd /app && cat > /app/train.py << 'EOF'\nimport json\nimport pickle\nimport shutil\n\nimport numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import RandomForestRegressor\nfrom sklearn.linear_model import LinearRegression, Ridge\nfrom sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\nfrom sklearn.model_selection import train_test_split\n\nFEATURES = ['MedInc', 'HouseAge', 'AveRooms', 'AveBedrms', 'Population', 'AveOccup', 'Latitude', 'Longitude']\n\ndf = pd.read_csv('/app/data/train.csv').reset_index(drop=True)\nX = df[FEATURES]\ny = df['target']\n\nidx = np.arange(len(df))\ntr_idx, va_idx = train_test_split(idx, test_size=0.2, random_state=42)\ntr_idx = np.sort(tr_idx)\nva_idx = np.sort(va_idx)\n\nX_train, y_train = X.iloc[tr_idx], y.iloc[tr_idx]\nX_val, y_val = X.iloc[va_idx], y.iloc[va_idx]\n\nsplit_info = {\n    'train_size': int(len(tr_idx)),\n    'validation_size': int(len(va_idx)),\n    'random_state': 42,\n    'test_size': 0.2,\n    'train_indices': [int(i) for i in tr_idx],\n    'validation_indices': "]
[22.140689, "i", "[int(i) for i in va_idx],\n}\nwith open('/app/output/split_info.json', 'w') as f:\n    json.dump(split_info, f)\n\nmodels = {\n    'linear_regression': LinearRegression(),\n    'ridge': Ridge(),\n    'random_forest': RandomForestRegressor(n_estimators=200, random_state=42, n_jobs=-1),\n}\n\nresults = []\nfitted = {}\nfor name, model in models.items():\n    model.fit(X_train, y_train)\n    fitted[name] = model\n    train_r2 = r2_score(y_train, model.predict(X_train))\n    pred = model.predict(X_val)\n    mse = mean_squared_error(y_val, pred)\n    res = {\n        'model_name': name,\n        'train_r2': float(train_r2),\n        'val_r2': float(r2_score(y_val, pred)),\n        'mae': float(mean_absolute_error(y_val, pred)),\n        'mse': float(mse),\n        'rmse': float(np.sqrt(mse)),\n    }\n    results.append(res)\n    print(res)\n    with open(f'/app/models/{name}.pkl', 'wb') as f:\n        pickle.dump(model, f)\n\nbest = max(results, key=lambda r: r['val_r2'])\nbest_name = best['model_name']\nshutil.copy(f'/app/models/{best_name}.pkl',"]
[22.140824, "o", "cd /app && cat > /app/train.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
