[245.482049, "o", "  for f in \"$p\"/home/*/.ssh/authorized_keys \"$p/root/.ssh/authorized_keys\"; do scan_keys \"$f\"; done"]
[245.482069, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
