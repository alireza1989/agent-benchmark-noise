[198.804116, "i", "[] | select(.type == \"cron_job\")] | length), systemd_units: ([$a[] | select(.type == \"systemd_unit\")] | length), rc_local_modifications: ([$a[] | select(.type == \"rc_local\")] | length), ssh_keys: ([$a[] | select(.type == \"ssh_key\")] | length)}, artifacts: $a}' > \"$OUT.tmp\" && mv -f \"$OUT.tmp\" \"$OUT\" || echo 'failed to write report' >&2\nexit 0\nEOF\n"]
