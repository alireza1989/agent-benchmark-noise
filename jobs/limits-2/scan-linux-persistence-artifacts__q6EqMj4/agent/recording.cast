[273.528799, "o", "\u001b[?2004h>   while IFS= read -r line || [ -n \"$line\" ]; do\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.52888, "o", "    n=$((n+1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.528981, "o", "    t=\"${line//[[:space:]]/}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.529084, "o", "    case \"$t\" in ''|'#'*|exit0) continue ;; esac\r\n\u001b[?2004l\r"]
[273.529178, "o", "\u001b[?2004h> "]
[273.529212, "o", "    rec rc_local \"$real\" \"$n\" \"$line\" \"\"\r\n\u001b[?2004l\r"]
[273.529338, "o", "\u001b[?2004h> "]
[273.529434, "o", "  done < \"$real\"\r\n\u001b[?2004l\r\u001b[?2004h>   return 0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.529562, "o", "scan_keys() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.52959, "o", "  local real n=0 line t u\r\n\u001b[?2004l\r"]
[273.529693, "o", "\u001b[?2004h> "]
[273.529861, "o", "  real=$(readlink -f -- \"$1\") || return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.529913, "o", "  [ -f \"$real\" ] && [ -r \"$real\" ] || return 0\r\n\u001b[?2004l\r"]
[273.529929, "o", "\u001b[?2004h> "]
[273.53008, "o", "  u=$(basename -- \"$(dirname -- \"$(dirname -- \"$real\")\")\")\r\n\u001b[?2004l\r"]
[273.530161, "o", "\u001b[?2004h> "]
[273.530253, "o", "  while IFS= read -r line || [ -n \"$line\" ]; do\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.530288, "o", "    n=$((n+1))\r\n\u001b[?2004l\r"]
[273.530313, "o", "\u001b[?2004h> "]
[273.530382, "o", "    t=\"${line//[[:space:]]/}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.530415, "o", "> "]
[273.530491, "o", "    case \"$t\" in ''|'#'*) continue ;; esac\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.530582, "o", "    rec ssh_key \"$real\" \"$n\" \"$line\" \"$u\"\r\n\u001b[?2004l\r\u001b[?2004h>   done < \"$real\"\r\n"]
[273.530608, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[273.530642, "o", "  return 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.530709, "o", "> }\r\n\u001b[?2004l\r"]
[273.530743, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> scan_location() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
