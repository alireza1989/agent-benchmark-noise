[245.471184, "i", ", cron_jobs: ([$a[] | select(.type == \"cron_job\")] | length), systemd_units: ([$a[] | select(.type == \"systemd_unit\")] | length), rc_local_modifications: ([$a[] | select(.type == \"rc_local\")] | length), ssh_keys: ([$a[] | select(.type == \"ssh_key\")] | length)}, artifacts: $a}' > \"$OUT.tmp\" && mv -f \"$OUT.tmp\" \"$OUT\" || echo 'failed to write report' >&2\nexit 0\nEOF\nchmod +x /app/scan_persistence.sh && bash -n /app/scan_persistence.sh && /app/scan_persistence.sh; echo \"exit=$?\"; jq -c .summary /app/persistence_report.json; jq -r '.artifacts[] | [.type, .path, .details.line_number, .details.user] | @tsv' /app/persistence_report.json\n"]
