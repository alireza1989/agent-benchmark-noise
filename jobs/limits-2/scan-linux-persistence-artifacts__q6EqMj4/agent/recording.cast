[245.477844, "o", "    case \"$exe\" in\r\n\u001b[?2004l\r\u001b[?2004h"]
[245.477904, "o", "> "]
[245.478045, "o", "      /usr/bin/*|/bin/*|/sbin/*|/usr/sbin/*|/usr/lib/*|/lib/*|/usr/libexec/*|/etc/update-motd.d/*|/etc/rc.local) ;;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.47814, "o", "      /*) reason=${reason:-suspicious_exec} ;;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.478205, "o", "    esac\r\n\u001b[?2004l\r\u001b[?2004h>   fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.478312, "o", "  if [ -n \"$reason\" ]; then rec systemd_unit \"$real\" \"\" \"$ex\" \"\"; fi"]
[245.478382, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
