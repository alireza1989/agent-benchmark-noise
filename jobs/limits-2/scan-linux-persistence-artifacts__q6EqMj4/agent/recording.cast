[245.476072, "o", "    if is_susp \"$line\" || cron_badpath \"$line\" || printf '%s\\n' \"$line\" | grep -Eq '^[[:space:]]*[*][[:space:]]+[*][[:space:]]+[*][[:space:]]+[*][[:space:]]+[*][[:space:]]'; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.47622, "o", "      if [ \"$2\" = 1 ]; then u=$(printf '%s\\n' \"$line\" | awk '{print $6}'); else u=$(basename -- \"$real\"); fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
