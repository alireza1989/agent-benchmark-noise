[248.820376, "o", "-rw-r--r-- 1 root root 4567 Oct 26 00:57 /app/persistence_report.json\r\n-rwxr-xr-x 1 root root 4419 Oct 26 00:57 \u001b[0m\u001b[01;32m/app/scan_persistence.sh\u001b[0m\r\n"]
[248.820469, "o", "\u001b[?2004hroot@2e4c025d507c:/app# "]
[273.519913, "i", "cat > /app/scan_persistence.sh <<'EOF_SCRIPT'\n#!/bin/bash\n# Read-only scanner for Linux persistence artifacts. Writes /app/persistence_report.json.\nexport LC_ALL=C\nshopt -s nullglob\nOUT=/app/persistence_report.json\nTMP=$(mktemp) || exit 0\ntrap 'rm -f \"$TMP\"' EXIT\nTAB=$(printf '\\t')\nSUSP_RE='/tmp(/|$| )|/var/tmp|/dev/shm|base64|eval |wget |curl |/dev/tcp|bash -c|sh -c|python3? -c|perl -e|(^|[^a-zA-Z_])n(c|cat)( |$)|socat|mkfifo|attacker'\n\nis_susp() { printf '%s\\n' \"$1\" | grep -Eq \"$SUSP_RE\"; }\n\ncron_badpath() {\n  local tok\n  while IFS= read -r tok; do\n    case \"$tok\" in\n      /usr/bin/*|/bin/*|/sbin/*|/usr/sbin/*|/usr/lib/*|/etc/cron.*|/dev/null|/run/systemd/system|/) ;;\n      *) return 0 ;;\n    esac\n  done < <(printf '%s\\n' \"$1\" | tr \" $TAB=&|;()\" '\\n' | grep '^/')\n  return 1\n}\n\nrec() {\n  local sha pv\n  sha=$(sha256sum -- \"$2\" 2>/dev/null | awk '{print $1}')\n  [ -n \"$sha\" ] || return 0\n  pv=$(printf '%.100s' \"$4\" | tr \"$TAB\" ' ')\n  printf '%s\\t%s\\t%s\\t%s\\t%s\\t%s\\n' \"$1\" \"$2\" \"$sha\" \"$3\" \"$pv\" \"$5\" >> \"$TMP\"\n}"]
[273.520553, "o", "cat > /app/scan_persistence.sh <<'EOF_SCRIPT'\r\n\u001b[?2004l\r"]
[273.521777, "i", "\n\nscan_cron() {\n  local real n=0 line t u\n  real=$(readlink -f -- \"$1\") || return 0\n  [ -f \"$real\" ] && [ -r \"$real\" ] || return 0\n  while IFS= read -r line || [ -n \"$line\" ]; do\n    n=$((n+1))\n    t=\"${line//[[:space:]]/}\"\n    case \"$t\" in ''|'#'*) continue ;; esac\n    if is_susp \"$line\" || cron_badpath \"$line\" || printf '%s\\n' \"$line\" | grep -Eq '^[[:space:]]*[*][[:space:]]+[*][[:space:]]+[*][[:space:]]+[*][[:space:]]+[*][[:space:]]'; then\n      if [ \"$2\" = 1 ]; then u=$(printf '%s\\n' \"$line\" | awk '{print $6}'); else u=$(basename -- \"$real\"); fi\n      rec cron_job \"$real\" \"$n\" \"$line\" \"$u\"\n    fi\n  done < \"$real\"\n  return 0\n}\n\nscan_unit() {\n  local real ex exe reason=\"\"\n  real=$(readlink -f -- \"$1\") || return 0\n  [ -f \"$real\" ] && [ -r \"$real\" ] || return 0\n  case \"$(basename -- \"$1\")\" in .*) reason=hidden ;; esac\n  ex=$(grep -m1 '^[[:space:]]*ExecStart' -- \"$real\")\n  if [ -n \"$ex\" ]; then\n    is_susp \"$ex\" && reason=${reason:-suspicious_exec}\n    exe=$(printf '%s\\n' \"$ex\" | sed -E 's/^[^=]*=//; s/^[[:spac"]
[273.521949, "o", "\u001b[?2004h> #!/bin/bash\r\n\u001b[?2004l\r\u001b[?2004h> # Read-only scanner for Linux persistence artifacts. Writes /app/persistence_report.json.\r\n\u001b[?2004l\r\u001b[?2004h> export LC_ALL=C\r\n\u001b[?2004l\r\u001b[?2004h> shopt -s nullglob\r\n\u001b[?2004l\r\u001b[?2004h> OUT=/app/persistence_report.json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.522211, "i", "e:]]*[-@+!:]*//' | awk '{print $1}')\n    case \"$exe\" in\n      /usr/bin/*|/bin/*|/sbin/*|/usr/sbin/*|/usr/lib/*|/lib/*|/usr/libexec/*|/etc/update-motd.d/*|/etc/rc.local) ;;\n      /*) reason=${reason:-suspicious_exec} ;;\n    esac\n  fi\n  if [ -n \"$reason\" ]; then rec systemd_unit \"$real\" \"\" \"$ex\" \"\"; fi\n  return 0\n}\n\nscan_rc() {\n  local real n=0 line t\n  real=$(readlink -f -- \"$1\") || return 0\n  [ -f \"$real\" ] && [ -r \"$real\" ] || return 0\n  while IFS= read -r line || [ -n \"$line\" ]; do\n    n=$((n+1))\n    t=\"${line//[[:space:]]/}\"\n    case \"$t\" in ''|'#'*|exit0) continue ;; esac\n    rec rc_local \"$real\" \"$n\" \"$line\" \"\"\n  done < \"$real\"\n  return 0\n}\n\nscan_keys() {\n  local real n=0 line t u\n  real=$(readlink -f -- \"$1\") || return 0\n  [ -f \"$real\" ] && [ -r \"$real\" ] || return 0\n  u=$(basename -- \"$(dirname -- \"$(dirname -- \"$real\")\")\")\n  while IFS= read -r line || [ -n \"$line\" ]; do\n    n=$((n+1))\n    t=\"${line//[[:space:]]/}\"\n    case \"$t\" in ''|'#'*) continue ;; esac\n    rec ssh_key \"$real\" \"$n\" \"$line\" \"$u\"\n  d"]
[273.522249, "o", "TMP=$(mktemp) || exit 0\r\n\u001b[?2004l\r\u001b[?2004h> trap 'rm -f \"$TMP\"' EXIT\r\n\u001b[?2004l\r\u001b[?2004h> TAB=$(printf '\\t')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.522455, "i", "one < \"$real\"\n  return 0\n}\n\nscan_location() {\n  local p=\"$1\" d f\n  [ -f \"$p/etc/crontab\" ] && scan_cron \"$p/etc/crontab\" 1\n  for f in \"$p\"/etc/cron.d/*; do scan_cron \"$f\" 1; done\n  for f in \"$p\"/var/spool/cron/crontabs/*; do scan_cron \"$f\" 0; done\n  for d in \"$p/etc/systemd/system\" \"$p/usr/lib/systemd/system\" \"$p/run/systemd/system\"; do\n    for f in \"$d\"/*.service \"$d\"/.*.service; do scan_unit \"$f\"; done\n  done\n  for f in \"$p/etc/rc.local\" \"$p/etc/rc.d/rc.local\"; do scan_rc \"$f\"; done\n  for f in \"$p\"/home/*/.ssh/authorized_keys \"$p/root/.ssh/authorized_keys\"; do scan_keys \"$f\"; done\n  return 0\n}\n\n[ -d /app_target ] && scan_location /app_target\nscan_location \"\"\n\nsort -u \"$TMP\" | sort -t \"$TAB\" -k1,1 -k2,2 -k4,4n -s | jq -R -s 'split(\"\\n\") | map(select(length > 0) | split(\"\\t\")) | map({type: .[0], path: .[1], sha256: .[2], details: {line_number: (if .[3] == \"\" then null else (.[3] | tonumber) end), content_preview: .[4], user: (if .[5] == \"\" then null else .[5] end)}}) as $a | {summary: {total_artifacts: ($a | "]
[273.522618, "o", "SUSP_RE='/tmp(/|$| )|/var/tmp|/dev/shm|base64|eval |wget |curl |/dev/tcp|bash -c|sh -c|python3? -c|perl -e|(^|[^a-zA-Z_])n(c|cat)( |$)|socat|mkfifo|attacker'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> is_susp() { printf '%s\\n' \"$1\" | grep -Eq \"$SUSP_RE\"; }\r\n\u001b[?2004l\r"]
[273.522657, "i", "length), cron_jobs: ([$a[] | select(.type == \"cron_job\")] | length), systemd_units: ([$a[] | select(.type == \"systemd_unit\")] | length), rc_local_modifications: ([$a[] | select(.type == \"rc_local\")] | length), ssh_keys: ([$a[] | select(.type == \"ssh_key\")] | length)}, artifacts: $a}' > \"$OUT.tmp\" && mv -f \"$OUT.tmp\" \"$OUT\" || echo 'failed to write report' >&2\nexit 0\nEOF_SCRIPT\nchmod +x /app/scan_persistence.sh && bash -n /app/scan_persistence.sh && head -2 /app/scan_persistence.sh && grep -c '^[a-z_]*() {' /app/scan_persistence.sh && /app/scan_persistence.sh; echo \"exit=$?\"; jq -c .summary /app/persistence_report.json; jq -r '.artifacts[] | [.type, .path, .details.line_number, .details.user] | @tsv' /app/persistence_report.json\n"]
[273.522672, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[273.522723, "o", "\u001b[?2004h> "]
[273.522787, "o", "cron_badpath() {\r\n\u001b[?2004l\r() {' /ap\u001b[?2004h> "]
[273.523194, "o", "  local tok\r\n\u001b[?2004l\r\u001b[?2004h>   while IFS= read -r tok; do\r\n\u001b[?2004l\r"]
[273.523218, "o", "\u001b[?2004h> "]
[273.523365, "o", "    case \"$tok\" in\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.523618, "o", "      /usr/bin/*|/bin/*|/sbin/*|/usr/sbin/*|/usr/lib/*|/etc/cron.*|/dev/null|/run/systemd/system|/) ;;\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.523679, "o", "> "]
[273.523895, "o", "      *) return 0 ;;\r\n\u001b[?2004l\rser\u001b[?2004h>     esac\r\n\u001b[?2004l\r"]
[273.523946, "o", "\u001b[?2004h> "]
[273.524092, "o", "  done < <(printf '%s\\n' \"$1\" | tr \" $TAB=&|;()\" '\\n' | grep '^/')\r\n\u001b[?2004l\r"]
[273.524113, "o", "\u001b[?2004h"]
[273.524232, "o", ">   return 1\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[273.524262, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[273.524333, "o", "\u001b[?2004h> rec() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.524459, "o", "  local sha pv\r\n\u001b[?2004l\r\u001b[?2004h>   sha=$(sha256sum -- \"$2\" 2>/dev/null | awk '{print $1}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.524493, "o", "  [ -n \"$sha\" ] || return 0\r\n\u001b[?2004l\r"]
[273.52451, "o", "\u001b[?2004h> "]
[273.524609, "o", "  pv=$(printf '%.100s' \"$4\" | tr \"$TAB\" ' ')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.524718, "o", "  printf '%s\\t%s\\t%s\\t%s\\t%s\\t%s\\n' \"$1\" \"$2\" \"$sha\" \"$3\" \"$pv\" \"$5\" >> \"$TMP\"\r\n\u001b[?2004l\r"]
[273.524748, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[273.524763, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[273.524785, "o", "> "]
[273.524856, "o", "scan_cron() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.524919, "o", "  local real n=0 line t u\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.525016, "o", "  real=$(readlink -f -- \"$1\") || return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.525045, "o", "  [ -f \"$real\" ] && [ -r \"$real\" ] || return 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.525096, "o", "> "]
[273.525136, "o", "  while IFS= read -r line || [ -n \"$line\" ]; do\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.525199, "o", ">     n=$((n+1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.52527, "o", "    t=\"${line//[[:space:]]/}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.525322, "o", "> "]
[273.525426, "o", "    case \"$t\" in ''|'#'*) continue ;; esac\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.525614, "o", "    if is_susp \"$line\" || cron_badpath \"$line\" || printf '%s\\n' \"$line\" | grep -Eq '^[[:space:]]*[*][[:space:]]+[*][[:space:]]+[*][[:space:]]+[*][[:space:]]+[*][[:space:]]'; then\r\n\u001b[?2004l\r"]
[273.525684, "o", "\u001b[?2004h> "]
[273.525803, "o", "      if [ \"$2\" = 1 ]; then u=$(printf '%s\\n' \"$line\" | awk '{print $6}'); else u=$(basename -- \"$real\"); fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.525932, "o", "      rec cron_job \"$real\" \"$n\" \"$line\" \"$u\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.526011, "o", "    fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.526086, "o", "  done < \"$real\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.526173, "o", "  return 0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.52625, "o", "scan_unit() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.526351, "o", "  local real ex exe reason=\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.526465, "o", "  real=$(readlink -f -- \"$1\") || return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.526575, "o", "  [ -f \"$real\" ] && [ -r \"$real\" ] || return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.526657, "o", "  case \"$(basename -- \"$1\")\" in .*) reason=hidden ;; esac\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.526776, "o", "  ex=$(grep -m1 '^[[:space:]]*ExecStart' -- \"$real\")\r\n\u001b[?2004l\r"]
[273.526853, "o", "\u001b[?2004h> "]
[273.52693, "o", "  if [ -n \"$ex\" ]; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.527068, "o", "    is_susp \"$ex\" && reason=${reason:-suspicious_exec}\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.527147, "o", "> "]
[273.527227, "o", "    exe=$(printf '%s\\n' \"$ex\" | sed -E 's/^[^=]*=//; s/^[[:space:]]*[-@+!:]*//' | awk '{print $1}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.527341, "o", "    case \"$exe\" in\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.527578, "o", "      /usr/bin/*|/bin/*|/sbin/*|/usr/sbin/*|/usr/lib/*|/lib/*|/usr/libexec/*|/etc/update-motd.d/*|/etc/rc.local) ;;\r\n"]
[273.527681, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[273.527709, "o", "      /*) reason=${reason:-suspicious_exec} ;;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.5278, "o", "    esac\r\n\u001b[?2004l\r"]
[273.527897, "o", "\u001b[?2004h>   fi\r\n\u001b[?2004l\r"]
[273.527924, "o", "\u001b[?2004h> "]
[273.528013, "o", "  if [ -n \"$reason\" ]; then rec systemd_unit \"$real\" \"\" \"$ex\" \"\"; fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.528099, "o", "  return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.528153, "o", "}"]
[273.528194, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
