[245.479075, "o", ">   real=$(readlink -f -- \"$1\") || return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.479142, "o", "  [ -f \"$real\" ] && [ -r \"$real\" ] || return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.479199, "o", "  while IFS= read -r line || [ -n \"$line\" ]; do\r\n\u001b[?2004l\r\u001b[?2004h>     n=$((n+1))\r\n\u001b[?2004l\r"]
[245.479218, "o", "\u001b[?2004h"]
