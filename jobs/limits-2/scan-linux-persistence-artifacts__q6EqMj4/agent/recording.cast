[198.807994, "o", "    t=\"${line//[[:space:]]/}\"\r\n\u001b[?2004l\r"]
[198.808028, "o", "\u001b[?2004h> "]
[198.808127, "o", "    case \"$t\" in ''|'#'*|exit0) continue ;; esac\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.80821, "o", "    rec rc_local \"$real\" \"$n\" \"$line\" \"\"\r\n\u001b[?2004l\r\u001b[?2004h>   done < \"$real\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.808295, "o", "  return 0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.808312, "o", "scan_keys() {\r\n"]
[198.808378, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[198.808443, "o", "  local real n=0 line t u\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.808532, "o", "  real=$(readlink -f -- \"$1\") || return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.808625, "o", "  [ -f \"$real\" ] && [ -r \"$real\" ] || return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.808736, "o", "  u=$(basename -- \"$(dirname -- \"$(dirname -- \"$real\")\")\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.808812, "o", "  while IFS= read -r line || [ -n \"$line\" ]; do\r\n\u001b[?2004l\r\u001b[?2004h>     n=$((n+1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.808923, "o", "    t=\"${line//[[:space:]]/}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.80895, "o", "    case \"$t\" in ''|'#'*) continue ;; esac\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.809057, "o", "    rec ssh_key \"$real\" \"$n\" \"$line\" \"$u\"\r\n\u001b[?2004l\r\u001b[?2004h>   done < \"$real\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.809135, "o", "  return 0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[198.80917, "o", "\u001b[?2004h> "]
[198.80924, "o", "scan_location() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.809266, "o", "  local p=\"$1\" d f\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.809367, "o", "  [ -f \"$p/etc/crontab\" ] && scan_cron \"$p/etc/crontab\" 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.809474, "o", "  for f in \"$p\"/etc/cron.d/*; do scan_cron \"$f\" 1; done\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.809569, "o", "  for f in \"$p\"/var/spool/cron/crontabs/*; do scan_cron \"$f\" 0; done\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.809695, "o", "  for d in \"$p/etc/systemd/system\" \"$p/usr/lib/systemd/system\" \"$p/run/systemd/system\"; do\r\n\u001b[?2004l\r\u001b[?2004h"]
[198.809721, "o", "> "]
[198.809817, "o", "    for f in \"$d\"/*.service \"$d\"/.*.service; do scan_unit \"$f\"; done\r\n\u001b[?2004l\r\u001b[?2004h"]
[198.809858, "o", ">   done\r\n\u001b[?2004l\r"]
[198.809953, "o", "\u001b[?2004h> "]
[198.81005, "o", "  for f in \"$p/etc/rc.local\" \"$p/etc/rc.d/rc.local\"; do scan_rc \"$f\"; done\r\n\u001b[?2004l\r"]
[198.810074, "o", "\u001b[?2004h> "]
[198.810225, "o", "  for f in \"$p\"/home/*/.ssh/authorized_keys \"$p/root/.ssh/authorized_keys\"; do scan_keys \"$f\"; done\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.81031, "o", "  return 0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[198.810335, "o", "\u001b[?2004h> "]
[198.810431, "o", "[ -d /app_target ] && scan_location /app_target\r\n\u001b[?2004l\r\u001b[?2004h> scan_location \"\"\r\n"]
[198.810457, "o", "\u001b[?2004l\r"]
[198.810541, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.811315, "o", "sort -u \"$TMP\" | sort -t \"$TAB\" -k1,1 -k2,2 -k4,4n -s | jq -R -s 'split(\"\\n\") | map(select(length > 0) | split(\"\\t\")) | map({type: .[0], path: .[1], sha256: .[2], details: {line_number: (if .[3] == \"\" then null else (.[3] | tonumber) end), content_preview: .[4], user: (if .[5] == \"\" then null else .[5] end)}}) as $a | {summary: {total_artifacts: ($a | length), cron_jobs: ([$a[] | select(.type == \"cron_job\")] | length), systemd_units: ([$a[] | select(.type == \"systemd_unit\")] | length), rc_local_modifications: ([$a[] | select(.type == \"rc_local\")] | length), ssh_keys: ([$a[] | select(.type == \"ssh_key\")] | length)}, artifacts: $a}' > \"$OUT.tmp\" && mv -f \"$OUT.tmp\" \"$OUT\" || echo 'failed to write report' >&2\r\n\u001b[?2004l\r"]
[198.811389, "o", "\u001b[?2004h> exit 0\r\n\u001b[?2004l\r"]
[198.811501, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
