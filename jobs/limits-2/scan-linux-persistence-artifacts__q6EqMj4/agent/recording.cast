[119.040123, "i", "cat > /app/scan_persistence.sh <<'EOF'\n#!/bin/bash\n# Read-only scanner for Linux persistence artifacts. Writes /app/persistence_report.json.\nexport LC_ALL=C\nshopt -s nullglob\nOUT=/app/persistence_report.json\nTMP=$(mktemp) || exit 0\ntrap 'rm -f \"$TMP\"' EXIT\n: > \"$TMP\"\n\nSUSP_RE='/tmp|/var/tmp|/dev/shm|base64|eval|wget|curl|/dev/tcp|bash -c|python3? -c|perl -e|nc -e|ncat|socat|/bin/sh -i|mkfifo'\n\npath_ok() {\n  case \"$1\" in\n    /|/usr/bin/*|/bin/*|/sbin/*|/usr/sbin/*|/usr/lib/*|/lib/*|/etc/cron.*|/run/systemd/system|/dev/null) return 0 ;;\n  esac\n  return 1\n}\n\nis_suspicious() {\n  local text=\"$1\" tok\n  if printf '%s\\n' \"$text\" | grep -Eq \"$SUSP_RE\"; then return 0; fi\n  while IFS= read -r tok; do\n    [ -z \"$tok\" ] && continue\n    path_ok \"$tok\" || return 0\n  done < <(printf '%s\\n' \"$text\" | tr ' \\t=&|;()' '\\n' | grep '^/')\n  return 1\n}\n\nrec() {  # type path line preview user\n  local sha p\n  sha=$(sha256sum -- \"$2\" 2>/dev/null | awk '{print $1}')\n  [ -n \"$sha\" ] || return 0\n  p=$(printf '%.100s' \"$4\" | tr '\\t' ' ')\n "]
[119.040807, "o", "cat > /app/scan_persistence.sh <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #!/bin/bash\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.040859, "i", " printf '%s\\t%s\\t%s\\t%s\\t%s\\t%s\\n' \"$1\" \"$2\" \"$sha\" \"$3\" \"$p\" \"$5\" >> \"$TMP\"\n}\n\nscan_cron() {  # file hasuser(1 = cron.d style with user field)\n  local f=\"$1\" hasuser=\"$2\" real n=0 line t u reason\n  real=$(readlink -f -- \"$f\") || return 0\n  [ -r \"$real\" ] || return 0\n  while IFS= read -r line || [ -n \"$line\" ]; do\n    n=$((n+1))\n    t=\"${line//[[:space:]]/}\"\n    [ -z \"$t\" ] && continue\n    case \"$t\" in '#'*) continue ;; esac\n    reason=\"\"\n    if is_suspicious \"$line\"; then reason=suspicious; fi\n    if [ -z \"$reason\" ] && printf '%s\\n' \"$line\" | grep -Eq '^[[:space:]]*[*][[:space:]]+[*][[:space:]]+[*][[:space:]]+[*][[:space:]]+[*][[:space:]]'; then reason=every_minute; fi\n    if [ -n \"$reason\" ]; then\n      if [ \"$hasuser\" = 1 ]; then u=$(printf '%s\\n' \"$line\" | awk '{print $6}'); else u=$(basename -- \"$real\"); fi\n      rec cron_job \"$real\" \"$n\" \"$line\" \"$u\"\n    fi\n  done < \"$real\"\n}\n\nscan_unit() {\n  local f=\"$1\" real ex reason=\"\"\n  real=$(readlink -f -- \"$f\") || return 0\n  [ -f \"$real\" ] && [ -r \"$real\" ] || "]
[119.042136, "o", "# Read-only scanner for Linux persistence artifacts. Writes /app/persistence_report.json.\r\n\u001b[?2004l\r\u001b[?2004h> export LC_ALL=C\r\n\u001b[?2004l\r\u001b[?2004h> shopt -s nullglob\r\n\u001b[?2004l\r\u001b[?2004h> OUT=/app/persistence_report.json\r\n\u001b[?2004l\r\u001b[?2004h> TMP=$(mktemp) || exit 0\r\n\u001b[?2004l\r\u001b[?2004h> trap 'rm -f \"$TMP\"' EXIT\r\n\u001b[?2004l\r\u001b[?2004h> : > \"$TMP\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> SUSP_RE='/tmp|/var/tmp|/dev/shm|base64|eval|wget|curl|/dev/tcp|bash -c|python3? -c|perl -e|nc -e|ncat|socat|/bin/sh -i|mkfifo'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> path_ok() {\r\n\u001b[?2004l\r\u001b[?2004h>   case \"$1\" in\r\n\u001b[?2004l\r\u001b[?2004h>     /|/usr/bin/*|/bin/*|/sbin/*|/usr/sbin/*|/usr/lib/*|/lib/*|/etc/cron.*|/run/systemd/system|/dev/null) return 0 ;;\r\n\u001b[?2004l\r\u001b[?2004h>   esac\r\n\u001b[?2004l\r\u001b[?2004h>   return 1\r\n\u001b[?2004l\r"]
[119.042161, "i", "return 0\n  case \"$(basename -- \"$f\")\" in .*) reason=hidden ;; esac\n  ex=$(grep -m1 -E '^[[:space:]]*ExecStart' -- \"$real\")\n  [ -n \"$ex\" ] || ex=$(head -n 1 -- \"$real\")\n  if [ -z \"$reason\" ] && is_suspicious \"$ex\"; then reason=suspicious_exec; fi\n  if [ -n \"$reason\" ]; then rec systemd_unit \"$real\" \"\" \"$ex\" \"\"; fi\n  return 0\n}\n\nscan_rc() {\n  local f=\"$1\" real n=0 line t\n  real=$(readlink -f -- \"$f\") || return 0\n  [ -r \"$real\" ] || return 0\n  while IFS= read -r line || [ -n \"$line\" ]; do\n    n=$((n+1))\n    t=\"${line//[[:space:]]/}\"\n    [ -z \"$t\" ] && continue\n    case \"$t\" in '#'*|exit0) continue ;; esac\n    rec rc_local \"$real\" \"$n\" \"$line\" \"\"\n  done < \"$real\"\n}\n\nscan_keys() {\n  local f=\"$1\" real u n=0 line t\n  real=$(readlink -f -- \"$f\") || return 0\n  [ -r \"$real\" ] || return 0\n  u=$(basename -- \"$(dirname -- \"$(dirname -- \"$real\")\")\")\n  while IFS= read -r line || [ -n \"$line\" ]; do\n    n=$((n+1))\n    t=\"${line//[[:space:]]/}\"\n    [ -z \"$t\" ] && continue\n    case \"$t\" in '#'*) continue ;; esac\n    rec ssh_key"]
[119.042398, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> is_suspicious() {\r\n\u001b[?2004l\rreturn 0\r\n  case \"$(basename -- \"$f\")\" in .*) reason=hidden ;; esac\r\n  ex=$(grep -m1 -E '^[[:space:]]*ExecStart' -- \"$real\")\r\n  [ -n \"$ex\" ] || ex=$(head -n 1 -- \"$real\")\r\n  if [ -z \"$reason\" ] && is_suspicious \"$ex\"; then reason=suspicious_exec; fi\r\n  if [ -n \"$reason\" ]; then rec systemd_unit \"$real\" \"\" \"$ex\" \"\"; fi\r\n  return 0\r\n}\r\n\r\nscan_rc() {\r\n  local f=\"$1\" real n=0 line t\r\n  real=$(readlink -f -- \"$f\") || return 0\r\n  [ -r \"$real\" ] || return 0\r\n  while IFS= read -r line || [ -n \"$line\" ]; do\r\n    n=$((n+1))\r\n    t=\"${line//[[:space:]]/}\"\r\n    [ -z \"$t\" ] && continue\r\n    case \"$t\" in '#'*|exit0) continue ;; esac\r\n    rec rc_local \"$real\" \"$n\" \"$line\" \"\"\r\n  done < \"$real\"\r\n}\r\n\r\nscan_keys() {\r\n  local f=\"$1\" real u n=0 line t\r\n  real=$(readlink -f -- \"$f\") || return 0\r\n  [ -r \"$real\" ] || return 0\r\n  u=$(basename -- \"$(dirname -- \"$(dirname -- \"$real\")\")\")\r\n  while IFS= read -r line || [ -n \"$line\" ]; do\r\n    n=$((n+1))\r\n   "]
[119.04244, "i", " \"$real\" \"$n\" \"$line\" \"$u\"\n  done < \"$real\"\n}\n\nscan_location() {\n  local p=\"$1\" d f\n  [ -f \"$p/etc/crontab\" ] && scan_cron \"$p/etc/crontab\" 1\n  for f in \"$p\"/etc/cron.d/*; do [ -f \"$f\" ] && scan_cron \"$f\" 1; done\n  for f in \"$p\"/var/spool/cron/crontabs/*; do [ -f \"$f\" ] && scan_cron \"$f\" 0; done\n  for d in \"$p/etc/systemd/system\" \"$p/usr/lib/systemd/system\" \"$p/run/systemd/system\"; do\n    for f in \"$d\"/*.service \"$d\"/.*.service; do scan_unit \"$f\"; done\n  done\n  for f in \"$p/etc/rc.local\" \"$p/etc/rc.d/rc.local\"; do [ -f \"$f\" ] && scan_rc \"$f\"; done\n  for f in \"$p\"/home/*/.ssh/authorized_keys \"$p/root/.ssh/authorized_keys\"; do [ -f \"$f\" ] && scan_keys \"$f\"; done\n  return 0\n}\n\n[ -d /app_target ] && scan_location /app_target\nscan_location \"\"\n\nsort -t \"$(printf '\\t')\" -k1,1 -k2,2 -u \"$TMP\" | jq -R -s 'split(\"\\n\") | map(select(length > 0) | split(\"\\t\")) | map({type: .[0], path: .[1], sha256: .[2], details: {line_number: (if .[3] == \"\" then null else (.[3] | tonumber) end), content_preview: .[4], user: (if .[5] == \""]
[119.042453, "o", " t=\"${line//[[:space:]]/}\"\r\n    [ -z \"$t\" ] && continue\r\n    case \"$t\" in '#'*) continue ;; esac\r\n    rec ssh_key"]
[119.042475, "i", "\" then null else .[5] end)}}) as $a | {summary: {total_artifacts: ($a | length), cron_jobs: ([$a[] | select(.type == \"cron_job\")] | length), systemd_units: ([$a[] | select(.type == \"systemd_unit\")] | length), rc_local_modifications: ([$a[] | select(.type == \"rc_local\")] | length), ssh_keys: ([$a[] | select(.type == \"ssh_key\")] | length)}, artifacts: $a}' > \"$OUT.tmp\" && mv -f \"$OUT.tmp\" \"$OUT\" || echo 'failed to write report' >&2\nexit 0\nEOF\n"]
