[245.482454, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.48367, "o", "sort -u \"$TMP\" | sort -t \"$TAB\" -k1,1 -k2,2 -k4,4n -s | jq -R -s 'split(\"\\n\") | map(select(length > 0) | split(\"\\t\")) | map({type: .[0], path: .[1], sha256: .[2], details: {line_number: (if .[3] == \"\" then null else (.[3] | tonumber) end), content_preview: .[4], user: (if .[5] == \"\" then null else .[5] end)}}) as $a | {summary: {total_artifacts: ($a | length), cron_jobs: ([$a[] | select(.type == \"cron_job\")] | length), systemd_units: ([$a[] | select(.type == \"systemd_unit\")] | length), rc_local_modifications: ([$a[] | select(.type == \"rc_local\")] | length), ssh_keys: ([$a[] | select(.type == \"ssh_key\")] | length)}, artifacts: $a}' > \"$OUT.tmp\" && mv -f \"$OUT.tmp\" \"$OUT\" || echo 'failed to write report' >&2\r\n\u001b[?2004l\r"]
[245.483776, "o", "\u001b[?2004h> exit 0\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
