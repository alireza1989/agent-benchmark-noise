[273.5314, "o", "    for f in \"$d\"/*.service \"$d\"/.*.service; do scan_unit \"$f\"; done\r\n\u001b[?2004l\r\u001b[?2004h>   done\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.531504, "o", "  for f in \"$p/etc/rc.local\" \"$p/etc/rc.d/rc.local\"; do scan_rc \"$f\"; done\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.531597, "o", "> "]
