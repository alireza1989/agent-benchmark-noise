[273.531802, "o", "\u001b[?2004h>   return 0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> [ -d /app_target ] && scan_location /app_target"]
