[245.484914, "o", "root@2e4c025d507c:/app# "]
[245.485286, "o", "chmod +x /app/scan_persistence.sh && bash -n /app/scan_persistence.sh && /app/scan_persistence.sh; echo \"exit=$?\"; jq -c .summary /app/persistence_report.json; jq -r '.artifacts[] | [.type, .path, .details.line_number, .details.user] | @tsv' /app/persistence_report.json\r\n\u001b[?2004l\r"]
[245.882004, "o", "exit=0\r\n"]
[245.900997, "o", "\u001b[1;39m{\u001b[0m\u001b[34;1m\"total_artifacts\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m13\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"cron_jobs\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m4\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"systemd_units\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m3\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"rc_local_modifications\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m1\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"ssh_keys\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m5\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[245.920508, "o", "cron_job\t/app_target/etc/cron.d/app_cron\t1\troot\r\ncron_job\t/etc/cron.d/backdoor_cron\t1\troot\r\ncron_job\t/etc/cron.d/backdoor_cron\t2\tuser\r\ncron_job\t/var/spool/cron/crontabs/root\t2\troot\r\nrc_local\t/app_target/etc/rc.local\t3\t\r\nssh_key\t/app_target/home/victim/.ssh/authorized_keys\t1\tvictim\r\nssh_key\t/home/testuser/.ssh/authorized_keys\t1\ttestuser\r\nssh_key\t/home/testuser/.ssh/authorized_keys\t2\ttestuser\r\nssh_key\t/root/.ssh/authorized_keys\t1\troot\r\nssh_key\t/root/.ssh/authorized_keys\t3\troot\r\nsystemd_unit\t/app_target/etc/systemd/system/app_backdoor.service\t\t\r\nsystemd_unit\t/etc/systemd/system/persistence.service\t\t\r\nsystemd_unit\t/usr/lib/systemd/system/.hidden_service.service\t\t\r\n"]
[245.920744, "o", "\u001b[?2004hroot@2e4c025d507c:/app# "]
[248.440845, "i", "cp /app/persistence_report.json /tmp/r1.json; /app/scan_persistence.sh; cmp /tmp/r1.json /app/persistence_report.json && echo IDEMPOTENT; rm -f /tmp/r1.json; ls -l /app/scan_persistence.sh /app/persistence_report.json\n"]
[248.44134, "o", "cp /app/persistence_report.json /tmp/r1.json; /app/scan_persistence.sh; cmp /tmp/r1.json /app/persistence_report.json && echo IDEMPOTENT; rm -f /tmp/r1.json; ls -l /app/scan_persistence.sh /app/persistence_report.json\r\n\u001b[?2004l\r"]
