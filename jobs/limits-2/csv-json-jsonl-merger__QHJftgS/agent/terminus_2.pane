[?2004hroot@6951b9910dc1:/workspace# cat > /workspace/do_merge.py << 'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def norm_email(e):
[?2004l[?2004h>     if isinstance(e, str):
[?2004l[?2004h>         e = e.strip().lower()
[?2004l[?2004h>         return e if e else None
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> rows = []
[?2004l[?2004h> 
[?2004l[?2004h> # users.csv
[?2004l[?2004h> users = pd.read_csv('/workspace/users.csv', dtype=str)
[?2004l[?2004h> for _, r in users.iterrows():
[?2004l[?2004h>     rows.append({'email': r.get('email'), 'phone': r.get('phone'), 'status': r.get('status')})
[?2004l[?2004h> 
[?2004l[?2004h> # records.jsonl
[?2004l[?2004h> with open('/workspace/records.jsonl') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line = line.strip()
[?2004l[?2004h>         if not line:
[?2004l[?2004h>             continue
[?2004l[?2004h>         x = json.loads(line)
[?2004l[?2004h>         rows.append({'email': x.get('email'), 'phone': x.get('phone'), 'status': x.get('status')})
[?2004l[?2004h> 
[?2004l[?2004h> # profiles.json (dict keyed by email, phone nested in other_info)
[?2004l[?2004h> with open('/workspace/profiles.json') as f:
[?2004l[?2004h>     profiles = json.load(f)
[?2004l[?2004h> for key, v in profiles.items():
[?2004l[?2004h>     oi = v.get('other_info') or {}
[?2004l[?2004h>     rows.append({'email': v.get('email', key), 'phone': oi.get('phone'), 'status': v.get('status')})
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.DataFrame(rows, columns=['email', 'phone', 'status'])
[?2004l[?2004h> df['email'] = df['email'].map(norm_email)
[?2004l[?2004h> df = df[df['email'].notna()]
[?2004l[?2004h> 
[?2004l[?2004h> # Union: one row per unique email, taking first non-null value per column
[?2004l[?2004h> merged = df.groupby('email', as_index=False, sort=True).first()
[?2004l[?2004h> merged = merged[['email', 'phone', 'status']]
[?2004l[?2004h> merged.to_csv('/workspace/merged_records.csv', index=False)
[?2004l[?2004h> print('Wrote', len(merged), 'unique records')
[?2004l[?2004h> EOF
