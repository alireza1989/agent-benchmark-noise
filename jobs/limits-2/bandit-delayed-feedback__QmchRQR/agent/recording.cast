[125.189744, "i", "cd /app && python3 -c \"import pandas as pd, numpy as np; from scipy.stats import norm; from scipy.optimize import minimize; c=pd.read_csv('data/conversions.csv'); d=c.delay_hours.values; print('n',len(d),'eq72',(d>=72.0).sum(),'ge71.9',(d>=71.9).sum()); L=np.log(d); print('plain mu,sig',L.mean(),L.std()); cen=d>=72.0; ld=L[~cen]; lc=np.log(72.0)\ndef nll(p):\n    mu,ls=p; s=np.exp(ls)\n    obs=norm.logpdf(ld,mu,s).sum(); ce=norm.logsf(lc,mu,s)*cen.sum()\n    return -(obs+ce)\nr=minimize(nll,[L.mean(),np.log(L.std())],method='Nelder-Mead'); print('censored mu,sig',r.x[0],np.exp(r.x[1]))\"\n"]
[125.191116, "o", "cd /app && python3 -c \"import pandas as pd, numpy as np; from scipy.stats import norm; from scipy.optimize import minimize; c=pd.read_csv('data/conversions.csv'); d=c.delay_hours.values; print('n',len(d),'eq72',(d>=72.0).sum(),'ge71.9',(d>=71.9).sum()); L=np.log(d); print('plain mu,sig',L.mean(),L.std()); cen=d>=72.0; ld=L[~cen]; lc=np.log(72.0)\r\n\u001b[?2004l\r\u001b[?2004h> def nll(p):\r\n\u001b[?2004l\r\u001b[?2004h>     mu,ls=p; s=np.exp(ls)\r\n\u001b[?2004l\r\u001b[?2004h>     obs=norm.logpdf(ld,mu,s).sum(); ce=norm.logsf(lc,mu,s)*cen.sum()\r\n\u001b[?2004l\r\u001b[?2004h>     return -(obs+ce)\r\n\u001b[?2004l\r\u001b[?2004h> r=minimize(nll,[L.mean(),np.log(L.std())],method='Nelder-Mead'); print('censored mu,sig',r.x[0],np.exp(r.x[1]))\"\r\n\u001b[?2004l\r"]
