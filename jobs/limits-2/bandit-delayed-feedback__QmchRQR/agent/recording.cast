[98.114419, "i", "cd /app && python3 -c \"import pandas as pd, numpy as np; imp=pd.read_csv('data/impressions.csv'); conv=pd.read_csv('data/conversions.csv'); T=max(imp.timestamp.max(), conv.conversion_timestamp.max()); print('T',T,'max imp',imp.timestamp.max(),'max conv',conv.conversion_timestamp.max()); m=imp.merge(conv,on='impression_id',how='left'); m['y']=m.conversion_timestamp.notna(); m['age_h']=(T-m.timestamp)/3600; m['b']=pd.cut(m.age_h,[-1,6,12,24,48,72,96,1e9]); print(m.groupby('b',observed=True).agg(n=('y','size'),cvr=('y','mean'))); print('delay>=71.9 frac', (conv.delay_hours>=71.9).mean()); print('check conv ts - imp ts vs delay', ((conv.conversion_timestamp - m.set_index('impression_id').loc[conv.impression_id,'timestamp'].values)/3600 - conv.delay_hours).abs().max())\"\n"]
[98.115972, "o", "cd /app && python3 -c \"import pandas as pd, numpy as np; imp=pd.read_csv('data/impressions.csv'); conv=pd.read_csv('data/conversions.csv'); T=max(imp.timestamp.max(), conv.conversion_timestamp.max()); print('T',T,'max imp',imp.timestamp.max(),'max conv',conv.conversion_timestamp.max()); m=imp.merge(conv,on='impression_id',how='left'); m['y']=m.conversion_timestamp.notna(); m['age_h']=(T-m.timestamp)/3600; m['b']=pd.cut(m.age_h,[-1,6,12,24,48,72,96,1e9]); print(m.groupby('b',observed=True).agg(n=('y','size'),cvr=('y','mean'))); print('delay>=71.9 frac', (conv.delay_hours>=71.9).mean()); print('check conv ts - imp ts vs delay', ((conv.conversion_timestamp - m.set_index('impression_id').loc[conv.impression_id,'timestamp'].values)/3600 - conv.delay_hours).abs().max())\"\r\n\u001b[?2004l\r"]
