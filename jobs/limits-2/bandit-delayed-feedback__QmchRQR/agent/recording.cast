[67.689482, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.689499, "o", "> "]
[67.68957, "o", "nb=np.array([n[a] for a in range(10)])[best]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.689627, "o", "cvb=np.array([cvv[a] for a in range(10)])[best]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.689646, "o", "relse=np.sqrt((1-pb+cvb**2)/(nb*pb))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.689713, "o", "half=1.2815516*E*relse\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.689812, "o", "lower=np.clip(E-half,0,None)\r\n\u001b[?2004l\r\u001b[?2004h> upper=E+half\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.689974, "o", "out=pd.DataFrame({'context_id':ctx.context_id,'selected_arm':best.astype(int),'expected_reward':np.round(E,6),'confidence_lower':np.round(lower,6),'confidence_upper':np.round(upper,6)})\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.690012, "o", "> "]
[67.69006, "o", "out.to_csv(O+'predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.690086, "o", "# arm statistics\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.69037, "o", "ast=pd.DataFrame({'arm_id':list(range(10)),'estimated_conversion_rate':[round(cvr[a],6) for a in range(10)],'estimated_avg_value':[round(val[a],6) for a in range(10)],'total_impressions':[n[a] for a in range(10)],'total_conversions':[k[a] for a in range(10)]})\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.690449, "o", "> "]
[67.690475, "o", "ast.to_csv(O+'arm_statistics.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.69054, "o", "# delay model\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.690759, "o", "dm={'distribution_type':'lognormal','parameters':{'mu':mu,'sigma':sig},'median_delay_hours':float(np.exp(mu)),'p90_delay_hours':float(np.exp(mu+1.2815516*sig)),'conversion_rate_estimate':float(imp.ipw.mean())}\r\n\u001b[?2004l\r"]
[67.690807, "o", "\u001b[?2004h> "]
[67.690881, "o", "json.dump(dm, open(O+'delay_model.json','w'), indent=2)\r\n\u001b[?2004l\r"]
[67.690909, "o", "\u001b[?2004h> "]
[67.690954, "o", "print('best arm counts', np.bincount(best, minlength=10).tolist())\r\n\u001b[?2004l\r"]
[67.691013, "o", "\u001b[?2004h> "]
[67.69104, "o", "print('mean expected reward on test', E.mean())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.691106, "o", "print(ast.to_string())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.691121, "o", "print(json.dumps(dm, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.69119, "o", "> EOF\r\n\u001b[?2004l\r"]
[67.692948, "o", "\u001b[?2004hroot@6d0f8e3ca579:/app# "]
