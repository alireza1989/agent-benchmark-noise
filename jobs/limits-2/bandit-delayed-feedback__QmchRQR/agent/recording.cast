[111.484336, "i", "cd /app && python3 -c \"import pandas as pd, json; p=pd.read_csv('output/predictions.csv'); c=pd.read_csv('data/test_contexts.csv'); a=pd.read_csv('output/arm_statistics.csv'); d=json.load(open('output/delay_model.json')); print('pred rows',len(p),'ids match',set(p.context_id)==set(c.context_id)); print('arm range ok',p.selected_arm.between(0,9).all(),'nan',p.isna().sum().sum()); print('ci ok',((p.confidence_lower<=p.expected_reward)&(p.expected_reward<=p.confidence_upper)).all(),'nonneg',(p.confidence_lower>=0).all()); print('arm rows',len(a), sorted(a.arm_id.tolist())==list(range(10))); print(sorted(d.keys()), d['distribution_type'])\"\n"]
[111.485976, "o", "cd /app && python3 -c \"import pandas as pd, json; p=pd.read_csv('output/predictions.csv'); c=pd.read_csv('data/test_contexts.csv'); a=pd.read_csv('output/arm_statistics.csv'); d=json.load(open('output/delay_model.json')); print('pred rows',len(p),'ids match',set(p.context_id)==set(c.context_id)); print('arm range ok',p.selected_arm.between(0,9).all(),'nan',p.isna().sum().sum()); print('ci ok',((p.confidence_lower<=p.expected_reward)&(p.expected_reward<=p.confidence_upper)).all(),'nonneg',(p.confidence_lower>=0).all()); print('arm rows',len(a), sorted(a.arm_id.tolist())==list(range(10))); print(sorted(d.keys()), d['distribution_type'])\"\r\n\u001b[?2004l\r"]
