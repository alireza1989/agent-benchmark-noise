[?2004hroot@6d0f8e3ca579:/app# cat > /app/solve.py << 'EOF'
[?2004l[?2004h> import pandas as pd, numpy as np, json, os
[?2004l[?2004h> from scipy.stats import norm
[?2004l[?2004h> D='/app/data/'; O='/app/output/'
[?2004l[?2004h> os.makedirs(O, exist_ok=True)
[?2004l[?2004h> imp=pd.read_csv(D+'impressions.csv')
[?2004l[?2004h> conv=pd.read_csv(D+'conversions.csv')
[?2004l[?2004h> ctx=pd.read_csv(D+'test_contexts.csv')
[?2004l[?2004h> meta=json.load(open(D+'arms_metadata.json'))
[?2004l[?2004h> # Task 1: lognormal delay MLE on observed delays
[?2004l[?2004h> ld=np.log(conv.delay_hours.values)
[?2004l[?2004h> mu=float(ld.mean()); sig=float(ld.std(ddof=0))
[?2004l[?2004h> T=float(max(imp.timestamp.max(), conv.conversion_timestamp.max()))
[?2004l[?2004h> F72=norm.cdf((np.log(72.0)-mu)/sig)
[?2004l[?2004h> def comp(age):
[?2004l[?2004h>     a=np.clip(age,1e-3,72.0)
[?2004l[?2004h>     return np.clip(norm.cdf((np.log(a)-mu)/sig)/F72, 0.05, 1.0)
[?2004l[?2004h> imp=imp.merge(conv[['impression_id','conversion_value']], on='impression_id', how='left')
[?2004l[?2004h> imp['y']=imp.conversion_value.notna().astype(float)
[?2004l[?2004h> imp['v']=imp.conversion_value.fillna(0.0)
[?2004l[?2004h> imp['age']=(T-imp.timestamp)/3600.0
[?2004l[?2004h> imp['c']=comp(imp.age.values)
[?2004l[?2004h> imp['ipw']=imp.y/imp.c
[?2004l[?2004h> # Task 2: contextual features
[?2004l[?2004h> e1=np.quantile(imp.context_feature_1,[1/3,2/3]); e2=np.quantile(imp.context_feature_2,[1/3,2/3])
[?2004l[?2004h> def feats(df):
[?2004l[?2004h>     out=pd.DataFrame(index=df.index)
[?2004l[?2004h>     out['seg']=df.user_segment
[?2004l[?2004h>     out['dev']=df.device_type
[?2004l[?2004h>     out['hb']=(df.hour_of_day//6).astype(int)
[?2004l[?2004h>     out['wk']=(df.day_of_week>=5).astype(int)
[?2004l[?2004h>     out['f1']=np.digitize(df.context_feature_1,e1)
[?2004l[?2004h>     out['f2']=np.digitize(df.context_feature_2,e2)
[?2004l[?2004h>     return out
[?2004l[?2004h> Fi=feats(imp); Fc=feats(ctx)
[?2004l[?2004h> cvr={}; val={}; n={}; k={}; cvv={}; ratio={}; vals_all={}
[?2004l[?2004h> for a in range(10):
[?2004l[?2004h>     s=imp[imp.arm_id==a]
[?2004l[?2004h>     cvr[a]=float(s.ipw.mean())
[?2004l[?2004h>     vals=s.loc[s.y==1,'conversion_value'].values
[?2004l[?2004h>     vals_all[a]=vals
[?2004l[?2004h>     val[a]=float(vals.mean()); cvv[a]=float(vals.std()/vals.mean())
[?2004l[?2004h>     n[a]=len(s); k[a]=int(s.y.sum())
[?2004l[?2004h>     ratio[a]={}
[?2004l[?2004h>     overall=s.ipw.mean()
[?2004l[?2004h>     for f in Fi.columns:
[?2004l[?2004h>         g=s.ipw.groupby(Fi.loc[s.index,f]).mean()/overall
[?2004l[?2004h>         ratio[a][f]=g.to_dict()
[?2004l[?2004h> def pred(a,F):
[?2004l[?2004h>     p=np.full(len(F), cvr[a], dtype=float)
[?2004l[?2004h>     for f in Fi.columns:
[?2004l[?2004h>         p=p*F[f].map(ratio[a][f]).fillna(1.0).values
[?2004l[?2004h>     return np.clip(p,1e-4,1.0)
[?2004l[?2004h> # calibration check on historical impressions
[?2004l[?2004h> pr=np.zeros(len(imp))
[?2004l[?2004h> for a in range(10):
[?2004l[?2004h>     m=(imp.arm_id==a).values
[?2004l[?2004h>     pr[m]=pred(a,Fi)[m]*val[a]
[?2004l[?2004h> print('hist mean predicted reward', pr.mean(), ' IPW actual reward', (imp.ipw*imp.v).mean(), ' raw actual', imp.v.mean())
[?2004l[?2004h> Pc=np.column_stack([pred(a,Fc) for a in range(10)])
[?2004l[?2004h> P=Pc*np.array([val[a] for a in range(10)])[None,:]
[?2004l[?2004h> best=P.argmax(1)
[?2004l[?2004h> E=P.max(1)
[?2004l[?2004h> idx=np.arange(len(ctx))
[?2004l[?2004h> pb=Pc[idx,best]
[?2004l[?2004h> nb=np.array([n[a] for a in range(10)])[best]
[?2004l[?2004h> cvb=np.array([cvv[a] for a in range(10)])[best]
[?2004l[?2004h> relse=np.sqrt((1-pb+cvb**2)/(nb*pb))
[?2004l[?2004h> half=1.2815516*E*relse
[?2004l[?2004h> lower=np.clip(E-half,0,None)
[?2004l[?2004h> upper=E+half
[?2004l[?2004h> out=pd.DataFrame({'context_id':ctx.context_id,'selected_arm':best.astype(int),'expected_reward':np.round(E,6),'confidence_lower':np.round(lower,6),'confidence_upper':np.round(upper,6)})
[?2004l[?2004h> out.to_csv(O+'predictions.csv', index=False)
[?2004l[?2004h> # arm statistics
[?2004l[?2004h> ast=pd.DataFrame({'arm_id':list(range(10)),'estimated_conversion_rate':[round(cvr[a],6) for a in range(10)],'estimated_avg_value':[round(val[a],6) for a in range(10)],'total_impressions':[n[a] for a in range(10)],'total_conversions':[k[a] for a in range(10)]})
[?2004l[?2004h> ast.to_csv(O+'arm_statistics.csv', index=False)
[?2004l[?2004h> # delay model
[?2004l[?2004h> dm={'distribution_type':'lognormal','parameters':{'mu':mu,'sigma':sig},'median_delay_hours':float(np.exp(mu)),'p90_delay_hours':float(np.exp(mu+1.2815516*sig)),'conversion_rate_estimate':float(imp.ipw.mean())}
[?2004l[?2004h> json.dump(dm, open(O+'delay_model.json','w'), indent=2)
[?2004l[?2004h> print('best arm counts', np.bincount(best, minlength=10).tolist())
[?2004l[?2004h> print('mean expected reward on test', E.mean())
[?2004l[?2004h> print(ast.to_string())
[?2004l[?2004h> print(json.dumps(dm, indent=2))
