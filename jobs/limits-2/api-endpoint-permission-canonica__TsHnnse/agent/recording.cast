[41.557553, "i", "cat > /app/canonicalize.py << 'EOF'\nimport re\n\nVALID_METHODS = {'GET', 'POST', 'PUT', 'DELETE', 'PATCH'}\nVALID_PERMS = {'ALLOW', 'DENY'}\nVAR_RE = re.compile(r'\\{[A-Za-z0-9_-]+\\}')\n\n\ndef norm(path):\n    return VAR_RE.sub('{var}', path)\n\n\ndef segs(path):\n    return [s for s in path.split('/') if s]\n\n\ndef is_strict_prefix(a, b):\n    sa, sb = segs(a), segs(b)\n    return len(sa) < len(sb) and sb[:len(sa)] == sa\n\n\ndef main():\n    with open('/app/input.txt') as fh:\n        lines = [l.rstrip('\\r\\n') for l in fh.readlines()]\n\n    i = 0\n    while i < len(lines) and not lines[i].strip():\n        i += 1\n    ep_lines = []\n    while i < len(lines) and lines[i].strip():\n        ep_lines.append(lines[i])\n        i += 1\n    rest = lines[i:]\n\n    meta_lines, plan_lines = [], []\n    for l in rest:\n        s = l.split()\n        if not s:\n            continue\n        if s[0].lower() in ('base', 'exclude'):\n            meta_lines.append(s)\n        else:\n            plan_lines.append(s)\n\n    eps = []\n    name_map = {}\n    for l in "]
[41.558139, "i", "ep_lines:\n        f = l.split()\n        if len(f) != 4:\n            break\n        path, method, role, perm = f\n        m = method.upper()\n        p = perm.upper()\n        if (not path.strip() or m not in VALID_METHODS or\n                p not in VALID_PERMS or not role.strip()):\n            break\n        eps.append((path, m, role, p))\n        name_map.setdefault(norm(path), path)\n\n    base = None\n    exclude = set()\n    for f in meta_lines:\n        if f[0].lower() == 'base':\n            base = f[1] if len(f) > 1 else None\n        elif f[0].lower() == 'exclude':\n            exclude.update(f[1:])\n\n    plan = []\n    for f in plan_lines:\n        if len(f) != 2:\n            break\n        path, method = f\n        m = method.upper()\n        if m not in VALID_METHODS or not path.strip():\n            break\n        plan.append((norm(path), m))\n\n    eligible = [e for e in eps if base is None or e[0].startswith(base)]\n\n    if not plan:\n        selected = [e for e in eligible if e[2] not in exclude]\n    else:\n        plan"]
[41.558318, "o", "cat > /app/canonicalize.py << 'EOF'\r\n\u001b[?2004l\rep_lines:\r\n        f = l.split()\r\n        if len(f) != 4:\r\n            break\r\n        path, method, role, perm = f\r\n        m = method.upper()\r\n        p = perm.upper()\r\n        if (not path.strip() or m not in VALID_METHODS or\r\n                p not in VALID_PERMS or not role.strip()):\r\n            break\r\n        eps.append((path, m, role, p))\r\n        name_map.setdefault(norm(path), path)\r\n\r\n    base = None\r\n    exclude = set()\r\n    for f in meta_lines:\r\n        if f[0].lower() == 'base':\r\n            base = f[1] if len(f) > 1 else None\r\n        elif f[0].lower() == 'exclude':\r\n            exclude.update(f[1:])\r\n\r\n    plan = []\r\n    for f in plan_lines:\r\n        if len(f) != 2:\r\n            break\r\n        path, method = f\r\n        m = method.upper()\r\n        if m not in VALID_METHODS or not path.strip():\r\n            break\r\n        plan.append((norm(path), m))\r\n\r\n    eligible = [e for e in eps if base is None or e[0].startswith(base)]\r\n\r\n    if not plan:\r\n      "]
[41.558359, "i", "_set = set(plan)\n        plan_norms = set(pn for pn, _ in plan)\n        chosen = set()\n        by_norm = {}\n        for idx, e in enumerate(eligible):\n            by_norm.setdefault(norm(e[0]), []).append(idx)\n            if (norm(e[0]), e[1]) in plan_set and e[2] not in exclude:\n                chosen.add(idx)\n        for pn2, idxs in by_norm.items():\n            if any(is_strict_prefix(pn2, pn) for pn in plan_norms):\n                nonex = [j for j in idxs if eligible[j][2] not in exclude]\n                chosen.update(nonex if nonex else idxs)\n        selected = [eligible[j] for j in sorted(chosen)]\n\n    seen = set()\n    result = []\n    for path, m, role, perm in selected:\n        key = (norm(path), m, role)\n        if key in seen:\n            continue\n        seen.add(key)\n        result.append((name_map[norm(path)], m, role, perm))\n\n    result.sort(key=lambda r: (-len(segs(r[0])), r[1], r[2], r[3]))\n\n    if not result:\n        out = '\\n'\n    else:\n        out = ''.join('%s %s %s %s\\n' % r for r in resul"]
[41.558491, "o", "  selected = [e for e in eligible if e[2] not in exclude]\r\n    else:\r\n        plan\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> VALID_METHODS = {'GET', 'POST', 'PUT', 'DELETE', 'PATCH'}\r\n\u001b[?2004l\r\u001b[?2004h> VALID_PERMS = {'ALLOW', 'DENY'}\r\n\u001b[?2004l\r\u001b[?2004h> VAR_RE = re.compile(r'\\{[A-Za-z0-9_-]+\\}')\r\n\u001b[?2004l\r"]
