[?2004hroot@28c2218b6991:/opt/myapp# cat > /usr/local/bin/check_service_health.sh <<'EOF'
[?2004l[?2004h> #!/bin/bash
[?2004l[?2004h> # Report myapp restart and error counts for the last 5 minutes as JSON.
[?2004l[?2004h> SERVICE="myapp"
[?2004l[?2004h> WINDOW_LABEL="5 minutes"
[?2004l[?2004h> RESTART_THRESHOLD=3
[?2004l[?2004h> APP_LOG="/var/log/app_events.log"
[?2004l[?2004h> SINCE_TS=$(date -u -d '5 minutes ago' +%Y-%m-%dT%H:%M:%SZ)
[?2004l[?2004h> 
[?2004l[?2004h> if command -v journalctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
[?2004l[?2004h>     LOGS=$(journalctl -u "${SERVICE}.service" --since "5 minutes ago" --no-pager -o cat 2>/dev/null)
[?2004l[?2004h>     START_PAT='Started '
[?2004l[?2004h> else
[?2004l[?2004h>     LOGS=$(awk -v since="$SINCE_TS" 'match($0, /"timestamp":"[^"]+"/) { ts = substr($0, RSTART + 13, RLENGTH - 14); if (ts >= since) print }' "$APP_LOG" 2>/dev/null)
[?2004l[?2004h>     START_PAT='Service started'
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> RESTARTS=$(printf '%s\n' "$LOGS" | grep -c "$START_PAT")
[?2004l[?2004h> ERRORS=$(printf '%s\n' "$LOGS" | grep -c 'ERROR')
[?2004l[?2004h> RESTARTS=${RESTARTS:-0}
[?2004l[?2004h> ERRORS=${ERRORS:-0}
[?2004l[?2004h> 
[?2004l[?2004h> LOOP=false
[?2004l[?2004h> if [ "$RESTARTS" -gt "$RESTART_THRESHOLD" ]; then
[?2004l[?2004h>     LOOP=true
[?2004l[?2004h> fi
[?2004l[?2004h> TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
[?2004l[?2004h> 
[?2004l[?2004h> printf '{\n  "service": "%s",\n  "time_window": "%s",\n  "restarts": %s,\n  "errors": %s,\n  "restart_loop_detected": %s,\n  "timestamp": "%s"\n}\n' "$SERVICE" "$WINDOW_LABEL" "$RESTARTS" "$ERRORS" "$LOOP" "$TS"
[?2004l[?2004h> EOF
