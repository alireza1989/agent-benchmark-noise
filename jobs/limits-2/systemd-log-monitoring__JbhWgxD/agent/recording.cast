[127.815708, "i", "cat > /etc/logrotate.d/myapp <<'EOF'\n/var/log/app_events.log /var/log/app_errors.log {\n    daily\n    rotate 7\n    compress\n    delaycompress\n    missingok\n    notifempty\n    create 0644 myapp myapp\n    sharedscripts\n    postrotate\n        [ -f /run/rsyslogd.pid ] && kill -HUP $(cat /run/rsyslogd.pid) 2>/dev/null || true\n    endscript\n}\nEOF\nlogrotate -d /etc/logrotate.d/myapp 2>&1 | tail -3; echo LOGROTATE_FIXED\n"]
