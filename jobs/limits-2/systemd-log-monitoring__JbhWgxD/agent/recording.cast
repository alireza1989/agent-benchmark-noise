[49.50268, "i", "cat > /opt/myapp/app.py <<'EOF'\n#!/usr/bin/env python3\n\"\"\"Long-running application emitting JSON structured log events to stdout.\"\"\"\nimport argparse\nimport datetime\nimport json\nimport logging\nimport signal\nimport sys\nimport threading\n\n\nclass JsonFormatter(logging.Formatter):\n    LEVEL_NAMES = {'WARNING': 'WARN'}\n\n    def format(self, record):\n        ts = datetime.datetime.fromtimestamp(record.created, datetime.timezone.utc)\n        payload = {\n            'timestamp': ts.strftime('%Y-%m-%dT%H:%M:%SZ'),\n            'level': self.LEVEL_NAMES.get(record.levelname, record.levelname),\n            'message': record.getMessage(),\n            'service': 'myapp',\n        }\n        return json.dumps(payload, separators=(',', ':'))\n\n\ndef parse_args(argv=None):\n    parser = argparse.ArgumentParser(description='myapp JSON event logger')\n    parser.add_argument('--log-level', default='INFO', type=lambda s: s.upper(),\n                        choices=['INFO', 'WARN', 'ERROR'], help='minimum level to emit')\n    parser.add_ar"]
[49.502964, "i", "gument('--interval', type=float, default=5.0, help='seconds between events')\n    return parser.parse_args(argv)\n\n\ndef main(argv=None):\n    args = parse_args(argv)\n    level = {'INFO': logging.INFO, 'WARN': logging.WARNING, 'ERROR': logging.ERROR}[args.log_level]\n\n    handler = logging.StreamHandler(sys.stdout)\n    handler.setFormatter(JsonFormatter())\n    logger = logging.getLogger('myapp')\n    logger.handlers = [handler]\n    logger.setLevel(level)\n    logger.propagate = False\n\n    stop_event = threading.Event()\n\n    def on_signal(signum, frame):\n        stop_event.set()\n\n    signal.signal(signal.SIGTERM, on_signal)\n    signal.signal(signal.SIGINT, on_signal)\n\n    logger.info('Service started')\n    cycle = 0\n    while not stop_event.wait(args.interval):\n        cycle += 1\n        if cycle % 12 == 0:\n            logger.error('Simulated error: downstream timeout')\n        elif cycle % 4 == 0:\n            logger.warning('Queue depth high')\n        else:\n            logger.info('Heartbeat cycle %d', cycle)\n    lo"]
[49.503084, "o", "cat > /opt/myapp/app.py <<'EOF'\r\n\u001b[?2004l\rgument('--interval', type=float, default=5.0, help='seconds between events')\r\n    return parser.parse_args(argv)\r\n\r\n\r\ndef main(argv=None):\r\n    args = parse_args(argv)\r\n    level = {'INFO': logging.INFO, 'WARN': logging.WARNING, 'ERROR': logging.ERROR}[args.log_level]\r\n\r\n    handler = logging.StreamHandler(sys.stdout)\r\n    handler.setFormatter(JsonFormatter())\r\n    logger = logging.getLogger('myapp')\r\n    logger.handlers = [handler]\r\n    logger.setLevel(level)\r\n    logger.propagate = False\r\n\r\n    stop_event = threading.Event()\r\n\r\n    def on_signal(signum, frame):\r\n        stop_event.set()\r\n\r\n    signal.signal(signal.SIGTERM, on_signal)\r\n    signal.signal(signal.SIGINT, on_signal)\r\n\r\n    logger.info('Service started')\r\n    cycle = 0\r\n    while not stop_event.wait(args.interval):\r\n        cycle += 1\r\n        if cycle % 12 == 0:\r\n            logger.error('Simulated error: downstream timeout')\r\n        elif cycle % 4 == 0:\r\n            logger.warning('Queue depth high')\r\n"]
[49.5031, "i", "gger.info('Service stopping')\n    sys.stdout.flush()\n    return 0\n\n\nif __name__ == '__main__':\n    sys.exit(main())\nEOF\nchmod 755 /opt/myapp/app.py; chown -R myapp:myapp /opt/myapp; echo APP_OK\n"]
