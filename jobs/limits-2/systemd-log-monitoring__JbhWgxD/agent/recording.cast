[71.513501, "i", "cat > /usr/local/bin/check_service_health.sh <<'EOF'\n#!/bin/bash\n# Analyze the systemd journal for myapp over the last 5 minutes and emit a JSON report.\nSERVICE=\"myapp\"\nWINDOW_LABEL=\"5 minutes\"\nRESTART_THRESHOLD=3\n\nLOGS=$(journalctl -u \"${SERVICE}.service\" --since \"5 minutes ago\" --no-pager -o cat 2>/dev/null)\nRESTARTS=$(printf '%s\\n' \"$LOGS\" | grep -c 'Started' || true)\nERRORS=$(printf '%s\\n' \"$LOGS\" | grep -c 'ERROR' || true)\nRESTARTS=${RESTARTS:-0}\nERRORS=${ERRORS:-0}\n\nLOOP=false\nif [ \"$RESTARTS\" -gt \"$RESTART_THRESHOLD\" ]; then\n    LOOP=true\nfi\nTS=$(date -u +%Y-%m-%dT%H:%M:%SZ)\n\nprintf '{\\n  \"service\": \"%s\",\\n  \"time_window\": \"%s\",\\n  \"restarts\": %s,\\n  \"errors\": %s,\\n  \"restart_loop_detected\": %s,\\n  \"timestamp\": \"%s\"\\n}\\n' \"$SERVICE\" \"$WINDOW_LABEL\" \"$RESTARTS\" \"$ERRORS\" \"$LOOP\" \"$TS\"\nEOF\nchmod 755 /usr/local/bin/check_service_health.sh; echo SCRIPT_OK\n"]
[71.513808, "o", "cat > /usr/local/bin/check_service_health.sh <<'EOF'\r\n\u001b[?2004l\r"]
