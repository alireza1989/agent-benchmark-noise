[51.494425, "i", "cat > /etc/rsyslog.d/50-myapp.conf <<'EOF'\n# Route myapp JSON events from journald/syslog into structured files\nif $programname == 'myapp' and $msg contains '\"level\":\"ERROR\"' then {\n    action(type=\"omfile\" file=\"/var/log/app_errors.log\" fileOwner=\"myapp\" fileGroup=\"myapp\" fileCreateMode=\"0644\")\n}\nif $programname == 'myapp' then {\n    action(type=\"omfile\" file=\"/var/log/app_events.log\" fileOwner=\"myapp\" fileGroup=\"myapp\" fileCreateMode=\"0644\")\n    stop\n}\nEOF\necho RSYSLOG_OK\n"]
