[158.810086, "i", "cat > /usr/local/bin/check_service_health.sh <<'EOF'\n#!/bin/bash\n# Report myapp restart and error counts for the last 5 minutes as JSON.\nSERVICE=\"myapp\"\nWINDOW_LABEL=\"5 minutes\"\nRESTART_THRESHOLD=3\nAPP_LOG=\"/var/log/app_events.log\"\nSINCE_TS=$(date -u -d '5 minutes ago' +%Y-%m-%dT%H:%M:%SZ)\n\nif command -v journalctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then\n    LOGS=$(journalctl -u \"${SERVICE}.service\" --since \"5 minutes ago\" --no-pager -o cat 2>/dev/null)\n    START_PAT='Started '\nelse\n    LOGS=$(awk -v since=\"$SINCE_TS\" 'match($0, /\"timestamp\":\"[^\"]+\"/) { ts = substr($0, RSTART + 13, RLENGTH - 14); if (ts >= since) print }' \"$APP_LOG\" 2>/dev/null)\n    START_PAT='Service started'\nfi\n\nRESTARTS=$(printf '%s\\n' \"$LOGS\" | grep -c \"$START_PAT\")\nERRORS=$(printf '%s\\n' \"$LOGS\" | grep -c 'ERROR')\nRESTARTS=${RESTARTS:-0}\nERRORS=${ERRORS:-0}\n\nLOOP=false\nif [ \"$RESTARTS\" -gt \"$RESTART_THRESHOLD\" ]; then\n    LOOP=true\nfi\nTS=$(date -u +%Y-%m-%dT%H:%M:%SZ)\n\nprintf '{\\n  \"service\": \"%s\",\\n  \"time_window\": \"%s\",\\n  "]
[158.810217, "i", "\"restarts\": %s,\\n  \"errors\": %s,\\n  \"restart_loop_detected\": %s,\\n  \"timestamp\": \"%s\"\\n}\\n' \"$SERVICE\" \"$WINDOW_LABEL\" \"$RESTARTS\" \"$ERRORS\" \"$LOOP\" \"$TS\"\nEOF\nchmod 755 /usr/local/bin/check_service_health.sh; echo SCRIPT_OK\n"]
[158.810619, "o", "cat > /usr/local/bin/check_service_health.sh <<'EOF'\r\n\u001b[?2004l\r"]
