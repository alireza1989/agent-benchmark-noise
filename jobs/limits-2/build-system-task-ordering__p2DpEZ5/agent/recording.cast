[54.191628, "i", "         comp.append(w)\n                if w == v:\n                    break\n            sccs.append(comp)\n\n    for v in nodes:\n        if v not in index:\n            strong(v)\n\n    comp_of = {}\n    for i, c in enumerate(sccs):\n        for v in c:\n            comp_of[v] = i\n\n    nidx = {n: i for i, n in enumerate(nodes)}\n    cycles = []\n    for c in sccs:\n        if len(c) >= 2 or (c[0] in adj.get(c[0], [])):\n            cycles.append(sorted(c))\n    cycles.sort()\n\n    m = len(sccs)\n    first = [min(nidx[v] for v in c) for c in sccs]\n    cadj = [[] for _ in range(m)]\n    cindeg = [0] * m\n    cseen = set()\n    for v in nodes:\n        for w in adj.get(v, []):\n            a = comp_of[v]\n            bb = comp_of[w]\n            if a != bb and (a, bb) not in cseen:\n                cseen.add((a, bb))\n                cadj[a].append(bb)\n                cindeg[bb] += 1\n\n    init = sorted([i for i in range(m) if cindeg[i] == 0], key=lambda i: first[i])\n    q = deque(init)\n    order = []\n    while q:\n        i = q.popleft"]
