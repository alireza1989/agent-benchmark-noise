[54.190368, "i", "cat > /app/solution.py << 'EOF'\nimport json\nfrom collections import deque\nimport sys\n\nKEYS = ('Depends', 'Before', 'After', 'Needs', 'Requires', 'Alias', 'Phony')\nEDGE_KEYS = ('Depends', 'Before', 'After', 'Needs', 'Requires')\n\n\ndef solve(lines):\n    sys.setrecursionlimit(100000)\n    blocks = []\n    cur = None\n    for raw in lines:\n        s = raw.strip()\n        if not s or s.startswith('#'):\n            continue\n        if s.startswith('[') and s.endswith(']'):\n            continue\n        toks = s.split()\n        if toks[0] == 'TARGET':\n            if len(toks) != 2:\n                return 'PARSE_ERROR'\n            cur = {'kind': 'TARGET', 'name': toks[1], 'id': '', 'dirs': []}\n            blocks.append(cur)\n        elif toks[0] == 'OVERRIDE':\n            if len(toks) != 3:\n                return 'PARSE_ERROR'\n            cur = {'kind': 'OVERRIDE', 'name': toks[1], 'id': toks[2], 'dirs': []}\n            blocks.append(cur)\n        else:\n            if cur is None:\n                return 'PARSE_ERROR'\n      "]
[54.190891, "i", "      if s.count('=') != 1:\n                return 'PARSE_ERROR'\n            k, v = s.split('=')\n            k = k.strip()\n            v = v.strip()\n            if k not in KEYS:\n                return 'PARSE_ERROR'\n            if k == 'Phony':\n                if v not in ('yes', 'no'):\n                    return 'PARSE_ERROR'\n                cur['dirs'].append(('Phony', v))\n            else:\n                cur['dirs'].append((k, v.split()))\n\n    parent = {}\n\n    def find(x):\n        parent.setdefault(x, x)\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(a, b):\n        ra = find(a)\n        rb = find(b)\n        if ra == rb:\n            return\n        if ra < rb:\n            parent[rb] = ra\n        else:\n            parent[ra] = rb\n\n    all_names = set()\n    for b in blocks:\n        find(b['name'])\n        all_names.add(b['name'])\n        for k, vals in b['dirs']:\n            if k == 'Alias':\n                for x in vals:\n      "]
[54.191048, "o", "cat > /app/solution.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> from collections import deque\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.191077, "i", "              union(b['name'], x)\n                    all_names.add(x)\n    for b in blocks:\n        for k, vals in b['dirs']:\n            if k in EDGE_KEYS:\n                for x in vals:\n                    all_names.add(x)\n\n    proc = [b for b in blocks if b['kind'] == 'TARGET'] + \\\n        sorted([b for b in blocks if b['kind'] == 'OVERRIDE'], key=lambda b: b['id'])\n\n    nodes = []\n    seen = set()\n\n    def add(n):\n        if n not in seen:\n            seen.add(n)\n            nodes.append(n)\n\n    acc = {}\n    torder = []\n    for b in proc:\n        U = find(b['name'])\n        add(U)\n        if U not in acc:\n            acc[U] = {k: [] for k in EDGE_KEYS}\n            torder.append(U)\n        for k, vals in b['dirs']:\n            if k in EDGE_KEYS:\n                for x in vals:\n                    c = find(x)\n                    if c not in acc[U][k]:\n                        acc[U][k].append(c)\n\n    adj = {}\n\n    def edge(a, b2):\n        add(a)\n        add(b2)\n        lst = adj.setdefault(a, [])\n        if b"]
[54.191119, "o", "import sys\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[54.191156, "i", "2 not in lst:\n            lst.append(b2)\n\n    for U in torder:\n        for x in acc[U]['Depends']:\n            edge(x, U)\n        for y in acc[U]['Before']:\n            edge(U, y)\n        for z in acc[U]['After']:\n            edge(z, U)\n        for w in acc[U]['Needs']:\n            edge(U, w)\n        for v in acc[U]['Requires']:\n            edge(U, v)\n\n    for n in sorted(set(find(x) for x in all_names)):\n        add(n)\n\n    index = {}\n    low = {}\n    onstack = set()\n    st = []\n    sccs = []\n    counter = [0]\n\n    def strong(v):\n        index[v] = counter[0]\n        low[v] = counter[0]\n        counter[0] += 1\n        st.append(v)\n        onstack.add(v)\n        for w in adj.get(v, []):\n            if w not in index:\n                strong(w)\n                low[v] = min(low[v], low[w])\n            elif w in onstack:\n                low[v] = min(low[v], index[w])\n        if low[v] == index[v]:\n            comp = []\n            while True:\n                w = st.pop()\n                onstack.discard(w)\n       "]
