f base is None or e[0].startswith(base)]\n\n    if not plan:\n        selected = [e for e in eligible if e[2] not in exclude]\n    else:\n        plan_set = set(plan)\n        plan_norms = set(pn for pn, _ in plan)\n        chosen = set()\n        by_norm = {}\n        for idx, e in enumerate(eligible):\n            by_norm.setdefault(norm(e[0]), []).append(idx)\n            if (norm(e[0]), e[1]) in plan_set and e[2] not in exclude:\n                chosen.add(idx)\n        for pn2, idxs in by_norm.items():\n            if any(is_strict_prefix(pn2, pn) for pn in plan_norms):\n                nonex = [j for j in idxs if eligible[j][2] not in exclude]\n                chosen.update(nonex if nonex else idxs)\n        selected = [eligible[j] for j in sorted(chosen)]\n\n    seen = set()\n    result = []\n    for path, m, role, perm in selected:\n        key = (norm(path), m, role)\n        if key in seen:\n            continue\n        seen.add(key)\n        result.append((name_map[norm(path)], m, role, perm))\n\n    result.sort(key=lambda r: (-len(segs(r[0])), r[1], r[2], r[3]))\n\n    if not result:\n        out = '\\n'\n    else:\n        out = ''.join('%s %s %s %s\\n' % r for r in result)\n\n    with open('/app/output.txt', 'w') as fh:\n        fh.write(out)\n\n\nif __name__ == '__main__':\n    main()\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
