Sending keys: ["cat > /app/solve.py << 'EOF'\nimport pandas as pd, numpy as np, json, os\nfrom scipy.stats import norm\nD='/app/data/'; O='/app/output/'\nos.makedirs(O, exist_ok=True)\nimp=pd.read_csv(D+'impressions.csv')\nconv=pd.read_csv(D+'conversions.csv')\nctx=pd.read_csv(D+'test_contexts.csv')\nmeta=json.load(open(D+'arms_metadata.json'))\n# Task 1: lognormal delay MLE on observed delays\nld=np.log(conv.delay_hours.values)\nmu=float(ld.mean()); sig=float(ld.std(ddof=0))\nT=float(max(imp.timestamp.max(), conv.conversion_timestamp.max()))\nF72=norm.cdf((np.log(72.0)-mu)/sig)\ndef comp(age):\n    a=np.clip(age,1e-3,72.0)\n    return np.clip(norm.cdf((np.log(a)-mu)/sig)/F72, 0.05, 1.0)\nimp=imp.merge(conv[['impression_id','conversion_value']], on='impression_id', how='left')\nimp['y']=imp.conversion_value.notna().astype(float)\nimp['v']=imp.conversion_value.fillna(0.0)\nimp['age']=(T-imp.timestamp)/3600.0\nimp['c']=comp(imp.age.values)\nimp['ipw']=imp.y/imp.c\n# Task 2: contextual features\ne1=np.quantile(imp.context_feature_1,[1/3,2/3]); e2=np.quantile(imp.context_feature_2,[1/3,2/3])\ndef feats(df):\n    out=pd.DataFrame(index=df.index)\n    out['seg']=df.user_segment\n    out['dev']=df.device_type\n    out['hb']=(df.hour_of_day//6).astype(int)\n    out['wk']=(df.day_of_week>=5).astype(int)\n    out['f1']=np.digitize(df.context_feature_1,e1)\n    out['f2']=np.digitize(df.context_feature_2,e2)\n    return out\nFi=feats(imp); Fc=feats(ctx)\ncvr={}; val={}; n={}; k={}; cvv={}; ratio={}; vals_all={}\nfor a in range(10):\n    s=imp[imp.arm_id==a]\n    cvr[a]=float(s.ipw.mean())\n    vals=s.loc[s.y==1,'conversion_value'].values\n    vals_all[a]=vals\n    val[a]=float(vals.mean()); cvv[a]=float(vals.std()/vals.mean())\n    n[a]=len(s); k[a]=int(s.y.sum())\n    ratio[a]={}\n    overall=s.ipw.mean()\n    for f in Fi.columns:\n        g=s.ipw.groupby(Fi.loc[s.index,f]).mean()/overall\n        ratio[a][f]=g.to_dict()\ndef pred(a,F):\n    p=np.full(len(F), cvr[a], dtype=float)\n    for f in Fi.columns:\n        p=p*F[f].map(ratio[a][f]).fillna(1.0).values\n    return np.clip(p,1e-4,1.0)\n# calibration check on historical impressions\npr=np.zeros(len(imp))\nfor a in range(10):\n    m=(imp.arm_id==a).values\n    pr[m]=pred(a,Fi)[m]*val[a]\nprint('hist mean predicted reward', pr.mean(), ' IPW actual reward', (imp.ipw*imp.v).mean(), ' raw actual', imp.v.mean())\nPc=np.column_stack([pred(a,Fc) for a in range(10)])\nP=Pc*np.array([val[a] for a in range(10)])[None,:]\nbest=P.argmax(1)\nE=P.max(1)\nidx=np.arange(len(ctx))\npb=Pc[idx,best]\nnb=np.array([n[a] for a in range(10)])[best]\ncvb=np.array([cvv[a] for a in range(10)])[best]\nrelse=np.sqrt((1-pb+cvb**2)/(nb*pb))\nhalf=1.2815516*E*relse\nlower=np.clip(E-half,0,None)\nupper=E+half\nout=pd.DataFrame({'context_id':ctx.context_id,'selected_arm':best.astype(int),'expected_reward':np.round(E,6),'confidence_lower':np.round(lower,6),'confidence_upper':np.round(upper,6)})\nout.to_csv(O+'predictions.csv', index=False)\n# arm statistics\nast=pd.DataFrame({'arm_id':list(range(10)),'estimated_conversion_rate':[round(cvr[a],6) for a in range(10)],'estimated_avg_value':[round(val[a],6) for a in range(10)],'total_impressions':[n[a] for a in range(10)],'total_conversions':[k[a] for a in range(10)]})\nast.to_csv(O+'arm_statistics.csv', index=False)\n# delay model\ndm={'distribution_type':'lognormal','parameters':{'mu':mu,'sigma':sig},'median_delay_hours':float(np.exp(mu)),'p90_delay_hours':float(np.exp(mu+1.2815516*sig)),'conversion_rate_estimate':float(imp.ipw.mean())}\njson.dump(dm, open(O+'delay_model.json','w'), indent=2)\nprint('best arm counts', np.bincount(best, minlength=10).tolist())\nprint('mean expected reward on test', E.mean())\nprint(ast.to_string())\nprint(json.dumps(dm, indent=2))\nEOF\npython3 /app/solve.py && wc -l /app/output/*.csv && head -3 /app/output/predictions.csv\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
