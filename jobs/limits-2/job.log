Sending keys: ["cat > /app/kiln_firmware.py << 'EOF'\nimport csv, json\n\ndef run_firing_cycle(schedule_path, specs_path):\n    specs = json.load(open(specs_path))\n    gp = float(specs['gas_burner_power_c'])\n    dc = float(specs['damper_cooling_c'])\n    al = float(specs['ambient_loss_c'])\n    with open(schedule_path) as f:\n        targets = [float(r['target_temp']) for r in csv.DictReader(f)]\n    n = len(targets)\n    T = targets[0]\n    g1 = 0\n    g2 = 0\n    out = []\n    for t in range(n):\n        nxt = targets[t + 1] if t + 1 < n else targets[t]\n        eff_base = 0.3 * g1 + 0.6 * g2\n        best = None\n        fallback = None\n        for g in range(6):\n            Tg = T + (0.1 * g + eff_base) * gp\n            for d in range(6):\n                Tn = Tg - (d * dc + al)\n                if fallback is None or Tn > fallback[0]:\n                    fallback = (Tn, g, d)\n                if Tn < T - 5.0:\n                    continue\n                cost = abs(Tn - nxt) + 0.02 * g\n                if best is None or cost < best[0]:\n                    best = (cost, g, d, Tn)\n        if best is not None:\n            _, g, d, Tn = best\n        else:\n            Tn, g, d = fallback\n        out.append({'gas': int(g), 'damper': int(d)})\n        T = Tn\n        g2 = g1\n        g1 = g\n    return out\n\nif __name__ == '__main__':\n    r = run_firing_cycle('/app/firing_schedule.csv', '/app/kiln_specs.json')\n    print(r[:3], len(r))\nEOF\n"] min_timeout_sec: 0.2 max_timeout_sec: 180.0
