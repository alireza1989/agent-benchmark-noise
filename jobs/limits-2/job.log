(length > 0) | split("\\t")) | map({type: .[0], path: .[1], sha256: .[2], details: {line_number: (if .[3] == "" then null else (.[3] | tonumber) end), content_preview: .[4], user: (if .[5] == "" then null else .[5] end)}}) as $a | {summary: {total_artifacts: ($a | length), cron_jobs: ([$a[] | select(.type == "cron_job")] | length), systemd_units: ([$a[] | select(.type == "systemd_unit")] | length), rc_local_modifications: ([$a[] | select(.type == "rc_local")] | length), ssh_keys: ([$a[] | select(.type == "ssh_key")] | length)}, artifacts: $a}\' > "$OUT.tmp" && mv -f "$OUT.tmp" "$OUT" || echo \'failed to write report\' >&2\nexit 0\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
