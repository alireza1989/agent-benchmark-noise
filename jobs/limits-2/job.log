Sending keys: ["cat > /workspace/analysis.py << 'PYEOF'\nimport json, statistics\nfrom collections import defaultdict\nfrom datetime import datetime, timezone\nfrom decimal import Decimal, ROUND_HALF_UP\n\ndef rnd(x, n):\n    return float(Decimal(str(x)).quantize(Decimal(1).scaleb(-n), rounding=ROUND_HALF_UP))\n\ndef ts(s):\n    return datetime.strptime(s, '%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=timezone.utc)\n\nd = json.load(open('/workspace/registry_data.json'))\nref = datetime(2024, 1, 25, tzinfo=timezone.utc)\n\nlayers = {}\ntotal = 0\nowners = defaultdict(set)\nfor img in d['images']:\n    for l in img['layers']:\n        total += l['size_bytes']\n        layers.setdefault(l['sha256'], l)\n        owners[l['sha256']].add(img['name'])\n\ndedup = sum(l['size_bytes'] for l in layers.values())\nsavings = (total - dedup) / total * 100\n\nacc = {a['sha256']: a for a in d['access_patterns']}\ntotal_acc = sum(a['access_count'] for a in d['access_patterns'])\nhit = (total_acc - len(acc)) / total_acc\n\ncfg = d['registry_config']\ncomp = dedup * cfg['compression_ratio']\ncost = comp / 1073741824 * cfg['storage_cost_per_gb_per_month']\nnet = dedup / ((cfg['network_bandwidth_mbps'] * 1000000) / 8)\n\nages = [(ref - ts(l['created_at'])).total_seconds() / 86400 for l in layers.values()]\navg_age = sum(ages) / len(ages)\nsd = statistics.pstdev([a['access_count'] for a in d['access_patterns']])\n\ntop = sorted(layers.values(), key=lambda l: l['size_bytes'], reverse=True)[:5]\ntop_out = [{'sha256': l['sha256'], 'size_bytes': l['size_bytes'], 'access_count': acc.get(l['sha256'], {}).get('access_count', 0), 'created_at': l['created_at']} for l in top]\n\ncutoff = datetime(2024, 1, 18, tzinfo=timezone.utc)\nrecent_count = sum(1 for a in d['access_patterns'] if ts(a['last_accessed']) >= cutoff)\nmost = sorted(d['access_patterns'], key=lambda a: ts(a['last_accessed']), reverse=True)[:3]\nmost_out = [{'sha256': a['sha256'], 'last_accessed': a['last_accessed'], 'access_count': a['access_count']} for a in most]\n\nshared_layers = [s for s, o in owners.items() if len(o) > 1]\nimgs_shared = [img['name'] for img in d['images'] if any(len(owners[l['sha256']]) > 1 for l in img['layers'])]\n\nout = {\n    'basic_metrics': {\n        'total_storage_bytes': total,\n        'deduplicated_storage_bytes': dedup,\n        'storage_savings_percent': rnd(savings, 1),\n        'cache_hit_ratio': rnd(hit, 2)\n    },\n    'advanced_metrics': {\n        'compressed_storage_bytes': int(comp),\n        'monthly_storage_cost_usd': rnd(cost, 2),\n        'network_transfer_time_seconds': rnd(net, 2),\n        'average_layer_age_days': rnd(avg_age, 1),\n        'access_frequency_std_dev': rnd(sd, 2)\n    },\n    'top_layers_by_size': top_out,\n    'recent_access_summary': {\n        'layers_accessed_last_7_days': recent_count,\n        'most_recent_layers': most_out\n    },\n    'shared_layer_analysis': {\n        'images_with_shared_layers': imgs_shared,\n        'total_shared_layer_count': len(shared_layers)\n    }\n}\n\nwith open('/workspace/output.json', 'w') as f:\n    json.dump(out, f, indent=2)\nprint(json.dumps(out, indent=2))\nPYEOF\npython3 /workspace/analysis.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
