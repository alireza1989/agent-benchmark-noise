ent[ra] = rb\n\n    all_names = set()\n    for b in blocks:\n        find(b[\'name\'])\n        all_names.add(b[\'name\'])\n        for k, vals in b[\'dirs\']:\n            if k == \'Alias\':\n                for x in vals:\n                    union(b[\'name\'], x)\n                    all_names.add(x)\n    for b in blocks:\n        for k, vals in b[\'dirs\']:\n            if k in EDGE_KEYS:\n                for x in vals:\n                    all_names.add(x)\n\n    proc = [b for b in blocks if b[\'kind\'] == \'TARGET\'] + \\\n        sorted([b for b in blocks if b[\'kind\'] == \'OVERRIDE\'], key=lambda b: b[\'id\'])\n\n    nodes = []\n    seen = set()\n\n    def add(n):\n        if n not in seen:\n            seen.add(n)\n            nodes.append(n)\n\n    acc = {}\n    torder = []\n    for b in proc:\n        U = find(b[\'name\'])\n        add(U)\n        if U not in acc:\n            acc[U] = {k: [] for k in EDGE_KEYS}\n            torder.append(U)\n        for k, vals in b[\'dirs\']:\n            if k in EDGE_KEYS:\n                for x in vals:\n                    c = find(x)\n                    if c not in acc[U][k]:\n                        acc[U][k].append(c)\n\n    adj = {}\n\n    def edge(a, b2):\n        add(a)\n        add(b2)\n        lst = adj.setdefault(a, [])\n        if b2 not in lst:\n            lst.append(b2)\n\n    for U in torder:\n        for x in acc[U][\'Depends\']:\n            edge(x, U)\n        for y in acc[U][\'Before\']:\n            edge(U, y)\n        for z in acc[U][\'After\']:\n            edge(z, U)\n        for w in acc[U][\'Needs\']:\n            edge(U, w)\n        for v in acc[U][\'Requires\']:\n            edge(U, v)\n\n    for n in sorted(set(find(x) for x in all_names)):\n        add(n)\n\n    index = {}\n    low = {}\n    onstack = set()\n    st = []\n    sccs = []\n    counter = [0]\n\n    def strong(v):\n        index[v] = counter[0]\n        low[v] = counter[0]\n        counter[0] += 1\n        st.append(v)\n        onstack.add(v)\n        for w in adj.get(v, []):\n            if w not in index:\n                strong(w)\n                low[v] = min(low[v], low[w])\n            elif w in onstack:\n                low[v] = min(low[v], index[w])\n        if low[v] == index[v]:\n            comp = []\n            while True:\n                w = st.pop()\n                onstack.discard(w)\n                comp.append(w)\n                if w == v:\n                    break\n            sccs.append(comp)\n\n    for v in nodes:\n        if v not in index:\n            strong(v)\n\n    comp_of = {}\n    for i, c in enumerate(sccs):\n        for v in c:\n            comp_of[v] = i\n\n    nidx = {n: i for i, n in enumerate(nodes)}\n    cycles = []\n    for c in sccs:\n        if len(c) >= 2 or (c[0] in adj.get(c[0], [])):\n            cycles.append(sorted(c))\n    cycles.sort()\n\n    m = len(sccs)\n    first = [min(nidx[v] for v in c) for c in sccs]\n    cadj = [[] for _ in range(m)]\n    cindeg = [0] * m\n    cseen = set()\n    for v in nodes:\n        for w in adj.get(v, []):\n            a = comp_of[v]\n            bb = comp_of[w]\n            if a != bb and (a, bb) not in cseen:\n                cseen.add((a, bb))\n                cadj[a].append(bb)\n                cindeg[bb] += 1\n\n    init = sorted([i for i in range(m) if cindeg[i] == 0], key=lambda i: first[i])\n    q = deque(init)\n    order = []\n    while q:\n        i = q.popleft()\n        order.extend(sorted(sccs[i]))\n        for j in cadj[i]:\n            cindeg[j] -= 1\n            if cindeg[j] == 0:\n                q.append(j)\n\n    return json.dumps({\'order\': order, \'cycles\': cycles}, separators=(\',\', \':\'))\nEOF\ncd /app && python3 -c "\nfrom solution import solve\nprint(solve([\'TARGET build\',\'Alias = compile link\',\'Depends = all\',\'TARGET compile\',\'Before = clean\']))\nprint(solve([\'TARGET test\',\'Phony = yes\',\'Depends = unit\',\'OVERRIDE test 20\',\'Phony = no\',\'After = integration\'