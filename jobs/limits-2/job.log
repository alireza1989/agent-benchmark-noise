cands.append(s)\n    cands.sort(key=lambda s: (pr[svc[s]['criticality']], -tl(s), -svc[s]['resource_units'], s))\n    placed = []\n    for s in cands:\n        sv = svc[s]\n        ru = sv['resource_units']\n        c = 1 if sv['criticality'] == 'critical' else 0\n        h = 1 if ru >= 5 else 0\n        t = sv['team']\n        if tcount[t] + 1 > limit(t):\n            continue\n        if c and gcrit + 1 > GC['max_global_critical_per_wave']:\n            continue\n        dcs = [reg[r] for r in sv['required_regions']]\n        ok = True\n        for d in dcs:\n            x = dc[d]\n            if usage[d] + ru > x['capacity_per_wave']:\n                ok = False\n            if c and crit[d] + 1 > x['max_critical_per_wave']:\n                ok = False\n            if h and hi[d] + 1 > x['high_resource_slots']:\n                ok = False\n        if not ok:\n            continue\n        for d in dcs:\n            usage[d] += ru\n            crit[d] += c\n            hi[d] += h\n        gcrit += c\n        tcount[t] += 1\n        done[s] = w\n        remaining.discard(s)\n        placed.append(s)\n    prev_team = dict(tcount)\n    waves.append(placed)\nplan_waves = []\ntotal_min = 0\nfor i, placed in enumerate(waves, 1):\n    deps = []\n    mx = 0\n    for s in placed:\n        sv = svc[s]\n        mx = max(mx, sv['deploy_time_minutes'])\n        for r in sv['required_regions']:\n            deps.append({'service_id': s, 'datacenter_id': reg[r], 'deploy_time_minutes': sv['deploy_time_minutes']})\n    total_min += mx\n    plan_waves.append({'wave_number': i, 'deployments': deps})\nplan = {\n    'generated_at': datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),\n    'total_waves': len(plan_waves),\n    'estimated_duration_minutes': total_min,\n    'waves': plan_waves,\n}\nimport os\nos.makedirs('/app/task_file/output_data', exist_ok=True)\njson.dump(plan, open('/app/task_file/output_data/deployment_plan.json', 'w'), indent=2)\nprint('waves', len(plan_waves), 'services', len(done))\nEOF\npython3 /app/solver.py && python3 /app/task_file/scripts/model.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
