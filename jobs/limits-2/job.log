Sending keys: ["cat > /app/api/app.py << 'EOF'\nimport json\nimport pickle\nfrom contextlib import asynccontextmanager\nfrom typing import List\n\nimport pandas as pd\nfrom fastapi import FastAPI, HTTPException\nfrom pydantic import BaseModel\n\nMODEL_PATH = '/app/models/best_model.pkl'\nCOMPARISON_PATH = '/app/output/model_comparison.json'\nFEATURES = ['MedInc', 'HouseAge', 'AveRooms', 'AveBedrms', 'Population', 'AveOccup', 'Latitude', 'Longitude']\n\nstate = {}\n\n\n@asynccontextmanager\nasync def lifespan(app):\n    with open(MODEL_PATH, 'rb') as f:\n        state['model'] = pickle.load(f)\n    with open(COMPARISON_PATH) as f:\n        state['name'] = json.load(f)['best_model_name']\n    yield\n    state.clear()\n\n\napp = FastAPI(title='California Housing Price API', lifespan=lifespan)\n\n\nclass PredictRequest(BaseModel):\n    features: List[float]\n\n\nclass PredictBatchRequest(BaseModel):\n    features_list: List[List[float]]\n\n\n@app.post('/predict')\ndef predict(req: PredictRequest):\n    if len(req.features) != 8:\n        raise HTTPException(status_code=422, detail='features must contain exactly 8 values')\n    X = pd.DataFrame([req.features], columns=FEATURES)\n    pred = float(state['model'].predict(X)[0])\n    return {'prediction': pred, 'model_name': state['name']}\n\n\n@app.get('/health')\ndef health():\n    return {'status': 'healthy', 'model_loaded': 'model' in state}\n\n\n@app.get('/model-info')\ndef model_info():\n    return {\n        'model_name': state['name'],\n        'model_type': type(state['model']).__name__,\n        'features_count': 8,\n    }\n\n\n@app.post('/predict-batch')\ndef predict_batch(req: PredictBatchRequest):\n    for row in req.features_list:\n        if len(row) != 8:\n            raise HTTPException(status_code=422, detail='each inner list must contain exactly 8 values')\n    if not req.features_list:\n        return {'predictions': [], 'model_name': state['name'], 'count': 0}\n    X = pd.DataFrame(req.features_list, columns=FEATURES)\n    preds = [float(p) for p in state['model'].predict(X)]\n    return {'predictions': preds, 'model_name': state['name'], 'count': len(preds)}\nEOF\ncd /app && nohup uvicorn api.app:app --host 0.0.0.0 --port 8000 > /app/output/server.log 2>&1 &\nfor i in $(seq 1 40); do curl -s http://localhost:8000/health && break; sleep 1; done; echo\ncurl -s http://localhost:8000/model-info; echo\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
