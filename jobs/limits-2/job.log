Sending keys: ["cat > /app/src/conv.py << 'EOF'\nimport numpy as np\n\nfrom .base import BaseLayer\nfrom .padding import zero_pad, get_output_shape\n\n\nclass Conv2D(BaseLayer):\n    def __init__(self, in_channels, out_channels, kernel_size, stride=1, padding=0, dilation=1):\n        super().__init__()\n        self.in_channels = int(in_channels)\n        self.out_channels = int(out_channels)\n        self.kernel_size = int(kernel_size)\n        self.stride = int(stride)\n        self.padding = int(padding)\n        self.dilation = int(dilation)\n        fan_in = self.in_channels * self.kernel_size * self.kernel_size\n        fan_out = self.out_channels * self.kernel_size * self.kernel_size\n        limit = np.sqrt(6.0 / (fan_in + fan_out))\n        self.weights = np.random.uniform(-limit, limit, (self.out_channels, self.in_channels, self.kernel_size, self.kernel_size)).astype(np.float64)\n        self.bias = np.zeros(self.out_channels, dtype=np.float64)\n\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        N, H, W, C = x.shape\n        k, s, d = self.kernel_size, self.stride, self.dilation\n        xp = zero_pad(x, self.padding)\n        oh, ow = get_output_shape((H, W), k, s, self.padding, d)\n        out = np.zeros((N, oh, ow, self.out_channels), dtype=np.float64)\n        for i in range(k):\n            for j in range(k):\n                hs = i * d\n                ws = j * d\n                patch = xp[:, hs:hs + s * (oh - 1) + 1:s, ws:ws + s * (ow - 1) + 1:s, :]\n                out += np.einsum('nhwc,oc->nhwo', patch, self.weights[:, :, i, j])\n        out += self.bias\n        return out\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/src/conv_transpose.py << 'EOF'\nimport numpy as np\n\nfrom .base import BaseLayer\n\n\nclass Conv2DTranspose(BaseLayer):\n    def __init__(self, in_channels, out_channels, kernel_size, stride=1, padding=0):\n        super().__init__()\n        self.in_channels = int(in_channels)\n        self.out_channels = int(out_channels)\n        self.kernel_size = int(kernel_size)\n        self.stride = int(stride)\n        self.padding = int(padding)\n        fan_in = self.in_channels * self.kernel_size * self.kernel_size\n        fan_out = self.out_channels * self.kernel_size * self.kernel_size\n        limit = np.sqrt(6.0 / (fan_in + fan_out))\n        self.weights = np.random.uniform(-limit, limit, (self.in_channels, self.out_channels, self.kernel_size, self.kernel_size)).astype(np.float64)\n        self.bias = np.zeros(self.out_channels, dtype=np.float64)\n\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        N, H, W, C = x.shape\n        k, s, p = self.kernel_size, self.stride, self.padding\n        Hf = (H - 1) * s + k\n        Wf = (W - 1) * s + k\n        full = np.zeros((N, Hf, Wf, self.out_channels), dtype=np.float64)\n        for i in range(k):\n            for j in range(k):\n                contrib = np.einsum('nhwc,co->nhwo', x, self.weights[:, :, i, j])\n                full[:, i:i + s * (H - 1) + 1:s, j:j + s * (W - 1) + 1:s, :] += contrib\n        out = full[:, p:Hf - p, p:Wf - p, :]\n        out = out + self.bias\n        return out.astype(np.float64)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/src/pooling.py << 'EOF'\nimport numpy as np\n\nfrom .base import BaseLayer\n\n\nclass _Pool2D(BaseLayer):\n    def __init__(self, kernel_size, stride=None):\n        super().__init__()\n        self.kernel_size = int(kernel_size)\n        self.stride = int(stride) if stride is not None else self.kernel_size\n\n    def _patches(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        N, H, W, C = x.shape\n        k, s = self.kernel_size, self.stride\n        oh = (H - k) // s + 1\n        ow = (W - k) // s + 1\n        patches = []\n        for i in range(k):\n            for j in range(k):\n                patches.append(x[:, i:i + s * (oh - 1) + 1:s, j:j + s * (ow - 1) + 1:s, :])\n        return np.stack(patches, axis=0)\n\n\nclass MaxPool2D(_Pool2D):\n    def forward(self, x):\n        return self._patches(x).max(axis=0).astype(np.float64)\n\n\nclass AvgPool2D(_Pool2D):\n    def forward(self, x):\n        return self._patches(x).mean(axis=0).astype(np.float64)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/src/normalization.py << 'EOF'\nimport numpy as np\n\nfrom .base import BaseLayer\n\n\nclass BatchNorm2D(BaseLayer):\n    def __init__(self, num_features, eps=1e-5, momentum=0.1):\n        super().__init__()\n        self.num_features = int(num_features)\n        self.eps = float(eps)\n        self.momentum = float(momentum)\n        self.gamma = np.ones(self.num_features, dtype=np.float64)\n        self.beta = np.zeros(self.num_features, dtype=np.float64)\n        self.running_mean = np.zeros(self.num_features, dtype=np.float64)\n        self.running_var = np.ones(self.num_features, dtype=np.float64)\n\n    def forward(self, x, training=True):\n        x = np.asarray(x, dtype=np.float64)\n        axes = (0, 1, 2)\n        if training:\n            mean = x.mean(axis=axes)\n            var = x.var(axis=axes)\n            m = self.momentum\n            self.running_mean = (1 - m) * self.running_mean + m * mean\n            self.running_var = (1 - m) * self.running_var + m * var\n        else:\n            mean = self.running_mean\n            var = self.running_var\n        x_hat = (x - mean) / np.sqrt(var + self.eps)\n        return (self.gamma * x_hat + self.beta).astype(np.float64)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
