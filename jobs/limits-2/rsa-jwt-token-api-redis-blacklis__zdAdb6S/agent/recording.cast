[105.538208, "i", "cat > /app/api.py << 'EOF'\nimport os, time, uuid, logging\nfrom flask import Flask, request, jsonify\nimport jwt, bcrypt, redis\n\nBASE = '/app'\nKEY_DIR = BASE + '/keys'\nos.makedirs(BASE + '/logs', exist_ok=True)\nlogging.basicConfig(filename=BASE + '/logs/app.log', level=logging.INFO, format='%(asctime)s %(levelname)s api %(message)s')\nlog = logging.getLogger('api')\n\nwith open(KEY_DIR + '/private.pem') as f:\n    PRIV = f.read()\nwith open(KEY_DIR + '/public.pem') as f:\n    PUB = f.read()\n\nISS = 'rsa-jwt-api'\nACCESS_TTL = 15 * 60\nREFRESH_TTL = 7 * 24 * 3600\nrds = redis.Redis(host=os.environ.get('REDIS_HOST', 'localhost'), port=int(os.environ.get('REDIS_PORT', '6379')), decode_responses=True)\nUSERS = {'admin': bcrypt.hashpw(b'password123', bcrypt.gensalt()).decode()}\n\napp = Flask(__name__)\n\n\ndef issue(sub, ttype, ttl):\n    now = int(time.time())\n    payload = {'iss': ISS, 'sub': sub, 'iat': now, 'exp': now + ttl, 'jti': str(uuid.uuid4()), 'type': ttype}\n    return jwt.encode(payload, PRIV, algorithm='RS256')\n\n\ndef d"]
[105.538415, "i", "ecode(token, verify_exp=True):\n    return jwt.decode(token, PUB, algorithms=['RS256'], issuer=ISS,\n                      options={'verify_exp': verify_exp, 'require': ['exp', 'iat', 'jti', 'sub', 'iss']})\n\n\ndef err(code, msg):\n    log.warning('%s: %s', code, msg)\n    return jsonify({'error': msg}), code\n\n\ndef bearer():\n    h = request.headers.get('Authorization', '')\n    if h.startswith('Bearer '):\n        return h[7:]\n    return None\n\n\ndef verify(token, expect_type=None):\n    if not token:\n        return None, err(401, 'missing token')\n    try:\n        claims = decode(token)\n    except jwt.ExpiredSignatureError:\n        return None, err(401, 'token expired')\n    except jwt.InvalidTokenError as e:\n        return None, err(401, 'invalid token: ' + str(e))\n    if expect_type and claims.get('type') != expect_type:\n        return None, err(401, 'wrong token type')\n    if rds.exists('blacklist:' + claims['jti']):\n        return None, err(403, 'token revoked')\n    return claims, None\n\n\n@app.route('/auth/public-key'"]
[105.538537, "o", "cat > /app/api.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[105.538569, "i", ", methods=['GET'])\ndef public_key():\n    return PUB, 200, {'Content-Type': 'text/plain'}\n\n\n@app.route('/auth/login', methods=['POST'])\ndef login():\n    body = request.get_json(silent=True) or {}\n    u = str(body.get('username', ''))\n    p = str(body.get('password', ''))\n    h = USERS.get(u)\n    if not h or not bcrypt.checkpw(p.encode(), h.encode()):\n        return err(401, 'invalid credentials')\n    log.info('login ok for %s', u)\n    return jsonify({'access_token': issue(u, 'access', ACCESS_TTL),\n                    'refresh_token': issue(u, 'refresh', REFRESH_TTL),\n                    'token_type': 'Bearer',\n                    'access_expires_in': ACCESS_TTL,\n                    'refresh_expires_in': REFRESH_TTL}), 200\n\n\n@app.route('/auth/refresh', methods=['POST'])\ndef refresh():\n    body = request.get_json(silent=True) or {}\n    claims, bad = verify(body.get('refresh_token'), 'refresh')\n    if bad:\n        return bad\n    return jsonify({'access_token': issue(claims['sub'], 'access', ACCESS_TTL),\n         "]
[105.538681, "o", "import os, time, uuid, logging\r\n\u001b[?2004l\r\u001b[?2004h> "]
[105.538851, "i", "           'token_type': 'Bearer', 'expires_in': ACCESS_TTL}), 200\n\n\n@app.route('/auth/revoke', methods=['POST'])\ndef revoke():\n    body = request.get_json(silent=True) or {}\n    tok = body.get('token') or bearer()\n    if not tok:\n        return err(400, 'token required')\n    try:\n        claims = decode(tok, verify_exp=False)\n    except jwt.InvalidTokenError as e:\n        return err(401, 'invalid token: ' + str(e))\n    ttl = max(int(claims['exp'] - time.time()), 1)\n    rds.set('blacklist:' + claims['jti'], claims['sub'], ex=ttl)\n    log.info('revoked jti %s', claims['jti'])\n    return jsonify({'revoked': True, 'jti': claims['jti'], 'ttl': ttl}), 200\n\n\n@app.route('/auth/validate', methods=['GET'])\ndef validate():\n    claims, bad = verify(bearer() or request.args.get('token'))\n    if bad:\n        return bad\n    return jsonify({'valid': True, 'sub': claims['sub'], 'jti': claims['jti'],\n                    'type': claims['type'], 'exp': claims['exp']}), 200\n\n\nif __name__ == '__main__':\n    app.run(host='0.0.0.0'"]
