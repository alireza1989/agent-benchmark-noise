[105.577459, "o", "\u001b[?2004hroot@00b13f7960b9:/app# "]
[106.552269, "i", "cat > /app/cli.py << 'EOF'\nimport sys, json, os, argparse, logging\nimport requests\n\nTOKENS = '/app/tokens.json'\nURL = os.environ.get('API_URL', 'http://localhost:5000')\nos.makedirs('/app/logs', exist_ok=True)\nlogging.basicConfig(filename='/app/logs/app.log', level=logging.INFO, format='%(asctime)s %(levelname)s cli %(message)s')\nlog = logging.getLogger('cli')\n\n\ndef load():\n    if not os.path.exists(TOKENS):\n        return {}\n    with open(TOKENS) as f:\n        return json.load(f)\n\n\ndef save(d):\n    with open(TOKENS, 'w') as f:\n        json.dump(d, f, indent=2)\n\n\ndef fail(msg):\n    log.error(msg)\n    print('ERROR: ' + msg, file=sys.stderr)\n    return 1\n\n\ndef call(method, path, token=None, body=None):\n    headers = {'Authorization': 'Bearer ' + token} if token else {}\n    return requests.request(method, URL + path, headers=headers, json=body, timeout=10)\n\n\ndef acquire(username, password):\n    try:\n        resp = requests.post(URL + '/auth/login', json={'username': username, 'password': password}, timeout=10)\n  "]
[106.552363, "i", "  except requests.RequestException as e:\n        return fail('login request failed: %s' % e)\n    if resp.status_code != 200:\n        return fail('login failed: %s %s' % (resp.status_code, resp.text))\n    data = resp.json()\n    save({'username': username, 'access_token': data['access_token'], 'refresh_token': data['refresh_token'],\n          'revoked': {}})\n    print('tokens acquired and saved to ' + TOKENS)\n    return 0\n\n\ndef cmd_acquire(args):\n    return acquire(args.username, args.password)\n\n\ndef cmd_validate(args):\n    d = load()\n    tok = d.get(args.kind + '_token')\n    if not tok:\n        return fail('no %s token found; run acquire' % args.kind)\n    try:\n        resp = call('GET', '/auth/validate', tok)\n    except requests.RequestException as e:\n        return fail('validate request failed: %s' % e)\n    if resp.status_code == 200:\n        print('valid: ' + json.dumps(resp.json()))\n        return 0\n    return fail('%s token rejected: %s %s' % (args.kind, resp.status_code, resp.text))\n\n\ndef cmd_revoke(args"]
[106.552374, "i", "):\n    d = load()\n    tok = d.get(args.kind + '_token')\n    if not tok:\n        return fail('no %s token found; run acquire' % args.kind)\n    try:\n        resp = call('POST', '/auth/revoke', body={'token': tok})\n    except requests.RequestException as e:\n        return fail('revoke request failed: %s' % e)\n    if resp.status_code != 200:\n        return fail('revoke failed: %s %s' % (resp.status_code, resp.text))\n    d.setdefault('revoked', {})[args.kind] = True\n    save(d)\n    print('%s token revoked: %s' % (args.kind, resp.json()))\n    return 0\n\n\ndef cmd_retry(args):\n    d = load()\n    if d.get('access_token'):\n        try:\n            resp = call('GET', '/auth/validate', d['access_token'])\n            if resp.status_code == 200:\n                print('access token still valid; nothing to retry')\n                return 0\n        except requests.RequestException as e:\n            return fail('validate request failed: %s' % e)\n        log.warning('access token rejected (%s); attempting refresh' % resp.status_c"]
[106.552379, "i", "ode)\n    if d.get('refresh_token') and not d.get('revoked', {}).get('refresh'):\n        try:\n            resp = call('POST', '/auth/refresh', body={'refresh_token': d['refresh_token']})\n            if resp.status_code == 200:\n                d['access_token'] = resp.json()['access_token']\n                save(d)\n                print('access token refreshed')\n                return 0\n            log.warning('refresh failed: %s %s' % (resp.status_code, resp.text))\n        except requests.RequestException as e:\n            return fail('refresh request failed: %s' % e)\n    print('refresh unavailable; acquiring new tokens')\n    return acquire(d.get('username', 'admin'), args.password)\n\n\ndef main():\n    p = argparse.ArgumentParser(description='JWT auth CLI')\n    sub = p.add_subparsers(dest='cmd', required=True)\n    a = sub.add_parser('acquire')\n    a.add_argument('--username', default='admin')\n    a.add_argument('--password', default='password123')\n    a.set_defaults(func=cmd_acquire)\n    v = sub.add_parser('valid"]
[106.552387, "i", "ate')\n    v.add_argument('--kind', choices=['access', 'refresh'], default='access')\n    v.set_defaults(func=cmd_validate)\n    r = sub.add_parser('revoke')\n    r.add_argument('--kind', choices=['access', 'refresh'], default='access')\n    r.set_defaults(func=cmd_revoke)\n    t = sub.add_parser('retry')\n    t.add_argument('--password', default='password123')\n    t.set_defaults(func=cmd_retry)\n    args = p.parse_args()\n    sys.exit(args.func(args))\n\n\nif __name__ == '__main__':\n    main()\nEOF\npython3 -m py_compile /app/cli.py && echo CLI_OK\n"]
