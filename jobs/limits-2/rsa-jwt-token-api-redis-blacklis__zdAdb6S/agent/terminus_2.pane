[?2004l           'token_type': 'Bearer', 'expires_in': ACCESS_TTL}), 200


@app.route('/auth/revoke', methods=['POST'])
def revoke():
    body = request.get_json(silent=True) or {}
    tok = body.get('token') or bearer()
    if not tok:
        return err(400, 'token required')
    try:
        claims = decode(tok, verify_exp=False)
    except jwt.InvalidTokenError as e:
        return err(401, 'invalid token: ' + str(e))
    ttl = max(int(claims['exp'] - time.time()), 1)
    rds.set('blacklist:' + claims['jti'], claims['sub'], ex=ttl)
    log.info('revoked jti %s', claims['jti'])
    return jsonify({'revoked': True, 'jti': claims['jti'], 'ttl': ttl}), 200


@app.route('/auth/validate', methods=['GET'])
def validate():
    claims, bad = verify(bearer() or request.args.get('token'))
    if bad:
        return bad
    return jsonify({'valid': True, 'sub': claims['sub'], 'jti': claims['jti'],
                    'type': claims['type'], 'exp': claims['exp']}), 200


if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000)
