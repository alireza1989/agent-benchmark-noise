[36.382345, "i", "    return base is None or path.startswith(base)\n\n    allowed = [e for e in endpoints if in_base(e[0]) and e[2] not in excluded]\n\n    if not plan:\n        selected = allowed\n    else:\n        plan_set = set((norm(p), m) for p, m in plan)\n        planned = [e for e in allowed if (norm(e[0]), e[1]) in plan_set]\n        planned_norms = set(norm(e[0]) for e in planned)\n        parent_norms = set()\n        for e in allowed:\n            m = norm(e[0])\n            for pn in planned_norms:\n                if m != pn and pn.startswith(m):\n                    parent_norms.add(m)\n                    break\n        selected = [e for e in allowed\n                    if (norm(e[0]) in parent_norms) or\n                    (norm(e[0]), e[1]) in plan_set]\n\n    # dedupe on (normalized path, method, role), first occurrence wins\n    seen = set()\n    result = []\n    for path, method, role, perm in selected:\n        key = (norm(path), method, role)\n        if key in seen:\n            continue\n        seen.add(key)\n        result.ap"]
