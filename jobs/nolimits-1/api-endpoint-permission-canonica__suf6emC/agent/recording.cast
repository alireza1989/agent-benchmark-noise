[36.381397, "i", "cat > /app/canonicalize.py << 'EOF'\n#!/usr/bin/env python3\nimport re\n\nINPUT = '/app/input.txt'\nOUTPUT = '/app/output.txt'\nMETHODS = {'GET', 'POST', 'PUT', 'DELETE', 'PATCH'}\nPERMS = {'ALLOW', 'DENY'}\nVAR_RE = re.compile(r'\\{[A-Za-z0-9_-]+\\}')\nMETHOD_ORDER = {'DELETE': 0, 'GET': 1, 'PATCH': 2, 'POST': 3, 'PUT': 4}\nPERM_ORDER = {'ALLOW': 0, 'DENY': 1}\n\n\ndef norm(path):\n    return VAR_RE.sub('{var}', path)\n\n\ndef segments(path):\n    return len([s for s in path.split('/') if s])\n\n\ndef main():\n    try:\n        with open(INPUT, 'r') as f:\n            lines = [l.rstrip('\\r') for l in f.read().split('\\n')]\n    except FileNotFoundError:\n        lines = []\n\n    i = 0\n    endpoint_lines = []\n    while i < len(lines) and lines[i].strip() != '':\n        endpoint_lines.append(lines[i])\n        i += 1\n\n    base = None\n    excluded = set()\n    plan_lines = []\n    for line in lines[i:]:\n        parts = line.split()\n        if not parts:\n            continue\n        if parts[0] == 'base':\n            if len(parts) >= 2:\n       "]
[36.38201, "i", "         base = parts[1]\n        elif parts[0] == 'exclude':\n            excluded.update(parts[1:])\n        else:\n            plan_lines.append(parts)\n\n    # ENDPOINTS with hard cutoff\n    endpoints = []\n    for line in endpoint_lines:\n        parts = line.split()\n        if len(parts) != 4:\n            break\n        path, method, role, perm = parts\n        method = method.upper()\n        perm = perm.upper()\n        if not path or method not in METHODS or perm not in PERMS or not role:\n            break\n        endpoints.append((path, method, role, perm))\n\n    # PLAN with hard cutoff\n    plan = []\n    for parts in plan_lines:\n        if len(parts) != 2:\n            break\n        path, method = parts\n        method = method.upper()\n        if not path or method not in METHODS:\n            break\n        plan.append((path, method))\n\n    # first-seen original variable name per normalized path\n    canon = {}\n    for path, _, _, _ in endpoints:\n        canon.setdefault(norm(path), path)\n\n    def in_base(path):\n    "]
