[84.174294, "i", "cat > /app/scan_persistence.sh <<'EOF'\n#!/bin/bash\n# Read-only scanner for seeded persistence artifacts; writes /app/persistence_report.json\nset -u\nset -f\nshopt -s nullglob\nOUT=/app/persistence_report.json\nTMP=$(mktemp) || exit 0\ntrap 'rm -f \"$TMP\"' EXIT\nCR=$(printf '\\015')\nSUSP_CRON='/tmp|/var/tmp|/dev/shm|base64|eval|curl|wget|/dev/tcp|(^|[[:space:]])nc[[:space:]]|netcat|bash -i|sh -i'\nSUSP_EXEC='/tmp|/var/tmp|/dev/shm|base64|eval|curl|wget|/dev/tcp|(^|[[:space:]])nc[[:space:]]|netcat|ncat|sh -[ci]|python[0-9.]* -c|socket|subprocess|perl -e'\n\nemit() {\n  jq -cn --arg t \"$1\" --arg p \"$2\" --arg s \"$3\" --argjson l \"$4\" --arg c \"$5\" --arg u \"$6\" '{type:$t, path:$p, sha256:$s, details:{line_number:$l, content_preview:($c | .[0:100]), user:(if ($u|length)==0 then null else $u end)}}' >> \"$TMP\"\n}\n\nsha_of() { sha256sum \"$1\" 2>/dev/null | awk '{print $1}'; }\n\nscan_cron() {\n  local f=$1 user=$2 real sha n=0 line t susp tok\n  real=$(realpath -e \"$f\" 2>/dev/null) || return 0\n  [ -f \"$real\" ] && [ -r \"$real\" ] || return "]
[84.174982, "o", "cat > /app/scan_persistence.sh <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #!/bin/bash\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.176583, "i", "0\n  sha=$(sha_of \"$real\")\n  while IFS= read -r line || [ -n \"$line\" ]; do\n    n=$((n+1))\n    line=${line%$CR}\n    t=${line#\"${line%%[![:space:]]*}\"}\n    case \"$t\" in ''|'#'*) continue ;; esac\n    if [[ $t =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then continue; fi\n    susp=0\n    if printf '%s\\n' \"$t\" | grep -qE \"$SUSP_CRON\"; then susp=1; fi\n    if printf '%s\\n' \"$t\" | grep -qE '^[*][[:space:]]+[*][[:space:]]+[*][[:space:]]+[*][[:space:]]+[*]([[:space:]]|$)'; then susp=1; fi\n    for tok in $t; do\n      case \"$tok\" in\n        /usr/bin/*|/bin/*|/sbin/*|/usr/sbin/*|/etc/*|/) ;;\n        /*) susp=1 ;;\n      esac\n    done\n    if [ \"$susp\" -eq 1 ]; then emit cron_job \"$real\" \"$sha\" \"$n\" \"$t\" \"$user\"; fi\n  done < \"$real\"\n}\n\nscan_unit() {\n  local f=$1 real sha name hidden=0 susp=0 hit prev\n  real=$(realpath -e \"$f\" 2>/dev/null) || return 0\n  [ -f \"$real\" ] && [ -r \"$real\" ] || return 0\n  name=$(basename \"$f\")\n  if [[ $name == .* ]]; then hidden=1; fi\n  sha=$(sha_of \"$real\")\n  hit=$(grep -nE '^[[:space:]]*Exec[A-Za-z]*[[:space:]]"]
[84.176608, "o", "# Read-only scanner for seeded persistence artifacts; writes /app/persistence_report.json\r\n\u001b[?2004l\r\u001b[?2004h> set -u\r\n\u001b[?2004l\r\u001b[?2004h> set -f\r\n\u001b[?2004l\r\u001b[?2004h> shopt -s nullglob\r\n\u001b[?2004l\r\u001b[?2004h> OUT=/app/persistence_report.json\r\n\u001b[?2004l\r\u001b[?2004h> TMP=$(mktemp) || exit 0\r\n\u001b[?2004l\r\u001b[?2004h> trap 'rm -f \"$TMP\"' EXIT\r\n\u001b[?2004l\r\u001b[?2004h> CR=$(printf '\\015')\r\n\u001b[?2004l\r\u001b[?2004h> SUSP_CRON='/tmp|/var/tmp|/dev/shm|base64|eval|curl|wget|/dev/tcp|(^|[[:space:]])nc[[:space:]]|netcat|bash -i|sh -i'\r\n\u001b[?2004l\r\u001b[?2004h> SUSP_EXEC='/tmp|/var/tmp|/dev/shm|base64|eval|curl|wget|/dev/tcp|(^|[[:space:]])nc[[:space:]]|netcat|ncat|sh -[ci]|python[0-9.]* -c|socket|subprocess|perl -e' \r\u001bM\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C"]
[84.176628, "i", "*=' \"$real\" 2>/dev/null | grep -E \"$SUSP_EXEC\" | head -n1)\n  if [ -n \"$hit\" ]; then\n    susp=1\n    prev=${hit#*:}\n  else\n    prev=$(grep -m1 -E '^[[:space:]]*Exec' \"$real\" 2>/dev/null)\n    if [ -z \"$prev\" ]; then prev=$(head -n1 \"$real\" 2>/dev/null); fi\n  fi\n  if [ \"$hidden\" -eq 1 ]; then susp=1; fi\n  if [ \"$susp\" -eq 1 ]; then emit systemd_unit \"$real\" \"$sha\" null \"$prev\" \"\"; fi\n}\n\nscan_rc() {\n  local f=$1 real sha n=0 line t\n  real=$(realpath -e \"$f\" 2>/dev/null) || return 0\n  [ -f \"$real\" ] && [ -r \"$real\" ] || return 0\n  sha=$(sha_of \"$real\")\n  while IFS= read -r line || [ -n \"$line\" ]; do\n    n=$((n+1))\n    line=${line%$CR}\n    t=${line#\"${line%%[![:space:]]*}\"}\n    case \"$t\" in ''|'#'*|'exit 0') continue ;; esac\n    emit rc_local \"$real\" \"$sha\" \"$n\" \"$t\" \"\"\n  done < \"$real\"\n}\n\nscan_ssh() {\n  local f=$1 user=$2 real sha n=0 line t\n  real=$(realpath -e \"$f\" 2>/dev/null) || return 0\n  [ -f \"$real\" ] && [ -r \"$real\" ] || return 0\n  sha=$(sha_of \"$real\")\n  while IFS= read -r line || [ -n \"$line\" ]; do\n    n="]
[84.176634, "o", "\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[K'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> emit() {\r\n\u001b[?2004l\r\u001b[?2004h>   jq -cn --arg t \"$1\" --arg p \"$2\" --arg s \"$3\" --argjson l \"$4\" --arg c \"$5\" --arg u \"$6\" '{type:$t, path:$p, sha256:$s, details:{line_number:$l, content_preview:($c | .[0:100]), user:(if ($u|length)==0 then null else $u end)}}' >> \"$TMP\"\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> sha_of() { sha256sum \"$1\" 2>/dev/null | awk '{print $1}'; }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> scan_cron() {\r\n\u001b[?2004l\r\u001b[?2004h>   local f=$1 user=$2 real sha n=0 line t susp tok\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.176638, "i", "$((n+1))\n    line=${line%$CR}\n    t=${line#\"${line%%[![:space:]]*}\"}\n    case \"$t\" in ''|'#'*) continue ;; esac\n    emit ssh_key \"$real\" \"$sha\" \"$n\" \"$t\" \"$user\"\n  done < \"$real\"\n}\n\nBASES=()\nif [ -d /app_target ]; then BASES+=(/app_target); fi\nBASES+=(\"\")\nfor b in \"${BASES[@]}\"; do\n  scan_cron \"$b/etc/crontab\" \"\"\n  while IFS= read -r f; do scan_cron \"$f\" \"\"; done < <(find -L \"$b/etc/cron.d\" -maxdepth 1 -type f 2>/dev/null | sort)\n  for f in \"$b\"/var/spool/cron/crontabs/*; do\n    if [ -f \"$f\" ]; then scan_cron \"$f\" \"$(basename \"$f\")\"; fi\n  done\n  for d in etc/systemd/system usr/lib/systemd/system run/systemd/system; do\n    while IFS= read -r f; do scan_unit \"$f\"; done < <(find -L \"$b/$d\" -maxdepth 1 -type f 2>/dev/null | sort)\n  done\n  scan_rc \"$b/etc/rc.local\"\n  scan_rc \"$b/etc/rc.d/rc.local\"\n  scan_ssh \"$b/root/.ssh/authorized_keys\" \"root\"\n  for h in \"$b\"/home/*/; do\n    scan_ssh \"${h}.ssh/authorized_keys\" \"$(basename \"$h\")\"\n  done\ndone\n\njq --indent 2 -s '\n  (unique_by([.type, .path, .details.line_number, .d"]
[84.176691, "o", "  real=$(realpath -e \"$f\" 2>/dev/null) || return 0\r\n\u001b[?2004l\r"]
[84.176846, "i", "etails.content_preview]) | sort_by([.type, .path])) as $a\n  | {\n      summary: {\n        total_artifacts: ($a | length),\n        cron_jobs: ([$a[] | select(.type == \"cron_job\")] | length),\n        systemd_units: ([$a[] | select(.type == \"systemd_unit\")] | length),\n        rc_local_modifications: ([$a[] | select(.type == \"rc_local\")] | length),\n        ssh_keys: ([$a[] | select(.type == \"ssh_key\")] | length)\n      },\n      artifacts: $a\n    }' \"$TMP\" > \"$OUT\"\n\nexit 0\nEOF\nchmod +x /app/scan_persistence.sh && bash -n /app/scan_persistence.sh && echo SYNTAX_OK\n"]
