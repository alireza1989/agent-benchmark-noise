[29.027337, "i", "cat > /app/check.py << 'EOF'\nimport csv, json\nfrom kiln_firmware import run_firing_cycle\n\nsched = '/app/firing_schedule.csv'\nspecs = '/app/kiln_specs.json'\nplan = run_firing_cycle(sched, specs)\ns = json.load(open(specs))\nG = s['gas_burner_power_c']; C = s['damper_cooling_c']; A = s['ambient_loss_c']\ntargets = [float(r['target_temp']) for r in csv.DictReader(open(sched))]\nprint('len', len(plan))\nassert all(isinstance(p['gas'], int) and 0 <= p['gas'] <= 5 for p in plan)\nassert all(isinstance(p['damper'], int) and 0 <= p['damper'] <= 5 for p in plan)\nT = targets[0]\ng1 = g2 = 0\nerr = 0.0\ngas = 0\nmaxdrop = 0.0\nfor t, p in enumerate(plan):\n    err += abs(T - targets[t])\n    g = p['gas']; d = p['damper']\n    gas += g\n    geff = 0.1 * g + 0.3 * g1 + 0.6 * g2\n    Tn = T + G * geff - (C * d + A)\n    maxdrop = max(maxdrop, T - Tn)\n    T = Tn\n    g2 = g1; g1 = g\nprint('total_gas', gas, 'limit <2100')\nprint('total_err', round(err, 3), 'limit <400')\nprint('max_drop', round(maxdrop, 3), 'limit <=5')\nEOF\n"]
