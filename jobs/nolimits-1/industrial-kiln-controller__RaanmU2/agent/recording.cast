[57.943815, "i", "cd /app && python3 -c \"import csv,json; from kiln_firmware import run_firing_cycle as r; p=r('/app/firing_schedule.csv','/app/kiln_specs.json'); s=json.load(open('/app/kiln_specs.json')); G=s['gas_burner_power_c'];C=s['damper_cooling_c'];A=s['ambient_loss_c']; tg=[float(x['target_temp']) for x in csv.DictReader(open('/app/firing_schedule.csv'))]; T=tg[0]; g1=g2=0; e_alt=0.0; e_std=0.0\nfor t,q in enumerate(p):\n    g=q['gas'];d=q['damper'];geff=0.1*g+0.3*g1+0.6*g2;Tn=T+G*geff-(C*d+A);e_std+=abs(T-tg[t]);e_alt+=abs(Tn-tg[t]);T=Tn;g2=g1;g1=g\nprint('std',round(e_std,3),'alt',round(e_alt,3))\"\n"]
