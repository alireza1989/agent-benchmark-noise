[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def run_firing_cycle(schedule_path, specs_path):
[?2004l[?2004h>     specs = json.load(open(specs_path))
[?2004l[?2004h>     G = float(specs['gas_burner_power_c'])
[?2004l[?2004h>     C = float(specs['damper_cooling_c'])
[?2004l[?2004h>     A = float(specs['ambient_loss_c'])
[?2004l[?2004h>     with open(schedule_path) as f:
[?2004l[?2004h>         targets = [float(r['target_temp']) for r in csv.DictReader(f)]
[?2004l[?2004h>     N = len(targets)
[?2004l[?2004h>     H = 2
[?2004l[?2004h>     lam = 0.02
[?2004l[?2004h>     actions = [(g, d) for g in range(6) for d in range(6)]
[?2004l[?2004h>     T = targets[0]
[?2004l[?2004h>     g1 = 0
[?2004l[?2004h>     g2 = 0
[?2004l[?2004h>     out = []
[?2004l[?2004h>     for t in range(N):
[?2004l[?2004h>         best_cost = None
[?2004l[?2004h>         best_first = (0, 0)
[?2004l[?2004h>         for seq in itertools.product(actions, repeat=H):
[?2004l[?2004h>             Tc = T
[?2004l[?2004h>             a1 = g1
[?2004l[?2004h>             a2 = g2
[?2004l[?2004h>             cost = 0.0
[?2004l[?2004h>             ok = True
[?2004l[?2004h>             for k, (g, d) in enumerate(seq):
[?2004l[?2004h>                 tt = t + k
[?2004l[?2004h>                 if tt >= N:
[?2004l[?2004h>                     break
[?2004l[?2004h>                 geff = 0.1 * g + 0.3 * a1 + 0.6 * a2
[?2004l[?2004h>                 Tn = Tc + G * geff - (C * d + A)
[?2004l[?2004h>                 if Tn < Tc - 5.0:
[?2004l[?2004h>                     ok = False
[?2004l[?2004h>                     break
[?2004l[?2004h>                 idx = min(tt + 1, N - 1)
[?2004l[?2004h>                 cost += abs(Tn - targets[idx]) + lam * g
[?2004l[?2004h>                 Tc = Tn
[?2004l[?2004h>                 a2 = a1
[?2004l[?2004h>                 a1 = g
[?2004l[?2004h>             if not ok:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             if best_cost is None or cost < best_cost:
[?2004l[?2004h>                 best_cost = cost
[?2004l[?2004h>                 best_first = seq[0]
[?2004l[?2004h>         if best_cost is None:
[?2004l[?2004h>             # fallback: cool as needed without heating
[?2004l[?2004h>             g, d = 0, 0
[?2004l[?2004h>         else:
[?2004l[?2004h>             g, d = best_first
[?2004l[?2004h>         geff = 0.1 * g + 0.3 * g1 + 0.6 * g2
[?2004l[?2004h>         T = T + G * geff - (C * d + A)
[?2004l[?2004h>         out.append({'gas': int(g), 'damper': int(d)})
[?2004l[?2004h>         g2 = g1
[?2004l[?2004h>         g1 = g
[?2004l[?2004h>     return out
