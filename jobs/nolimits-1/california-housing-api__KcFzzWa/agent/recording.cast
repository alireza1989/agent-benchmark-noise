[97.33226, "i", "cat > /app/api/app.py << 'EOF'\nimport json\nimport pickle\nfrom typing import List\n\nimport pandas as pd\nfrom fastapi import FastAPI, HTTPException\nfrom pydantic import BaseModel\n\nFEATURES = ['MedInc', 'HouseAge', 'AveRooms', 'AveBedrms', 'Population', 'AveOccup', 'Latitude', 'Longitude']\nMODEL_PATH = '/app/models/best_model.pkl'\nCOMPARISON_PATH = '/app/output/model_comparison.json'\n\nwith open(MODEL_PATH, 'rb') as f:\n    model = pickle.load(f)\nwith open(COMPARISON_PATH) as f:\n    MODEL_NAME = json.load(f)['best_model_name']\nMODEL_TYPE = type(model).__name__\n\napp = FastAPI(title='California Housing Price Prediction')\n\n\nclass PredictRequest(BaseModel):\n    features: List[float]\n\n\nclass BatchPredictRequest(BaseModel):\n    features_list: List[List[float]]\n\n\ndef to_frame(rows):\n    for r in rows:\n        if len(r) != len(FEATURES):\n            raise HTTPException(status_code=422, detail='Each sample must have exactly 8 features')\n    return pd.DataFrame(rows, columns=FEATURES)\n\n\n@app.get('/health')\ndef health():\n    "]
[97.332767, "o", "cat > /app/api/app.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.333707, "i", "return {'status': 'healthy', 'model_loaded': model is not None}\n\n\n@app.get('/model-info')\ndef model_info():\n    return {'model_name': MODEL_NAME, 'model_type': MODEL_TYPE, 'features_count': len(FEATURES)}\n\n\n@app.post('/predict')\ndef predict(req: PredictRequest):\n    X = to_frame([req.features])\n    pred = model.predict(X)\n    return {'prediction': float(pred[0]), 'model_name': MODEL_NAME}\n\n\n@app.post('/predict-batch')\ndef predict_batch(req: BatchPredictRequest):\n    X = to_frame(req.features_list)\n    preds = model.predict(X)\n    return {'predictions': [float(p) for p in preds], 'model_name': MODEL_NAME, 'count': len(preds)}\nEOF\ncd /app && nohup python3 -m uvicorn api.app:app --host 0.0.0.0 --port 8000 > /app/output/server.log 2>&1 &\nsleep 20 && curl -s http://localhost:8000/health && echo && curl -s http://localhost:8000/model-info && echo\n"]
[97.333727, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> import pickle\r\n\u001b[?2004l\r\u001b[?2004h> from typing import List\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> "]
