[134.982138, "i", "cat > /app/api_test.py << 'EOF'\nimport json\nimport numpy as np\nimport pandas as pd\nimport pickle\nimport requests\nfrom sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n\nFEATURES = ['MedInc', 'HouseAge', 'AveRooms', 'AveBedrms', 'Population', 'AveOccup', 'Latitude', 'Longitude']\ndf = pd.read_csv('/app/data/train.csv').reset_index(drop=True)\nsplit = json.load(open('/app/output/split_info.json'))\nval_idx = split['validation_indices']\nval = df.loc[val_idx]\nX_val = val[FEATURES]\ny_true = val['target'].values\n\nrows = []\nfor i, (_, row) in enumerate(X_val.iterrows()):\n    r = requests.post('http://localhost:8000/predict', json={'features': [float(v) for v in row.values]})\n    r.raise_for_status()\n    rows.append({'sample_index': i, 'y_true': float(y_true[i]), 'y_pred': r.json()['prediction']})\n\nout = pd.DataFrame(rows)\nout['absolute_error'] = (out['y_true'] - out['y_pred']).abs()\nout.to_csv('/app/output/api_predictions.csv', index=False)\n\ny_pred = out['y_pred'].values\nmse = float(mean_squared_"]
[134.982177, "i", "error(y_true, y_pred))\nmetrics = {\n    'sample_count': int(len(out)),\n    'mae': float(mean_absolute_error(y_true, y_pred)),\n    'mse': mse,\n    'rmse': float(np.sqrt(mse)),\n    'r2_score': float(r2_score(y_true, y_pred)),\n}\nwith open('/app/output/api_metrics.json', 'w') as f:\n    json.dump(metrics, f, indent=2)\nprint(metrics)\n\nmodel = pickle.load(open('/app/models/best_model.pkl', 'rb'))\ndirect = model.predict(X_val)\nprint('max abs diff vs direct:', float(np.max(np.abs(direct - y_pred))))\nEOF\ncd /app && python3 api_test.py && head -3 /app/output/api_predictions.csv && python3 -c \"import json; json.load(open('/app/output/api_metrics.json')); json.load(open('/app/output/split_info.json')); json.load(open('/app/output/model_comparison.json')); print('json ok')\"\n"]
