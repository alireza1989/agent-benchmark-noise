[?2004l[?2004h>   "restarts": ${restarts},
[?2004l[?2004h>   "errors": ${errors},
[?2004l[?2004h>   "restart_loop_detected": ${loop},
[?2004l[?2004h>   "timestamp": "${TS}"
[?2004l[?2004h> }
[?2004l[?2004h> JSON
[?2004l[?2004h> EOF
