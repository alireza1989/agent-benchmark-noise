[?2004l[?2004h> #!/bin/bash
[?2004l[?2004h> # Analyze the myapp journal for the last 5 minutes and emit a JSON report.
[?2004l[?2004h> SERVICE="myapp"
[?2004l[?2004h> WINDOW_MIN=5
[?2004l[?2004h> RESTART_THRESHOLD=3
[?2004l[?2004h> 
[?2004l[?2004h> JOURNAL=$(journalctl -u "$SERVICE" --since "${WINDOW_MIN} minutes ago" -o cat --no-pager 2>/dev/null || true)
[?2004l[?2004h> 
[?2004l[?2004h> restarts=$(printf '%s\n' "$JOURNAL" | grep -c "Started ${SERVICE}.service" || true)
[?2004l[?2004h> errors=$(printf '%s\n' "$JOURNAL" | grep -c 'ERROR' || true)
[?2004l[?2004h> restarts=${restarts:-0}
[?2004l[?2004h> errors=${errors:-0}
[?2004l[?2004h> 
[?2004l[?2004h> if [ "$restarts" -gt "$RESTART_THRESHOLD" ]; then
[?2004l[?2004h>     loop=true
[?2004l[?2004h> else
[?2004l[?2004h>     loop=false
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
[?2004l[?2004h> 
