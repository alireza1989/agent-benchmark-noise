[?2004hroot@2778ee03006e:/opt/myapp# cat > /opt/myapp/app.py <<'EOF'
[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> """Simple application that logs JSON-formatted events to stdout."""
[?2004l[?2004h> import argparse
[?2004l[?2004h> import datetime
[?2004l[?2004h> import json
[?2004l[?2004h> import logging
[?2004l[?2004h> import sys
[?2004l[?2004h> import time
[?2004l[?2004h> 
[?2004l[?2004h> logging.addLevelName(logging.WARNING, "WARN")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> class JsonFormatter(logging.Formatter):
[?2004l[?2004h>     def format(self, record):
[?2004l[?2004h>         ts = datetime.datetime.fromtimestamp(record.created, datetime.timezone.utc)
[?2004l[?2004h>         payload = {
[?2004l[?2004h>             "timestamp": ts.strftime("%Y-%m-%dT%H:%M:%SZ"),
[?2004l[?2004h>             "level": record.levelname,
[?2004l[?2004h>             "message": record.getMessage(),
[?2004l[?2004h>             "service": "myapp",
[?2004l[?2004h>         }
[?2004l[?2004h>         return json.dumps(payload, separators=(",", ":"))
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     parser = argparse.ArgumentParser(description="myapp JSON event logger")
[?2004l[?2004h>     parser.add_argument("--log-level", default="INFO", choices=["INFO", "WARN", "ERROR"])
[?2004l[?2004h>     parser.add_argument("--interval", type=float, default=5.0, help="seconds between events")
[?2004l[?2004h>     args = parser.parse_args()
[?2004l[?2004h> 
[?2004l[?2004h>     handler = logging.StreamHandler(sys.stdout)
[?2004l[?2004h>     handler.setFormatter(JsonFormatter())
[?2004l[?2004h>     logger = logging.getLogger("myapp")
[?2004l[?2004h>     logger.handlers = [handler]
[?2004l[?2004h>     logger.propagate = False
[?2004l[?2004h>     logger.setLevel(getattr(logging, args.log_level))
[?2004l[?2004h> 
[?2004l[?2004h>     logger.info("Service started")
[?2004l[?2004h>     counter = 0
[?2004l[?2004h>     try:
[?2004l[?2004h>         while True:
[?2004l[?2004h>             time.sleep(args.interval)
[?2004l[?2004h>             counter += 1
[?2004l[?2004h>             logger.info("Heartbeat event %d", counter)
[?2004l[?2004h>             if counter % 3 == 0:
[?2004l[?2004h>                 logger.warning("Queue depth above normal threshold")
[?2004l[?2004h>             if counter % 5 == 0:
[?2004l[?2004h>                 logger.error("Simulated processing failure on event %d", counter)
[?2004l[?2004h>     except KeyboardInterrupt:
[?2004l[?2004h>         pass
[?2004l[?2004h>     logger.info("Service stopping")
[?2004l[?2004h>     return 0
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == "__main__":
[?2004l[?2004h>     sys.exit(main())
[?2004l[?2004h> EOF
