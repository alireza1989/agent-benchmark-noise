[55.933865, "i", "cat > /etc/rsyslog.d/50-myapp.conf <<'EOF'\n# Route myapp JSON events from journald into structured files\n$FileOwner myapp\n$FileGroup myapp\n$FileCreateMode 0644\n\nif $programname == 'myapp' and $msg contains '\"level\":\"ERROR\"' then /var/log/app_errors.log\nif $programname == 'myapp' then /var/log/app_events.log\nEOF\ncat /etc/rsyslog.d/50-myapp.conf; which rsyslogd journalctl systemctl ps 2>&1; (rsyslogd -N1 2>&1 | tail -n 5) || echo 'rsyslogd not available for validation'\n"]
