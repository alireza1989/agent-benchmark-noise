[28.287665, "i", "cat > /etc/systemd/system/myapp.service <<'EOF'\n[Unit]\nDescription=myapp JSON event logging service\nAfter=network.target systemd-journald.service\n\n[Service]\nType=simple\nUser=myapp\nGroup=myapp\nWorkingDirectory=/opt/myapp\nExecStart=/opt/myapp/app.py --log-level=INFO\nRestart=on-failure\nRestartSec=2\nSyslogIdentifier=myapp\nEnvironment=PYTHONUNBUFFERED=1\nEnvironment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\nStandardOutput=journal\nStandardError=journal\n\n[Install]\nWantedBy=multi-user.target\nEOF\ncat /etc/systemd/system/myapp.service | head -3\n"]
