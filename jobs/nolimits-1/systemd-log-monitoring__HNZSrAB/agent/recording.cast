[28.295857, "o", "[Unit]\r\nDescription=myapp JSON event logging service\r\nAfter=network.target systemd-journald.service\r\n"]
[28.295976, "o", "\u001b[?2004hroot@2778ee03006e:/opt/myapp# "]
[28.776333, "i", "cat > /etc/rsyslog.d/50-myapp.conf <<'EOF'\n# Route myapp JSON events from journald into structured files\n$FileOwner myapp\n$FileGroup myapp\n$FileCreateMode 0644\n\nif $programname == 'myapp' and $msg contains '\"level\":\"ERROR\"' then /var/log/app_errors.log\nif $programname == 'myapp' then /var/log/app_events.log\n& stop\nEOF\ntouch /var/log/app_events.log /var/log/app_errors.log; chown myapp:myapp /var/log/app_events.log /var/log/app_errors.log; chmod 644 /var/log/app_events.log /var/log/app_errors.log; ls -l /var/log/app_*.log\n"]
[28.776581, "o", "cat > /etc/rsyslog.d/50-myapp.conf <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.776995, "o", "# Route myapp JSON events from journald into structured files\r\n\u001b[?2004l\r\u001b[?2004h> $FileOwner myapp\r\n\u001b[?2004l\r\u001b[?2004h> $FileGroup myapp\r\n\u001b[?2004l\r\u001b[?2004h> $FileCreateMode 0644\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if $programname == 'myapp' and $msg contains '\"level\":\"ERROR\"' then /var/log/app_errors.log\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.777071, "o", "if $programname == 'myapp' then /var/log/app_events.log\r\n\u001b[?2004l\r"]
[28.777282, "o", "\u001b[?2004h> & stop\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[28.781154, "o", "\u001b[?2004hroot@2778ee03006e:/opt/myapp# "]
