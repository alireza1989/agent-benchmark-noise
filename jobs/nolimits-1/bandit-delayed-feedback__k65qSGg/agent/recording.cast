[13.986617, "i", "cd /app && python3 -c \"import pandas as pd, numpy as np; imp=pd.read_csv('data/impressions.csv'); conv=pd.read_csv('data/conversions.csv'); ctx=pd.read_csv('data/test_contexts.csv'); print(imp.timestamp.min(), imp.timestamp.max(), ctx.timestamp.min(), ctx.timestamp.max()); print(conv.delay_hours.describe()); ld=np.log(conv.delay_hours); print('log mu', ld.mean(), 'log sd', ld.std(ddof=0), 'sd ddof1', ld.std()); print(conv.conversion_value.describe()); print('dup conv ids', conv.impression_id.duplicated().sum(), 'unmatched', (~conv.impression_id.isin(imp.impression_id)).sum()); m=imp.merge(conv, on='impression_id', how='left'); g=m.groupby('arm_id').agg(n=('impression_id','size'), c=('delay_hours', lambda s: s.notna().sum()), v=('conversion_value','mean')); print(g); print(imp.arm_id.value_counts().sort_index().values); print(imp.user_segment.value_counts(), imp.device_type.value_counts())\"\n"]
[13.988945, "o", "cd /app && python3 -c \"import pandas as pd, numpy as np; imp=pd.read_csv('data/impressions.csv'); conv=pd.read_csv('data/conversions.csv'); ctx=pd.read_csv('data/test_contexts.csv'); print(imp.timestamp.min(), imp.timestamp.max(), ctx.timestamp.min(), ctx.timestamp.max()); print(conv.delay_hours.describe()); ld=np.log(conv.delay_hours); print('log mu', ld.mean(), 'log sd', ld.std(ddof=0), 'sd ddof1', ld.std()); print(conv.conversion_value.describe()); print('dup conv ids', conv.impression_id.duplicated().sum(), 'unmatched', (~conv.impression_id.isin(imp.impression_id)).sum()); m=imp.merge(conv, on='impression_id', how='left'); g=m.groupby('arm_id').agg(n=('impression_id','size'), c=('delay_hours', lambda s: s.notna().sum()), v=('conversion_value','mean')); print(g); print(imp.arm_id.value_counts().sort_index().values); print(imp.user_segment.value_counts(), imp.device_type.value_counts())\"\r\n"]
