[?2004hroot@98339942150e:/app# cat > /app/solve.py << 'EOF'
[?2004l[?2004h> import pandas as pd, numpy as np, json
[?2004l[?2004h> from scipy.stats import norm, gamma
[?2004l[?2004h> imp = pd.read_csv('data/impressions.csv')
[?2004l[?2004h> conv = pd.read_csv('data/conversions.csv')
[?2004l[?2004h> ctx = pd.read_csv('data/test_contexts.csv')
[?2004l[?2004h> arms = json.load(open('data/arms_metadata.json'))['arms']
[?2004l[?2004h> lnd = np.log(conv.delay_hours.values)
[?2004l[?2004h> mu = lnd.mean()
[?2004l[?2004h> sig = lnd.std(ddof=0)
[?2004l[?2004h> T = imp.timestamp.max()
[?2004l[?2004h> m = imp.merge(conv[['impression_id', 'conversion_value', 'delay_hours']], on='impression_id', how='left')
[?2004l[?2004h> m['conv'] = m.delay_hours.notna().astype(int)
[?2004l[?2004h> m['v'] = m.conversion_value.fillna(0.0)
[?2004l[?2004h> age = np.clip((T - m.timestamp.values) / 3600.0, 1e-9, None)
[?2004l[?2004h> F = norm.cdf((np.log(age) - mu) / sig)
[?2004l[?2004h> m['F'] = np.where(age >= 72, 1.0, F)
[?2004l[?2004h> K = 100.0
[?2004l[?2004h> OVERALL = m.conv.sum() / m.F.sum()
[?2004l[?2004h> g = m.groupby('arm_id').agg(n=('conv', 'size'), c=('conv', 'sum'), E=('F', 'sum'))
[?2004l[?2004h> g['rate'] = (g.c + K * OVERALL) / (g.E + K)
[?2004l[?2004h> val = conv.merge(imp[['impression_id', 'arm_id']], on='impression_id').groupby('arm_id').conversion_value.mean()
[?2004l[?2004h> g['val'] = val
[?2004l[?2004h> m['cell'] = list(zip(m.arm_id, m.user_segment, m.device_type))
[?2004l[?2004h> cell = m.groupby('cell').agg(c=('conv', 'sum'), E=('F', 'sum'))
[?2004l[?2004h> def cell_stats(arm, seg, dev):
[?2004l[?2004h>     r = g.loc[arm, 'rate']
[?2004l[?2004h>     key = (arm, seg, dev)
[?2004l[?2004h>     if key in cell.index:
[?2004l[?2004h>         c = cell.loc[key, 'c']; E = cell.loc[key, 'E']
[?2004l[?2004h>     else:
[?2004l[?2004h>         c = 0.0; E = 0.0
[?2004l[?2004h>     a = c + K * r
[?2004l[?2004h>     b = E + K
[?2004l[?2004h>     rate = a / b
[?2004l[?2004h>     lo = gamma.ppf(0.1, a, scale=1.0 / b)
[?2004l[?2004h>     hi = gamma.ppf(0.9, a + 1.0, scale=1.0 / b)
[?2004l[?2004h>     return rate, lo, hi
[?2004l[?2004h> rows = []
[?2004l[?2004h> for _, row in ctx.iterrows():
[?2004l[?2004h>     best = None
[?2004l[?2004h>     for arm in range(10):
[?2004l[?2004h>         rate, lo, hi = cell_stats(arm, row.user_segment, row.device_type)
[?2004l[?2004h>         v = g.loc[arm, 'val']
[?2004l[?2004h>         ev = rate * v
[?2004l[?2004h>         if best is None or ev > best[1]:
[?2004l[?2004h>             best = (arm, ev, lo * v, hi * v)
[?2004l[?2004h>     arm, ev, lo, hi = best
[?2004l[?2004h>     lo = min(lo, ev); hi = max(hi, ev)
[?2004l[?2004h>     rows.append((row.context_id, int(arm), float(ev), float(max(lo, 0.0)), float(hi)))
[?2004l[?2004h> pred = pd.DataFrame(rows, columns=['context_id', 'selected_arm', 'expected_reward', 'confidence_lower', 'confidence_upper'])
[?2004l[?2004h> pred.to_csv('output/predictions.csv', index=False)
[?2004l[?2004h> stats = pd.DataFrame({'arm_id': g.index, 'estimated_conversion_rate': g.rate.values, 'estimated_avg_value': g.val.values, 'total_impressions': g.n.values, 'total_conversions': conv.merge(imp[['impression_id', 'arm_id']], on='impression_id').groupby('arm_id').size().reindex(g.index).values})
[?2004l[?2004h> stats.to_csv('output/arm_statistics.csv', index=False)
[?2004l[?2004h> med = float(np.exp(mu))
[?2004l[?2004h> p90 = float(np.exp(mu + norm.ppf(0.9) * sig))
[?2004l[?2004h> out = {'distribution_type': 'lognormal', 'parameters': {'mu': float(mu), 'sigma': float(sig)}, 'median_delay_hours': med, 'p90_delay_hours': p90, 'conversion_rate_estimate': float(OVERALL)}
[?2004l[?2004h> json.dump(out, open('output/delay_model.json', 'w'), indent=2)
[?2004l[?2004h> print(out)
[?2004l[?2004h> print(pred.describe())
[?2004l[?2004h> print(pred.selected_arm.value_counts().sort_index())
[?2004l[?2004h> print(stats)
