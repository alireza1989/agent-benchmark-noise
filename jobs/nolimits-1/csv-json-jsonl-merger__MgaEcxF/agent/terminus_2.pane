[?2004hroot@541564ba62bd:/workspace# cat > /workspace/do_merge.py << 'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> records = {}
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def norm(v):
[?2004l[?2004h>     if v is None or (isinstance(v, float) and pd.isna(v)):
[?2004l[?2004h>         return ''
[?2004l[?2004h>     return str(v).strip()
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def add(email, phone, status):
[?2004l[?2004h>     email = norm(email).lower()
[?2004l[?2004h>     if not email:
[?2004l[?2004h>         return
[?2004l[?2004h>     phone = norm(phone)
[?2004l[?2004h>     status = norm(status)
[?2004l[?2004h>     cur = records.setdefault(email, {'email': email, 'phone': '', 'status': ''})
[?2004l[?2004h>     if not cur['phone'] and phone:
[?2004l[?2004h>         cur['phone'] = phone
[?2004l[?2004h>     if not cur['status'] and status:
[?2004l[?2004h>         cur['status'] = status
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> # users.csv
[?2004l[?2004h> users = pd.read_csv('/workspace/users.csv', dtype=str, keep_default_na=False)
[?2004l[?2004h> for rec in users.to_dict('records'):
[?2004l[?2004h>     add(rec.get('email'), rec.get('phone'), rec.get('status'))
[?2004l[?2004h> 
[?2004l[?2004h> # records.jsonl
[?2004l[?2004h> with open('/workspace/records.jsonl', encoding='utf-8') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         if line.strip():
[?2004l[?2004h>             rec = json.loads(line)
[?2004l[?2004h>             add(rec.get('email'), rec.get('phone'), rec.get('status'))
[?2004l[?2004h> 
[?2004l[?2004h> # profiles.json (dict keyed by email, phone nested in other_info)
[?2004l[?2004h> with open('/workspace/profiles.json', encoding='utf-8') as f:
[?2004l[?2004h>     profiles = json.load(f)
[?2004l[?2004h> if isinstance(profiles, dict):
[?2004l[?2004h>     items = list(profiles.items())
[?2004l[?2004h> else:
[?2004l[?2004h>     items = [(None, p) for p in profiles]
[?2004l[?2004h> for key, rec in items:
[?2004l[?2004h>     other = rec.get('other_info') or {}
[?2004l[?2004h>     phone = rec.get('phone') or other.get('phone')
[?2004l[?2004h>     add(rec.get('email') or key, phone, rec.get('status'))
[?2004l[?2004h> 
[?2004l[?2004h> out = pd.DataFrame(list(records.values()), columns=['email', 'phone', 'status'])
[?2004l[?2004h> out.to_csv('/workspace/merged_records.csv', index=False)
[?2004l[?2004h> print('wrote', len(out), 'unique emails')
[?2004l[?2004h> EOF
