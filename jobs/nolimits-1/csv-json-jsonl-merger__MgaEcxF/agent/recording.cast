[11.739831, "o", "\u001b[?2004hroot@541564ba62bd:/workspace# "]
[21.895599, "i", "cat > /workspace/do_merge.py << 'EOF'\nimport json\nimport pandas as pd\n\nrecords = {}\n\n\ndef norm(v):\n    if v is None or (isinstance(v, float) and pd.isna(v)):\n        return ''\n    return str(v).strip()\n\n\ndef add(email, phone, status):\n    email = norm(email).lower()\n    if not email:\n        return\n    phone = norm(phone)\n    status = norm(status)\n    cur = records.setdefault(email, {'email': email, 'phone': '', 'status': ''})\n    if not cur['phone'] and phone:\n        cur['phone'] = phone\n    if not cur['status'] and status:\n        cur['status'] = status\n\n\n# users.csv\nusers = pd.read_csv('/workspace/users.csv', dtype=str, keep_default_na=False)\nfor rec in users.to_dict('records'):\n    add(rec.get('email'), rec.get('phone'), rec.get('status'))\n\n# records.jsonl\nwith open('/workspace/records.jsonl', encoding='utf-8') as f:\n    for line in f:\n        if line.strip():\n            rec = json.loads(line)\n            add(rec.get('email'), rec.get('phone'), rec.get('status'))\n\n# profiles.json (dict keyed by email, phone nested in other_info)\nwith open('/workspace/profiles.json', encoding='utf-8') as f:\n    profiles = json.load(f)\nif isinstance(profiles, dict):\n    items = list(profiles.items())\nelse:\n    items = [(None, p) for p in profiles]\nfor key, rec in items:\n    other = rec.get('other_info') or {}\n    phone = rec.get('phone') or other.get('phone')\n    add(rec.get('email') or key, phone, rec.get('status'))\n\nout = pd.DataFrame(list(records.values()), columns=['email', 'phone', 'status'])\nout.to_csv('/workspace/merged_records.csv', index=False)\nprint('wrote', len(out), 'unique emails')\nEOF\n"]
