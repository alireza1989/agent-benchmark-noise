[11.382201, "i", "python3 -c \"import json,collections,pandas as pd; r=[json.loads(l) for l in open('/workspace/records.jsonl') if l.strip()]; print('records',len(r)); print(collections.Counter(tuple(sorted(x.keys())) for x in r)); p=json.load(open('/workspace/profiles.json')); print('profiles',type(p).__name__,len(p)); v=list(p.values()); print(collections.Counter(tuple(sorted(x.keys())) for x in v)); print(collections.Counter(tuple(sorted(x.get('other_info',{}).keys())) for x in v)); u=pd.read_csv('/workspace/users.csv',dtype=str); print('users',u.shape, list(u.columns)); print(u.isna().sum().to_dict())\"\n"]
[11.384036, "o", "python3 -c \"import json,collections,pandas as pd; r=[json.loads(l) for l in open('/workspace/records.jsonl') if l.strip()]; print('records',len(r)); print(collections.Counter(tuple(sorted(x.keys())) for x in r)); p=json.load(open('/workspace/profiles.json')); print('profiles',type(p).__name__,len(p)); v=list(p.values()); print(collections.Counter(tuple(sorted(x.keys())) for x in v)); print(collections.Counter(tuple(sorted(x.get('other_info',{}).keys())) for x in v)); u=pd.read_csv('/workspace/users.csv',dtype=str); print('users',u.shape, list(u.columns)); print(u.isna().sum().to_dict())\"\r\n\u001b[?2004l\r"]
