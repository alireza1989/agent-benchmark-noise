[68.045775, "o", "        ca, cb = comp_of[a], comp_of[b]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.045859, "o", "        if ca != cb and cb not in cadj[ca]:\r\n\u001b[?2004l\r\u001b[?2004h>             cadj[ca].add(cb)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.045878, "o", "            indeg[cb] += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.045939, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.046013, "o", "    members = [sorted(c) for c in comps]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.046033, "o", "    first = [min(idx[n] for n in c) for c in comps]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.046134, "o", "    rep = [m[0] for m in members]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.046201, "o", "    queue = sorted([i for i in range(len(comps)) if indeg[i] == 0],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.046293, "o", "                   key=lambda i: first[i])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.04635, "o", "    order = []\r\n\u001b[?2004l\r\u001b[?2004h>     while queue:\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.046371, "o", "> "]
[68.046375, "o", "        i = queue.pop(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.046424, "o", "> "]
[68.046462, "o", "        order.extend(members[i])\r\n\u001b[?2004l\r"]
[68.046482, "o", "\u001b[?2004h>         newly = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.046638, "o", "        for j in cadj[i]:\r\n\u001b[?2004l\r"]
[68.046658, "o", "\u001b[?2004h> "]
[68.046739, "o", "            indeg[j] -= 1\r\n\u001b[?2004l\r\u001b[?2004h>             if indeg[j] == 0:\r\n\u001b[?2004l\r"]
[68.046767, "o", "\u001b[?2004h> "]
[68.046824, "o", "                newly.append(j)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.046864, "o", "        queue.extend(newly)\r\n\u001b[?2004l\r"]
[68.046907, "o", "\u001b[?2004h> "]
[68.046992, "o", "        queue.sort(key=lambda k: rep[k])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.047091, "o", "    return json.dumps({'order': order, 'cycles': cycles}, separators=(',', ':'))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
