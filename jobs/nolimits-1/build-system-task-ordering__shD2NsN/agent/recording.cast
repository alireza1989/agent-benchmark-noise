[68.029778, "i", "cat > /app/solution.py << 'EOF'\nimport json\nimport sys\n\n\ndef solve(lines):\n    sys.setrecursionlimit(100000)\n    ALLOWED = {'Depends', 'Before', 'After', 'Needs', 'Requires', 'Alias', 'Phony'}\n    blocks = []\n    cur = None\n    for raw in lines:\n        line = raw.strip()\n        if not line or line.startswith('#'):\n            continue\n        if line.startswith('[') and line.endswith(']'):\n            continue\n        tok = line.split()\n        if tok[0] == 'TARGET':\n            if len(tok) != 2:\n                return 'PARSE_ERROR'\n            cur = {'kind': 'T', 'name': tok[1], 'id': '', 'dirs': []}\n            blocks.append(cur)\n        elif tok[0] == 'OVERRIDE':\n            if len(tok) != 3:\n                return 'PARSE_ERROR'\n            cur = {'kind': 'O', 'name': tok[1], 'id': tok[2], 'dirs': []}\n            blocks.append(cur)\n        elif '=' in line:\n            if line.count('=') != 1 or cur is None:\n                return 'PARSE_ERROR'\n            k, v = line.split('=', 1)\n            k = k.stri"]
