[26.714774, "o", "    \"\"\"Returns ALL unique Type1 and Type2 values in the storage system.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.714857, "o", "        'type1_values': sorted(all_type1_values),\r\n\u001b[?2004l\r\u001b[?2004h> "]
