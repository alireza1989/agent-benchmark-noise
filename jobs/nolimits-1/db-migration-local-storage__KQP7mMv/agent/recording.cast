[26.708722, "o", "            groups.setdefault((clean['Type1'], clean['Type2']), []).append(clean)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.708812, "o", "            all_type1_values.add(clean['Type1'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.708916, "o", "            all_type2_values.add(clean['Type2'])\r\n\u001b[?2004l\r\u001b[?2004h>             total_records += 1\r\n"]
[26.708935, "o", "\u001b[?2004l\r"]
[26.709082, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     for idx, combo in enumerate(sorted(groups.keys())):\r\n\u001b[?2004l\r"]
[26.709107, "o", "\u001b[?2004h> "]
[26.709245, "o", "        rows = sorted(groups[combo], key=lambda r: r['ID'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.709311, "o", "> "]
[26.709411, "o", "        path = os.path.join(CHUNK_DIR, f'chunk_{idx:03d}.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.709482, "o", "        with open(path, 'w', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.709597, "o", "            writer = csv.DictWriter(f, fieldnames=FIELDNAMES)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.709662, "o", "            writer.writeheader()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.709689, "o", "            writer.writerows(rows)\r\n\u001b[?2004l\r"]
[26.709733, "o", "\u001b[?2004h> "]
[26.709999, "o", "        chunk_index[combo] = path\r\n\u001b[?2004l\r"]
[26.710029, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     print(f'Wrote {len(chunk_index)} chunks for {total_records} records into {CHUNK_DIR}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[26.710133, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @app.on_event('startup')\r\n\u001b[?2004l\r"]
[26.710175, "o", "\u001b[?2004h> async def startup_event():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.710282, "o", "    build_chunks()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[26.710336, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.710472, "o", "@app.get('/')\r\n\u001b[?2004l\r"]
[26.71053, "o", "\u001b[?2004h> async def root():\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Health check endpoint\"\"\""]
[26.710596, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.710724, "o", "    return {'status': 'healthy', 'message': 'Service is running'}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[26.710819, "o", "> @app.get('/query')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.710949, "o", "async def query_records(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.711051, "o", "    type1: str = Query(..., description='Type1 value to filter by'),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.71117, "o", "    type2: str = Query(..., description='Type2 value to filter by')\r\n\u001b[?2004l\r\u001b[?2004h> ) -> List[Record]:\r\n\u001b[?2004l\r"]
[26.711205, "o", "\u001b[?2004h"]
[26.711301, "o", "> "]
[26.711393, "o", "    \"\"\"Query records by Type1 and Type2. Loads only the matching chunk.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.711521, "o", "    global last_loaded_type1_values, last_loaded_type2_values\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.711632, "o", "    if not type1 or not type2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.711836, "o", "        raise HTTPException(status_code=400, detail='Both type1 and type2 are required')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.711949, "o", "    last_loaded_type1_values = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.712067, "o", "    last_loaded_type2_values = set()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.712234, "o", "    path = chunk_index.get((type1, type2))\r\n\u001b[?2004l\r\u001b[?2004h>     if path is None:\r\n\u001b[?2004l\r\u001b[?2004h>         return []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[26.712354, "o", "\u001b[?2004h"]
[26.712394, "o", ">     results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.712534, "o", "    with open(path, 'r', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         reader = csv.DictReader(f)\r\n\u001b[?2004l\r"]
[26.71267, "o", "\u001b[?2004h>         for row in reader:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.712795, "o", "            results.append(Record(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.712962, "o", "                Type1=row['Type1'],\r\n\u001b[?2004l\r\u001b[?2004h>                 Type2=row['Type2'],\r\n\u001b[?2004l\r"]
[26.713033, "o", "\u001b[?2004h> "]
[26.713108, "o", "                Text=row['Text'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.713154, "o", "                ID=int(row['ID']),\r\n\u001b[?2004l\r\u001b[?2004h>             ))\r\n\u001b[?2004l\r"]
[26.713208, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[26.713284, "o", "\u001b[?2004h>     for r in results:\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.713316, "o", "> "]
[26.713455, "o", "        last_loaded_type1_values.add(r.Type1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.713565, "o", "        last_loaded_type2_values.add(r.Type2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.713667, "o", "    return results\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.71374, "o", "@app.get('/get_all_loaded_types_and_subtypes')\r\n\u001b[?2004l\r"]
[26.71385, "o", "\u001b[?2004h> "]
[26.713933, "o", "async def get_all_loaded_types_and_subtypes() -> dict:\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.714015, "o", "> "]
[26.714173, "o", "    \"\"\"Returns the Type1/Type2 values loaded by the most recent query.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.714235, "o", "        'type1_values': sorted(last_loaded_type1_values),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.714352, "o", "        'type2_values': sorted(last_loaded_type2_values),\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[26.714476, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
