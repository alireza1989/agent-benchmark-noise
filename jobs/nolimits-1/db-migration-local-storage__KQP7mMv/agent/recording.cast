[38.155648, "i", "python3 - << 'EOF'\nimport json, time, urllib.request\nB = 'http://localhost:8000'\ndef get(p):\n    t = time.time()\n    with urllib.request.urlopen(B + p) as r:\n        d = json.loads(r.read())\n    return d, time.time() - t\nprint(get('/')[0])\nprint(get('/stats')[0])\nr, dt = get('/query?type1=electronics&type2=laptops')\nprint(len(r), 'records in', round(dt, 4), 's')\nprint(r[0])\nprint(get('/get_all_loaded_types_and_subtypes')[0])\nr, _ = get('/query?type1=toys&type2=dolls')\nprint(len(r), r[0]['Type1'], r[0]['Type2'])\nprint(get('/get_all_loaded_types_and_subtypes')[0])\ntotal = 0\nfor a in ['electronics','furniture','clothing','food','books','sports','toys','automotive','home','beauty']:\n    pass\nimport csv\nwith open('/app/data.csv') as f:\n    combos = {(row['Type1'], row['Type2']) for row in csv.DictReader(f)}\nfor t1, t2 in combos:\n    rr, _ = get('/query?type1=%s&type2=%s' % (t1, t2))\n    total += len(rr)\nprint('combos', len(combos), 'total records via queries', total)\nEOF\nls /app/chunks | head -3; head -3 /app/chunks/chunk_000.csv\n"]
[38.15641, "o", "python3 - << 'EOF'\r\n\u001b[?2004l\r"]
