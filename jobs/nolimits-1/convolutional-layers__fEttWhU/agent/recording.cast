[25.295007, "i", "cat > /app/src/normalization.py << 'EOF'\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass BatchNorm2D(BaseLayer):\n    def __init__(self, num_features, eps=1e-5, momentum=0.1):\n        super().__init__()\n        self.num_features = int(num_features)\n        self.eps = eps\n        self.momentum = momentum\n        self.gamma = np.ones((num_features,), dtype=np.float64)\n        self.beta = np.zeros((num_features,), dtype=np.float64)\n        self.running_mean = np.zeros((num_features,), dtype=np.float64)\n        self.running_var = np.ones((num_features,), dtype=np.float64)\n\n    def forward(self, x, training=True):\n        x = np.asarray(x, dtype=np.float64)\n        if training:\n            axes = (0, 1, 2)\n            mean = x.mean(axis=axes)\n            var = x.var(axis=axes)\n            self.running_mean = (1 - self.momentum) * self.running_mean + self.momentum * mean\n            self.running_var = (1 - self.momentum) * self.running_var + self.momentum * var\n        else:\n            mean = self.running_me"]
[25.295183, "i", "an\n            var = self.running_var\n        x_hat = (x - mean) / np.sqrt(var + self.eps)\n        return (self.gamma * x_hat + self.beta).astype(np.float64)\nEOF\n"]
