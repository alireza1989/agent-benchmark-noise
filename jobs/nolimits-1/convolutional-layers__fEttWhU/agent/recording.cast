[24.934891, "i", "cat > /app/src/pooling.py << 'EOF'\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass _Pool2D(BaseLayer):\n    def __init__(self, kernel_size, stride=None):\n        super().__init__()\n        self.kernel_size = int(kernel_size)\n        self.stride = int(stride) if stride is not None else int(kernel_size)\n\n    def _windows(self, x):\n        N, H, W, C = x.shape\n        k, s = self.kernel_size, self.stride\n        oh = (H - k) // s + 1\n        ow = (W - k) // s + 1\n        for i in range(k):\n            for j in range(k):\n                yield x[:, i:i + s * (oh - 1) + 1:s, j:j + s * (ow - 1) + 1:s, :]\n\n\nclass MaxPool2D(_Pool2D):\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        out = None\n        for patch in self._windows(x):\n            out = patch.copy() if out is None else np.maximum(out, patch)\n        return out.astype(np.float64)\n\n\nclass AvgPool2D(_Pool2D):\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        out = None\n        for patch in self._w"]
[24.934954, "i", "indows(x):\n            out = patch.copy() if out is None else out + patch\n        return (out / (self.kernel_size * self.kernel_size)).astype(np.float64)\nEOF\n"]
