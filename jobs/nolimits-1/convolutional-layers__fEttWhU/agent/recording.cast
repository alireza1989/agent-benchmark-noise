[23.542208, "i", "cat > /app/src/padding.py << 'EOF'\nimport numpy as np\n\n\ndef zero_pad(x, pad):\n    x = np.asarray(x, dtype=np.float64)\n    if pad == 0:\n        return x.copy()\n    return np.pad(x, ((0, 0), (pad, pad), (pad, pad), (0, 0)), mode='constant', constant_values=0.0).astype(np.float64)\n\n\ndef get_output_shape(input_shape, kernel_size, stride, padding, dilation=1):\n    h, w = input_shape\n    eff = dilation * (kernel_size - 1) + 1\n    oh = (h + 2 * padding - eff) // stride + 1\n    ow = (w + 2 * padding - eff) // stride + 1\n    return (int(oh), int(ow))\nEOF\n"]
[23.542411, "o", "cat > /app/src/padding.py << 'EOF'\r\n\u001b[?2004l\r"]
