[23.888861, "i", "cat > /app/src/base.py << 'EOF'\nfrom abc import ABC, abstractmethod\n\n\nclass BaseLayer(ABC):\n    def __init__(self):\n        pass\n\n    def __call__(self, x, *args, **kwargs):\n        return self.forward(x, *args, **kwargs)\n\n    @abstractmethod\n    def forward(self, x):\n        raise NotImplementedError\nEOF\n"]
[23.889184, "o", "cat > /app/src/base.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.889376, "o", "from abc import ABC, abstractmethod\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.88942, "o", "class BaseLayer(ABC):\r\n\u001b[?2004l\r"]
[23.889519, "o", "\u001b[?2004h>     def __init__(self):\r\n\u001b[?2004l\r"]
[23.889812, "o", "\u001b[?2004h>         pass\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def __call__(self, x, *args, **kwargs):\r\n\u001b[?2004l\r\u001b[?2004h>         return self.forward(x, *args, **kwargs)"]
[23.890351, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     @abstractmethod\r\n\u001b[?2004l\r\u001b[?2004h>     def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h>         raise NotImplementedError\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[23.891592, "o", "\u001b[?2004hroot@1d2e3df2b505:/app# "]
[24.243346, "i", "cat > /app/src/conv.py << 'EOF'\nimport numpy as np\nfrom .base import BaseLayer\nfrom .padding import zero_pad, get_output_shape\n\n\nclass Conv2D(BaseLayer):\n    def __init__(self, in_channels, out_channels, kernel_size, stride=1, padding=0, dilation=1):\n        super().__init__()\n        self.in_channels = int(in_channels)\n        self.out_channels = int(out_channels)\n        self.kernel_size = int(kernel_size)\n        self.stride = int(stride)\n        self.padding = int(padding)\n        self.dilation = int(dilation)\n        fan_in = in_channels * kernel_size * kernel_size\n        fan_out = out_channels * kernel_size * kernel_size\n        limit = np.sqrt(6.0 / (fan_in + fan_out))\n        self.weights = np.random.uniform(-limit, limit, size=(out_channels, in_channels, kernel_size, kernel_size)).astype(np.float64)\n        self.bias = np.zeros((out_channels,), dtype=np.float64)\n\n    def forward(self, x):\n        x = zero_pad(x, self.padding)\n        N, H, W, C = x.shape\n        k, s, d = self.kernel_size, self.stri"]
[24.243397, "i", "de, self.dilation\n        oh, ow = get_output_shape((H, W), k, s, 0, d)\n        out = np.zeros((N, oh, ow, self.out_channels), dtype=np.float64)\n        for i in range(k):\n            for j in range(k):\n                hs = i * d\n                ws = j * d\n                patch = x[:, hs:hs + s * (oh - 1) + 1:s, ws:ws + s * (ow - 1) + 1:s, :]\n                out += np.tensordot(patch, self.weights[:, :, i, j], axes=([3], [1]))\n        out += self.bias\n        return out.astype(np.float64)\nEOF\n"]
