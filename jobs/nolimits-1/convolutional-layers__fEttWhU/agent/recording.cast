[36.243466, "i", "cd /app && python3 -c \"\nimport numpy as np\nfrom src import Conv2D, Conv2DTranspose, BatchNorm2D\nnp.random.seed(0)\nx = np.random.randn(2,9,9,3)\nc = Conv2D(3,4,3,stride=2,padding=1,dilation=2)\nxp = np.pad(x,((0,0),(1,1),(1,1),(0,0)))\noh,ow = c(x).shape[1:3]\nref = np.zeros((2,oh,ow,4))\nfor n in range(2):\n  for a in range(oh):\n    for b in range(ow):\n      for o in range(4):\n        s=0.0\n        for i in range(3):\n          for j in range(3):\n            s += np.sum(xp[n,a*2+i*2,b*2+j*2,:]*c.weights[o,:,i,j])\n        ref[n,a,b,o]=s+c.bias[o]\nprint('conv err', np.abs(c(x)-ref).max())\nt = Conv2DTranspose(3,5,3,stride=2,padding=1)\ny = t(x)\nH=(9-1)*2+3\nfull=np.zeros((2,H,H,5))\nfor n in range(2):\n  for a in range(9):\n    for b in range(9):\n      for i in range(3):\n        for j in range(3):\n          full[n,a*2+i,b*2+j,:] += x[n,a,b,:]@t.weights[:,:,i,j]\nref2=full[:,1:-1,1:-1,:]+t.bias\nprint('convT err', np.abs(y-ref2).max(), y.shape)\nbn = BatchNorm2D(3)\nz = bn(x)\nprint('bn mean', np.abs(z.mean(axis=(0,1,2))).max(), "]
[36.24355, "i", "'bn var', np.abs(z.var(axis=(0,1,2))-1).max())\n\"\n"]
