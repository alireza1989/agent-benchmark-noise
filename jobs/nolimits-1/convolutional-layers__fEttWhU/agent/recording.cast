[23.543196, "o", "    x = np.asarray(x, dtype=np.float64)\r\n\u001b[?2004l\r\u001b[?2004h>     if pad == 0:\r\n\u001b[?2004l\r\u001b[?2004h>         return x.copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.543974, "o", "    return np.pad(x, ((0, 0), (pad, pad), (pad, pad), (0, 0)), mode='constant', constant_values=0.0).astype(np.float64)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def get_output_shape(input_shape, kernel_size, stride, padding, dilation=1):\r\n\u001b[?2004l\r\u001b[?2004h>     h, w = input_shape\r\n\u001b[?2004l\r\u001b[?2004h>     eff = dilation * (kernel_size - 1) + 1\r\n\u001b[?2004l\r\u001b[?2004h>     oh = (h + 2 * padding - eff) // stride + 1\r\n\u001b[?2004l\r\u001b[?2004h>     ow = (w + 2 * padding - eff) // stride + 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
