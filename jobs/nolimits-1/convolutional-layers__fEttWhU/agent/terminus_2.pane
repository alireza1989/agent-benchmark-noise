[?2004l[?2004h>             var = x.var(axis=axes)
[?2004l[?2004h>             self.running_mean = (1 - self.momentum) * self.running_mean + self.momentum * mean
[?2004l[?2004h>             self.running_var = (1 - self.momentum) * self.running_var + self.momentum * var
[?2004l[?2004h>         else:
[?2004l[?2004h>             mean = self.running_mean
[?2004l[?2004h>             var = self.running_var
[?2004l[?2004h>         x_hat = (x - mean) / np.sqrt(var + self.eps)
[?2004l[?2004h>         return (self.gamma * x_hat + self.beta).astype(np.float64)
