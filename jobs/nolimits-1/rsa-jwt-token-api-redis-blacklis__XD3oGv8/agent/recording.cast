[62.277431, "i", "cat > /app/cli.py << 'EOF'\n#!/usr/bin/env python3\nimport argparse, json, os, sys, time, logging\nimport requests\n\nAPI = os.environ.get('API_URL', 'http://localhost:5000')\nTOKENS = '/app/tokens.json'\nLOG = '/app/logs/app.log'\nos.makedirs('/app/logs', exist_ok=True)\nlogging.basicConfig(filename=LOG, level=logging.INFO, format='%(asctime)s %(levelname)s cli %(message)s')\nlog = logging.getLogger('cli')\n\ndef die(msg, code=1):\n    log.error(msg)\n    print('ERROR: ' + msg, file=sys.stderr)\n    sys.exit(code)\n\ndef load():\n    if not os.path.exists(TOKENS):\n        return {}\n    with open(TOKENS) as f:\n        return json.load(f)\n\ndef save(d):\n    with open(TOKENS, 'w') as f:\n        json.dump(d, f, indent=2)\n    os.chmod(TOKENS, 0o600)\n\ndef call(method, path, body=None, token=None):\n    h = {'Authorization': 'Bearer ' + token} if token else {}\n    try:\n        return requests.request(method, API + path, json=body, headers=h, timeout=10)\n    except requests.RequestException as e:\n        die('API unreachable at %s: %s'"]
[62.277488, "i", " % (API, e))\n\ndef store_login(username, r):\n    d = r.json()\n    data = {'username': username, 'access_token': d['access_token'], 'refresh_token': d['refresh_token'], 'revoked': []}\n    save(data)\n    log.info('acquired tokens for %s', username)\n    print('Tokens acquired for %s and saved to %s' % (username, TOKENS))\n\ndef cmd_acquire(a):\n    r = call('POST', '/auth/login', {'username': a.username, 'password': a.password})\n    if r.status_code != 200:\n        die('login failed (%d): %s' % (r.status_code, r.text))\n    store_login(a.username, r)\n    return 0\n\ndef cmd_validate(a):\n    d = load()\n    key = a.type + '_token'\n    if not d.get(key):\n        die('no %s token in %s; run acquire first' % (a.type, TOKENS))\n    r = call('GET', '/auth/validate', token=d[key])\n    body = r.json() if r.content else {}\n    if r.status_code == 200:\n        print('VALID: ' + json.dumps(body))\n        return 0\n    if r.status_code == 401:\n        log.warning('validate: invalid or expired token: %s', body.get('error'))\n        pr"]
[62.277757, "i", "int('INVALID/EXPIRED (%s): run python3 /app/cli.py retry' % body.get('error'))\n        return 2\n    if r.status_code == 403:\n        log.warning('validate: revoked token')\n        print('REVOKED: %s' % body.get('error'))\n        return 3\n    print('Unexpected status %d: %s' % (r.status_code, r.text))\n    return 4\n\ndef cmd_revoke(a):\n    d = load()\n    types = ['access', 'refresh'] if a.type == 'all' else [a.type]\n    revoked = d.get('revoked', [])\n    for t in types:\n        tok = d.get(t + '_token')\n        if not tok or t in revoked:\n            continue\n        r = call('POST', '/auth/revoke', {'token': tok})\n        if r.status_code == 200:\n            print('Revoked %s token' % t)\n        elif r.status_code == 403:\n            print('%s token was already revoked' % t)\n        elif r.status_code == 401:\n            print('%s token is expired/invalid, nothing to revoke: %s' % (t, r.json().get('error')))\n        else:\n            die('revoke %s failed (%d): %s' % (t, r.status_code, r.text))\n        revoked."]
