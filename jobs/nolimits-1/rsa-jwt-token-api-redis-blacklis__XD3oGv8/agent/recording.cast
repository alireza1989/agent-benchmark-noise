[61.770028, "i", "cat > /app/api.py << 'EOF'\nimport os, uuid, time, logging, datetime as dt\nimport jwt, bcrypt, redis\nfrom flask import Flask, request, jsonify\n\nKEYS = '/app/keys'\nLOG = '/app/logs/app.log'\nISS = 'rsa-jwt-api'\nACCESS_TTL = 15 * 60\nREFRESH_TTL = 7 * 24 * 3600\n\nos.makedirs('/app/logs', exist_ok=True)\nlogging.basicConfig(filename=LOG, level=logging.INFO, format='%(asctime)s %(levelname)s api %(message)s')\nlog = logging.getLogger('api')\n\nwith open(KEYS + '/private.pem', 'rb') as f:\n    PRIV = f.read()\nwith open(KEYS + '/public.pem', 'rb') as f:\n    PUB = f.read()\n\nr = redis.Redis(host=os.environ.get('REDIS_HOST', 'localhost'), port=int(os.environ.get('REDIS_PORT', '6379')), decode_responses=True)\nUSERS = {'admin': bcrypt.hashpw(b'password123', bcrypt.gensalt()).decode()}\n\napp = Flask(__name__)\n\ndef fail(code, msg):\n    log.error('HTTP %d: %s', code, msg)\n    return jsonify(error=msg), code\n\ndef make_token(sub, ttype, ttl):\n    now = dt.datetime.now(dt.timezone.utc)\n    payload = {'iss': ISS, 'sub': sub, 'iat': now,"]
[61.770403, "i", " 'exp': now + dt.timedelta(seconds=ttl), 'jti': str(uuid.uuid4()), 'type': ttype}\n    return jwt.encode(payload, PRIV, algorithm='RS256')\n\ndef check(tok, expected=None):\n    try:\n        p = jwt.decode(tok, PUB, algorithms=['RS256'], issuer=ISS, options={'require': ['exp', 'iat', 'jti', 'sub', 'iss']})\n    except jwt.ExpiredSignatureError:\n        return None, (401, 'token expired')\n    except jwt.PyJWTError as e:\n        return None, (401, 'invalid token: %s' % e)\n    if expected and p.get('type') != expected:\n        return None, (401, 'wrong token type, expected %s' % expected)\n    if r.exists('blacklist:' + p['jti']):\n        return None, (403, 'token revoked')\n    return p, None\n\ndef bearer():\n    h = request.headers.get('Authorization', '')\n    if h.startswith('Bearer '):\n        return h[7:].strip()\n    return request.args.get('token')\n\n@app.post('/auth/login')\ndef login():\n    d = request.get_json(silent=True) or {}\n    u = str(d.get('username', ''))\n    pw = str(d.get('password', ''))\n    h = USERS.g"]
[61.770677, "o", "cat > /app/api.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import os, uuid, time, logging, datetime as dt\r\n\u001b[?2004l\r\u001b[?2004h> import jwt, bcrypt, redis\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.770724, "i", "et(u)\n    if not h or not bcrypt.checkpw(pw.encode(), h.encode()):\n        return fail(401, 'invalid credentials')\n    log.info('login ok user=%s', u)\n    return jsonify(access_token=make_token(u, 'access', ACCESS_TTL), refresh_token=make_token(u, 'refresh', REFRESH_TTL), token_type='Bearer', expires_in=ACCESS_TTL)\n\n@app.post('/auth/refresh')\ndef refresh():\n    d = request.get_json(silent=True) or {}\n    p, e = check(str(d.get('refresh_token', '')), 'refresh')\n    if e:\n        return fail(*e)\n    log.info('refresh ok sub=%s', p['sub'])\n    return jsonify(access_token=make_token(p['sub'], 'access', ACCESS_TTL), token_type='Bearer', expires_in=ACCESS_TTL)\n\n@app.post('/auth/revoke')\ndef revoke():\n    d = request.get_json(silent=True) or {}\n    p, e = check(str(d.get('token', '')))\n    if e:\n        return fail(*e)\n    ttl = int(p['exp'] - time.time())\n    if ttl > 0:\n        r.set('blacklist:' + p['jti'], 'revoked', ex=ttl)\n    log.info('revoked jti=%s type=%s ttl=%d', p['jti'], p.get('type'), ttl)\n    return j"]
[61.770744, "o", "from flask import Flask, request, jsonify\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> KEYS = '/app/keys'\r\n\u001b[?2004l\r\u001b[?2004h> LOG = '/app/logs/app.log'\r\n\u001b[?2004l\r"]
[61.770749, "i", "sonify(revoked=True, jti=p['jti'], type=p.get('type'))\n\n@app.get('/auth/validate')\ndef validate():\n    t = bearer()\n    if not t:\n        return fail(401, 'missing token')\n    p, e = check(t)\n    if e:\n        return fail(*e)\n    return jsonify(valid=True, sub=p['sub'], jti=p['jti'], type=p['type'], exp=p['exp'])\n\nif __name__ == '__main__':\n    app.run(host='0.0.0.0', port=5000)\nEOF\npython3 -c \"import ast; ast.parse(open('/app/api.py').read()); print('api.py OK')\"\n"]
