[62.277993, "i", "append(t)\n    d['revoked'] = revoked\n    save(d)\n    return 0\n\ndef cmd_retry(a):\n    d = load()\n    if d.get('access_token') and 'access' not in d.get('revoked', []):\n        r = call('GET', '/auth/validate', token=d['access_token'])\n        if r.status_code == 200:\n            print('Access token still valid; nothing to do (use acquire to force a new login).')\n            return 0\n        print('Access token not usable (%d); retrying' % r.status_code)\n    user = a.username or d.get('username', 'admin')\n    for i in range(1, a.attempts + 1):\n        if d.get('refresh_token') and 'refresh' not in d.get('revoked', []):\n            r = call('POST', '/auth/refresh', {'refresh_token': d['refresh_token']})\n            if r.status_code == 200:\n                d['access_token'] = r.json()['access_token']\n                d['revoked'] = [x for x in d.get('revoked', []) if x != 'access']\n                save(d)\n                log.info('access token refreshed for %s', user)\n                print('Access token refreshed "]
[62.278111, "o", "\u001b[?2004h> import argparse, json, os, sys, time, logging\r\n\u001b[?2004l\r\u001b[?2004h> import requests\r\n\u001b[?2004l\r"]
[62.278131, "i", "and saved to %s' % TOKENS)\n                return 0\n            log.warning('refresh failed (%d): %s', r.status_code, r.text)\n        r = call('POST', '/auth/login', {'username': user, 'password': a.password})\n        if r.status_code == 200:\n            store_login(user, r)\n            return 0\n        log.warning('retry %d/%d login failed (%d)', i, a.attempts, r.status_code)\n        print('Attempt %d/%d failed (%d)' % (i, a.attempts, r.status_code), file=sys.stderr)\n        time.sleep(a.delay)\n    die('retry failed after %d attempts' % a.attempts)\n\ndef main():\n    p = argparse.ArgumentParser(description='RSA JWT CLI')\n    sub = p.add_subparsers(dest='cmd', required=True)\n    s = sub.add_parser('acquire', help='login and save tokens')\n    s.add_argument('--username', default='admin')\n    s.add_argument('--password', default='password123')\n    s.set_defaults(func=cmd_acquire)\n    s = sub.add_parser('validate', help='validate saved token')\n    s.add_argument('--type', choices=['access', 'refresh'], default='ac"]
