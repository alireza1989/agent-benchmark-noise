[62.278368, "i", "cess')\n    s.set_defaults(func=cmd_validate)\n    s = sub.add_parser('revoke', help='revoke saved tokens')\n    s.add_argument('--type', choices=['access', 'refresh', 'all'], default='all')\n    s.set_defaults(func=cmd_revoke)\n    s = sub.add_parser('retry', help='refresh or re-acquire if expired')\n    s.add_argument('--username')\n    s.add_argument('--password', default='password123')\n    s.add_argument('--attempts', type=int, default=3)\n    s.add_argument('--delay', type=float, default=2.0)\n    s.set_defaults(func=cmd_retry)\n    args = p.parse_args()\n    sys.exit(args.func(args) or 0)\n\nif __name__ == '__main__':\n    main()\nEOF\nchmod +x /app/cli.py && python3 -m py_compile /app/cli.py && echo cli OK\n"]
