Sending keys: ['cat > /opt/myapp/app.py <<\'EOF\'\n#!/usr/bin/env python3\n"""Simple application that logs JSON-formatted events to stdout."""\nimport argparse\nimport datetime\nimport json\nimport logging\nimport sys\nimport time\n\nlogging.addLevelName(logging.WARNING, "WARN")\n\n\nclass JsonFormatter(logging.Formatter):\n    def format(self, record):\n        ts = datetime.datetime.fromtimestamp(record.created, datetime.timezone.utc)\n        payload = {\n            "timestamp": ts.strftime("%Y-%m-%dT%H:%M:%SZ"),\n            "level": record.levelname,\n            "message": record.getMessage(),\n            "service": "myapp",\n        }\n        return json.dumps(payload, separators=(",", ":"))\n\n\ndef main():\n    parser = argparse.ArgumentParser(description="myapp JSON event logger")\n    parser.add_argument("--log-level", default="INFO", choices=["INFO", "WARN", "ERROR"])\n    parser.add_argument("--interval", type=float, default=5.0, help="seconds between events")\n    args = parser.parse_args()\n\n    handler = logging.StreamHandler(sys.stdout)\n    handler.setFormatter(JsonFormatter())\n    logger = logging.getLogger("myapp")\n    logger.handlers = [handler]\n    logger.propagate = False\n    logger.setLevel(getattr(logging, args.log_level))\n\n    logger.info("Service started")\n    counter = 0\n    try:\n        while True:\n            time.sleep(args.interval)\n            counter += 1\n            logger.info("Heartbeat event %d", counter)\n            if counter % 3 == 0:\n                logger.warning("Queue depth above normal threshold")\n            if counter % 5 == 0:\n                logger.error("Simulated processing failure on event %d", counter)\n    except KeyboardInterrupt:\n        pass\n    logger.info("Service stopping")\n    return 0\n\n\nif __name__ == "__main__":\n    sys.exit(main())\nEOF\nchmod 755 /opt/myapp/app.py; chown -R myapp:myapp /opt/myapp; python3 -m py_compile /opt/myapp/app.py && echo COMPILE_OK\n'] min_timeout_sec