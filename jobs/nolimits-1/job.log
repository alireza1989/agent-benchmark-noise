into {CHUNK_DIR}\')\n\n\n@app.on_event(\'startup\')\nasync def startup_event():\n    build_chunks()\n\n\n@app.get(\'/\')\nasync def root():\n    """Health check endpoint"""\n    return {\'status\': \'healthy\', \'message\': \'Service is running\'}\n\n\n@app.get(\'/query\')\nasync def query_records(\n    type1: str = Query(..., description=\'Type1 value to filter by\'),\n    type2: str = Query(..., description=\'Type2 value to filter by\')\n) -> List[Record]:\n    """Query records by Type1 and Type2. Loads only the matching chunk."""\n    global last_loaded_type1_values, last_loaded_type2_values\n\n    if not type1 or not type2:\n        raise HTTPException(status_code=400, detail=\'Both type1 and type2 are required\')\n\n    last_loaded_type1_values = set()\n    last_loaded_type2_values = set()\n\n    path = chunk_index.get((type1, type2))\n    if path is None:\n        return []\n\n    results = []\n    with open(path, \'r\', newline=\'\') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            results.append(Record(\n                Type1=row[\'Type1\'],\n                Type2=row[\'Type2\'],\n                Text=row[\'Text\'],\n                ID=int(row[\'ID\']),\n            ))\n\n    for r in results:\n        last_loaded_type1_values.add(r.Type1)\n        last_loaded_type2_values.add(r.Type2)\n\n    return results\n\n\n@app.get(\'/get_all_loaded_types_and_subtypes\')\nasync def get_all_loaded_types_and_subtypes() -> dict:\n    """Returns the Type1/Type2 values loaded by the most recent query."""\n    return {\n        \'type1_values\': sorted(last_loaded_type1_values),\n        \'type2_values\': sorted(last_loaded_type2_values),\n    }\n\n\n@app.get(\'/get_all_available_types_and_subtypes\')\nasync def get_all_available_types_and_subtypes() -> dict:\n    """Returns ALL unique Type1 and Type2 values in the storage system."""\n    return {\n        \'type1_values\': sorted(all_type1_values),\n        \'type2_values\': sorted(all_type2_values),\n    }\n\n\n@app.get(\'/stats\')\nasync def get_stats():\n    """Get dataset statistics"""\n    return {\n        \'total_records\': total_records,\n        \'unique_type1\': len(all_type1_values),\n        \'unique_type2\': len(all_type2_values),\n        \'storage_backend\': \'CSV\',\n    }\n\n\nif __name__ == \'__main__\':\n    import uvicorn\n    uvicorn.run(app, host=\'0.0.0.0\', port=8000, log_level=\'info\')\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
