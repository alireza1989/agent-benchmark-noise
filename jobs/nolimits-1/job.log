 imgs]\ncounts = Counter(s for _, ss in img_sets for s in ss)\nshared = {s for s, c in counts.items() if c > 1}\nimages_shared = [name for name, ss in img_sets if ss & shared]\n\nout = {\n    'basic_metrics': {\n        'total_storage_bytes': total,\n        'deduplicated_storage_bytes': dedup,\n        'storage_savings_percent': savings,\n        'cache_hit_ratio': hit_ratio\n    },\n    'advanced_metrics': {\n        'compressed_storage_bytes': compressed,\n        'monthly_storage_cost_usd': cost,\n        'network_transfer_time_seconds': net_time,\n        'average_layer_age_days': avg_age,\n        'access_frequency_std_dev': sd\n    },\n    'top_layers_by_size': top_out,\n    'recent_access_summary': {\n        'layers_accessed_last_7_days': last7,\n        'most_recent_layers': recent_out\n    },\n    'shared_layer_analysis': {\n        'images_with_shared_layers': images_shared,\n        'total_shared_layer_count': len(shared)\n    }\n}\n\njson.dump(out, open('/workspace/output.json', 'w'), indent=2)\nprint(json.dumps(out, indent=2))\nEOF\n"] min_timeout_sec: 0.3 max_timeout_sec: 180.0
