Sending keys: ["cat > /app/src/conv.py << 'EOF'\nimport numpy as np\nfrom .base import BaseLayer\nfrom .padding import zero_pad, get_output_shape\n\n\nclass Conv2D(BaseLayer):\n    def __init__(self, in_channels, out_channels, kernel_size, stride=1, padding=0, dilation=1):\n        super().__init__()\n        self.in_channels = int(in_channels)\n        self.out_channels = int(out_channels)\n        self.kernel_size = int(kernel_size)\n        self.stride = int(stride)\n        self.padding = int(padding)\n        self.dilation = int(dilation)\n        fan_in = in_channels * kernel_size * kernel_size\n        fan_out = out_channels * kernel_size * kernel_size\n        limit = np.sqrt(6.0 / (fan_in + fan_out))\n        self.weights = np.random.uniform(-limit, limit, size=(out_channels, in_channels, kernel_size, kernel_size)).astype(np.float64)\n        self.bias = np.zeros((out_channels,), dtype=np.float64)\n\n    def forward(self, x):\n        x = zero_pad(x, self.padding)\n        N, H, W, C = x.shape\n        k, s, d = self.kernel_size, self.stride, self.dilation\n        oh, ow = get_output_shape((H, W), k, s, 0, d)\n        out = np.zeros((N, oh, ow, self.out_channels), dtype=np.float64)\n        for i in range(k):\n            for j in range(k):\n                hs = i * d\n                ws = j * d\n                patch = x[:, hs:hs + s * (oh - 1) + 1:s, ws:ws + s * (ow - 1) + 1:s, :]\n                out += np.tensordot(patch, self.weights[:, :, i, j], axes=([3], [1]))\n        out += self.bias\n        return out.astype(np.float64)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/src/conv_transpose.py << 'EOF'\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass Conv2DTranspose(BaseLayer):\n    def __init__(self, in_channels, out_channels, kernel_size, stride=1, padding=0):\n        super().__init__()\n        self.in_channels = int(in_channels)\n        self.out_channels = int(out_channels)\n        self.kernel_size = int(kernel_size)\n        self.stride = int(stride)\n        self.padding = int(padding)\n        fan_in = in_channels * kernel_size * kernel_size\n        fan_out = out_channels * kernel_size * kernel_size\n        limit = np.sqrt(6.0 / (fan_in + fan_out))\n        self.weights = np.random.uniform(-limit, limit, size=(in_channels, out_channels, kernel_size, kernel_size)).astype(np.float64)\n        self.bias = np.zeros((out_channels,), dtype=np.float64)\n\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        N, H, W, C = x.shape\n        k, s, p = self.kernel_size, self.stride, self.padding\n        Hf = (H - 1) * s + k\n        Wf = (W - 1) * s + k\n        full = np.zeros((N, Hf, Wf, self.out_channels), dtype=np.float64)\n        for i in range(k):\n            for j in range(k):\n                contrib = np.tensordot(x, self.weights[:, :, i, j], axes=([3], [0]))\n                full[:, i:i + s * (H - 1) + 1:s, j:j + s * (W - 1) + 1:s, :] += contrib\n        out = full[:, p:Hf - p, p:Wf - p, :]\n        out = out + self.bias\n        return out.astype(np.float64)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/src/pooling.py << 'EOF'\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass _Pool2D(BaseLayer):\n    def __init__(self, kernel_size, stride=None):\n        super().__init__()\n        self.kernel_size = int(kernel_size)\n        self.stride = int(stride) if stride is not None else int(kernel_size)\n\n    def _windows(self, x):\n        N, H, W, C = x.shape\n        k, s = self.kernel_size, self.stride\n        oh = (H - k) // s + 1\n        ow = (W - k) // s + 1\n        for i in range(k):\n            for j in range(k):\n                yield x[:, i:i + s * (oh - 1) + 1:s, j:j + s * (ow - 1) + 1:s, :]\n\n\nclass MaxPool2D(_Pool2D):\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        out = None\n        for patch in self._windows(x):\n            out = patch.copy() if out is None else np.maximum(out, patch)\n        return out.astype(np.float64)\n\n\nclass AvgPool2D(_Pool2D):\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        out = None\n        for patch in self._windows(x):\n            out = patch.copy() if out is None else out + patch\n        return (out / (self.kernel_size * self.kernel_size)).astype(np.float64)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/src/normalization.py << 'EOF'\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass BatchNorm2D(BaseLayer):\n    def __init__(self, num_features, eps=1e-5, momentum=0.1):\n        super().__init__()\n        self.num_features = int(num_features)\n        self.eps = eps\n        self.momentum = momentum\n        self.gamma = np.ones((num_features,), dtype=np.float64)\n        self.beta = np.zeros((num_features,), dtype=np.float64)\n        self.running_mean = np.zeros((num_features,), dtype=np.float64)\n        self.running_var = np.ones((num_features,), dtype=np.float64)\n\n    def forward(self, x, training=True):\n        x = np.asarray(x, dtype=np.float64)\n        if training:\n            axes = (0, 1, 2)\n            mean = x.mean(axis=axes)\n            var = x.var(axis=axes)\n            self.running_mean = (1 - self.momentum) * self.running_mean + self.momentum * mean\n            self.running_var = (1 - self.momentum) * self.running_var + self.momentum * var\n        else:\n            mean = self.running_mean\n            var = self.running_var\n        x_hat = (x - mean) / np.sqrt(var + self.eps)\n        return (self.gamma * x_hat + self.beta).astype(np.float64)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/src/activation.py << 'EOF'\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass ReLU(BaseLayer):\n    def __init__(self):\n        super().__init__()\n\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        return np.maximum(0.0, x).astype(np.float64)\n\n\nclass LeakyReLU(BaseLayer):\n    def __init__(self, negative_slope=0.01):\n        super().__init__()\n        self.negative_slope = negative_slope\n\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        return np.where(x > 0, x, self.negative_slope * x).astype(np.float64)\n\n\nclass Sigmoid(BaseLayer):\n    def __init__(self):\n        super().__init__()\n\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        z = np.exp(-np.abs(x))\n        out = np.where(x >= 0, 1.0 / (1.0 + z), z / (1.0 + z))\n        return out.astype(np.float64)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
