Sending keys: ["cat > /app/solve.py << 'EOF'\nimport pandas as pd, numpy as np, json\nfrom scipy.stats import norm, gamma\nimp = pd.read_csv('data/impressions.csv')\nconv = pd.read_csv('data/conversions.csv')\nctx = pd.read_csv('data/test_contexts.csv')\narms = json.load(open('data/arms_metadata.json'))['arms']\nlnd = np.log(conv.delay_hours.values)\nmu = lnd.mean()\nsig = lnd.std(ddof=0)\nT = imp.timestamp.max()\nm = imp.merge(conv[['impression_id', 'conversion_value', 'delay_hours']], on='impression_id', how='left')\nm['conv'] = m.delay_hours.notna().astype(int)\nm['v'] = m.conversion_value.fillna(0.0)\nage = np.clip((T - m.timestamp.values) / 3600.0, 1e-9, None)\nF = norm.cdf((np.log(age) - mu) / sig)\nm['F'] = np.where(age >= 72, 1.0, F)\nK = 100.0\nOVERALL = m.conv.sum() / m.F.sum()\ng = m.groupby('arm_id').agg(n=('conv', 'size'), c=('conv', 'sum'), E=('F', 'sum'))\ng['rate'] = (g.c + K * OVERALL) / (g.E + K)\nval = conv.merge(imp[['impression_id', 'arm_id']], on='impression_id').groupby('arm_id').conversion_value.mean()\ng['val'] = val\nm['cell'] = list(zip(m.arm_id, m.user_segment, m.device_type))\ncell = m.groupby('cell').agg(c=('conv', 'sum'), E=('F', 'sum'))\ndef cell_stats(arm, seg, dev):\n    r = g.loc[arm, 'rate']\n    key = (arm, seg, dev)\n    if key in cell.index:\n        c = cell.loc[key, 'c']; E = cell.loc[key, 'E']\n    else:\n        c = 0.0; E = 0.0\n    a = c + K * r\n    b = E + K\n    rate = a / b\n    lo = gamma.ppf(0.1, a, scale=1.0 / b)\n    hi = gamma.ppf(0.9, a + 1.0, scale=1.0 / b)\n    return rate, lo, hi\nrows = []\nfor _, row in ctx.iterrows():\n    best = None\n    for arm in range(10):\n        rate, lo, hi = cell_stats(arm, row.user_segment, row.device_type)\n        v = g.loc[arm, 'val']\n        ev = rate * v\n        if best is None or ev > best[1]:\n            best = (arm, ev, lo * v, hi * v)\n    arm, ev, lo, hi = best\n    lo = min(lo, ev); hi = max(hi, ev)\n    rows.append((row.context_id, int(arm), float(ev), float(max(lo, 0.0)), float(hi)))\npred = pd.DataFrame(rows, columns=['context_id', 'selected_arm', 'expected_reward', 'confidence_lower', 'confidence_upper'])\npred.to_csv('output/predictions.csv', index=False)\nstats = pd.DataFrame({'arm_id': g.index, 'estimated_conversion_rate': g.rate.values, 'estimated_avg_value': g.val.values, 'total_impressions': g.n.values, 'total_conversions': conv.merge(imp[['impression_id', 'arm_id']], on='impression_id').groupby('arm_id').size().reindex(g.index).values})\nstats.to_csv('output/arm_statistics.csv', index=False)\nmed = float(np.exp(mu))\np90 = float(np.exp(mu + norm.ppf(0.9) * sig))\nout = {'distribution_type': 'lognormal', 'parameters': {'mu': float(mu), 'sigma': float(sig)}, 'median_delay_hours': med, 'p90_delay_hours': p90, 'conversion_rate_estimate': float(OVERALL)}\njson.dump(out, open('output/delay_model.json', 'w'), indent=2)\nprint(out)\nprint(pred.describe())\nprint(pred.selected_arm.value_counts().sort_index())\nprint(stats)\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
