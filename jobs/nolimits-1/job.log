Sending keys: ["cat > /tmp/play.py << 'EOF'\nimport subprocess, math, re\nW = 40\nC = 0.5\n\ndef play(seed):\n    p = subprocess.Popen(['/app/bandit', '--seed', str(seed)], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, bufsize=1)\n    hist = [[] for _ in range(10)]\n    done = None\n    while True:\n        line = p.stdout.readline()\n        if not line:\n            break\n        line = line.strip()\n        if line.startswith('TURN'):\n            ns = [len(h) for h in hist]\n            N = sum(ns)\n            best = 0\n            bs = -1e9\n            arm = None\n            for i in range(10):\n                if ns[i] == 0:\n                    arm = i\n                    break\n                s = sum(hist[i]) / ns[i] + C * math.sqrt(2 * math.log(max(N, 2)) / ns[i])\n                if s > bs:\n                    bs = s\n                    best = i\n            if arm is None:\n                arm = best\n            p.stdin.write(str(arm) + '\\n')\n            p.stdin.flush()\n            rl = p.stdout.readline().strip()\n            r = float(rl.split()[1])\n            hist[arm].append(r)\n            hist[arm] = hist[arm][-W:]\n        elif line.startswith('DONE'):\n            done = line\n            break\n    p.stdin.close()\n    p.wait()\n    m = re.search(r'total_reward=([-\\d.]+) oracle_reward=([-\\d.]+) regret=([-\\d.]+)', done)\n    return float(m.group(1)), float(m.group(3)), done\n\ntot = []\nreg = []\nfor s in [42, 43, 44]:\n    t, g, d = play(s)\n    print(d)\n    tot.append(t)\n    reg.append(g)\navg_t = sum(tot) / len(tot)\navg_g = sum(reg) / len(reg)\nwith open('/app/answer.txt', 'w') as f:\n    f.write('total_reward=%.3f\\nregret=%.3f\\n' % (avg_t, avg_g))\nprint(open('/app/answer.txt').read())\nEOF\npython3 /tmp/play.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
