Sending keys: ["cat > /app/kiln_firmware.py << 'EOF'\nimport csv\nimport json\nimport itertools\n\n\ndef run_firing_cycle(schedule_path, specs_path):\n    specs = json.load(open(specs_path))\n    G = float(specs['gas_burner_power_c'])\n    C = float(specs['damper_cooling_c'])\n    A = float(specs['ambient_loss_c'])\n    with open(schedule_path) as f:\n        targets = [float(r['target_temp']) for r in csv.DictReader(f)]\n    N = len(targets)\n    H = 2\n    lam = 0.02\n    actions = [(g, d) for g in range(6) for d in range(6)]\n    T = targets[0]\n    g1 = 0\n    g2 = 0\n    out = []\n    for t in range(N):\n        best_cost = None\n        best_first = (0, 0)\n        for seq in itertools.product(actions, repeat=H):\n            Tc = T\n            a1 = g1\n            a2 = g2\n            cost = 0.0\n            ok = True\n            for k, (g, d) in enumerate(seq):\n                tt = t + k\n                if tt >= N:\n                    break\n                geff = 0.1 * g + 0.3 * a1 + 0.6 * a2\n                Tn = Tc + G * geff - (C * d + A)\n                if Tn < Tc - 5.0:\n                    ok = False\n                    break\n                idx = min(tt + 1, N - 1)\n                cost += abs(Tn - targets[idx]) + lam * g\n                Tc = Tn\n                a2 = a1\n                a1 = g\n            if not ok:\n                continue\n            if best_cost is None or cost < best_cost:\n                best_cost = cost\n                best_first = seq[0]\n        if best_cost is None:\n            # fallback: cool as needed without heating\n            g, d = 0, 0\n        else:\n            g, d = best_first\n        geff = 0.1 * g + 0.3 * g1 + 0.6 * g2\n        T = T + G * geff - (C * d + A)\n        out.append({'gas': int(g), 'damper': int(d)})\n        g2 = g1\n        g1 = g\n    return out\nEOF\n"] min_timeout_sec: 0.2 max_timeout_sec: 180.0
