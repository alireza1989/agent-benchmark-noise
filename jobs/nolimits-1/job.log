"\n  scan_rc "$b/etc/rc.d/rc.local"\n  scan_ssh "$b/root/.ssh/authorized_keys" "root"\n  for h in "$b"/home/*/; do\n    scan_ssh "${h}.ssh/authorized_keys" "$(basename "$h")"\n  done\ndone\n\njq --indent 2 -s \'\n  (unique_by([.type, .path, .details.line_number, .details.content_preview]) | sort_by([.type, .path])) as $a\n  | {\n      summary: {\n        total_artifacts: ($a | length),\n        cron_jobs: ([$a[] | select(.type == "cron_job")] | length),\n        systemd_units: ([$a[] | select(.type == "systemd_unit")] | length),\n        rc_local_modifications: ([$a[] | select(.type == "rc_local")] | length),\n        ssh_keys: ([$a[] | select(.type == "ssh_key")] | length)\n      },\n      artifacts: $a\n    }\' "$TMP" > "$OUT"\n\nexit 0\nEOF\nchmod +x /app/scan_persistence.sh && bash -n /app/scan_persistence.sh && echo SYNTAX_OK\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
