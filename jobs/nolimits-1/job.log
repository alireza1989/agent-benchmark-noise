Sending keys: ["cat > /app/solution.py << 'EOF'\nimport json\nimport sys\n\n\ndef solve(lines):\n    sys.setrecursionlimit(100000)\n    ALLOWED = {'Depends', 'Before', 'After', 'Needs', 'Requires', 'Alias', 'Phony'}\n    blocks = []\n    cur = None\n    for raw in lines:\n        line = raw.strip()\n        if not line or line.startswith('#'):\n            continue\n        if line.startswith('[') and line.endswith(']'):\n            continue\n        tok = line.split()\n        if tok[0] == 'TARGET':\n            if len(tok) != 2:\n                return 'PARSE_ERROR'\n            cur = {'kind': 'T', 'name': tok[1], 'id': '', 'dirs': []}\n            blocks.append(cur)\n        elif tok[0] == 'OVERRIDE':\n            if len(tok) != 3:\n                return 'PARSE_ERROR'\n            cur = {'kind': 'O', 'name': tok[1], 'id': tok[2], 'dirs': []}\n            blocks.append(cur)\n        elif '=' in line:\n            if line.count('=') != 1 or cur is None:\n                return 'PARSE_ERROR'\n            k, v = line.split('=', 1)\n            k = k.strip()\n            v = v.strip()\n            if k not in ALLOWED:\n                return 'PARSE_ERROR'\n            if k == 'Phony':\n                if v not in ('yes', 'no'):\n                    return 'PARSE_ERROR'\n                cur['dirs'].append(('Phony', v))\n            else:\n                cur['dirs'].append((k, v.split()))\n        else:\n            return 'PARSE_ERROR'\n\n    parent = {}\n\n    def find(x):\n        parent.setdefault(x, x)\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(a, b):\n        ra, rb = find(a), find(b)\n        if ra != rb:\n            if ra < rb:\n                parent[rb] = ra\n            else:\n                parent[ra] = rb\n\n    for b in blocks:\n        find(b['name'])\n        for k, vals in b['dirs']:\n            if k == 'Alias':\n                for a in vals:\n                    union(b['name'], a)\n\n    def canon(x):\n        return find(x)\n\n    universe = []\n    idx = {}\n\n    def add(x):\n        c = canon(x)\n        if c not in idx:\n            idx[c] = len(universe)\n            universe.append(c)\n\n    for b in blocks:\n        add(b['name'])\n        for k, vals in b['dirs']:\n            if k != 'Phony':\n                for v in vals:\n                    add(v)\n\n    order_blocks = [b for b in blocks if b['kind'] == 'T'] + \\\n        sorted([b for b in blocks if b['kind'] == 'O'], key=lambda b: b['id'])\n    rec = {}\n    for b in order_blocks:\n        c = canon(b['name'])\n        r = rec.setdefault(c, {'Depends': set(), 'Before': set(), 'After': set(),\n                               'Needs': set(), 'Requires': set(), 'Phony': 'no'})\n        for k, vals in b['dirs']:\n            if k == 'Phony':\n                r['Phony'] = vals\n            elif k != 'Alias':\n                r[k].update(canon(x) for x in vals)\n\n    edges = set()\n    for u, r in rec.items():\n        for x in r['Depends']:\n            edges.add((x, u))\n        for y in r['Before']:\n            edges.add((u, y))\n        for z in r['After']:\n            edges.add((z, u))\n        for w in r['Needs']:\n            edges.add((u, w))\n        for v in r['Requires']:\n            edges.add((u, v))\n\n    adj = {n: [] for n in universe}\n    for a, b in edges:\n        adj[a].append(b)\n\n    index = {}\n    low = {}\n    onst = set()\n    st = []\n    comps = []\n    counter = [0]\n\n    def strong(v):\n        index[v] = low[v] = counter[0]\n        counter[0] += 1\n        st.append(v)\n        onst.add(v)\n        for w in adj[v]:\n            if w not in index:\n                strong(w)\n                low[v] = min(low[v], low[w])\n            elif w in onst:\n                low[v] = min(low[v], index[w])\n        if low[v] == index[v]:\n            comp = []\n            while True:\n                w = st.pop()\n                onst.discard(w)\n                comp.append(w)\n                if w == v:\n                    break\n            comps.append(comp)\n\n    for n in universe:\n        if n not in index:\n            strong(n)\n\n    comp_of = {}\n    for i, c in enumerate(comps):\n        for n in c:\n            comp_of[n] = i\n\n    cycles = []\n    for c in comps:\n        if len(c) >= 2 or (len(c) == 1 and c[0] in adj[c[0]]):\n            cycles.append(sorted(c))\n    cycles.sort()\n\n    cadj = [set() for _ in comps]\n    indeg = [0] * len(comps)\n    for a, b in edges:\n        ca, cb = comp_of[a], comp_of[b]\n        if ca != cb and cb not in cadj[ca]:\n            cadj[ca].add(cb)\n            indeg[cb] += 1\n\n    members = [sorted(c) for c in comps]\n    first = [min(idx[n] for n in c) for c in comps]\n    rep = [m[0] for m in members]\n    queue = sorted([i for i in range(len(comps)) if indeg[i] == 0],\n                   key=lambda i: first[i])\n    order = []\n    while queue:\n        i = queue.pop(0)\n        order.extend(members[i])\n        newly = []\n        for j in cadj[i]:\n            indeg[j] -= 1\n            if indeg[j] == 0:\n                newly.append(j)\n        queue.extend(newly)\n        queue.sort(key=lambda k: rep[k])\n\n    return json.dumps({'order': order, 'cycles': cycles}, separators=(',', ':'))\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
