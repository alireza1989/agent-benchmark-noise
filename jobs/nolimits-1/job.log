Sending keys: ["cat > /app/solver.py << 'EOF'\nimport json, random, sys\nfrom collections import defaultdict\nfrom datetime import datetime, timezone\nsys.path.insert(0, '/app/task_file/scripts')\nfrom model import DeploymentScorer\n\nIN = '/app/task_file/input_data/'\nOUT = '/app/task_file/output_data/deployment_plan.json'\nsvcs = json.load(open(IN + 'services.json'))['services']\ndcj = json.load(open(IN + 'datacenters.json'))\ndeps = json.load(open(IN + 'dependencies.json'))['dependencies']\ndcs = dcj['datacenters']\nbw = dcj['team_bandwidth']\ngcfg = dcj['global_constraints']\nfat_thr = gcfg['team_fatigue_threshold']\nfat_red = gcfg['team_fatigue_reduction']\ngmax = gcfg['max_global_critical_per_wave']\ndc_by_region = {d['region']: d for d in dcs}\nsmap = {s['id']: s for s in svcs}\nCB = {'critical': 3, 'high': 2, 'medium': 1, 'low': 0}\nTHR = {'wave_efficiency': 0.75, 'capacity_utilization': 0.55, 'priority_compliance': 0.55, 'balance_score': 0.45, 'team_balance': 0.60, 'constraint_margin': 0.50, 'deployment_smoothness': 0.50}\n\nhard = defaultdict(set)\nchildren = defaultdict(set)\nfor d in deps:\n    if d['dependency_type'] == 'hard':\n        for p in d['depends_on']:\n            if p in smap and d['service'] in smap:\n                hard[d['service']].add(p)\n                children[p].add(d['service'])\n\ntail = {}\ndef gt(s):\n    if s in tail:\n        return tail[s]\n    v = 0\n    for c in children[s]:\n        v = max(v, 1 + gt(c))\n    tail[s] = v\n    return v\nfor s in smap:\n    gt(s)\n\ndef build(seed, noise, cw, fill):\n    rng = random.Random(seed)\n    placed = {}\n    prev = defaultdict(int)\n    waves = []\n    remaining = set(smap)\n    w = 0\n    while remaining and w < 120:\n        w += 1\n        ready = [s for s in remaining if all(p in placed and placed[p] < w for p in hard[s])]\n        ready.sort(key=lambda s: -(tail[s] + cw * CB[smap[s]['criticality']] + rng.random() * noise))\n        usage = defaultdict(int)\n        crit = defaultdict(int)\n        high = defaultdict(int)\n        teamc = defaultdict(int)\n        gcrit = 0\n        chosen = []\n        for s in ready:\n            sv = smap[s]\n            team = sv['team']\n            ru = sv['resource_units']\n            is_crit = sv['criticality'] == 'critical'\n            is_high = ru >= 5\n            dl = [dc_by_region[r] for r in sv['required_regions']]\n            base = bw.get(team, 10)\n            if prev[team] >= fat_thr:\n                base = max(1, base - fat_red)\n            cap = min([base] + [d['max_team_services_per_wave'] for d in dl])\n            ok = teamc[team] + 1 <= cap\n            if is_crit and gcrit + 1 > gmax:\n                ok = False\n            for d in dl:\n                if not ok:\n                    break\n                i = d['id']\n                if w in d['blackout_waves']:\n                    ok = False\n                elif usage[i] + ru > d['capacity_per_wave'] * fill:\n                    ok = False\n                elif is_crit and crit[i] + 1 > d['max_critical_per_wave']:\n                    ok = False\n                elif is_high and high[i] + 1 > d['high_resource_slots']:\n                    ok = False\n            if not ok:\n                continue\n            for d in dl:\n                i = d['id']\n                usage[i] += ru\n                if is_crit:\n                    crit[i] += 1\n                if is_high:\n                    high[i] += 1\n            teamc[team] += 1\n            if is_crit:\n                gcrit += 1\n            chosen.append(s)\n        for s in chosen:\n            placed[s] = w\n            remaining.discard(s)\n        deployments = []\n        for s in chosen:\n            for r in smap[s]['required_regions']:\n                deployments.append({'service_id': s, 'datacenter_id': dc_by_region[r]['id'], 'deploy_time_minutes': smap[s]['deploy_time_minutes']})\n        waves.append({'wave_number': w, 'deployments': deployments})\n        prev = teamc\n    return waves\n\nsc = DeploymentScorer()\nsc.load_inputs()\n\ndef make_plan(waves):\n    dur = sum(max(x['deploy_time_minutes'] for x in wv['deployments']) for wv in waves if wv['deployments'])\n    return {'generated_at': datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'), 'total_waves': len(waves), 'estimated_duration_minutes': dur, 'waves': waves}\n\ndef evaluate(plan):\n    sc.plan = plan\n    sc.errors = []\n    cons = sc.validate_constraints()\n    if not all(cons.values()):\n        return None, None, sc.errors[:2]\n    scores = sc.calculate_scores()\n    return sc.compute_total_score(scores), scores, []\n\nbest = None\nN = int(sys.argv[1]) if len(sys.argv) > 1 else 10\nfails = 0\nfor seed in range(N):\n    for noise in [0.0, 3.0]:\n        for cw in [0, 3]:\n            for fill in [0.85, 1.0]:\n                waves = build(seed, noise, cw, fill)\n                plan = make_plan(waves)\n                total, scores, errs = evaluate(plan)\n                if total is None:\n                    fails += 1\n                    if fails <= 3:\n                        print('INVALID', seed, noise, cw, fill, errs)\n                    continue\n                passed = all(scores[k] >= v for k, v in THR.items()) and total >= 0.68\n                key = (passed, total)\n                if best is None or key > best[0]:\n                    best = (key, plan, scores, (seed, noise, cw, fill))\n                    print('best', key, plan['total_waves'], (seed, noise, cw, fill), {k: round(v, 3) for k, v in scores.items()})\nprint('invalid candidates:', fails)\nif best:\n    with open(OUT, 'w') as f:\n        json.dump(best[1], f, indent=2)\n    print('WROTE', OUT, best[0], best[3])\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
