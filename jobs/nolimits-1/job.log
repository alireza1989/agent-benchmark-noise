eturn dict(a)\n\ndef objs(x): return (x['acc'], x['eff'], x['div'])\n\ndef dom(p, q): return all(a >= b for a, b in zip(p, q)) and any(a > b for a, b in zip(p, q))\n\ndef nd_sort(inds):\n    rem = set(range(len(inds))); fronts = []\n    while rem:\n        f = [i for i in rem if not any(dom(objs(inds[j]), objs(inds[i])) for j in rem if j != i)]\n        fronts.append(sorted(f)); rem -= set(f)\n    return fronts\n\ndef crowd(inds, front):\n    dist = {i: 0.0 for i in front}\n    for m in range(3):\n        s = sorted(front, key=lambda i: objs(inds[i])[m])\n        dist[s[0]] = float('inf'); dist[s[-1]] = float('inf')\n        lo = objs(inds[s[0]])[m]; hi = objs(inds[s[-1]])[m]\n        if hi - lo <= 0: continue\n        for k in range(1, len(s) - 1):\n            dist[s[k]] += (objs(inds[s[k+1]])[m] - objs(inds[s[k-1]])[m]) / (hi - lo)\n    return dist\n\ndef assign(inds):\n    fronts = nd_sort(inds)\n    for r, f in enumerate(fronts):\n        cd = crowd(inds, f)\n        for i in f:\n            inds[i]['rank'] = r; inds[i]['crowd'] = cd[i]\n    return fronts\n\ndef tournament(pop):\n    a, b = rng.sample(pop, 2)\n    return a if (a['rank'], -a['crowd']) < (b['rank'], -b['crowd']) else b\n\nARCHIVE = []\ndef make(g):\n    x = build(g)\n    x['id'] = 'arch_%05d' % (len(ARCHIVE) + 1)\n    ARCHIVE.append(x)\n    return x\n\ndef hv2d(pts):\n    pts = sorted(pts)\n    hv = 0.0; prev = 0.0\n    for i, (x, _) in enumerate(pts):\n        h = max(y for _, y in pts[i:])\n        hv += (x - prev) * h\n        prev = x\n    return hv\n\npop = []; seen = set()\nwhile len(pop) < POP:\n    g = new_genome()\n    if build(g)['sig'] in seen: continue\n    seen.add(build(g)['sig'])\n    pop.append(make(g))\nassign(pop)\n\nlog = []\nfor gen in range(GENS):\n    div = len(set(x['sig'] for x in pop)) / float(POP)\n    pm = 0.3 + 0.5 * (1 - div)\n    if gen > 0:\n        kids = []\n        while len(kids) < POP:\n            p1 = tournament(pop); p2 = tournament(pop)\n            cg = cr