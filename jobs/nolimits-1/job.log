path or method not in METHODS:\n            break\n        plan.append((path, method))\n\n    canon = {}\n    for path, _, _, _ in endpoints:\n        canon.setdefault(norm(path), path)\n\n    def in_base(path):\n        return base is None or seg_prefix(base, path) or path.startswith(base)\n\n    allowed = [e for e in endpoints if in_base(e[0]) and e[2] not in excluded]\n\n    if not plan:\n        selected = allowed\n    else:\n        plan_set = set((norm(p), m) for p, m in plan)\n        planned_norms = set(norm(e[0]) for e in allowed if (norm(e[0]), e[1]) in plan_set)\n        parent_norms = set()\n        for e in allowed:\n            m = norm(e[0])\n            if any(m != pn and seg_prefix(m, pn) for pn in planned_norms):\n                parent_norms.add(m)\n        selected = [e for e in allowed\n                    if norm(e[0]) in parent_norms or (norm(e[0]), e[1]) in plan_set]\n\n    seen = set()\n    result = []\n    for path, method, role, perm in selected:\n        key = (norm(path), method, role)\n        if key in seen:\n            continue\n        seen.add(key)\n        result.append((canon[norm(path)], method, role, perm))\n\n    result.sort(key=lambda e: (-len(segs(e[0])), METHOD_ORDER[e[1]], e[2], PERM_ORDER[e[3]], e[0]))\n\n    out_lines = [f'{p} {m} {r} {perm}' for p, m, r, perm in result]\n    text = '\\n'.join(out_lines) + '\\n' if out_lines else '\\n'\n    with open(OUTPUT, 'w') as f:\n        f.write(text)\n\n\nif __name__ == '__main__':\n    main()\nPYEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
