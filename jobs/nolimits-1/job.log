0\n    if r.status_code == 401:\n        log.warning('validate: invalid or expired token: %s', body.get('error'))\n        print('INVALID/EXPIRED (%s): run python3 /app/cli.py retry' % body.get('error'))\n        return 2\n    if r.status_code == 403:\n        log.warning('validate: revoked token')\n        print('REVOKED: %s' % body.get('error'))\n        return 3\n    print('Unexpected status %d: %s' % (r.status_code, r.text))\n    return 4\n\ndef cmd_revoke(a):\n    d = load()\n    types = ['access', 'refresh'] if a.type == 'all' else [a.type]\n    revoked = d.get('revoked', [])\n    for t in types:\n        tok = d.get(t + '_token')\n        if not tok or t in revoked:\n            continue\n        r = call('POST', '/auth/revoke', {'token': tok})\n        if r.status_code == 200:\n            print('Revoked %s token' % t)\n        elif r.status_code == 403:\n            print('%s token was already revoked' % t)\n        elif r.status_code == 401:\n            print('%s token is expired/invalid, nothing to revoke: %s' % (t, r.json().get('error')))\n        else:\n            die('revoke %s failed (%d): %s' % (t, r.status_code, r.text))\n        revoked.append(t)\n    d['revoked'] = revoked\n    save(d)\n    return 0\n\ndef cmd_retry(a):\n    d = load()\n    if d.get('access_token') and 'access' not in d.get('revoked', []):\n        r = call('GET', '/auth/validate', token=d['access_token'])\n        if r.status_code == 200:\n            print('Access token still valid; nothing to do (use acquire to force a new login).')\n            return 0\n        print('Access token not usable (%d); retrying' % r.status_code)\n    user = a.username or d.get('username', 'admin')\n    for i in range(1, a.attempts + 1):\n        if d.get('refresh_token') and 'refresh' not in d.get('revoked', []):\n            r = call('POST', '/auth/refresh', {'refresh_token': d['refresh_token']})\n            if r.status_code == 200:\n                d['access_token'] = r.json()['access_token']