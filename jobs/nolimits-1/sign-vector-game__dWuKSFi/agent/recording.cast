[33.877726, "i", "cat > solve.py << 'EOF'\nimport math\nS=[list(map(float,l.split())) for l in open('signs.txt') if l.strip()]\ny=list(map(float,open('sum.txt').read().split()))\nn=len(S)\nQ=[];idx=[];r=y[:]\nfor step in range(16):\n    best=(-1,None,None)\n    for i in range(n):\n        if i in idx: continue\n        v=S[i][:]\n        for q in Q:\n            d=sum(a*b for a,b in zip(v,q))\n            v=[a-d*b for a,b in zip(v,q)]\n        nv2=sum(a*a for a in v)\n        if nv2<1e-9: continue\n        g=sum(a*b for a,b in zip(v,r))\n        sc=g*g/nv2\n        if sc>best[0]: best=(sc,i,v)\n    sc,i,v=best\n    nv=math.sqrt(sum(a*a for a in v))\n    q=[a/nv for a in v]\n    Q.append(q); idx.append(i)\n    g=sum(a*b for a,b in zip(q,r))\n    r=[a-g*b for a,b in zip(r,q)]\n    print(step,i+1,round(math.sqrt(sum(a*a for a in r)),6),flush=True)\nprint(sorted(i+1 for i in idx))\nopen('players.txt','w').write('\\n'.join(str(i+1) for i in sorted(idx))+'\\n')\nEOF\n"]
