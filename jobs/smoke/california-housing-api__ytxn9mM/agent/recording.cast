[103.673664, "i", "cat > /app/api_test.py << 'EOF'\nimport json\nimport pickle\nimport numpy as np\nimport pandas as pd\nimport requests\nfrom sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error\n\nFEATURES = ['MedInc', 'HouseAge', 'AveRooms', 'AveBedrms', 'Population', 'AveOccup', 'Latitude', 'Longitude']\ndf = pd.read_csv('/app/data/train.csv').reset_index(drop=True)\nwith open('/app/output/split_info.json') as f:\n    split = json.load(f)\nva_idx = split['validation_indices']\nX_va = df.iloc[va_idx][FEATURES].values\ny_va = df.iloc[va_idx]['target'].values\n\nurl = 'http://localhost:8000/predict'\npreds = []\nfor row in X_va:\n    r = requests.post(url, json={'features': [float(v) for v in row]})\n    r.raise_for_status()\n    preds.append(r.json()['prediction'])\npreds = np.array(preds)\n\nout = pd.DataFrame({\n    'sample_index': np.arange(len(y_va)),\n    'y_true': y_va,\n    'y_pred': preds,\n    'absolute_error': np.abs(y_va - preds),\n})\nout.to_csv('/app/output/api_predictions.csv', index=False)\n\nmse = mean_squared_error(y_va,"]
[103.674208, "i", " preds)\nmetrics = {\n    'sample_count': int(len(y_va)),\n    'mae': float(mean_absolute_error(y_va, preds)),\n    'mse': float(mse),\n    'rmse': float(np.sqrt(mse)),\n    'r2_score': float(r2_score(y_va, preds)),\n}\nwith open('/app/output/api_metrics.json', 'w') as f:\n    json.dump(metrics, f, indent=2)\nprint('API metrics:', metrics)\n\nwith open('/app/models/best_model.pkl', 'rb') as f:\n    model = pickle.load(f)\ndirect = model.predict(X_va)\nprint('Max abs diff API vs direct:', float(np.max(np.abs(direct - preds))))\n\nbatch = requests.post('http://localhost:8000/predict-batch', json={'features_list': [[float(v) for v in r] for r in X_va[:5]]})\nprint('Batch response:', batch.json())\nprint('Batch matches single:', np.allclose(batch.json()['predictions'], preds[:5]))\nEOF\ncd /app && python3 api_test.py && head -3 /app/output/api_predictions.csv && python3 -c \"import json; json.load(open('/app/output/api_metrics.json')); json.load(open('/app/output/split_info.json')); json.load(open('/app/output/model_comparison.json'))"]
