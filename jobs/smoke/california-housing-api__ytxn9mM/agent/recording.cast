[86.886475, "i", "cat > /app/api/app.py << 'EOF'\nimport json\nimport pickle\nfrom contextlib import asynccontextmanager\nfrom typing import List\n\nfrom fastapi import FastAPI, HTTPException\nfrom pydantic import BaseModel, Field\n\nMODEL = None\nMODEL_NAME = None\nMODEL_TYPE = None\n\n\n@asynccontextmanager\nasync def lifespan(app):\n    global MODEL, MODEL_NAME, MODEL_TYPE\n    with open('/app/models/best_model.pkl', 'rb') as f:\n        MODEL = pickle.load(f)\n    try:\n        with open('/app/output/model_comparison.json') as f:\n            MODEL_NAME = json.load(f)['best_model_name']\n    except Exception:\n        MODEL_NAME = type(MODEL).__name__\n    MODEL_TYPE = type(MODEL).__name__\n    yield\n\n\napp = FastAPI(title='California Housing Price API', lifespan=lifespan)\n\n\nclass PredictRequest(BaseModel):\n    features: List[float] = Field(..., min_length=8, max_length=8)\n\n\nclass BatchRequest(BaseModel):\n    features_list: List[List[float]]\n\n\n@app.post('/predict')\ndef predict(req: PredictRequest):\n    pred = MODEL.predict([req.features])\n    retur"]
[86.88682, "o", "cat > /app/api/app.py << 'EOF'\r\n\u001b[?2004l\r"]
[86.88689, "i", "n {'prediction': float(pred[0]), 'model_name': MODEL_NAME}\n\n\n@app.get('/health')\ndef health():\n    return {'status': 'healthy', 'model_loaded': MODEL is not None}\n\n\n@app.get('/model-info')\ndef model_info():\n    return {'model_name': MODEL_NAME, 'model_type': MODEL_TYPE, 'features_count': 8}\n\n\n@app.post('/predict-batch')\ndef predict_batch(req: BatchRequest):\n    for row in req.features_list:\n        if len(row) != 8:\n            raise HTTPException(status_code=422, detail='Each inner array must have exactly 8 features')\n    if len(req.features_list) == 0:\n        return {'predictions': [], 'model_name': MODEL_NAME, 'count': 0}\n    preds = MODEL.predict(req.features_list)\n    return {\n        'predictions': [float(p) for p in preds],\n        'model_name': MODEL_NAME,\n        'count': len(preds),\n    }\nEOF\ncd /app && nohup uvicorn api.app:app --host 0.0.0.0 --port 8000 > /app/output/server.log 2>&1 &\nsleep 5 && curl -s http://localhost:8000/health && echo && curl -s http://localhost:8000/model-info && echo\n"]
[86.888192, "o", "\u001b[?2004h> "]
