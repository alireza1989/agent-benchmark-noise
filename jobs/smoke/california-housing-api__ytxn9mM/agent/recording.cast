[86.889217, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> class PredictRequest(BaseModel):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.889385, "o", "    features: List[float] = Field(..., min_length=8, max_length=8)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.889662, "o", "class BatchRequest(BaseModel):\r\n\u001b[?2004l\r\u001b[?2004h>     features_list: List[List[float]]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @app.post('/predict')\r\n\u001b[?2004l\r\u001b[?2004h> def predict(req: PredictRequest):\r\n\u001b[?2004l\r"]
[86.889691, "o", "\u001b[?2004h> "]
[86.889958, "o", "    pred = MODEL.predict([req.features])\r\n\u001b[?2004l\r\u001b[?2004h>     return {'prediction': float(pred[0]), 'model_name': MODEL_NAME}\r\n\u001b[?2004l\r"]
[86.890032, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[86.890178, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> @app.get('/health')\r\n\u001b[?2004l\r\u001b[?2004h> def health():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.890249, "o", "    return {'status': 'healthy', 'model_loaded': MODEL is not None}\r\n\u001b[?2004l\r"]
[86.890308, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @app.get('/model-info')\r\n\u001b[?2004l\r"]
[86.890331, "o", "\u001b[?2004h> "]
[86.890423, "o", "def model_info():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.890535, "o", "    return {'model_name': MODEL_NAME, 'model_type': MODEL_TYPE, 'features_count': 8}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[86.890702, "o", "> @app.post('/predict-batch')\r\n\u001b[?2004l\r"]
[86.890803, "o", "\u001b[?2004h> def predict_batch(req: BatchRequest):\r\n\u001b[?2004l\r"]
[86.890877, "o", "\u001b[?2004h> "]
[86.890929, "o", "    for row in req.features_list:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.89104, "o", "        if len(row) != 8:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.891132, "o", "            raise HTTPException(status_code=422, detail='Each inner array must have exactly 8 features')\r\n\u001b[?2004l\r"]
[86.89122, "o", "\u001b[?2004h> "]
[86.891273, "o", "    if len(req.features_list) == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.891388, "o", "        return {'predictions': [], 'model_name': MODEL_NAME, 'count': 0}\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.891412, "o", "> "]
[86.891479, "o", "    preds = MODEL.predict(req.features_list)\r\n\u001b[?2004l\r"]
[86.891562, "o", "\u001b[?2004h>     return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.891694, "o", "        'predictions': [float(p) for p in preds],\r\n\u001b[?2004l\r\u001b[?2004h>         'model_name': MODEL_NAME,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.891772, "o", "        'count': len(preds),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.891804, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.891928, "o", "> EOF\r\n\u001b[?2004l\r"]
[86.894551, "o", "\u001b[?2004hroot@3e26a74ef3e6:/app# "]
[86.894673, "o", "cd /app && nohup uvicorn api.app:app --host 0.0.0.0 --port 8000 > /app/output/server.log 2>&1 &\r\n\u001b[?2004l\r"]
