[26.93998, "i", "cd /app && cat > train.py << 'EOF'\nimport json, pickle\nimport numpy as np\nimport pandas as pd\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.linear_model import LinearRegression, Ridge\nfrom sklearn.ensemble import RandomForestRegressor\nfrom sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error\n\nFEATURES = ['MedInc', 'HouseAge', 'AveRooms', 'AveBedrms', 'Population', 'AveOccup', 'Latitude', 'Longitude']\ndf = pd.read_csv('/app/data/train.csv').reset_index(drop=True)\nX = df[FEATURES]\ny = df['target']\n\nidx = np.arange(len(df))\ntr_idx, va_idx = train_test_split(idx, test_size=0.2, random_state=42)\ntr_idx = np.sort(tr_idx)\nva_idx = np.sort(va_idx)\n\nsplit_info = {\n    'train_size': int(len(tr_idx)),\n    'validation_size': int(len(va_idx)),\n    'random_state': 42,\n    'test_size': 0.2,\n    'train_indices': [int(i) for i in tr_idx],\n    'validation_indices': [int(i) for i in va_idx],\n}\nwith open('/app/output/split_info.json', 'w') as f:\n    json.dump(split_info, f)\n\nX_tr, y_tr = X"]
[26.940288, "i", ".iloc[tr_idx], y.iloc[tr_idx]\nX_va, y_va = X.iloc[va_idx], y.iloc[va_idx]\n\nmodels = {\n    'linear_regression': LinearRegression(),\n    'ridge': Ridge(alpha=1.0, random_state=42),\n    'random_forest': RandomForestRegressor(n_estimators=200, random_state=42, n_jobs=-1),\n}\n\nresults = []\nfitted = {}\nfor name, model in models.items():\n    model.fit(X_tr, y_tr)\n    train_r2 = r2_score(y_tr, model.predict(X_tr))\n    pred_va = model.predict(X_va)\n    mse = mean_squared_error(y_va, pred_va)\n    entry = {\n        'model_name': name,\n        'train_r2': float(train_r2),\n        'val_r2': float(r2_score(y_va, pred_va)),\n        'mae': float(mean_absolute_error(y_va, pred_va)),\n        'mse': float(mse),\n        'rmse': float(np.sqrt(mse)),\n    }\n    results.append(entry)\n    fitted[name] = model\n    with open(f'/app/models/{name}.pkl', 'wb') as f:\n        pickle.dump(model, f)\n    print(entry)\n\nbest = max(results, key=lambda r: r['val_r2'])\nbest_name = best['model_name']\nwith open('/app/models/best_model.pkl', 'wb') as f"]
[26.940508, "o", "cd /app && cat > train.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.940603, "i", ":\n    pickle.dump(fitted[best_name], f)\n\ncomparison = {'models': results, 'best_model_name': best_name}\nwith open('/app/output/model_comparison.json', 'w') as f:\n    json.dump(comparison, f, indent=2)\nprint('Best model:', best_name)\nEOF\nmkdir -p /app/output /app/models /app/api && python3 train.py\n"]
