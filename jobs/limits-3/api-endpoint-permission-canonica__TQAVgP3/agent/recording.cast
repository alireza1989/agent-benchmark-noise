[5.078533, "o", "\u001b[?2004hroot@ee4a33fb5199:/app# "]
[44.676742, "i", "cat > /app/canonicalize.py << 'EOF'\nimport re\n\nMETHODS = {'GET', 'POST', 'PUT', 'DELETE', 'PATCH'}\nPERMS = {'ALLOW', 'DENY'}\nNL = chr(10)\n\n\ndef norm(p):\n    return re.sub('[{][A-Za-z0-9_-]+[}]', '{var}', p)\n\n\ndef segs(p):\n    return len([s for s in p.split('/') if s])\n\n\ndef is_prefix(a, b):\n    if a == b:\n        return True\n    return b.startswith(a.rstrip('/') + '/')\n\n\ndef main():\n    try:\n        with open('/app/input.txt', 'r') as fh:\n            raw = fh.read().splitlines()\n    except OSError:\n        raw = []\n\n    parts = []\n    cur = []\n    for line in raw:\n        if line.strip() == '':\n            parts.append(cur)\n            cur = []\n        else:\n            cur.append(line)\n    parts.append(cur)\n\n    ep_lines = parts[0] if len(parts) > 0 else []\n    be_lines = parts[1] if len(parts) > 1 else []\n    plan_lines = [l for grp in parts[2:] for l in grp]\n\n    endpoints = []\n    for line in ep_lines:\n        f = line.split()\n        if len(f) != 4:\n            break\n        path, m, role, perm = f\n     "]
[44.677215, "o", "cat > /app/canonicalize.py << 'EOF'\r\n\u001b[?2004l\r"]
[44.677273, "i", "   m = m.upper()\n        perm = perm.upper()\n        if m not in METHODS or perm not in PERMS:\n            break\n        endpoints.append((path, m, role, perm))\n\n    base = None\n    excl = set()\n    for line in be_lines:\n        f = line.split()\n        if not f:\n            continue\n        kw = f[0].lower()\n        if kw == 'base' and len(f) >= 2:\n            base = f[1]\n        elif kw == 'exclude':\n            excl.update(f[1:])\n\n    plan = set()\n    for line in plan_lines:\n        f = line.split()\n        if len(f) != 2:\n            break\n        p, m = f[0], f[1].upper()\n        if m not in METHODS:\n            break\n        plan.add((norm(p), m))\n\n    if base is not None:\n        endpoints = [e for e in endpoints if e[0].startswith(base)]\n\n    canon = {}\n    for path, m, role, perm in endpoints:\n        n = norm(path)\n        if n not in canon:\n            canon[n] = path\n\n    uniq = []\n    seen = set()\n    for path, m, role, perm in endpoints:\n        key = (norm(path), m, role)\n        if key in seen"]
[44.677292, "o", "\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.677299, "i", ":\n            continue\n        seen.add(key)\n        uniq.append((norm(path), m, role, perm))\n\n    if not plan:\n        chosen = [u for u in uniq if u[2] not in excl]\n    else:\n        chosen_set = set()\n        plan_norms = set(u[0] for u in uniq if (u[0], u[1]) in plan)\n        for u in uniq:\n            if (u[0], u[1]) in plan and u[2] not in excl:\n                chosen_set.add(u)\n        all_norms = set(u[0] for u in uniq)\n        for pn in all_norms:\n            if not any(pn != n and is_prefix(pn, n) for n in plan_norms):\n                continue\n            group = [u for u in uniq if u[0] == pn]\n            nonex = [u for u in group if u[2] not in excl]\n            chosen_set.update(nonex if nonex else group)\n        chosen = list(chosen_set)\n\n    chosen.sort(key=lambda u: (-segs(u[0]), u[1], u[2], u[3]))\n    lines = [canon[u[0]] + ' ' + u[1] + ' ' + u[2] + ' ' + u[3] for u in chosen]\n    out = ''.join(l + NL for l in lines) if lines else NL\n    with open('/app/output.txt', 'w') as fh:\n        fh.wri"]
[44.678635, "o", "METHODS = {'GET', 'POST', 'PUT', 'DELETE', 'PATCH'}\r\n\u001b[?2004l\r\u001b[?2004h> PERMS = {'ALLOW', 'DENY'}\r\n\u001b[?2004l\r\u001b[?2004h> NL = chr(10)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def norm(p):\r\n\u001b[?2004l\r\u001b[?2004h>     return re.sub('[{][A-Za-z0-9_-]+[}]', '{var}', p)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def segs(p):\r\n\u001b[?2004l\r\u001b[?2004h>     return len([s for s in p.split('/') if s])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def is_prefix(a, b):\r\n\u001b[?2004l\r\u001b[?2004h>     if a == b:\r\n\u001b[?2004l\r\u001b[?2004h>         return True\r\n\u001b[?2004l\r\u001b[?2004h>     return b.startswith(a.rstrip('/') + '/')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main():\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         with open('/app/input.txt', 'r') as fh:\r\n\u001b[?2004l\r\u001b[?2004h>             raw = fh.read().splitlines()\r\n\u001b[?2004l\r\u001b[?2004h>     except OSError:\r\n\u001b[?2004l\r\u001b[?2004h>         raw = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.678655, "i", "te(out)\n\n\nif __name__ == '__main__':\n    main()\nEOF\n"]
