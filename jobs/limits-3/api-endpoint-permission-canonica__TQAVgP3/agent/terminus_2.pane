[?2004l[?2004h>         raw = []
[?2004l[?2004h> 
[?2004l[?2004h>     parts = []
[?2004l[?2004h>     cur = []
[?2004l[?2004h>     for line in raw:
[?2004l[?2004h>         if line.strip() == '':
[?2004l[?2004h>             parts.append(cur)
[?2004l[?2004h>             cur = []
[?2004l[?2004h>         else:
[?2004l[?2004h>             cur.append(line)
[?2004l[?2004h>     parts.append(cur)
[?2004l[?2004h> 
[?2004l[?2004h>     ep_lines = parts[0] if len(parts) > 0 else []
[?2004l[?2004h>     be_lines = parts[1] if len(parts) > 1 else []
[?2004l[?2004h>     plan_lines = [l for grp in parts[2:] for l in grp]
[?2004l[?2004h> 
[?2004l[?2004h>     endpoints = []
[?2004l[?2004h>     for line in ep_lines:
[?2004l[?2004h>         f = line.split()
[?2004l[?2004h>         if len(f) != 4:
[?2004l[?2004h>             break
[?2004l[?2004h>         path, m, role, perm = f
[?2004l[?2004h>         m = m.upper()
[?2004l[?2004h>         perm = perm.upper()
[?2004l[?2004h>         if m not in METHODS or perm not in PERMS:
[?2004l[?2004h>             break
[?2004l[?2004h>         endpoints.append((path, m, role, perm))
[?2004l[?2004h> 
[?2004l[?2004h>     base = None
[?2004l[?2004h>     excl = set()
[?2004l[?2004h>     for line in be_lines:
[?2004l[?2004h>         f = line.split()
[?2004l[?2004h>         if not f:
[?2004l[?2004h>             continue
[?2004l[?2004h>         kw = f[0].lower()
[?2004l[?2004h>         if kw == 'base' and len(f) >= 2:
[?2004l[?2004h>             base = f[1]
[?2004l[?2004h>         elif kw == 'exclude':
[?2004l[?2004h>             excl.update(f[1:])
[?2004l[?2004h> 
[?2004l[?2004h>     plan = set()
[?2004l[?2004h>     for line in plan_lines:
[?2004l[?2004h>         f = line.split()
[?2004l[?2004h>         if len(f) != 2:
[?2004l[?2004h>             break
[?2004l[?2004h>         p, m = f[0], f[1].upper()
[?2004l[?2004h>         if m not in METHODS:
[?2004l[?2004h>             break
[?2004l[?2004h>         plan.add((norm(p), m))
[?2004l[?2004h> 
[?2004l[?2004h>     if base is not None:
[?2004l[?2004h>         endpoints = [e for e in endpoints if e[0].startswith(base)]
[?2004l[?2004h> 
[?2004l[?2004h>     canon = {}
[?2004l[?2004h>     for path, m, role, perm in endpoints:
[?2004l[?2004h>         n = norm(path)
[?2004l[?2004h>         if n not in canon:
[?2004l[?2004h>             canon[n] = path
[?2004l[?2004h> 
[?2004l[?2004h>     uniq = []
[?2004l[?2004h>     seen = set()
[?2004l[?2004h>     for path, m, role, perm in endpoints:
[?2004l[?2004h>         key = (norm(path), m, role)
[?2004l[?2004h>         if key in seen:
[?2004l[?2004h>             continue
[?2004l[?2004h>         seen.add(key)
[?2004l[?2004h>         uniq.append((norm(path), m, role, perm))
[?2004l[?2004h> 
[?2004l[?2004h>     if not plan:
[?2004l[?2004h>         chosen = [u for u in uniq if u[2] not in excl]
[?2004l[?2004h>     else:
[?2004l[?2004h>         chosen_set = set()
[?2004l[?2004h>         plan_norms = set(u[0] for u in uniq if (u[0], u[1]) in plan)
[?2004l[?2004h>         for u in uniq:
[?2004l[?2004h>             if (u[0], u[1]) in plan and u[2] not in excl:
[?2004l[?2004h>                 chosen_set.add(u)
[?2004l[?2004h>         all_norms = set(u[0] for u in uniq)
[?2004l[?2004h>         for pn in all_norms:
[?2004l[?2004h>             if not any(pn != n and is_prefix(pn, n) for n in plan_norms):
[?2004l[?2004h>                 continue
[?2004l[?2004h>             group = [u for u in uniq if u[0] == pn]
[?2004l[?2004h>             nonex = [u for u in group if u[2] not in excl]
[?2004l[?2004h>             chosen_set.update(nonex if nonex else group)
[?2004l[?2004h>         chosen = list(chosen_set)
[?2004l[?2004h> 
[?2004l[?2004h>     chosen.sort(key=lambda u: (-segs(u[0]), u[1], u[2], u[3]))
[?2004l[?2004h>     lines = [canon[u[0]] + ' ' + u[1] + ' ' + u[2] + ' ' + u[3] for u in chosen]
[?2004l[?2004h>     out = ''.join(l + NL for l in lines) if lines else NL
[?2004l[?2004h>     with open('/app/output.txt', 'w') as fh:
