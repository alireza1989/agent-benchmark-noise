[?2004l[?2004h> PERMS = {'ALLOW', 'DENY'}
[?2004l[?2004h> NL = chr(10)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def norm(p):
[?2004l[?2004h>     return re.sub('[{][A-Za-z0-9_-]+[}]', '{var}', p)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def segs(p):
[?2004l[?2004h>     return len([s for s in p.split('/') if s])
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def is_prefix(a, b):
[?2004l[?2004h>     if a == b:
[?2004l[?2004h>         return True
[?2004l[?2004h>     return b.startswith(a.rstrip('/') + '/')
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     try:
[?2004l[?2004h>         with open('/app/input.txt', 'r') as fh:
[?2004l[?2004h>             raw = fh.read().splitlines()
