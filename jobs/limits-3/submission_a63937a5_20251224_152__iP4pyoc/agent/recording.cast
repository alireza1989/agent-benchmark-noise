[20.99063, "i", "sed -i '$d' /app/player.py && cat >> /app/player.py << 'EOF'\nif __name__ == '__main__':\n    res = []\n    for s in [42, 43, 44]:\n        d = play(s)\n        print(d)\n        kv = dict(x.split('=') for x in d.split()[1:])\n        res.append((float(kv['total_reward']), float(kv['regret'])))\n    tr = sum(r[0] for r in res) / 3\n    rg = sum(r[1] for r in res) / 3\n    with open('/app/answer.txt', 'w') as f:\n        f.write('total_reward=%.3f\\nregret=%.3f\\n' % (tr, rg))\n    print(open('/app/answer.txt').read())\nEOF\n"]
