[?2004l[H[J[3Jimport numpy as np
from .base import BaseLayer
from .padding import zero_pad, get_output_shape


class Conv2D(BaseLayer):
    def __init__(self, in_channels, out_channels, kernel_size, stride=1, padding=0, dilation=1):
        super().__init__()
        self.in_channels = int(in_channels)
        self.out_channels = int(out_channels)
        self.kernel_size = int(kernel_size)
        self.stride = int(stride)
        self.padding = int(padding)
        self.dilation = int(dilation)
        k = self.kernel_size
        fan_in = self.in_channels * k * k
        fan_out = self.out_channels * k * k
        limit = np.sqrt(6.0 / (fan_in + fan_out))
        self.weights = np.random.uniform(-limit, limit, size=(self.out_channels, self.in_channels, k, k)).astype(np.float64)
        self.bias = np.zeros(self.out_channels, dtype=np.float64)

    def forward(self, x):
        x = np.asarray(x, dtype=np.float64)
        n, h, w, c = x.shape
        k, s, p, d = self.kernel_size, self.stride, self.padding, self.dilation
        xp = zero_pad(x, p) if p > 0 else x
        oh, ow = get_output_shape((h, w), k, s, p, d)
        out = np.zeros((n, oh, ow, self.out_channels), dtype=np.float64)
        for i in range(k):
            for j in range(k):
                hs = i * d
                ws = j * d
                patch = xp[:, hs:hs + s * (oh - 1) + 1:s, ws:ws + s * (ow - 1) + 1:s, :]
                out += np.einsum('nhwc,oc->nhwo', patch, self.weights[:, :, i, j])
        out += self.bias
        return out
