[52.126158, "i", "cat > /tmp/check.py << 'EOF'\nimport numpy as np\nfrom src import Conv2D, BatchNorm2D\nnp.random.seed(0)\nx = np.random.randn(2, 9, 9, 3)\nc = Conv2D(3, 4, 3, stride=2, padding=1, dilation=2)\nxp = np.pad(x, ((0, 0), (1, 1), (1, 1), (0, 0)))\noh, ow = 4, 4\nW = c.weights\nref = np.zeros((2, oh, ow, 4))\nfor a in range(oh):\n    for b in range(ow):\n        for i in range(3):\n            for j in range(3):\n                ref[:, a, b, :] += xp[:, a*2 + i*2, b*2 + j*2, :] @ W[:, :, i, j].T\nref += c.bias\nprint('conv shape', c(x).shape, 'maxerr', np.abs(c(x) - ref).max())\n\nbn = BatchNorm2D(3, momentum=0.1)\ny = np.random.randn(4, 5, 5, 3) * 2 + 3\nout = bn(y, training=True)\nprint('bn train mean', out.mean(axis=(0,1,2)).round(6), 'std', out.std(axis=(0,1,2)).round(4))\nprint('running_mean', bn.running_mean.round(4), 'expected', (0.1 * y.mean(axis=(0,1,2))).round(4))\nprint('running_var', bn.running_var.round(4), 'expected', (0.9 + 0.1 * y.var(axis=(0,1,2))).round(4))\nprint('bn eval shape', bn(y, training=False).shape)\nEOF\npython3"]
[52.126413, "i", " /tmp/check.py\n"]
