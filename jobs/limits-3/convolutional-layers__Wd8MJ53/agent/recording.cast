[27.105352, "i", "cat > /app/src/pooling.py << 'EOF'\nimport numpy as np\nfrom .base import BaseLayer\n\n\ndef _pool_slices(x, kernel_size, stride):\n    n, h, w, c = x.shape\n    k, s = kernel_size, stride\n    oh = (h - k) // s + 1\n    ow = (w - k) // s + 1\n    for i in range(k):\n        for j in range(k):\n            yield x[:, i:i + s * (oh - 1) + 1:s, j:j + s * (ow - 1) + 1:s, :]\n\n\nclass MaxPool2D(BaseLayer):\n    def __init__(self, kernel_size, stride=None):\n        super().__init__()\n        self.kernel_size = int(kernel_size)\n        self.stride = int(stride) if stride is not None else self.kernel_size\n\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        out = None\n        for patch in _pool_slices(x, self.kernel_size, self.stride):\n            out = patch.copy() if out is None else np.maximum(out, patch)\n        return out.astype(np.float64)\n\n\nclass AvgPool2D(BaseLayer):\n    def __init__(self, kernel_size, stride=None):\n        super().__init__()\n        self.kernel_size = int(kernel_size)\n        sel"]
[27.105398, "i", "f.stride = int(stride) if stride is not None else self.kernel_size\n\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        out = None\n        for patch in _pool_slices(x, self.kernel_size, self.stride):\n            out = patch.copy() if out is None else out + patch\n        return (out / (self.kernel_size * self.kernel_size)).astype(np.float64)\nEOF\n"]
