[38.25223, "o", "\u001b[H\u001b[J\u001b[3J"]
[38.252952, "o", "import numpy as np\r\nfrom .base import BaseLayer\r\nfrom .padding import zero_pad, get_output_shape\r\n\r\n\r\nclass Conv2D(BaseLayer):\r\n    def __init__(self, in_channels, out_channels, kernel_size, stride=1, padding=0, dilation=1):\r\n        super().__init__()\r\n        self.in_channels = int(in_channels)\r\n        self.out_channels = int(out_channels)\r\n        self.kernel_size = int(kernel_size)\r\n        self.stride = int(stride)\r\n        self.padding = int(padding)\r\n        self.dilation = int(dilation)\r\n        k = self.kernel_size\r\n        fan_in = self.in_channels * k * k\r\n        fan_out = self.out_channels * k * k\r\n        limit = np.sqrt(6.0 / (fan_in + fan_out))\r\n        self.weights = np.random.uniform(-limit, limit, size=(self.out_channels, self.in_channels, k, k)).astype(np.float64)\r\n        self.bias = np.zeros(self.out_channels, dtype=np.float64)\r\n\r\n    def forward(self, x):\r\n        x = np.asarray(x, dtype=np.float64)\r\n        n, h, w, c = x.shape\r\n        k, s, p, d = self.kernel_size, self.stride, self"]
[38.253004, "o", ".padding, self.dilation\r\n        xp = zero_pad(x, p) if p > 0 else x\r\n        oh, ow = get_output_shape((h, w), k, s, p, d)\r\n        out = np.zeros((n, oh, ow, self.out_channels), dtype=np.float64)\r\n        for i in range(k):\r\n            for j in range(k):\r\n                hs = i * d\r\n                ws = j * d\r\n                patch = xp[:, hs:hs + s * (oh - 1) + 1:s, ws:ws + s * (ow - 1) + 1:s, :]\r\n                out += np.einsum('nhwc,oc->nhwo', patch, self.weights[:, :, i, j])\r\n        out += self.bias\r\n        return out\r\n"]
[38.253347, "o", "\u001b[?2004hroot@7e3bd4fe252b:/app# "]
[38.755463, "i", "cd /app && python3 -c \"import numpy as np; from src import Conv2D, Conv2DTranspose, BaseLayer, BatchNorm2D; np.random.seed(0); x=np.random.randn(2,9,9,3); c=Conv2D(3,4,3,stride=2,padding=1,dilation=2); xp=np.pad(x,((0,0),(1,1),(1,1),(0,0))); oh,ow=3,3; ref=np.zeros((2,oh,ow,4)); W=c.weights\nfor a in range(oh):\n  for b in range(ow):\n    for i in range(3):\n      for j in range(3):\n        ref[:,a,b,:]+=xp[:,a*2+i*2,b*2+j*2,:]@W[:,:,i,j].T\nref+=c.bias; print('conv maxerr', np.abs(c(x)-ref).max()); print(c(x).shape)\"\n"]
