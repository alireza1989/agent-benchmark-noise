[26.735992, "i", "cat > /app/src/conv_transpose.py << 'EOF'\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass Conv2DTranspose(BaseLayer):\n    def __init__(self, in_channels, out_channels, kernel_size, stride=1, padding=0):\n        super().__init__()\n        self.in_channels = int(in_channels)\n        self.out_channels = int(out_channels)\n        self.kernel_size = int(kernel_size)\n        self.stride = int(stride)\n        self.padding = int(padding)\n        k = self.kernel_size\n        fan_in = self.in_channels * k * k\n        fan_out = self.out_channels * k * k\n        limit = np.sqrt(6.0 / (fan_in + fan_out))\n        self.weights = np.random.uniform(-limit, limit, size=(self.in_channels, self.out_channels, k, k)).astype(np.float64)\n        self.bias = np.zeros(self.out_channels, dtype=np.float64)\n\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        n, h, w, c = x.shape\n        k, s, p = self.kernel_size, self.stride, self.padding\n        full_h = (h - 1) * s + k\n        full_w = (w - 1) * s + k"]
[26.736164, "i", "\n        out = np.zeros((n, full_h, full_w, self.out_channels), dtype=np.float64)\n        for i in range(k):\n            for j in range(k):\n                contrib = np.einsum('nhwc,co->nhwo', x, self.weights[:, :, i, j])\n                out[:, i:i + s * (h - 1) + 1:s, j:j + s * (w - 1) + 1:s, :] += contrib\n        if p > 0:\n            out = out[:, p:full_h - p, p:full_w - p, :]\n        out += self.bias\n        return out\nEOF\n"]
