[25.621072, "i", "cat > /app/src/base.py << 'EOF'\nfrom abc import ABC, abstractmethod\n\n\nclass BaseLayer(ABC):\n    def __init__(self):\n        pass\n\n    def __call__(self, x, *args, **kwargs):\n        return self.forward(x, *args, **kwargs)\n\n    @abstractmethod\n    def forward(self, x):\n        raise NotImplementedError\nEOF\n"]
