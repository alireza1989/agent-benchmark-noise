[25.989138, "i", "cat > /app/src/padding.py << 'EOF'\nimport numpy as np\n\n\ndef zero_pad(x, pad):\n    x = np.asarray(x, dtype=np.float64)\n    if pad == 0:\n        return x.copy()\n    return np.pad(x, ((0, 0), (pad, pad), (pad, pad), (0, 0)), mode='constant', constant_values=0.0).astype(np.float64)\n\n\ndef get_output_shape(input_shape, kernel_size, stride, padding, dilation=1):\n    h, w = input_shape\n    oh = (h + 2 * padding - dilation * (kernel_size - 1) - 1) // stride + 1\n    ow = (w + 2 * padding - dilation * (kernel_size - 1) - 1) // stride + 1\n    return (int(oh), int(ow))\nEOF\n"]
[25.98934, "o", "cat > /app/src/padding.py << 'EOF'\r\n\u001b[?2004l\r"]
[25.989366, "o", "\u001b[?2004h> "]
[25.98955, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[25.989656, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def zero_pad(x, pad):\r\n\u001b[?2004l\r\u001b[?2004h>     x = np.asarray(x, dtype=np.float64)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.989752, "o", "    if pad == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.989916, "o", "        return x.copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
