Sending keys: ["cat > /app/solution.py << 'EOF'\nimport json\n\nKEYS = {'Depends', 'Before', 'After', 'Needs', 'Requires', 'Alias', 'Phony'}\nSETKEYS = ('Depends', 'Before', 'After', 'Needs', 'Requires')\n\n\nclass _PE(Exception):\n    pass\n\n\ndef solve(lines):\n    try:\n        return _solve(lines)\n    except _PE:\n        return 'PARSE_ERROR'\n\n\ndef _solve(lines):\n    blocks = []\n    cur = None\n    for raw in lines:\n        s = raw.strip()\n        if not s or s.startswith('#'):\n            continue\n        toks = s.split()\n        if toks[0] == 'TARGET':\n            if len(toks) != 2:\n                raise _PE()\n            cur = {'kind': 'TARGET', 'name': toks[1], 'id': None, 'dirs': [], 'phony': None}\n            blocks.append(cur)\n        elif toks[0] == 'OVERRIDE':\n            if len(toks) != 3:\n                raise _PE()\n            cur = {'kind': 'OVERRIDE', 'name': toks[1], 'id': toks[2], 'dirs': [], 'phony': None}\n            blocks.append(cur)\n        else:\n            if '=' not in s and s.startswith('[') and s.endswith(']'):\n                continue\n            if s.count('=') != 1 or cur is None:\n                raise _PE()\n            k, v = s.split('=')\n            k = k.strip()\n            v = v.strip()\n            if k not in KEYS:\n                raise _PE()\n            if k == 'Phony':\n                if v not in ('yes', 'no'):\n                    raise _PE()\n                cur['phony'] = v\n            else:\n                cur['dirs'].append((k, v.split()))\n\n    universe = set()\n    for b in blocks:\n        universe.add(b['name'])\n        for k, vals in b['dirs']:\n            universe.update(vals)\n\n    parent = {u: u for u in universe}\n\n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    for b in blocks:\n        for k, vals in b['dirs']:\n            if k == 'Alias':\n                for v in vals:\n                    ra = find(b['name'])\n                    rb = find(v)\n                    if ra != rb:\n                        parent[max(ra, rb)] = min(ra, rb)\n\n    members = {}\n    for u in universe:\n        members.setdefault(find(u), []).append(u)\n    canon_of_root = {r: min(m) for r, m in members.items()}\n\n    def canon(x):\n        return canon_of_root[find(x)]\n\n    ordered = [b for b in blocks if b['kind'] == 'TARGET']\n    ordered += sorted([b for b in blocks if b['kind'] == 'OVERRIDE'], key=lambda b: b['id'])\n\n    acc = {}\n    for b in ordered:\n        t = canon(b['name'])\n        a = acc.setdefault(t, {k: set() for k in SETKEYS})\n        for k, vals in b['dirs']:\n            if k in SETKEYS:\n                a[k].update(canon(v) for v in vals)\n\n    nodes = set(canon(u) for u in universe)\n    edges = set()\n    for U, a in acc.items():\n        for x in a['Depends']:\n            edges.add((x, U))\n        for y in a['Before']:\n            edges.add((U, y))\n        for z in a['After']:\n            edges.add((z, U))\n        for w in a['Needs']:\n            edges.add((U, w))\n        for v in a['Requires']:\n            edges.add((U, v))\n\n    adj = {n: set() for n in nodes}\n    for x, y in edges:\n        adj[x].add(y)\n\n    reach = {}\n    for n in nodes:\n        seen = {n}\n        stack = [n]\n        while stack:\n            x = stack.pop()\n            for y in adj[x]:\n                if y not in seen:\n                    seen.add(y)\n                    stack.append(y)\n        reach[n] = seen\n\n    comp_list = []\n    assigned = set()\n    for n in sorted(nodes):\n        if n in assigned:\n            continue\n        comp = sorted(m for m in reach[n] if n in reach[m])\n        assigned.update(comp)\n        comp_list.append(comp)\n\n    comp_of = {}\n    for i, c in enumerate(comp_list):\n        for m in c:\n            comp_of[m] = i\n\n    cycles = []\n    for c in comp_list:\n        if len(c) >= 2 or (c[0], c[0]) in edges:\n            cycles.append(c)\n    cycles.sort()\n\n    n_c = len(comp_list)\n    cadj = [set() for _ in range(n_c)]\n    indeg = [0] * n_c\n    for x, y in edges:\n        i = comp_of[x]\n        j = comp_of[y]\n        if i != j and j not in cadj[i]:\n            cadj[i].add(j)\n            indeg[j] += 1\n\n    avail = [i for i in range(n_c) if indeg[i] == 0]\n    order = []\n    while avail:\n        avail.sort(key=lambda i: comp_list[i][0])\n        i = avail.pop(0)\n        order.extend(comp_list[i])\n        for j in cadj[i]:\n            indeg[j] -= 1\n            if indeg[j] == 0:\n                avail.append(j)\n\n    return json.dumps({'order': order, 'cycles': cycles}, separators=(',', ':'))\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
Sending keys: ["cat > /app/canonicalize.py << 'EOF'\nimport re\n\nMETHODS = {'GET', 'POST', 'PUT', 'DELETE', 'PATCH'}\nPERMS = {'ALLOW', 'DENY'}\nNL = chr(10)\n\n\ndef norm(p):\n    return re.sub('[{][A-Za-z0-9_-]+[}]', '{var}', p)\n\n\ndef segs(p):\n    return len([s for s in p.split('/') if s])\n\n\ndef is_prefix(a, b):\n    if a == b:\n        return True\n    return b.startswith(a.rstrip('/') + '/')\n\n\ndef main():\n    try:\n        with open('/app/input.txt', 'r') as fh:\n            raw = fh.read().splitlines()\n    except OSError:\n        raw = []\n\n    parts = []\n    cur = []\n    for line in raw:\n        if line.strip() == '':\n            parts.append(cur)\n            cur = []\n        else:\n            cur.append(line)\n    parts.append(cur)\n\n    ep_lines = parts[0] if len(parts) > 0 else []\n    be_lines = parts[1] if len(parts) > 1 else []\n    plan_lines = [l for grp in parts[2:] for l in grp]\n\n    endpoints = []\n    for line in ep_lines:\n        f = line.split()\n        if len(f) != 4:\n            break\n        path, m, role, perm = f\n        m = m.upper()\n        perm = perm.upper()\n        if m not in METHODS or perm not in PERMS:\n            break\n        endpoints.append((path, m, role, perm))\n\n    base = None\n    excl = set()\n    for line in be_lines:\n        f = line.split()\n        if not f:\n            continue\n        kw = f[0].lower()\n        if kw == 'base' and len(f) >= 2:\n            base = f[1]\n        elif kw == 'exclude':\n            excl.update(f[1:])\n\n    plan = set()\n    for line in plan_lines:\n        f = line.split()\n        if len(f) != 2:\n            break\n        p, m = f[0], f[1].upper()\n        if m not in METHODS:\n            break\n        plan.add((norm(p), m))\n\n    if base is not None:\n        endpoints = [e for e in endpoints if e[0].startswith(base)]\n\n    canon = {}\n    for path, m, role, perm in endpoints:\n        n = norm(path)\n        if n not in canon:\n            canon[n] = path\n\n    uniq = []\n    seen = set()\n    for path, m, role, perm in endpoints:\n        key = (norm(path), m, role)\n        if key in seen:\n            continue\n        seen.add(key)\n        uniq.append((norm(path), m, role, perm))\n\n    if not plan:\n        chosen = [u for u in uniq if u[2] not in excl]\n    else:\n        chosen_set = set()\n        plan_norms = set(u[0] for u in uniq if (u[0], u[1]) in plan)\n        for u in uniq:\n            if (u[0], u[1]) in plan and u[2] not in excl:\n                chosen_set.add(u)\n        all_norms = set(u[0] for u in uniq)\n        for pn in all_norms:\n            if not any(pn != n and is_prefix(pn, n) for n in plan_norms):\n                continue\n            group = [u for u in uniq if u[0] == pn]\n            nonex = [u for u in group if u[2] not in excl]\n            chosen_set.update(nonex if nonex else group)\n        chosen = list(chosen_set)\n\n    chosen.sort(key=lambda u: (-segs(u[0]), u[1], u[2], u[3]))\n    lines = [canon[u[0]] + ' ' + u[1] + ' ' + u[2] + ' ' + u[3] for u in chosen]\n    out = ''.join(l + NL for l in lines) if lines else NL\n    with open('/app/output.txt', 'w') as fh:\n        fh.write(out)\n\n\nif __name__ == '__main__':\n    main()\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
