Sending keys: ["cat > /app/solve.py << 'EOF'\nimport pandas as pd, numpy as np, json, os\nfrom scipy.stats import norm\nfrom scipy.special import expit\nfrom scipy.optimize import minimize\nos.makedirs('/app/output', exist_ok=True)\nimp = pd.read_csv('/app/data/impressions.csv')\ncv = pd.read_csv('/app/data/conversions.csv')\ntc = pd.read_csv('/app/data/test_contexts.csv')\nimp['conv'] = imp.impression_id.isin(cv.impression_id).astype(int)\nmg = cv.merge(imp[['impression_id', 'arm_id']], on='impression_id')\nld = np.log(cv.delay_hours.values)\nmu = float(ld.mean()); sigma = float(ld.std(ddof=0))\nF72 = norm.cdf((np.log(72.0) - mu) / sigma)\nsnap = cv.conversion_timestamp.max()\nage = np.maximum((snap - imp.timestamp.values) / 3600.0, 1e-3)\nFm = np.minimum(norm.cdf((np.log(np.minimum(age, 72.0)) - mu) / sigma) / F72, 1.0)\nimp['Fm'] = Fm\nimp['mature'] = (age >= 72).astype(int)\nq_all = imp.conv.sum() / imp.Fm.sum()\narm = imp.groupby('arm_id').agg(n=('conv', 'size'), c=('conv', 'sum'), ex=('Fm', 'sum'))\narm['q'] = arm.c / arm.ex\narm['v'] = mg.groupby('arm_id').conversion_value.mean()\ndef feats(df):\n    s = pd.get_dummies(df.user_segment).reindex(columns=['middle', 'senior', 'young'], fill_value=0).astype(float).values\n    dv = pd.get_dummies(df.device_type).reindex(columns=['desktop', 'mobile', 'tablet'], fill_value=0).astype(float).values\n    h = 2 * np.pi * df.hour_of_day.values / 24.0\n    wk = (df.day_of_week.values >= 5).astype(float)\n    return np.column_stack([np.ones(len(df)), s[:, 0], s[:, 1], dv[:, 0], dv[:, 2], np.sin(h), np.cos(h), np.sin(2 * h), np.cos(2 * h), wk, df.context_feature_1.values, df.context_feature_2.values])\ndef fit(X, y, lam=1.0):\n    def f(w):\n        p = expit(X @ w)\n        ll = -(y * np.log(p + 1e-12) + (1 - y) * np.log(1 - p + 1e-12)).sum() + 0.5 * lam * (w[1:] @ w[1:])\n        g = X.T @ (p - y)\n        g[1:] += lam * w[1:]\n        return ll, g\n    return minimize(f, np.zeros(X.shape[1]), jac=True, method='L-BFGS-B').x\nXt = feats(tc)\nP = np.zeros((len(tc), 10))\nnm = np.zeros(10)\nfor a in range(10):\n    d = imp[(imp.arm_id == a) & (imp.mature == 1)]\n    nm[a] = len(d)\n    w = fit(feats(d), d.conv.values.astype(float))\n    P[:, a] = expit(Xt @ w)\nv = arm.v.values\nR = P * v[None, :]\nsel = R.argmax(1)\nidx = np.arange(len(tc))\nexp_r = R[idx, sel]\nz = 1.2816\nse = np.sqrt(P * (1 - P) / nm[None, :])\nlo = np.maximum(0, P - z * se) * v[None, :]\nhi = (P + z * se) * v[None, :]\npred = pd.DataFrame({'context_id': tc.context_id, 'selected_arm': sel.astype(int), 'expected_reward': exp_r, 'confidence_lower': lo[idx, sel], 'confidence_upper': hi[idx, sel]})\npred.to_csv('/app/output/predictions.csv', index=False)\ndm = {'distribution_type': 'lognormal', 'parameters': {'mu': mu, 'sigma': sigma}, 'median_delay_hours': float(np.exp(mu)), 'p90_delay_hours': float(np.exp(mu + 1.2816 * sigma)), 'conversion_rate_estimate': float(q_all)}\njson.dump(dm, open('/app/output/delay_model.json', 'w'), indent=2)\nas_ = pd.DataFrame({'arm_id': range(10), 'estimated_conversion_rate': arm.q.values, 'estimated_avg_value': arm.v.values, 'total_impressions': arm.n.values.astype(int), 'total_conversions': arm.c.values.astype(int)})\nas_.to_csv('/app/output/arm_statistics.csv', index=False)\nprint('mu', mu, 'sigma', sigma, 'q_all', q_all)\nprint(as_.to_string())\nprint(pd.Series(sel).value_counts().sort_index().to_string())\nprint('mean expected reward', exp_r.mean())\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
