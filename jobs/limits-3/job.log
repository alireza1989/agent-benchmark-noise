Sending keys: ["cat > /app/service.py << 'EOF'\nimport csv\nimport os\nimport shutil\nfrom typing import List, Dict, Tuple\nfrom fastapi import FastAPI, HTTPException, Query\nfrom pydantic import BaseModel\n\napp = FastAPI()\n\nDATA_PATH = '/app/data.csv'\nCHUNK_DIR = '/app/chunks'\n\n# In-memory index only: (Type1, Type2) -> chunk file path. No record data is kept here.\nchunk_index: Dict[Tuple[str, str], str] = {}\nall_type1_values: List[str] = []\nall_type2_values: List[str] = []\ntotal_records = 0\n\n# Type1/Type2 values from the most recent query's loaded chunk\nlast_loaded_type1_values = set()\nlast_loaded_type2_values = set()\n\n\nclass Record(BaseModel):\n    Type1: str\n    Type2: str\n    Text: str\n    ID: int\n\n\ndef build_chunks():\n    # Split data.csv into one CSV file per (Type1, Type2) combination\n    global chunk_index, all_type1_values, all_type2_values, total_records\n\n    if os.path.isdir(CHUNK_DIR):\n        shutil.rmtree(CHUNK_DIR)\n    os.makedirs(CHUNK_DIR)\n\n    groups: Dict[Tuple[str, str], List[dict]] = {}\n    with open(DATA_PATH, 'r', newline='') as f:\n        for row in csv.DictReader(f):\n            key = (row['Type1'], row['Type2'])\n            groups.setdefault(key, []).append(row)\n\n    new_index = {}\n    count = 0\n    for i, key in enumerate(sorted(groups.keys())):\n        path = os.path.join(CHUNK_DIR, f'chunk_{i:03d}.csv')\n        with open(path, 'w', newline='') as out:\n            writer = csv.writer(out)\n            writer.writerow(['Type1', 'Type2', 'Text', 'ID'])\n            for row in groups[key]:\n                writer.writerow([row['Type1'], row['Type2'], row['Text'], row['ID']])\n                count += 1\n        new_index[key] = path\n\n    chunk_index = new_index\n    all_type1_values = sorted({k[0] for k in groups})\n    all_type2_values = sorted({k[1] for k in groups})\n    total_records = count\n    print(f'Wrote {len(chunk_index)} chunks ({total_records} records) to {CHUNK_DIR}')\n\n\ndef load_chunk(key: Tuple[str, str]) -> List[Record]:\n    # Load exactly one chunk file for the given combination\n    path = chunk_index.get(key)\n    if path is None:\n        return []\n    records = []\n    with open(path, 'r', newline='') as f:\n        for row in csv.DictReader(f):\n            records.append(Record(\n                Type1=row['Type1'],\n                Type2=row['Type2'],\n                Text=row['Text'],\n                ID=int(row['ID'])\n            ))\n    return records\n\n\n@app.on_event('startup')\nasync def startup_event():\n    build_chunks()\n\n\n@app.get('/')\nasync def root():\n    return {'status': 'healthy', 'message': 'Service is running'}\n\n\n@app.get('/query')\nasync def query_records(\n    type1: str = Query(..., description='Type1 value to filter by'),\n    type2: str = Query(..., description='Type2 value to filter by')\n) -> List[Record]:\n    global last_loaded_type1_values, last_loaded_type2_values\n\n    if not type1 or not type2:\n        raise HTTPException(status_code=400, detail='Both type1 and type2 are required')\n\n    records = load_chunk((type1, type2))\n\n    last_loaded_type1_values = set()\n    last_loaded_type2_values = set()\n    for r in records:\n        last_loaded_type1_values.add(r.Type1)\n        last_loaded_type2_values.add(r.Type2)\n\n    return records\n\n\n@app.get('/get_all_loaded_types_and_subtypes')\nasync def get_all_loaded_types_and_subtypes() -> dict:\n    return {\n        'type1_values': sorted(last_loaded_type1_values),\n        'type2_values': sorted(last_loaded_type2_values)\n    }\n\n\n@app.get('/get_all_available_types_and_subtypes')\nasync def get_all_available_types_and_subtypes() -> dict:\n    return {\n        'type1_values': list(all_type1_values),\n        'type2_values': list(all_type2_values)\n    }\n\n\n@app.get('/stats')\nasync def get_stats():\n    return {\n        'total_records': total_records,\n        'unique_type1': len(all_type1_values),\n        'unique_type2': len(all_type2_values),\n        'storage_backend': 'CSV chunks'\n    }\n\n\nif __name__ == '__main__':\n    import uvicorn\n    uvicorn.run(app, host='0.0.0.0', port=8000, log_level='info')\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
