= load()\n    if 'access_token' not in d:\n        print('no tokens found; run acquire first', file=sys.stderr)\n        return 1\n    r = validate_token(d['access_token'])\n    if r.status_code == 401 and d.get('refresh_token'):\n        print('access token expired or invalid; attempting refresh')\n        if do_refresh(d):\n            r = validate_token(d['access_token'])\n    print(r.status_code, r.text)\n    if r.status_code == 200:\n        print('VALID')\n        return 0\n    print('INVALID (expired)' if r.status_code == 401 else 'INVALID (revoked)')\n    if r.status_code == 401:\n        log.warning('validate: token expired or invalid')\n    return 3 if r.status_code == 403 else 1\n\n\ndef cmd_revoke(args):\n    d = load()\n    keys = ['access_token', 'refresh_token'] if args.which == 'both' else [args.which + '_token']\n    for k in keys:\n        if k not in d:\n            continue\n        r = post('/auth/revoke', token=d[k])\n        print(k, r.status_code, r.text)\n        if r.status_code == 200:\n            log.info('revoked %s', k)\n        else:\n            log.error('revoke of %s failed: %s %s', k, r.status_code, r.text)\n        if r.status_code in (200, 401):\n            d.pop(k, None)\n    save(d)\n    return 0\n\n\ndef cmd_retry(args):\n    for i in range(1, args.attempts + 1):\n        d = load()\n        if d.get('access_token') and validate_token(d['access_token']).status_code == 200:\n            print('tokens valid; nothing to retry')\n            return 0\n        if do_refresh(d):\n            return 0\n        if do_login(args.username, args.password):\n            return 0\n        wait = 2 ** (i - 1)\n        print('attempt %d failed; retrying in %ds' % (i, wait))\n        time.sleep(wait)\n    print('giving up after %d attempts' % args.attempts, file=sys.stderr)\n    return 1\n\n\ndef main():\n    p = argparse.ArgumentParser(description='JWT auth CLI')\n    sub = p.add_subparsers(dest='cmd', required=True)\n    a = sub.add_parser('acquire')\n    a.add_argument('--username', default='admin')\n    a.add_argument('--password', default='password123')\n    sub.add_parser('validate')\n    rv = sub.add_parser('revoke')\n    rv.add_argument('--which', choices=['access', 'refresh', 'both'], default='both')\n    rt = sub.add_parser('retry')\n    rt.add_argument('--attempts', type=int, default=3)\n    rt.add_argument('--username', default='admin')\n    rt.add_argument('--password', default='password123')\n    args = p.parse_args()\n    handlers = {'acquire': cmd_acquire, 'validate': cmd_validate,\n                'revoke': cmd_revoke, 'retry': cmd_retry}\n    try:\n        return handlers[args.cmd](args)\n    except requests.RequestException as e:\n        log.error('API unreachable at %s: %s', API, e)\n        print('error: API unreachable at', API, file=sys.stderr)\n        return 2\n\n\nif __name__ == '__main__':\n    sys.exit(main())\nEOF\nchmod +x /app/cli.py && echo WROTE_CLI\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
