Sending keys: ["cat > /app/src/padding.py << 'EOF'\nimport numpy as np\n\n\ndef zero_pad(x, pad):\n    x = np.asarray(x, dtype=np.float64)\n    if pad == 0:\n        return x.copy()\n    return np.pad(x, ((0, 0), (pad, pad), (pad, pad), (0, 0)), mode='constant', constant_values=0.0).astype(np.float64)\n\n\ndef get_output_shape(input_shape, kernel_size, stride, padding, dilation=1):\n    h, w = input_shape\n    oh = (h + 2 * padding - dilation * (kernel_size - 1) - 1) // stride + 1\n    ow = (w + 2 * padding - dilation * (kernel_size - 1) - 1) // stride + 1\n    return (int(oh), int(ow))\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/src/conv.py << 'EOF'\nimport numpy as np\nfrom .base import BaseLayer\nfrom .padding import zero_pad, get_output_shape\n\n\nclass Conv2D(BaseLayer):\n    def __init__(self, in_channels, out_channels, kernel_size, stride=1, padding=0, dilation=1):\n        super().__init__()\n        self.in_channels = int(in_channels)\n        self.out_channels = int(out_channels)\n        self.kernel_size = int(kernel_size)\n        self.stride = int(stride)\n        self.padding = int(padding)\n        self.dilation = int(dilation)\n        k = self.kernel_size\n        fan_in = self.in_channels * k * k\n        fan_out = self.out_channels * k * k\n        limit = np.sqrt(6.0 / (fan_in + fan_out))\n        self.weights = np.random.uniform(-limit, limit, size=(self.out_channels, self.in_channels, k, k)).astype(np.float64)\n        self.bias = np.zeros(self.out_channels, dtype=np.float64)\n\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        n, h, w, c = x.shape\n        k, s, p, d = self.kernel_size, self.stride, self.padding, self.dilation\n        xp = zero_pad(x, p) if p > 0 else x\n        oh, ow = get_output_shape((h, w), k, s, p, d)\n        out = np.zeros((n, oh, ow, self.out_channels), dtype=np.float64)\n        for i in range(k):\n            for j in range(k):\n                hs = i * d\n                ws = j * d\n                patch = xp[:, hs:hs + s * (oh - 1) + 1:s, ws:ws + s * (ow - 1) + 1:s, :]\n                out += np.einsum('nhwc,oc->nhwo', patch, self.weights[:, :, i, j])\n        out += self.bias\n        return out\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/src/conv_transpose.py << 'EOF'\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass Conv2DTranspose(BaseLayer):\n    def __init__(self, in_channels, out_channels, kernel_size, stride=1, padding=0):\n        super().__init__()\n        self.in_channels = int(in_channels)\n        self.out_channels = int(out_channels)\n        self.kernel_size = int(kernel_size)\n        self.stride = int(stride)\n        self.padding = int(padding)\n        k = self.kernel_size\n        fan_in = self.in_channels * k * k\n        fan_out = self.out_channels * k * k\n        limit = np.sqrt(6.0 / (fan_in + fan_out))\n        self.weights = np.random.uniform(-limit, limit, size=(self.in_channels, self.out_channels, k, k)).astype(np.float64)\n        self.bias = np.zeros(self.out_channels, dtype=np.float64)\n\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        n, h, w, c = x.shape\n        k, s, p = self.kernel_size, self.stride, self.padding\n        full_h = (h - 1) * s + k\n        full_w = (w - 1) * s + k\n        out = np.zeros((n, full_h, full_w, self.out_channels), dtype=np.float64)\n        for i in range(k):\n            for j in range(k):\n                contrib = np.einsum('nhwc,co->nhwo', x, self.weights[:, :, i, j])\n                out[:, i:i + s * (h - 1) + 1:s, j:j + s * (w - 1) + 1:s, :] += contrib\n        if p > 0:\n            out = out[:, p:full_h - p, p:full_w - p, :]\n        out += self.bias\n        return out\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/src/pooling.py << 'EOF'\nimport numpy as np\nfrom .base import BaseLayer\n\n\ndef _pool_slices(x, kernel_size, stride):\n    n, h, w, c = x.shape\n    k, s = kernel_size, stride\n    oh = (h - k) // s + 1\n    ow = (w - k) // s + 1\n    for i in range(k):\n        for j in range(k):\n            yield x[:, i:i + s * (oh - 1) + 1:s, j:j + s * (ow - 1) + 1:s, :]\n\n\nclass MaxPool2D(BaseLayer):\n    def __init__(self, kernel_size, stride=None):\n        super().__init__()\n        self.kernel_size = int(kernel_size)\n        self.stride = int(stride) if stride is not None else self.kernel_size\n\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        out = None\n        for patch in _pool_slices(x, self.kernel_size, self.stride):\n            out = patch.copy() if out is None else np.maximum(out, patch)\n        return out.astype(np.float64)\n\n\nclass AvgPool2D(BaseLayer):\n    def __init__(self, kernel_size, stride=None):\n        super().__init__()\n        self.kernel_size = int(kernel_size)\n        self.stride = int(stride) if stride is not None else self.kernel_size\n\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        out = None\n        for patch in _pool_slices(x, self.kernel_size, self.stride):\n            out = patch.copy() if out is None else out + patch\n        return (out / (self.kernel_size * self.kernel_size)).astype(np.float64)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/src/normalization.py << 'EOF'\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass BatchNorm2D(BaseLayer):\n    def __init__(self, num_features, eps=1e-5, momentum=0.1):\n        super().__init__()\n        self.num_features = int(num_features)\n        self.eps = eps\n        self.momentum = momentum\n        self.gamma = np.ones(self.num_features, dtype=np.float64)\n        self.beta = np.zeros(self.num_features, dtype=np.float64)\n        self.running_mean = np.zeros(self.num_features, dtype=np.float64)\n        self.running_var = np.ones(self.num_features, dtype=np.float64)\n\n    def forward(self, x, training=True):\n        x = np.asarray(x, dtype=np.float64)\n        axes = (0, 1, 2)\n        if training:\n            mean = x.mean(axis=axes)\n            var = x.var(axis=axes)\n            self.running_mean = (1 - self.momentum) * self.running_mean + self.momentum * mean\n            self.running_var = (1 - self.momentum) * self.running_var + self.momentum * var\n        else:\n            mean = self.running_mean\n            var = self.running_var\n        x_hat = (x - mean) / np.sqrt(var + self.eps)\n        return (self.gamma * x_hat + self.beta).astype(np.float64)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
