+ timedelta(days=1))\n\n# Shared layers\ncount = {}\nfor im in images:\n    for s in {l['sha256'] for l in im['layers']}:\n        count[s] = count.get(s, 0) + 1\nshared = {s for s, c in count.items() if c >= 2}\nimages_shared = [im['name'] for im in images if any(l['sha256'] in shared for l in im['layers'])]\n\nout = {\n    'basic_metrics': {\n        'total_storage_bytes': total,\n        'deduplicated_storage_bytes': dedup,\n        'storage_savings_percent': savings,\n        'cache_hit_ratio': hit\n    },\n    'advanced_metrics': {\n        'compressed_storage_bytes': comp,\n        'monthly_storage_cost_usd': cost,\n        'network_transfer_time_seconds': net,\n        'average_layer_age_days': avg_age,\n        'access_frequency_std_dev': std\n    },\n    'top_layers_by_size': top_layers,\n    'recent_access_summary': {\n        'layers_accessed_last_7_days': last7,\n        'most_recent_layers': most_recent\n    },\n    'shared_layer_analysis': {\n        'images_with_shared_layers': images_shared,\n        'total_shared_layer_count': len(shared)\n    }\n}\n\njson.dump(out, open('output.json', 'w'), indent=2)\nprint(json.dumps(out, indent=2))\nPYEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
