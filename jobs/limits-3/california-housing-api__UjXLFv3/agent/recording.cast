[22.864187, "i", "cat > /app/train.py << 'EOF'\nimport json, pickle\nimport numpy as np\nimport pandas as pd\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.linear_model import LinearRegression, Ridge\nfrom sklearn.ensemble import RandomForestRegressor\nfrom sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error\n\nFEATS = ['MedInc', 'HouseAge', 'AveRooms', 'AveBedrms', 'Population', 'AveOccup', 'Latitude', 'Longitude']\ndf = pd.read_csv('/app/data/train.csv').reset_index(drop=True)\nX = df[FEATS]\ny = df['target']\n\nidx = np.arange(len(df))\ntr_idx, va_idx = train_test_split(idx, test_size=0.2, random_state=42)\ntr_idx = sorted(int(i) for i in tr_idx)\nva_idx = sorted(int(i) for i in va_idx)\n\nsplit_info = {\n    'train_size': len(tr_idx),\n    'validation_size': len(va_idx),\n    'random_state': 42,\n    'test_size': 0.2,\n    'train_indices': tr_idx,\n    'validation_indices': va_idx,\n}\nwith open('/app/output/split_info.json', 'w') as f:\n    json.dump(split_info, f)\n\nXtr = X.iloc[tr_idx].values\nytr = y.iloc[t"]
[22.864547, "i", "r_idx].values\nXva = X.iloc[va_idx].values\nyva = y.iloc[va_idx].values\n\nmodels = {\n    'linear_regression': LinearRegression(),\n    'ridge': Ridge(alpha=1.0),\n    'random_forest': RandomForestRegressor(n_estimators=200, random_state=42, n_jobs=-1),\n}\n\nresults = []\nfor name, m in models.items():\n    m.fit(Xtr, ytr)\n    train_r2 = float(r2_score(ytr, m.predict(Xtr)))\n    pv = m.predict(Xva)\n    mse = float(mean_squared_error(yva, pv))\n    results.append({\n        'model_name': name,\n        'train_r2': train_r2,\n        'val_r2': float(r2_score(yva, pv)),\n        'mae': float(mean_absolute_error(yva, pv)),\n        'mse': mse,\n        'rmse': float(np.sqrt(mse)),\n    })\n    with open(f'/app/models/{name}.pkl', 'wb') as f:\n        pickle.dump(m, f)\n    print(results[-1])\n\nbest = max(results, key=lambda r: r['val_r2'])\nbest_name = best['model_name']\nwith open('/app/models/best_model.pkl', 'wb') as f:\n    pickle.dump(models[best_name], f)\n\nwith open('/app/output/model_comparison.json', 'w') as f:\n    json.dump({'mod"]
