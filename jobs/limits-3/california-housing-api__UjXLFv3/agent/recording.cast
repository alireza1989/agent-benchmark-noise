[146.915322, "i", "cat > /app/api_test.py << 'EOF'\nimport json\nimport pickle\nimport numpy as np\nimport pandas as pd\nimport requests\nfrom sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n\nFEATS = ['MedInc', 'HouseAge', 'AveRooms', 'AveBedrms', 'Population', 'AveOccup', 'Latitude', 'Longitude']\ndf = pd.read_csv('/app/data/train.csv').reset_index(drop=True)\nsplit = json.load(open('/app/output/split_info.json'))\nva = split['validation_indices']\n\nsess = requests.Session()\nrows = []\nfor i, idx in enumerate(va):\n    feats = df.loc[idx, FEATS].astype(float).tolist()\n    r = sess.post('http://localhost:8000/predict', json={'features': feats}, timeout=10)\n    r.raise_for_status()\n    y_true = float(df.loc[idx, 'target'])\n    y_pred = float(r.json()['prediction'])\n    rows.append((i, y_true, y_pred, abs(y_true - y_pred)))\n\nout = pd.DataFrame(rows, columns=['sample_index', 'y_true', 'y_pred', 'absolute_error'])\nout.to_csv('/app/output/api_predictions.csv', index=False)\n\nyt = out['y_true'].values\nyp = out['y_pred'].v"]
[146.917125, "o", "cat > /app/api_test.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[146.917166, "i", "alues\nmse = float(mean_squared_error(yt, yp))\nmetrics = {\n    'sample_count': int(len(out)),\n    'mae': float(mean_absolute_error(yt, yp)),\n    'mse': mse,\n    'rmse': float(np.sqrt(mse)),\n    'r2_score': float(r2_score(yt, yp)),\n}\njson.dump(metrics, open('/app/output/api_metrics.json', 'w'), indent=2)\nprint('API metrics:', metrics)\n\nmodel = pickle.load(open('/app/models/best_model.pkl', 'rb'))\nXva = df.loc[va, FEATS].values.astype(float)\ndirect = model.predict(Xva)\nprint('max |API - direct| =', float(np.max(np.abs(direct - yp))))\nEOF\npython3 /app/api_test.py && head -3 /app/output/api_predictions.csv && cat /app/output/api_metrics.json\n"]
[146.917188, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> import pickle\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import requests\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> FEATS = ['MedInc', 'HouseAge', 'AveRooms', 'AveBedrms', 'Population', 'AveOccup', 'Latitude', 'Longitude']\r\n\u001b[?2004l\r\u001b[?2004h> df = pd.read_csv('/app/data/train.csv').reset_index(drop=True)\r\n\u001b[?2004l\r\u001b[?2004h> split = json.load(open('/app/output/split_info.json'))\r\n\u001b[?2004l\r\u001b[?2004h> va = split['validation_indices']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> sess = requests.Session()\r\n\u001b[?2004l\r\u001b[?2004h> rows = []\r\n\u001b[?2004l\r\u001b[?2004h> for i, idx in enumerate(va):\r\n\u001b[?2004l\r\u001b[?2004h>     feats = df.loc[idx, FEATS].astype(float).tolist()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[146.918277, "o", "    r = sess.post('http://localhost:8000/predict', json={'features': feats}, timeout=10)\r\n\u001b[?2004l\r\u001b[?2004h>     r.raise_for_status()\r\n\u001b[?2004l\r\u001b[?2004h>     y_true = float(df.loc[idx, 'target'])\r\n\u001b[?2004l\r\u001b[?2004h>     y_pred = float(r.json()['prediction'])\r\n\u001b[?2004l\r\u001b[?2004h>     rows.append((i, y_true, y_pred, abs(y_true - y_pred)))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> out = pd.DataFrame(rows, columns=['sample_index', 'y_true', 'y_pred', 'absolute_error'])\r\n\u001b[?2004l\r\u001b[?2004h> out.to_csv('/app/output/api_predictions.csv', index=False)\r\n\u001b[?2004l\r"]
