[100.886569, "i", "mkdir -p /app/api && touch /app/api/__init__.py && cat > /app/api/app.py << 'EOF'\nimport json\nimport os\nimport pickle\nfrom contextlib import asynccontextmanager\nfrom typing import List\n\nimport numpy as np\nfrom fastapi import FastAPI\nfrom pydantic import BaseModel, field_validator\n\nMODEL_PATH = '/app/models/best_model.pkl'\nCOMPARISON_PATH = '/app/output/model_comparison.json'\nN_FEATURES = 8\nstate = {'model': None, 'model_name': None, 'model_type': None}\n\n\n@asynccontextmanager\nasync def lifespan(app):\n    with open(MODEL_PATH, 'rb') as f:\n        model = pickle.load(f)\n    name = 'best_model'\n    if os.path.exists(COMPARISON_PATH):\n        with open(COMPARISON_PATH) as f:\n            name = json.load(f).get('best_model_name', name)\n    state['model'] = model\n    state['model_name'] = name\n    state['model_type'] = type(model).__name__\n    yield\n\n\napp = FastAPI(title='California Housing Price API', lifespan=lifespan)\n\n\nclass PredictRequest(BaseModel):\n    features: List[float]\n\n    @field_validator('features')\n "]
[100.88788, "o", "mkdir -p /app/api && touch /app/api/__init__.py && cat > /app/api/app.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import pickle\r\n\u001b[?2004l\r\u001b[?2004h> from contextlib import asynccontextmanager\r\n\u001b[?2004l\r\u001b[?2004h> from typing import List\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from fastapi import FastAPI\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.888451, "i", "   @classmethod\n    def check_len(cls, v):\n        if len(v) != N_FEATURES:\n            raise ValueError('features must contain exactly 8 values')\n        return v\n\n\nclass BatchRequest(BaseModel):\n    features_list: List[List[float]]\n\n    @field_validator('features_list')\n    @classmethod\n    def check_len(cls, v):\n        for row in v:\n            if len(row) != N_FEATURES:\n                raise ValueError('each inner list must contain exactly 8 values')\n        return v\n\n\n@app.get('/health')\ndef health():\n    return {'status': 'healthy', 'model_loaded': state['model'] is not None}\n\n\n@app.get('/model-info')\ndef model_info():\n    return {\n        'model_name': state['model_name'],\n        'model_type': state['model_type'],\n        'features_count': N_FEATURES,\n    }\n\n\n@app.post('/predict')\ndef predict(req: PredictRequest):\n    X = np.array([req.features], dtype=float)\n    pred = float(state['model'].predict(X)[0])\n    return {'prediction': pred, 'model_name': state['model_name']}\n\n\n@app.post('/predict-batch')"]
[100.888492, "o", "from pydantic import BaseModel, field_validator\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> MODEL_PATH = '/app/models/best_model.pkl'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.888502, "i", "\ndef predict_batch(req: BatchRequest):\n    if len(req.features_list) == 0:\n        preds = []\n    else:\n        X = np.array(req.features_list, dtype=float)\n        preds = [float(p) for p in state['model'].predict(X)]\n    return {\n        'predictions': preds,\n        'model_name': state['model_name'],\n        'count': len(preds),\n    }\nEOF\ncd /app && python3 -c \"import ast; ast.parse(open('/app/api/app.py').read()); print('syntax ok')\"\n"]
[100.88866, "o", "COMPARISON_PATH = '/app/output/model_comparison.json'\r\n\u001b[?2004l\r\u001b[?2004h> N_FEATURES = 8\r\n\u001b[?2004l\r\u001b[?2004h> state = {'model': None, 'model_name': None, 'model_type': None}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @asynccontextmanager\r\n\u001b[?2004l\r\u001b[?2004h> async def lifespan(app):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.888763, "o", "    with open(MODEL_PATH, 'rb') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.888777, "o", "        model = pickle.load(f)"]
[100.888884, "o", "\r\n"]
[100.890222, "o", "\u001b[?2004l\r\u001b[?2004h>     name = 'best_model'\r\n\u001b[?2004l\r\u001b[?2004h>     if os.path.exists(COMPARISON_PATH):\r\n\u001b[?2004l\r\u001b[?2004h>         with open(COMPARISON_PATH) as f:\r\n\u001b[?2004l\r\u001b[?2004h>             name = json.load(f).get('best_model_name', name)\r\n\u001b[?2004l\r\u001b[?2004h>     state['model'] = model\r\n\u001b[?2004l\r\u001b[?2004h>     state['model_name'] = name\r\n\u001b[?2004l\r\u001b[?2004h>     state['model_type'] = type(model).__name__\r\n\u001b[?2004l\r\u001b[?2004h>     yield\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> app = FastAPI(title='California Housing Price API', lifespan=lifespan)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class PredictRequest(BaseModel):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.890524, "o", "    features: List[float]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     @field_validator('features')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.890703, "o", "    @classmethod\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.890717, "o", "    def check_len(cls, v):\r\n\u001b[?2004l\r"]
[100.890819, "o", "\u001b[?2004h>         if len(v) != N_FEATURES:\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.891036, "o", ">             raise ValueError('features must contain exactly 8 values')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.891219, "o", "        return v\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.891371, "o", "class BatchRequest(BaseModel):\r\n\u001b[?2004l\r\u001b[?2004h>     features_list: List[List[float]]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.891476, "o", "    @field_validator('features_list')\r\n\u001b[?2004l\r\u001b[?2004h>     @classmethod\r\n\u001b[?2004l\r"]
[100.891504, "o", "\u001b[?2004h> "]
[100.891576, "o", "    def check_len(cls, v):\r\n\u001b[?2004l\r"]
[100.891666, "o", "\u001b[?2004h>         for row in v:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.891732, "o", "            if len(row) != N_FEATURES:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.891804, "o", "                raise ValueError('each inner list must contain exactly 8 values')\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.891875, "o", ">         return v\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[100.891939, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @app.get('/health')\r\n\u001b[?2004l\r"]
[100.892015, "o", "\u001b[?2004h> def health():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.89209, "o", "    return {'status': 'healthy', 'model_loaded': state['model'] is not None}\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.892185, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[100.892206, "o", "\u001b[?2004l\r\u001b[?2004h> @app.get('/model-info')\r\n\u001b[?2004l\r"]
[100.892256, "o", "\u001b[?2004h> def model_info():\r\n\u001b[?2004l\r"]
[100.892324, "o", "\u001b[?2004h>     return {\r\n\u001b[?2004l\r"]
[100.892345, "o", "\u001b[?2004h> "]
[100.892434, "o", "        'model_name': state['model_name'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.892522, "o", "        'model_type': state['model_type'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.892576, "o", ">         'features_count': N_FEATURES,\r\n\u001b[?2004l\r"]
[100.892629, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.892653, "o", "\r\n\u001b[?2004l\r"]
[100.892703, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.89272, "o", "@app.post('/predict')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.892801, "o", "def predict(req: PredictRequest):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.892889, "o", "    X = np.array([req.features], dtype=float)\r\n"]
[100.892909, "o", "\u001b[?2004l\r"]
[100.892982, "o", "\u001b[?2004h> "]
[100.893018, "o", "    pred = float(state['model'].predict(X)[0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.893118, "o", "    return {'prediction': pred, 'model_name': state['model_name']}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[100.893189, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.893246, "o", "@app.post('/predict-batch')\r\n\u001b[?2004l\r"]
[100.893278, "o", "\u001b[?2004h> "]
[100.893335, "o", "def predict_batch(req: BatchRequest):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.89339, "o", "    if len(req.features_list) == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.893465, "o", "        preds = []\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.893562, "o", "        X = np.array(req.features_list, dtype=float)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.893664, "o", "        preds = [float(p) for p in state['model'].predict(X)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.89377, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.893851, "o", "        'predictions': preds,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.893921, "o", "        'model_name': state['model_name'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.893958, "o", "        'count': len(preds),\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[100.894056, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[100.89781, "o", "\u001b[?2004hroot@a4ca0297672b:/app# "]
