[?2004hroot@790cec704ee7:/app# cat > /app/kiln_firmware.py << 'EOF'
[?2004l[?2004h> import json, csv
[?2004l[?2004h> 
[?2004l[?2004h> def run_firing_cycle(schedule_path, specs_path, W=300):
[?2004l[?2004h>     with open(specs_path) as f:
[?2004l[?2004h>         s = json.load(f)
[?2004l[?2004h>     G = float(s['gas_burner_power_c'])
[?2004l[?2004h>     C = float(s['damper_cooling_c'])
[?2004l[?2004h>     A = float(s['ambient_loss_c'])
[?2004l[?2004h>     with open(schedule_path) as f:
[?2004l[?2004h>         tgt = [float(r['target_temp']) for r in csv.DictReader(f)]
[?2004l[?2004h>     N = len(tgt)
[?2004l[?2004h>     nodes = []  # (parent_id, gas, damper)
[?2004l[?2004h>     # beam entries: (cost, T, g_prev1, g_prev2, total_gas, node_id)
[?2004l[?2004h>     beam = [(0.0, tgt[0], 0, 0, 0, -1)]
[?2004l[?2004h>     for t in range(N):
[?2004l[?2004h>         nt = tgt[t + 1] if t + 1 < N else tgt[-1]
[?2004l[?2004h>         cands = {}
[?2004l[?2004h>         for (cost, T, g1, g2, gas, nid) in beam:
[?2004l[?2004h>             for g in range(6):
[?2004l[?2004h>                 base = T + G * (0.3 * g1 + 0.6 * g2)
[?2004l[?2004h>                 gk = G * 0.1 * g
[?2004l[?2004h>                 for d in range(6):
[?2004l[?2004h>                     Tn = base + gk - (C * d + A)
[?2004l[?2004h>                     if Tn < T - 5.0:
[?2004l[?2004h>                         continue
[?2004l[?2004h>                     c = cost + abs(Tn - nt) + 0.001 * g
[?2004l[?2004h>                     key = (round(Tn, 2), g, g1)
[?2004l[?2004h>                     old = cands.get(key)
[?2004l[?2004h>                     if old is None or c < old[0]:
[?2004l[?2004h>                         cands[key] = (c, Tn, g, g1, gas + g, nid, d)
[?2004l[?2004h>         if not cands:
[?2004l[?2004h>             raise RuntimeError('infeasible at step %d' % t)
[?2004l[?2004h>         top = sorted(cands.values(), key=lambda x: x[0])[:W]
[?2004l[?2004h>         newbeam = []
[?2004l[?2004h>         for (c, Tn, g, g1, gas, pid, d) in top:
[?2004l[?2004h>             nodes.append((pid, g, d))
[?2004l[?2004h>             newbeam.append((c, Tn, g, g1, gas, len(nodes) - 1))
[?2004l[?2004h>         beam = newbeam
[?2004l[?2004h>     best = min(beam, key=lambda x: x[0])
[?2004l[?2004h>     nid = best[5]
[?2004l[?2004h>     seq = []
[?2004l[?2004h>     while nid >= 0:
[?2004l[?2004h>         p, g, d = nodes[nid]
[?2004l[?2004h>         seq.append({'gas': int(g), 'damper': int(d)})
[?2004l[?2004h>         nid = p
[?2004l[?2004h>     seq.reverse()
[?2004l[?2004h>     return seq
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == '__main__':
[?2004l[?2004h>     out = run_firing_cycle('/app/firing_schedule.csv', '/app/kiln_specs.json')
[?2004l[?2004h>     print(len(out))
