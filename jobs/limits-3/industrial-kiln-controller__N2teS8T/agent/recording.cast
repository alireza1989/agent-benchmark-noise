[48.513146, "i", "cat > /tmp/check.py << 'EOF'\nimport json, csv, sys\nsys.path.insert(0, '/app')\nfrom kiln_firmware import run_firing_cycle\ns = json.load(open('/app/kiln_specs.json'))\nG = s['gas_burner_power_c']; C = s['damper_cooling_c']; A = s['ambient_loss_c']\ntgt = [float(r['target_temp']) for r in csv.DictReader(open('/app/firing_schedule.csv'))]\nseq = run_firing_cycle('/app/firing_schedule.csv', '/app/kiln_specs.json')\nprint('len', len(seq))\nT = tgt[0]; g1 = g2 = 0; err = abs(T - tgt[0]); gas = 0; maxdrop = 0.0\nfor t in range(len(seq) - 1):\n    g = seq[t]['gas']; d = seq[t]['damper']\n    assert 0 <= g <= 5 and 0 <= d <= 5 and isinstance(g, int) and isinstance(d, int)\n    gas += g\n    ge = 0.1 * g + 0.3 * g1 + 0.6 * g2\n    Tn = T + G * ge - (C * d + A)\n    maxdrop = max(maxdrop, T - Tn)\n    err += abs(Tn - tgt[t + 1])\n    T = Tn; g2 = g1; g1 = g\ngas += seq[-1]['gas']\nprint('total_error', err, 'gas', gas, 'max_drop', maxdrop)\nprint('PASS' if err < 400 and gas < 2100 and maxdrop <= 5.0 else 'FAIL')\nEOF\npython3 /tmp/check.py\n"]
