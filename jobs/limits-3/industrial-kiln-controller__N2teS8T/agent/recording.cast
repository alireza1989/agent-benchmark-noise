[6.177391, "o", "\u001b[?2004hroot@790cec704ee7:/app# "]
[48.006782, "i", "cat > /app/kiln_firmware.py << 'EOF'\nimport json, csv\n\ndef run_firing_cycle(schedule_path, specs_path, W=300):\n    with open(specs_path) as f:\n        s = json.load(f)\n    G = float(s['gas_burner_power_c'])\n    C = float(s['damper_cooling_c'])\n    A = float(s['ambient_loss_c'])\n    with open(schedule_path) as f:\n        tgt = [float(r['target_temp']) for r in csv.DictReader(f)]\n    N = len(tgt)\n    nodes = []  # (parent_id, gas, damper)\n    # beam entries: (cost, T, g_prev1, g_prev2, total_gas, node_id)\n    beam = [(0.0, tgt[0], 0, 0, 0, -1)]\n    for t in range(N):\n        nt = tgt[t + 1] if t + 1 < N else tgt[-1]\n        cands = {}\n        for (cost, T, g1, g2, gas, nid) in beam:\n            for g in range(6):\n                base = T + G * (0.3 * g1 + 0.6 * g2)\n                gk = G * 0.1 * g\n                for d in range(6):\n                    Tn = base + gk - (C * d + A)\n                    if Tn < T - 5.0:\n                        continue\n                    c = cost + abs(Tn - nt) + 0.001 * g\n                    key = (round(Tn, 2), g, g1)\n                    old = cands.get(key)\n                    if old is None or c < old[0]:\n                        cands[key] = (c, Tn, g, g1, gas + g, nid, d)\n        if not cands:\n            raise RuntimeError('infeasible at step %d' % t)\n        top = sorted(cands.values(), key=lambda x: x[0])[:W]\n        newbeam = []\n        for (c, Tn, g, g1, gas, pid, d) in top:\n            nodes.append((pid, g, d))\n            newbeam.append((c, Tn, g, g1, gas, len(nodes) - 1))\n        beam = newbeam\n    best = min(beam, key=lambda x: x[0])\n    nid = best[5]\n    seq = []\n    while nid >= 0:\n        p, g, d = nodes[nid]\n        seq.append({'gas': int(g), 'damper': int(d)})\n        nid = p\n    seq.reverse()\n    return seq\n\nif __name__ == '__main__':\n    out = run_firing_cycle('/app/firing_schedule.csv', '/app/kiln_specs.json')\n    print(len(out))\nEOF\n"]
