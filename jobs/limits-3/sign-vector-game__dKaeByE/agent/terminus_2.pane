[?2004l[?2004h>     for c in range(k):
[?2004l[?2004h>         p = max(range(c, k), key=lambda r: abs(M[r][c]))
[?2004l[?2004h>         M[c], M[p] = M[p], M[c]
[?2004l[?2004h>         if abs(M[c][c]) < 1e-12:
[?2004l[?2004h>             return None
[?2004l[?2004h>         for r in range(k):
[?2004l[?2004h>             if r != c:
[?2004l[?2004h>                 f = M[r][c] / M[c][c]
[?2004l[?2004h>                 for j in range(c, k + 1):
[?2004l[?2004h>                     M[r][j] -= f * M[c][j]
[?2004l[?2004h>     return [M[i][k] / M[i][i] for i in range(k)]
[?2004l[?2004h> 
[?2004l[?2004h> def resid(sel):
[?2004l[?2004h>     c = solve([signs[i] for i in sel], s)
