[?2004l[?2004h>         return None, None
[?2004l[?2004h>     r = s[:]
[?2004l[?2004h>     for ci, i in zip(c, sel):
[?2004l[?2004h>         for t in range(d):
[?2004l[?2004h>             r[t] -= ci * signs[i][t]
[?2004l[?2004h>     return sum(x * x for x in r), r
[?2004l[?2004h> 
[?2004l[?2004h> sel = []
[?2004l[?2004h> r = s[:]
