[22.88055, "i", "cat > solve.py << 'EOF'\nsigns = [list(map(int, l.split())) for l in open('signs.txt') if l.strip()]\ns = [float(x) for x in open('sum.txt').read().split()]\nn = len(signs)\nd = len(s)\n\ndef dot(a, b):\n    return sum(x * y for x, y in zip(a, b))\n\ndef solve(A, b):\n    k = len(A)\n    M = [[dot(A[i], A[j]) for j in range(k)] + [dot(A[i], b)] for i in range(k)]\n    for c in range(k):\n        p = max(range(c, k), key=lambda r: abs(M[r][c]))\n        M[c], M[p] = M[p], M[c]\n        if abs(M[c][c]) < 1e-12:\n            return None\n        for r in range(k):\n            if r != c:\n                f = M[r][c] / M[c][c]\n                for j in range(c, k + 1):\n                    M[r][j] -= f * M[c][j]\n    return [M[i][k] / M[i][i] for i in range(k)]\n\ndef resid(sel):\n    c = solve([signs[i] for i in sel], s)\n    if c is None:\n        return None, None\n    r = s[:]\n    for ci, i in zip(c, sel):\n        for t in range(d):\n            r[t] -= ci * signs[i][t]\n    return sum(x * x for x in r), r\n\nsel = []\nr = s[:]\nfor step in range(16):\n    best = max((abs(dot(signs[i], r)), i) for i in range(n) if i not in sel)[1]\n    sel.append(best)\n    e, r = resid(sel)\n    print(step + 1, best + 1, e)\n\nwith open('players.txt', 'w') as f:\n    for i in sorted(sel):\n        f.write(str(i + 1) + '\\n')\nprint('selected', sorted(i + 1 for i in sel))\nprint('final residual squared', resid(sel)[0])\nEOF\npython3 solve.py\n"]
