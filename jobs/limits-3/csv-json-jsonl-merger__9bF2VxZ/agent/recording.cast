[26.025545, "i", "cat > /workspace/do_merge.py << 'EOF'\nimport json\nimport pandas as pd\n\ndef clean(v):\n    if v is None or (isinstance(v, float) and pd.isna(v)):\n        return ''\n    return str(v).strip()\n\nrecords = {}\n\ndef add(email, phone, status):\n    e = clean(email)\n    if not e:\n        return\n    cur = records.setdefault(e, {'email': e, 'phone': '', 'status': ''})\n    if not cur['phone'] and clean(phone):\n        cur['phone'] = clean(phone)\n    if not cur['status'] and clean(status):\n        cur['status'] = clean(status)\n\nusers = pd.read_csv('/workspace/users.csv', dtype=str, keep_default_na=False)\nfor _, r in users.iterrows():\n    add(r.get('email', ''), r.get('phone', ''), r.get('status', ''))\n\nwith open('/workspace/records.jsonl') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        r = json.loads(line)\n        other = r.get('other_info') or {}\n        add(r.get('email'), r.get('phone') or other.get('phone'), r.get('status'))\n\nwith open('/workspace/profiles.json') as f:\n    profiles = json.load(f)\nif isinstance(profiles, dict):\n    items = [(k, v) for k, v in profiles.items()]\nelse:\n    items = [(None, v) for v in profiles]\nfor key, r in items:\n    other = r.get('other_info') or {}\n    add(r.get('email') or key, r.get('phone') or other.get('phone'), r.get('status'))\n\nout = pd.DataFrame(list(records.values()), columns=['email', 'phone', 'status'])\nout.to_csv('/workspace/merged_records.csv', index=False)\nprint(len(out), 'rows written')\nEOF\n"]
