[101.679601, "i", "cd /app && python3 - << 'EOF'\nsrc = open('/app/solve.py').read()\nold = 'mu = float(ld.mean()); sigma = float(ld.std(ddof=0))'\nnew = '''_u = cv.delay_hours.values < 71.99\n_x = np.log(cv.delay_hours.values)\ndef _nll(p):\n    return -(norm.logpdf(_x[_u], p[0], np.exp(p[1])).sum() + (~_u).sum() * norm.logsf(np.log(72.0), p[0], np.exp(p[1])))\n_r = minimize(_nll, [_x.mean(), np.log(_x.std())], method='Nelder-Mead')\nmu = float(_r.x[0]); sigma = float(np.exp(_r.x[1]))'''\nassert old in src\nopen('/app/solve.py', 'w').write(src.replace(old, new))\nprint('patched')\nEOF\n"]
