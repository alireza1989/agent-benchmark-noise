[61.078366, "o", ">     dv = pd.get_dummies(df.device_type).reindex(columns=['desktop', 'mobile', 'tablet'], fill_value=0).astype(float).values\r\n\u001b[?2004l\r\u001b[?2004h>     h = 2 * np.pi * df.hour_of_day.values / 24.0\r\n\u001b[?2004l\r\u001b[?2004h>     wk = (df.day_of_week.values >= 5).astype(float)\r\n\u001b[?2004l\r\u001b[?2004h>     return np.column_stack([np.ones(len(df)), s[:, 0], s[:, 1], dv[:, 0], dv[:, 2], np.sin(h), np.cos(h), np.sin(2 * h), np.cos(2 * h), wk, df.context_feature_1.values, df.context_feature_2.values])\r\n\u001b[?2004l\r\u001b[?2004h> def fit(X, y, lam=1.0):\r\n\u001b[?2004l\r\u001b[?2004h>     def f(w):\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.078386, "o", "> "]
[61.080722, "o", "        p = expit(X @ w)\r\n\u001b[?2004l\r\u001b[?2004h>         ll = -(y * np.log(p + 1e-12) + (1 - y) * np.log(1 - p + 1e-12)).sum() + 0.5 * lam * (w[1:] @ w[1:])\r\n\u001b[?2004l\r\u001b[?2004h>         g = X.T @ (p - y)\r\n\u001b[?2004l\r\u001b[?2004h>         g[1:] += lam * w[1:]\r\n\u001b[?2004l\r\u001b[?2004h>         return ll, g\r\n\u001b[?2004l\r\u001b[?2004h>     return minimize(f, np.zeros(X.shape[1]), jac=True, method='L-BFGS-B').x\r\n\u001b[?2004l\r\u001b[?2004h> Xt = feats(tc)\r\n\u001b[?2004l\r\u001b[?2004h> P = np.zeros((len(tc), 10))\r\n\u001b[?2004l\r\u001b[?2004h> nm = np.zeros(10)\r\n\u001b[?2004l\r\u001b[?2004h> for a in range(10):\r\n\u001b[?2004l\r\u001b[?2004h>     d = imp[(imp.arm_id == a) & (imp.mature == 1)]\r\n\u001b[?2004l\r\u001b[?2004h>     nm[a] = len(d)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.08077, "o", "    w = fit(feats(d), d.conv.values.astype(float))\r\n\u001b[?2004l\r\u001b[?2004h>     P[:, a] = expit(Xt @ w)\r\n\u001b[?2004l\r"]
[61.080873, "o", "\u001b[?2004h> v = arm.v.values\r\n\u001b[?2004l\r"]
[61.081742, "o", "\u001b[?2004h> R = P * v[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> sel = R.argmax(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.081891, "o", "idx = np.arange(len(tc))\r\n\u001b[?2004l\r\u001b[?2004h> exp_r = R[idx, sel]\r\n\u001b[?2004l\r\u001b[?2004h> z = 1.2816\r\n\u001b[?2004l\r\u001b[?2004h> se = np.sqrt(P * (1 - P) / nm[None, :])\r\n\u001b[?2004l\r\u001b[?2004h> lo = np.maximum(0, P - z * se) * v[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> hi = (P + z * se) * v[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> pred = pd.DataFrame({'context_id': tc.context_id, 'selected_arm': sel.astype(int), 'expected_reward': exp_r, 'confidence_lower': lo[idx, sel], 'confidence_upper': hi[idx, sel]})\r\n\u001b[?2004l\r\u001b[?2004h> pred.to_csv('/app/output/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> dm = {'distribution_type': 'lognormal', 'parameters': {'mu': mu, 'sigma': sigma}, 'median_delay_hours': float(np.exp(mu)), 'p90_delay_hours': float(np.exp(mu + 1.2816 * sigma)), 'conversion_rate_estimate': float(q_all)}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.082119, "o", "json.dump(dm, open('/app/output/delay_model.json', 'w'), indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.082301, "o", "as_ = pd.DataFrame({'arm_id': range(10), 'estimated_conversion_rate': arm.q.values, 'estimated_avg_value': arm.v.values, 'total_impressions': arm.n.values.astype(int), 'total_conversions': arm.c.values.astype(int)})\r\n\u001b[?2004l\r\u001b[?2004h> as_.to_csv('/app/output/arm_statistics.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.08246, "o", "print('mu', mu, 'sigma', sigma, 'q_all', q_all)\r\n\u001b[?2004l\r"]
[61.08254, "o", "\u001b[?2004h> print(as_.to_string())\r\n\u001b[?2004l\r\u001b[?2004h> print(pd.Series(sel).value_counts().sort_index().to_string())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.082659, "o", "print('mean expected reward', exp_r.mean())\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
