[90.025211, "i", "cd /app && python3 -c \"\nimport pandas as pd, numpy as np\nfrom scipy.stats import norm\nfrom scipy.optimize import minimize\ncv=pd.read_csv('data/conversions.csv'); d=cv.delay_hours.values\nprint('n at >=71.99:', (d>=71.99).sum(), 'of', len(d))\nprint('hist counts 60-72 by 2h:', np.histogram(d[d>=60], bins=6, range=(60,72))[0])\nu=d<71.99; x=np.log(d)\ndef nll(p):\n    m,s=p[0],np.exp(p[1])\n    ll=norm.logpdf(x[u],m,s).sum()+(~u).sum()*norm.logsf(np.log(72),m,s)\n    return -ll\nr=minimize(nll,[x.mean(),np.log(x.std())],method='Nelder-Mead')\nprint('censored MLE mu',r.x[0],'sigma',np.exp(r.x[1]))\nprint('naive mu',x.mean(),'sigma',x.std())\n\"\n"]
[90.026642, "o", "cd /app && python3 -c \"\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd, numpy as np\r\n\u001b[?2004l\r"]
[90.026804, "o", "\u001b[?2004h> "]
[90.027072, "o", "from scipy.stats import norm\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.optimize import minimize\r\n\u001b[?2004l\r\u001b[?2004h> cv=pd.read_csv('data/conversions.csv'); d=cv.delay_hours.values\r\n\u001b[?2004l\r\u001b[?2004h> print('n at >=71.99:', (d>=71.99).sum(), 'of', len(d))\r\n\u001b[?2004l\r\u001b[?2004h> print('hist counts 60-72 by 2h:', np.histogram(d[d>=60], bins=6, range=(60,72))[0])\r\n\u001b[?2004l\r\u001b[?2004h> u=d<71.99; x=np.log(d)\r\n\u001b[?2004l\r\u001b[?2004h> def nll(p):\r\n\u001b[?2004l\r\u001b[?2004h>     m,s=p[0],np.exp(p[1])\r\n\u001b[?2004l\r\u001b[?2004h>     ll=norm.logpdf(x[u],m,s).sum()+(~u).sum()*norm.logsf(np.log(72),m,s)\r\n\u001b[?2004l\r\u001b[?2004h>     return -ll\r\n\u001b[?2004l\r\u001b[?2004h> r=minimize(nll,[x.mean(),np.log(x.std())],method='Nelder-Mead')\r\n\u001b[?2004l\r\u001b[?2004h> print('censored MLE mu',r.x[0],'sigma',np.exp(r.x[1]))\r\n\u001b[?2004l\r\u001b[?2004h> print('naive mu',x.mean(),'sigma',x.std())\r\n\u001b[?2004l\r\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
