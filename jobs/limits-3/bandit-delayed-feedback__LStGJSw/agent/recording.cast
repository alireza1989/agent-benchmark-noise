[61.073158, "i", "cat > /app/solve.py << 'EOF'\nimport pandas as pd, numpy as np, json, os\nfrom scipy.stats import norm\nfrom scipy.special import expit\nfrom scipy.optimize import minimize\nos.makedirs('/app/output', exist_ok=True)\nimp = pd.read_csv('/app/data/impressions.csv')\ncv = pd.read_csv('/app/data/conversions.csv')\ntc = pd.read_csv('/app/data/test_contexts.csv')\nimp['conv'] = imp.impression_id.isin(cv.impression_id).astype(int)\nmg = cv.merge(imp[['impression_id', 'arm_id']], on='impression_id')\nld = np.log(cv.delay_hours.values)\nmu = float(ld.mean()); sigma = float(ld.std(ddof=0))\nF72 = norm.cdf((np.log(72.0) - mu) / sigma)\nsnap = cv.conversion_timestamp.max()\nage = np.maximum((snap - imp.timestamp.values) / 3600.0, 1e-3)\nFm = np.minimum(norm.cdf((np.log(np.minimum(age, 72.0)) - mu) / sigma) / F72, 1.0)\nimp['Fm'] = Fm\nimp['mature'] = (age >= 72).astype(int)\nq_all = imp.conv.sum() / imp.Fm.sum()\narm = imp.groupby('arm_id').agg(n=('conv', 'size'), c=('conv', 'sum'), ex=('Fm', 'sum'))\narm['q'] = arm.c / arm.ex\narm['v'] = mg."]
[61.076834, "o", "cat > /app/solve.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd, numpy as np, json, os\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.stats import norm\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.special import expit\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.optimize import minimize\r\n\u001b[?2004l\r\u001b[?2004h> os.makedirs('/app/output', exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> imp = pd.read_csv('/app/data/impressions.csv')\r\n\u001b[?2004l\r\u001b[?2004h> cv = pd.read_csv('/app/data/conversions.csv')\r\n\u001b[?2004l\r\u001b[?2004h> tc = pd.read_csv('/app/data/test_contexts.csv')\r\n\u001b[?2004l\r\u001b[?2004h> imp['conv'] = imp.impression_id.isin(cv.impression_id).astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> mg = cv.merge(imp[['impression_id', 'arm_id']], on='impression_id')\r\n\u001b[?2004l\r\u001b[?2004h> ld = np.log(cv.delay_hours.values)\r\n\u001b[?2004l\r\u001b[?2004h> mu = float(ld.mean()); sigma = float(ld.std(ddof=0))\r\n\u001b[?2004l\r\u001b[?2004h> F72 = norm.cdf((np.log(72.0) - mu) / sigma)\r\n\u001b[?2004l\r\u001b[?2004h> snap = cv.conversion_timestamp.max()\r\n\u001b[?2004l\r\u001b[?2004h> age = np.maximum((snap - imp.timestamp.values) / 3600.0, 1e-3)\r\n\u001b[?2"]
[61.076973, "i", "groupby('arm_id').conversion_value.mean()\ndef feats(df):\n    s = pd.get_dummies(df.user_segment).reindex(columns=['middle', 'senior', 'young'], fill_value=0).astype(float).values\n    dv = pd.get_dummies(df.device_type).reindex(columns=['desktop', 'mobile', 'tablet'], fill_value=0).astype(float).values\n    h = 2 * np.pi * df.hour_of_day.values / 24.0\n    wk = (df.day_of_week.values >= 5).astype(float)\n    return np.column_stack([np.ones(len(df)), s[:, 0], s[:, 1], dv[:, 0], dv[:, 2], np.sin(h), np.cos(h), np.sin(2 * h), np.cos(2 * h), wk, df.context_feature_1.values, df.context_feature_2.values])\ndef fit(X, y, lam=1.0):\n    def f(w):\n        p = expit(X @ w)\n        ll = -(y * np.log(p + 1e-12) + (1 - y) * np.log(1 - p + 1e-12)).sum() + 0.5 * lam * (w[1:] @ w[1:])\n        g = X.T @ (p - y)\n        g[1:] += lam * w[1:]\n        return ll, g\n    return minimize(f, np.zeros(X.shape[1]), jac=True, method='L-BFGS-B').x\nXt = feats(tc)\nP = np.zeros((len(tc), 10))\nnm = np.zeros(10)\nfor a in range(10):\n    d = imp[(imp."]
[61.077136, "o", "004l\r\u001b[?2004h> Fm = np.minimum(norm.cdf((np.log(np.minimum(age, 72.0)) - mu) / sigma) / F72, 1.0)\r\n\u001b[?2004l\r\u001b[?2004h> imp['Fm'] = Fm\r\n\u001b[?2004l\r\u001b[?2004h> imp['mature'] = (age >= 72).astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> q_all = imp.conv.sum() / imp.Fm.sum()\r\n\u001b[?2004l\r\u001b[?2004h> arm = imp.groupby('arm_id').agg(n=('conv', 'size'), c=('conv', 'sum'), ex=('Fm', 'sum'))\r\n\u001b[?2004l\r\u001b[?2004h> arm['q'] = arm.c / arm.ex\r\n\u001b[?2004l\r\u001b[?2004h> arm['v'] = mg."]
[61.077481, "i", "arm_id == a) & (imp.mature == 1)]\n    nm[a] = len(d)\n    w = fit(feats(d), d.conv.values.astype(float))\n    P[:, a] = expit(Xt @ w)\nv = arm.v.values\nR = P * v[None, :]\nsel = R.argmax(1)\nidx = np.arange(len(tc))\nexp_r = R[idx, sel]\nz = 1.2816\nse = np.sqrt(P * (1 - P) / nm[None, :])\nlo = np.maximum(0, P - z * se) * v[None, :]\nhi = (P + z * se) * v[None, :]\npred = pd.DataFrame({'context_id': tc.context_id, 'selected_arm': sel.astype(int), 'expected_reward': exp_r, 'confidence_lower': lo[idx, sel], 'confidence_upper': hi[idx, sel]})\npred.to_csv('/app/output/predictions.csv', index=False)\ndm = {'distribution_type': 'lognormal', 'parameters': {'mu': mu, 'sigma': sigma}, 'median_delay_hours': float(np.exp(mu)), 'p90_delay_hours': float(np.exp(mu + 1.2816 * sigma)), 'conversion_rate_estimate': float(q_all)}\njson.dump(dm, open('/app/output/delay_model.json', 'w'), indent=2)\nas_ = pd.DataFrame({'arm_id': range(10), 'estimated_conversion_rate': arm.q.values, 'estimated_avg_value': arm.v.values, 'total_impressions': arm."]
