[?2004hroot@3d7cd451650f:/app# cat > /app/solve.py << 'EOF'
[?2004l[?2004h> import pandas as pd, numpy as np, json, os
[?2004l[?2004h> from scipy.stats import norm
[?2004l[?2004h> from scipy.special import expit
[?2004l[?2004h> from scipy.optimize import minimize
[?2004l[?2004h> os.makedirs('/app/output', exist_ok=True)
[?2004l[?2004h> imp = pd.read_csv('/app/data/impressions.csv')
[?2004l[?2004h> cv = pd.read_csv('/app/data/conversions.csv')
[?2004l[?2004h> tc = pd.read_csv('/app/data/test_contexts.csv')
[?2004l[?2004h> imp['conv'] = imp.impression_id.isin(cv.impression_id).astype(int)
[?2004l[?2004h> mg = cv.merge(imp[['impression_id', 'arm_id']], on='impression_id')
[?2004l[?2004h> ld = np.log(cv.delay_hours.values)
[?2004l[?2004h> mu = float(ld.mean()); sigma = float(ld.std(ddof=0))
[?2004l[?2004h> F72 = norm.cdf((np.log(72.0) - mu) / sigma)
[?2004l[?2004h> snap = cv.conversion_timestamp.max()
[?2004l[?2004h> age = np.maximum((snap - imp.timestamp.values) / 3600.0, 1e-3)
[?2004l[?2004h> Fm = np.minimum(norm.cdf((np.log(np.minimum(age, 72.0)) - mu) / sigma) / F72, 1.0)
[?2004l[?2004h> imp['Fm'] = Fm
[?2004l[?2004h> imp['mature'] = (age >= 72).astype(int)
[?2004l[?2004h> q_all = imp.conv.sum() / imp.Fm.sum()
[?2004l[?2004h> arm = imp.groupby('arm_id').agg(n=('conv', 'size'), c=('conv', 'sum'), ex=('Fm', 'sum'))
[?2004l[?2004h> arm['q'] = arm.c / arm.ex
[?2004l[?2004h> arm['v'] = mg.groupby('arm_id').conversion_value.mean()
[?2004l[?2004h> def feats(df):
[?2004l[?2004h>     s = pd.get_dummies(df.user_segment).reindex(columns=['middle', 'senior', 'young'], fill_value=0).astype(float).values
[?2004l[?2004h>     dv = pd.get_dummies(df.device_type).reindex(columns=['desktop', 'mobile', 'tablet'], fill_value=0).astype(float).values
[?2004l[?2004h>     h = 2 * np.pi * df.hour_of_day.values / 24.0
[?2004l[?2004h>     wk = (df.day_of_week.values >= 5).astype(float)
[?2004l[?2004h>     return np.column_stack([np.ones(len(df)), s[:, 0], s[:, 1], dv[:, 0], dv[:, 2], np.sin(h), np.cos(h), np.sin(2 * h), np.cos(2 * h), wk, df.context_feature_1.values, df.context_feature_2.values])
[?2004l[?2004h> def fit(X, y, lam=1.0):
[?2004l[?2004h>     def f(w):
[?2004l[?2004h>         p = expit(X @ w)
[?2004l[?2004h>         ll = -(y * np.log(p + 1e-12) + (1 - y) * np.log(1 - p + 1e-12)).sum() + 0.5 * lam * (w[1:] @ w[1:])
[?2004l[?2004h>         g = X.T @ (p - y)
[?2004l[?2004h>         g[1:] += lam * w[1:]
[?2004l[?2004h>         return ll, g
[?2004l[?2004h>     return minimize(f, np.zeros(X.shape[1]), jac=True, method='L-BFGS-B').x
[?2004l[?2004h> Xt = feats(tc)
[?2004l[?2004h> P = np.zeros((len(tc), 10))
[?2004l[?2004h> nm = np.zeros(10)
[?2004l[?2004h> for a in range(10):
[?2004l[?2004h>     d = imp[(imp.arm_id == a) & (imp.mature == 1)]
[?2004l[?2004h>     nm[a] = len(d)
[?2004l[?2004h>     w = fit(feats(d), d.conv.values.astype(float))
[?2004l[?2004h>     P[:, a] = expit(Xt @ w)
[?2004l[?2004h> v = arm.v.values
[?2004l[?2004h> R = P * v[None, :]
[?2004l[?2004h> sel = R.argmax(1)
[?2004l[?2004h> idx = np.arange(len(tc))
[?2004l[?2004h> exp_r = R[idx, sel]
[?2004l[?2004h> z = 1.2816
[?2004l[?2004h> se = np.sqrt(P * (1 - P) / nm[None, :])
[?2004l[?2004h> lo = np.maximum(0, P - z * se) * v[None, :]
[?2004l[?2004h> hi = (P + z * se) * v[None, :]
[?2004l[?2004h> pred = pd.DataFrame({'context_id': tc.context_id, 'selected_arm': sel.astype(int), 'expected_reward': exp_r, 'confidence_lower': lo[idx, sel], 'confidence_upper': hi[idx, sel]})
[?2004l[?2004h> pred.to_csv('/app/output/predictions.csv', index=False)
[?2004l[?2004h> dm = {'distribution_type': 'lognormal', 'parameters': {'mu': mu, 'sigma': sigma}, 'median_delay_hours': float(np.exp(mu)), 'p90_delay_hours': float(np.exp(mu + 1.2816 * sigma)), 'conversion_rate_estimate': float(q_all)}
[?2004l[?2004h> json.dump(dm, open('/app/output/delay_model.json', 'w'), indent=2)
[?2004l[?2004h> as_ = pd.DataFrame({'arm_id': range(10), 'estimated_conversion_rate': arm.q.values, 'estimated_avg_value': arm.v.values, 'total_impressions': arm.n.values.astype(int), 'total_conversions': arm.c.values.astype(int)})
[?2004l[?2004h> as_.to_csv('/app/output/arm_statistics.csv', index=False)
[?2004l[?2004h> print('mu', mu, 'sigma', sigma, 'q_all', q_all)
[?2004l[?2004h> print(as_.to_string())
[?2004l[?2004h> print(pd.Series(sel).value_counts().sort_index().to_string())
