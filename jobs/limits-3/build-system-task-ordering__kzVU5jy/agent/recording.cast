[44.587596, "i", "dj = {n: set() for n in nodes}\n    for x, y in edges:\n        adj[x].add(y)\n\n    reach = {}\n    for n in nodes:\n        seen = {n}\n        stack = [n]\n        while stack:\n            x = stack.pop()\n            for y in adj[x]:\n                if y not in seen:\n                    seen.add(y)\n                    stack.append(y)\n        reach[n] = seen\n\n    comp_list = []\n    assigned = set()\n    for n in sorted(nodes):\n        if n in assigned:\n            continue\n        comp = sorted(m for m in reach[n] if n in reach[m])\n        assigned.update(comp)\n        comp_list.append(comp)\n\n    comp_of = {}\n    for i, c in enumerate(comp_list):\n        for m in c:\n            comp_of[m] = i\n\n    cycles = []\n    for c in comp_list:\n        if len(c) >= 2 or (c[0], c[0]) in edges:\n            cycles.append(c)\n    cycles.sort()\n\n    n_c = len(comp_list)\n    cadj = [set() for _ in range(n_c)]\n    indeg = [0] * n_c\n    for x, y in edges:\n        i = comp_of[x]\n        j = comp_of[y]\n        if i != j and j not in cadj["]
