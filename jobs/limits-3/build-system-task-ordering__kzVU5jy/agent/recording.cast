[44.924755, "i", "cat > /tmp/test_solution.py << 'EOF'\nimport sys\nsys.path.insert(0, '/app')\nfrom solution import solve\n\nex1 = ['TARGET build', 'Alias = compile link', 'Depends = all', 'TARGET compile', 'Before = clean']\nex2 = ['TARGET test', 'Phony = yes', 'Depends = unit', 'OVERRIDE test 20', 'Phony = no', 'After = integration', 'OVERRIDE test 10', 'Depends = e2e']\nex3 = ['TARGET zebra', 'Alias = alpha', 'TARGET alpha', 'Alias = build', 'TARGET build', 'Depends = compile']\nex4 = ['TARGET a', 'Depends = b', 'TARGET b', 'Depends = c', 'TARGET c', 'Depends = a']\nfor e in [ex1, ex2, ex3, ex4]:\n    print(solve(e))\nprint(solve([]))\nprint(solve(['Depends = x']))\nEOF\npython3 /tmp/test_solution.py\n"]
