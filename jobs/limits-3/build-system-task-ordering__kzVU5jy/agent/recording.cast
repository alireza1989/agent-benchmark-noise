[44.581262, "i", "cat > /app/solution.py << 'EOF'\nimport json\n\nKEYS = {'Depends', 'Before', 'After', 'Needs', 'Requires', 'Alias', 'Phony'}\nSETKEYS = ('Depends', 'Before', 'After', 'Needs', 'Requires')\n\n\nclass _PE(Exception):\n    pass\n\n\ndef solve(lines):\n    try:\n        return _solve(lines)\n    except _PE:\n        return 'PARSE_ERROR'\n\n\ndef _solve(lines):\n    blocks = []\n    cur = None\n    for raw in lines:\n        s = raw.strip()\n        if not s or s.startswith('#'):\n            continue\n        toks = s.split()\n        if toks[0] == 'TARGET':\n            if len(toks) != 2:\n                raise _PE()\n            cur = {'kind': 'TARGET', 'name': toks[1], 'id': None, 'dirs': [], 'phony': None}\n            blocks.append(cur)\n        elif toks[0] == 'OVERRIDE':\n            if len(toks) != 3:\n                raise _PE()\n            cur = {'kind': 'OVERRIDE', 'name': toks[1], 'id': toks[2], 'dirs': [], 'phony': None}\n            blocks.append(cur)\n        else:\n            if '=' not in s and s.startswith('[') and s.endswith(']'"]
[44.583338, "o", "cat > /app/solution.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> KEYS = {'Depends', 'Before', 'After', 'Needs', 'Requires', 'Alias', 'Phony'}\r\n\u001b[?2004l\r\u001b[?2004h> SETKEYS = ('Depends', 'Before', 'After', 'Needs', 'Requires')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class _PE(Exception):\r\n\u001b[?2004l\r\u001b[?2004h>     pass\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def solve(lines):\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[44.583462, "i", "):\n                continue\n            if s.count('=') != 1 or cur is None:\n                raise _PE()\n            k, v = s.split('=')\n            k = k.strip()\n            v = v.strip()\n            if k not in KEYS:\n                raise _PE()\n            if k == 'Phony':\n                if v not in ('yes', 'no'):\n                    raise _PE()\n                cur['phony'] = v\n            else:\n                cur['dirs'].append((k, v.split()))\n\n    universe = set()\n    for b in blocks:\n        universe.add(b['name'])\n        for k, vals in b['dirs']:\n            universe.update(vals)\n\n    parent = {u: u for u in universe}\n\n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    for b in blocks:\n        for k, vals in b['dirs']:\n            if k == 'Alias':\n                for v in vals:\n                    ra = find(b['name'])\n                    rb = find(v)\n                    if ra != rb:\n                        parent[ma"]
