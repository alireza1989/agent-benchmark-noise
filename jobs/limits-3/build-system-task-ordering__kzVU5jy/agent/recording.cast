[44.58768, "i", "i]:\n            cadj[i].add(j)\n            indeg[j] += 1\n\n    avail = [i for i in range(n_c) if indeg[i] == 0]\n    order = []\n    while avail:\n        avail.sort(key=lambda i: comp_list[i][0])\n        i = avail.pop(0)\n        order.extend(comp_list[i])\n        for j in cadj[i]:\n            indeg[j] -= 1\n            if indeg[j] == 0:\n                avail.append(j)\n\n    return json.dumps({'order': order, 'cycles': cycles}, separators=(',', ':'))\nEOF\n"]
