[44.583513, "i", "x(ra, rb)] = min(ra, rb)\n\n    members = {}\n    for u in universe:\n        members.setdefault(find(u), []).append(u)\n    canon_of_root = {r: min(m) for r, m in members.items()}\n\n    def canon(x):\n        return canon_of_root[find(x)]\n\n    ordered = [b for b in blocks if b['kind'] == 'TARGET']\n    ordered += sorted([b for b in blocks if b['kind'] == 'OVERRIDE'], key=lambda b: b['id'])\n\n    acc = {}\n    for b in ordered:\n        t = canon(b['name'])\n        a = acc.setdefault(t, {k: set() for k in SETKEYS})\n        for k, vals in b['dirs']:\n            if k in SETKEYS:\n                a[k].update(canon(v) for v in vals)\n\n    nodes = set(canon(u) for u in universe)\n    edges = set()\n    for U, a in acc.items():\n        for x in a['Depends']:\n            edges.add((x, U))\n        for y in a['Before']:\n            edges.add((U, y))\n        for z in a['After']:\n            edges.add((z, U))\n        for w in a['Needs']:\n            edges.add((U, w))\n        for v in a['Requires']:\n            edges.add((U, v))\n\n    a"]
