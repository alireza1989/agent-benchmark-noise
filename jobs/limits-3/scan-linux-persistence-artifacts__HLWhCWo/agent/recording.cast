[263.986394, "o", "  while IFS= read -r line || [[ -n $line ]]; do\r\n\u001b[?2004l\r\u001b[?2004h>     n=$((n+1))\r\n\u001b[?2004l\r"]
[263.986418, "o", "\u001b[?2004h> "]
