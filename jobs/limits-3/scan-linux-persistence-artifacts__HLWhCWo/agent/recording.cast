[263.984426, "o", "    fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.984449, "o", "  done < \"$f\" 2>/dev/null\r\n\u001b[?2004l\r"]
[263.984522, "o", "\u001b[?2004h> "]
[263.984615, "o", "  if (( hidden )) || [[ -n $hitline ]]; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.984699, "o", "    if [[ -n $hitline ]]; then\r\n\u001b[?2004l\r\u001b[?2004h>       preview=$hittext\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.984724, "o", "    else\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.984795, "o", "> "]
[263.984827, "o", "      preview=\"hidden unit file: $base\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.984892, "o", "    fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
