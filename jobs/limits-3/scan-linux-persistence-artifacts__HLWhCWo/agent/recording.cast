[160.213057, "i", "cat > /app/scan_persistence.sh <<'EOF'\n#!/bin/bash\n# scan_persistence.sh - read-only scanner for seeded persistence artifacts\nexport LC_ALL=C\n\nOUT=/app/persistence_report.json\nSEP=$'\\x1f'\nRECORDS=\"\"\nKNOWN_KEYS_FILE=/app/known_ssh_keys.txt\ndeclare -A SEEN=()\ndeclare -A KNOWN=()\n\nSUSP_RE='/tmp|/var/tmp|/dev/shm|base64|eval|curl|wget|/dev/tcp|mkfifo|ncat|netcat|bash -i|sh -i|python[0-9.]* -c|perl -e|[|] *(ba|z)?sh'\n\nif [[ -r $KNOWN_KEYS_FILE ]]; then\n  while IFS= read -r k || [[ -n $k ]]; do\n    [[ -n $k ]] && KNOWN[\"$k\"]=1\n  done < \"$KNOWN_KEYS_FILE\"\nfi\n\njson_escape() {\n  local s=$1\n  s=${s//\\\\/\\\\\\\\}\n  s=${s//\\\"/\\\\\\\"}\n  printf '%s' \"$s\"\n}\n\nclean() {\n  local s\n  s=$(printf '%s' \"$1\" | tr -d '[:cntrl:]')\n  s=${s#\"${s%%[![:space:]]*}\"}\n  s=${s%\"${s##*[![:space:]]}\"}\n  printf '%s' \"${s:0:100}\"\n}\n\nadd_record() {\n  local type=$1 path=$2 line=$3 preview user=$5 sha\n  preview=$(clean \"$4\")\n  sha=$(sha256sum -- \"$path\" 2>/dev/null | awk '{print $1}')\n  [[ -z $sha ]] && return 0\n  RECORDS+=\"${type}${SEP}${path}${SEP}${sh"]
