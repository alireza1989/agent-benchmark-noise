[263.98346, "o", "  local f=$1 base hidden=0 n=0 text value hitline=\"\" hittext=\"\" preview\r\n\u001b[?2004l\r\u001b[?2004h>   base=$(basename -- \"$f\")\r\n"]
[263.98355, "o", "\u001b[?2004l\r\u001b[?2004h>   [[ $base == .* ]] && hidden=1\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.98357, "o", "> "]
[263.98371, "o", "  while IFS= read -r text || [[ -n $text ]]; do\r\n\u001b[?2004l\r\u001b[?2004h>     n=$((n+1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.983873, "o", "    if [[ $text =~ ^[[:space:]]*Exec(Start|StartPre|StartPost|Stop)?[[:space:]]*= ]]; then\r\n\u001b[?2004l\r"]
[263.9839, "o", "\u001b[?2004h> "]
[263.983975, "o", "      value=${text#*=}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.984054, "o", "      value=${value#\"${value%%[![:space:]]*}\"}\r\n\u001b[?2004l\r\u001b[?2004h>       value=${value#-}\r\n\u001b[?2004l\r"]
[263.984129, "o", "\u001b[?2004h> "]
[263.984218, "o", "      if [[ -z $hitline ]] && is_suspicious \"$value\"; then\r\n\u001b[?2004l\r\u001b[?2004h>         hitline=$n\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.984245, "o", "> "]
