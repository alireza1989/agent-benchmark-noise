[239.231824, "i", "clear; cat > /app/scan_persistence.sh <<'EOF'\n#!/bin/bash\n# scan_persistence.sh - read-only scanner for seeded persistence artifacts\nexport LC_ALL=C\n\nOUT=/app/persistence_report.json\nSEP=$'\\x1f'\nRECORDS=\"\"\nKNOWN_KEYS_FILE=/app/known_ssh_keys.txt\ndeclare -A SEEN=()\ndeclare -A KNOWN=()\n\nSUSP_RE='(^|[^[:alnum:]_])/(var/)?tmp(/|[^[:alnum:]_]|$)|/dev/shm|base64|eval |curl |wget |/dev/tcp|mkfifo|(^|[ |;&(])n(c|cat)( |$)|bash -i|sh -i|python[0-9.]* -c|perl -e|[|] *(ba|z)?sh|attacker|backdoor|payload|reverse'\n\nif [[ -r $KNOWN_KEYS_FILE ]]; then\n  while IFS= read -r k || [[ -n $k ]]; do\n    [[ -n $k ]] && KNOWN[\"$k\"]=1\n  done < \"$KNOWN_KEYS_FILE\"\nfi\n\njson_escape() {\n  local s=$1\n  s=${s//\\\\/\\\\\\\\}\n  s=${s//\\\"/\\\\\\\"}\n  printf '%s' \"$s\"\n}\n\nclean() {\n  local s\n  s=$(printf '%s' \"$1\" | tr '\\t' ' ' | tr -d '[:cntrl:]')\n  s=${s#\"${s%%[![:space:]]*}\"}\n  s=${s%\"${s##*[![:space:]]}\"}\n  printf '%s' \"${s:0:100}\"\n}\n\nadd_record() {\n  local type=$1 path=$2 line=$3 preview user=$5 sha\n  preview=$(clean \"$4\")\n  sha=$(sha256sum -- \"$pat"]
[239.23215, "i", "h\" 2>/dev/null | awk '{print $1}')\n  [[ -z $sha ]] && return 0\n  RECORDS+=\"${type}${SEP}${path}${SEP}${sha}${SEP}${line:-null}${SEP}${preview}${SEP}${user}\"$'\\n'\n}\n\nresolve() {\n  local r\n  r=$(readlink -f -- \"$1\" 2>/dev/null) || return 1\n  [[ -n $r && -f $r && -r $r ]] || return 1\n  printf '%s' \"$r\"\n}\n\nseen_once() {\n  local key=\"$1|$2\"\n  [[ -n ${SEEN[$key]:-} ]] && return 1\n  SEEN[$key]=1\n  return 0\n}\n\nis_every_minute() {\n  [[ $1 =~ ^([*]|[*]/1)([[:space:]]+([*]|[*]/1)){4}([[:space:]]|$) ]]\n}\n\nis_stock_cron() {\n  [[ $1 =~ ^[0-9*/,-]+[[:space:]]+[0-9*/,-]+[[:space:]]+[0-9*/,-]+[[:space:]]+[0-9*/,-]+[[:space:]]+[0-9*/,-]+[[:space:]]+root[[:space:]]+(cd / \\&\\& )?(test -x /usr/sbin/anacron \\|\\| \\( cd / \\&\\& )?run-parts --report /etc/cron\\.(hourly|daily|weekly|monthly)\\)?$ ]]\n}\n\nis_suspicious() {\n  local t=$1 tok\n  local -a toks\n  grep -Eqi -- \"$SUSP_RE\" <<< \"$t\" && return 0\n  read -ra toks <<< \"$t\"\n  for tok in \"${toks[@]}\"; do\n    case $tok in\n      /*)\n        case $tok in\n          /|/usr/bin/*|/bin/*|/sbin/*|"]
[239.232197, "o", "clear; cat > /app/scan_persistence.sh <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[239.232319, "i", "/usr/sbin/*|/usr/lib/*|/usr/libexec/*|/usr/share/*|/lib/*|/etc/*|/run/*|/sysroot|/sysroot/*|/system-update|/dev/null|/proc/*|/sys/*|/var/lib/*|/var/log/*) ;;\n          *) return 0 ;;\n        esac ;;\n    esac\n  done\n  return 1\n}\n\nscan_cron_file() {\n  local f=$1 spool=0 n=0 line t user idx\n  local -a F\n  [[ $f == */spool/cron/* ]] && spool=1\n  while IFS= read -r line || [[ -n $line ]]; do\n    n=$((n+1))\n    t=${line#\"${line%%[![:space:]]*}\"}\n    [[ -z $t || $t == \"#\"* ]] && continue\n    [[ $t =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && continue\n    if is_stock_cron \"$t\"; then continue; fi\n    user=\"\"\n    if (( spool )); then\n      user=$(basename -- \"$f\")\n    else\n      read -ra F <<< \"$t\"\n      idx=5\n      [[ ${F[0]} == @* ]] && idx=1\n      [[ -n ${F[$idx]:-} ]] && user=${F[$idx]}\n    fi\n    if is_every_minute \"$t\" || is_suspicious \"$t\"; then\n      add_record cron_job \"$f\" \"$n\" \"$t\" \"$user\"\n    fi\n  done < \"$f\" 2>/dev/null\n}\n\nscan_systemd_file() {\n  local f=$1 base hidden=0 n=0 text value hitline=\"\" hittext=\"\" preview\n "]
[239.232346, "o", "#!/bin/bash\r\n\u001b[?2004l\r\u001b[?2004h> "]
[239.232589, "i", " base=$(basename -- \"$f\")\n  [[ $base == .* ]] && hidden=1\n  while IFS= read -r text || [[ -n $text ]]; do\n    n=$((n+1))\n    if [[ $text =~ ^[[:space:]]*Exec(Start|StartPre|StartPost|Stop)?[[:space:]]*= ]]; then\n      value=${text#*=}\n      value=${value#\"${value%%[![:space:]]*}\"}\n      value=${value#-}\n      if [[ -z $hitline ]] && is_suspicious \"$value\"; then\n        hitline=$n\n        hittext=$text\n      fi\n    fi\n  done < \"$f\" 2>/dev/null\n  if (( hidden )) || [[ -n $hitline ]]; then\n    if [[ -n $hitline ]]; then\n      preview=$hittext\n    else\n      preview=\"hidden unit file: $base\"\n    fi\n    add_record systemd_unit \"$f\" \"$hitline\" \"$preview\" \"\"\n  fi\n}\n\nscan_rclocal_file() {\n  local f=$1 n=0 line t\n  while IFS= read -r line || [[ -n $line ]]; do\n    n=$((n+1))\n    t=${line#\"${line%%[![:space:]]*}\"}\n    t=${t%\"${t##*[![:space:]]}\"}\n    [[ -z $t || $t == \"#\"* || $t == \"exit 0\" ]] && continue\n    add_record rc_local \"$f\" \"$n\" \"$t\" \"\"\n  done < \"$f\" 2>/dev/null\n}\n\nscan_ssh_file() {\n  local f=$1 n=0 line t us"]
