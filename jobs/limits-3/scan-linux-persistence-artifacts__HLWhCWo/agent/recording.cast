[199.245582, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> is_suspicious() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.245701, "o", "  local t=$1 tok\r\n\u001b[?2004l\r"]
[199.24574, "o", "\u001b[?2004h> "]
[199.245894, "o", "  local -a toks\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.246018, "o", "  grep -Eqi -- \"$SUSP_RE\" <<< \"$t\" && return 0\r\n\u001b[?2004l\rne\r\n \u001b[?2004h"]
[199.246111, "o", "> "]
[199.246146, "o", "  read -ra toks <<< \"$t\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.246211, "o", "> "]
[199.246416, "o", "  for tok in \"${toks[@]}\"; do\r\n\u001b[?2004l\r\u001b[?2004h>     case $tok in\r\n\u001b[?2004l\r\u001b[?2004h>       /*)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.246517, "o", "        case $tok in\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.246987, "o", "          /usr/bin/*|/bin/*|/sbin/*|/usr/sbin/*|/usr/lib/*|/usr/libexec/*|/usr/share/*|/lib/*|/etc/*|/run/*|/sysroot|/sysroot/*|/system-update|/dev/null|/proc/*|/sys/*|/var/lib/*|/var/log/*) ;;\r\n\u001b[?2004l\r"]
[199.247025, "o", "\u001b[?2004h> "]
[199.247099, "o", "          *) return 0 ;;\r\n\u001b[?2004l\r"]
[199.24719, "o", "\u001b[?2004h>         esac ;;\r\n\u001b[?2004l\r\u001b[?2004h>     esac\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.247325, "o", "  done\r\n\u001b[?2004l\rpath\")\"\u001b[?2004h>   return 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.247389, "o", "> }\r\n\u001b[?2004l\rj\"\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.247495, "o", "scan_cron_file() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.247605, "o", "  local f=$1 spool=0 n=0 line t user idx\r\n\u001b[?2004l\r"]
[199.247767, "o", "\u001b[?2004h>   local -a F\r\n\u001b[?2004l\r$item\r\ndone <<\u001b[?2004h> "]
[199.24784, "o", "  [[ $f == */spool/cron/* ]] && spool=1\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.247884, "o", "> "]
[199.248049, "o", "  while IFS= read -r line || [[ -n $line ]]; do\r\n\u001b[?2004l\r\u001b[?2004h>     n=$((n+1))\r\n\u001b[?2004l\rst"]
[199.248077, "o", "\u001b[?2004h> "]
[199.248192, "o", "    t=${line#\"${line%%[![:space:]]*}\"}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.248455, "o", "    [[ -z $t || $t == \"#\"* ]] && continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.248561, "o", "    [[ $t =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && continue\r\n\u001b[?2004l\rc_rc\" \"$\u001b[?2004h> "]
[199.248667, "o", "    user=\"\"\r\n\u001b[?2004l\r"]
[199.248683, "o", "\u001b[?2004h> "]
[199.248791, "o", "    if (( spool )); then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.248823, "o", "      user=$(basename -- \"$f\")\r\n\u001b[?2004l\r\\n}\\n' \"$item"]
[199.24888, "o", "\u001b[?2004h>     else\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.248911, "o", "> "]
[199.249021, "o", "      read -ra F <<< \"$t\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.249044, "o", "      idx=5\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.249149, "o", ">       [[ ${F[0]} == @* ]] && idx=1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.249383, "o", "      [[ -n ${F[$idx]:-} ]] && user=${F[$idx]}\r\n\u001b[?2004l\r& ech\u001b[?2004h> "]
[199.249475, "o", "    fi\r\n\u001b[?2004l\rcri"]
[199.249499, "o", "\u001b[?2004h> "]
[199.249608, "o", "    if is_every_minute \"$t\" || is_suspicious \"$t\"; then\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.249671, "o", "> "]
[199.249742, "o", "      add_record cron_job \"$f\" \"$n\" \"$t\" \"$user\"\r\n\u001b[?2004l\r\u001b[?2004h>     fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.249857, "o", "  done < \"$f\" 2>/dev/null\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.249923, "o", "scan_systemd_file() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.25003, "o", "  local f=$1 base hidden=0 n=0 text value hitline=\"\" hittext=\"\" preview\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.250123, "o", "  base=$(basename -- \"$f\")\r\n\u001b[?2004l\r\u001b[?2004h>   [[ $base == .* ]] && hidden=1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.250215, "o", "  while IFS= read -r text || [[ -n $text ]]; do\r\n\u001b[?2004l\r\u001b[?2004h>     n=$((n+1))\r\n\u001b[?2004l\r"]
[199.250323, "o", "\u001b[?2004h> "]
[199.250427, "o", "    if [[ $text =~ ^[[:space:]]*Exec(Start|StartPre|StartPost|Stop)?[[:space:]]*= ]]; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.250457, "o", "      value=${text#*=}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.250555, "o", "      value=${value#\"${value%%[![:space:]]*}\"}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.250579, "o", "      value=${value#-}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.250718, "o", "      if [[ -z $hitline ]] && is_suspicious \"$value\"; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.25085, "o", "        hitline=$n\r\n\u001b[?2004l\r\u001b[?2004h>         hittext=$text\r\n\u001b[?2004l\r\u001b[?2004h>       fi\r\n\u001b[?2004l\r\u001b[?2004h>     fi\r\n\u001b[?2004l\r"]
[199.250922, "o", "\u001b[?2004h>   done < \"$f\" 2>/dev/null\r\n"]
[199.250972, "o", "\u001b[?2004l\r\u001b[?2004h"]
[199.251132, "o", ">   if (( hidden )) || [[ -n $hitline ]]; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.251188, "o", "    if [[ -n $hitline ]]; then\r\n\u001b[?2004l\r"]
[199.251302, "o", "\u001b[?2004h>       preview=$hittext\r\n\u001b[?2004l\r"]
[199.251331, "o", "\u001b[?2004h"]
[199.2514, "o", ">     else\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.251522, "o", "      preview=\"hidden unit file: $base\"\r\n\u001b[?2004l\r\u001b[?2004h>     fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.25164, "o", "    add_record systemd_unit \"$f\" \"$hitline\" \"$preview\" \"\"\r\n\u001b[?2004l\r\u001b[?2004h>   fi\r\n"]
[199.251782, "o", "\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[199.251826, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[199.251895, "o", "\u001b[?2004h> scan_rclocal_file() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.251971, "o", "  local f=$1 n=0 line t\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.252137, "o", "  while IFS= read -r line || [[ -n $line ]]; do"]
[199.252186, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.252193, "o", "    n=$((n+1))\r\n\u001b[?2004l\r"]
[199.252252, "o", "\u001b[?2004h> "]
[199.252373, "o", "    t=${line#\"${line%%[![:space:]]*}\"}\r\n\u001b[?2004l\r\u001b[?2004h>     t=${t%\"${t##*[![:space:]]}\"}\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.252402, "o", "> "]
[199.252482, "o", "    [[ -z $t || $t == \"#\"* || $t == \"exit 0\" ]] && continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.252602, "o", "    add_record rc_local \"$f\" \"$n\" \"$t\" \"\"\r\n\u001b[?2004l\r\u001b[?2004h>   done < \"$f\" 2>/dev/null\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[199.252741, "o", "\u001b[?2004h> \r\n"]
[199.252798, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[199.252826, "o", "scan_ssh_file() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.252915, "o", "  local f=$1 n=0 line t user=root\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.253025, "o", "  if [[ $f =~ /home/([^/]+)/[.]ssh/authorized_keys$ ]]; then\r\n\u001b[?2004l\r\u001b[?2004h>     user=${BASH_REMATCH[1]}"]
[199.25311, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   fi\r\n\u001b[?2004l\r"]
[199.253141, "o", "\u001b[?2004h"]
[199.253211, "o", "> "]
[199.253257, "o", "  while IFS= read -r line || [[ -n $line ]]; do\r\n\u001b[?2004l\r"]
[199.253324, "o", "\u001b[?2004h>     n=$((n+1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.253425, "o", "    t=${line#\"${line%%[![:space:]]*}\"}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.253447, "o", "    t=${t%\"${t##*[![:space:]]}\"}\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.253506, "o", "> "]
[199.253528, "o", "    [[ -z $t || $t == \"#\"* ]] && continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.253599, "o", ">     [[ -n ${KNOWN[$t]:-} ]] && continue\r\n\u001b[?2004l\r"]
[199.253728, "o", "\u001b[?2004h>     add_record ssh_key \"$f\" \"$n\" \"$t\" \"$user\"\r\n\u001b[?2004l\r"]
[199.253801, "o", "\u001b[?2004h> "]
[199.253919, "o", "  done < \"$f\" 2>/dev/null\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[199.253949, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> walk_dir() {\r\n\u001b[?2004l\r"]
[199.253986, "o", "\u001b[?2004h>   local d=$1 cb=$2 e r\r\n\u001b[?2004l\r"]
[199.254011, "o", "\u001b[?2004h> "]
[199.254103, "o", "  while IFS= read -r -d '' e; do\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.254203, "o", "    r=$(resolve \"$e\") || continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.254336, "o", "    seen_once \"$cb\" \"$r\" || continue\r\n\u001b[?2004l\r\u001b[?2004h>     \"$cb\" \"$r\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.254486, "o", "  done < <(find \"$d\" -mindepth 1 -maxdepth 1 -print0 2>/dev/null | sort -z)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[199.254511, "o", "\u001b[?2004h> scan_file_list() {\r\n\u001b[?2004l\r"]
[199.254562, "o", "\u001b[?2004h> "]
[199.254586, "o", "  local cb=$1 p r\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.254665, "o", ">   shift\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.254688, "o", "  for p in \"$@\"; do\r\n\u001b[?2004l\r"]
[199.254793, "o", "\u001b[?2004h> "]
[199.254819, "o", "    r=$(resolve \"$p\") || continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.254887, "o", "    seen_once \"$cb\" \"$r\" || continue\r\n\u001b[?2004l\r\u001b[?2004h>     \"$cb\" \"$r\"\r\n\u001b[?2004l\r"]
[199.254952, "o", "\u001b[?2004h>   done\r\n"]
[199.254977, "o", "\u001b[?2004l\r"]
[199.255073, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.255216, "o", "for d in /etc/cron.d /var/spool/cron/crontabs /app_target/etc/cron.d /app_target/var/spool/cron/crontabs; do\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.25534, "o", "  walk_dir \"$d\" scan_cron_file\r\n\u001b[?2004l\r\u001b[?2004h> done\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.255527, "o", "scan_file_list scan_cron_file /etc/crontab /app_target/etc/crontab\r\n\u001b[?2004l\r"]
[199.255551, "o", "\u001b[?2004h"]
[199.255611, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.255836, "o", "for d in /etc/systemd/system /usr/lib/systemd/system /run/systemd/system /app_target/etc/systemd/system /app_target/usr/lib/systemd/system /app_target/run/systemd/system; do\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.255931, "o", "  walk_dir \"$d\" scan_systemd_file\r\n\u001b[?2004l\r\u001b[?2004h> done\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[199.255959, "o", "> "]
[199.256124, "o", "scan_file_list scan_rclocal_file /etc/rc.local /etc/rc.d/rc.local /app_target/etc/rc.local /app_target/etc/rc.d/rc.local\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.256204, "o", "> "]
[199.256403, "o", "scan_file_list scan_ssh_file /root/.ssh/authorized_keys /app_target/root/.ssh/authorized_keys /home/*/.ssh/authorized_keys /app_target/home/*/.ssh/authorized_keys\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> mkdir -p /app\r\n\u001b[?2004l\r"]
[199.256515, "o", "\u001b[?2004h> TMP=\"${OUT}.tmp.$$\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.256643, "o", "SORTED=$(printf '%s' \"$RECORDS\" | sort -t \"$SEP\" -k1,1 -k2,2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.256684, "o", "total=0; c_cron=0; c_sys=0; c_rc=0; c_ssh=0\r\n\u001b[?2004l\r"]
[199.25675, "o", "\u001b[?2004h> items=\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.256827, "o", "while IFS=\"$SEP\" read -r type path sha line preview user; do\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.256907, "o", "  [[ -z $type ]] && continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.257011, "o", "  total=$((total + 1))\r\n\u001b[?2004l\r\u001b[?2004h>   case $type in\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.25707, "o", "    cron_job) c_cron=$((c_cron + 1)) ;;\r\n\u001b[?2004l\r"]
[199.25708, "o", "\u001b[?2004h> "]
[199.257156, "o", "    systemd_unit) c_sys=$((c_sys + 1)) ;;\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.257232, "o", "> "]
[199.257263, "o", "    rc_local) c_rc=$((c_rc + 1)) ;;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.257329, "o", "    ssh_key) c_ssh=$((c_ssh + 1)) ;;\r\n\u001b[?2004l\r\u001b[?2004h>   esac\r\n\u001b[?2004l\r"]
[199.257441, "o", "\u001b[?2004h>   lj=$line\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.257482, "o", "  [[ -z $lj || $lj == null ]] && lj=null\r\n\u001b[?2004l\r\u001b[?2004h>   uj=null"]
[199.257586, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.257635, "o", "> "]
[199.257761, "o", "  [[ -n $user ]] && uj=$(printf '\"%s\"' \"$(json_escape \"$user\")\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.258063, "o", "  item=$(printf '    {\\n      \"type\": \"%s\",\\n      \"path\": \"%s\",\\n      \"sha256\": \"%s\",\\n      \"details\": {\\n        \"line_number\": %s,\\n        \"content_preview\": \"%s\",\\n        \"user\": %s\\n      }\\n    }' \"$type\" \"$(json_escape \"$path\")\" \"$sha\" \"$lj\" \"$(json_escape \"$preview\")\" \"$uj\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.258157, "o", "  items+=${items:+,$'\\n'}$item\r\n\u001b[?2004l\r\u001b[?2004h> done <<< \"$SORTED\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[199.258262, "o", "\u001b[?2004l\r"]
[199.258356, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.25854, "o", "  printf '{\\n  \"summary\": {\\n    \"total_artifacts\": %d,\\n    \"cron_jobs\": %d,\\n    \"systemd_units\": %d,\\n    \"rc_local_modifications\": %d,\\n    \"ssh_keys\": %d\\n  },\\n  \"artifacts\": [' \"$total\" \"$c_cron\" \"$c_sys\" \"$c_rc\" \"$c_ssh\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.258563, "o", "  if [[ -n $items ]]; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.258623, "o", "    printf '\\n%s\\n  ]\\n}\\n' \"$items\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.258706, "o", ">   else\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.258762, "o", "> "]
[199.258817, "o", "    printf ']\\n}\\n'\r\n\u001b[?2004l\r\u001b[?2004h>   fi\r\n\u001b[?2004l\r\u001b[?2004h> } > \"$TMP\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.258904, "o", "mv -f \"$TMP\" \"$OUT\" 2>/dev/null\r\n\u001b[?2004l\r\u001b[?2004h> exit 0\r\n"]
[199.258971, "o", "\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[199.259753, "o", "\u001b[?2004hroot@0d5a608a53ec:/app# "]
[199.259851, "o", "chmod +x /app/scan_persistence.sh && echo 'script written'\r\n\u001b[?2004l\r"]
