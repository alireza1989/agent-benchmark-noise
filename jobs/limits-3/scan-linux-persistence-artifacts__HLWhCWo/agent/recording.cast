[239.232898, "i", "system /usr/lib/systemd/system /run/systemd/system /app_target/etc/systemd/system /app_target/usr/lib/systemd/system /app_target/run/systemd/system; do\n  walk_dir \"$d\" scan_systemd_file\ndone\n\nscan_file_list scan_rclocal_file /etc/rc.local /etc/rc.d/rc.local /app_target/etc/rc.local /app_target/etc/rc.d/rc.local\nscan_file_list scan_ssh_file /root/.ssh/authorized_keys /app_target/root/.ssh/authorized_keys /home/*/.ssh/authorized_keys /app_target/home/*/.ssh/authorized_keys\n\nmkdir -p /app\nTMP=\"${OUT}.tmp.$$\"\nSORTED=$(printf '%s' \"$RECORDS\" | sort -t \"$SEP\" -k1,1 -k2,2)\ntotal=0; c_cron=0; c_sys=0; c_rc=0; c_ssh=0\nitems=\"\"\nwhile IFS=\"$SEP\" read -r type path sha line preview user; do\n  [[ -z $type ]] && continue\n  total=$((total + 1))\n  case $type in\n    cron_job) c_cron=$((c_cron + 1)) ;;\n    systemd_unit) c_sys=$((c_sys + 1)) ;;\n    rc_local) c_rc=$((c_rc + 1)) ;;\n    ssh_key) c_ssh=$((c_ssh + 1)) ;;\n  esac\n  lj=$line\n  [[ -z $lj || $lj == null ]] && lj=null\n  uj=null\n  [[ -n $user ]] && uj=$(printf '\"%s\"' \"$(jso"]
