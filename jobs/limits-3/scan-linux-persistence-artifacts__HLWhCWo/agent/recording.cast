[199.239504, "i", "r() {\n  local d=$1 cb=$2 e r\n  while IFS= read -r -d '' e; do\n    r=$(resolve \"$e\") || continue\n    seen_once \"$cb\" \"$r\" || continue\n    \"$cb\" \"$r\"\n  done < <(find \"$d\" -mindepth 1 -maxdepth 1 -print0 2>/dev/null | sort -z)\n}\n\nscan_file_list() {\n  local cb=$1 p r\n  shift\n  for p in \"$@\"; do\n    r=$(resolve \"$p\") || continue\n    seen_once \"$cb\" \"$r\" || continue\n    \"$cb\" \"$r\"\n  done\n}\n\nfor d in /etc/cron.d /var/spool/cron/crontabs /app_target/etc/cron.d /app_target/var/spool/cron/crontabs; do\n  walk_dir \"$d\" scan_cron_file\ndone\nscan_file_list scan_cron_file /etc/crontab /app_target/etc/crontab\n\nfor d in /etc/systemd/system /usr/lib/systemd/system /run/systemd/system /app_target/etc/systemd/system /app_target/usr/lib/systemd/system /app_target/run/systemd/system; do\n  walk_dir \"$d\" scan_systemd_file\ndone\n\nscan_file_list scan_rclocal_file /etc/rc.local /etc/rc.d/rc.local /app_target/etc/rc.local /app_target/etc/rc.d/rc.local\nscan_file_list scan_ssh_file /root/.ssh/authorized_keys /app_target/root/.ssh/authorized"]
