[161.224495, "o", "/app/scan_persistence.sh; echo \"exit=$?\"; md5sum /app/persistence_report.json; /app/scan_persistence.sh; echo \"exit=$?\"; md5sum /app/persistence_report.json; (python3 -m json.tool /app/persistence_report.json >/dev/null && echo JSON_VALID) || echo JSON_INVALID; cat /app/persistence_report.json\r\n\u001b[?2004l\r"]
