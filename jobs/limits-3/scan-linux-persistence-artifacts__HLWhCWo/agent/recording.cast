[263.985601, "o", ">     t=${t%\"${t##*[![:space:]]}\"}\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.985643, "o", "> "]
[263.985736, "o", "    [[ -z $t || $t == \"#\"* || $t == \"exit 0\" ]] && continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.985816, "o", "    add_record rc_local \"$f\" \"$n\" \"$t\" \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.985847, "o", "  done < \"$f\" 2>/dev/null\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.985891, "o", "> }\r\n\u001b[?2004l\r"]
