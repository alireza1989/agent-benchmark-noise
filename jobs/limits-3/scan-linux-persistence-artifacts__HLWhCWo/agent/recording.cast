[263.989715, "o", "  [[ -z $type ]] && continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.989796, "o", "  total=$((total + 1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.98989, "o", "  case $type in\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.989969, "o", "    cron_job) c_cron=$((c_cron + 1)) ;;\r\n\u001b[?2004l\r\u001b[?2004h>     systemd_unit) c_sys=$((c_sys + 1)) ;;\r\n\u001b[?2004l\r"]
