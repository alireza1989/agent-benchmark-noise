[160.223248, "o", "    fi\r\n\u001b[?2004l\r\u001b[?2004h>   done < \"$f\" 2>/dev/null\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.223348, "o", "scan_systemd_file() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.223439, "o", "  local f=$1 base hidden=0 n=0 text value hitline=\"\" hittext=\"\" preview\r\n\u001b[?2004l\r\u001b[?2004h>   base=$(basename -- \"$f\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.223464, "o", "> "]
[160.223534, "o", "  [[ $base == .* ]] && hidden=1\r\n\u001b[?2004l\r"]
[160.223618, "o", "\u001b[?2004h>   while IFS= read -r text || [[ -n $text ]]; do\r\n\u001b[?2004l\r"]
[160.223644, "o", "\u001b[?2004h"]
[160.223696, "o", ">     n=$((n+1))\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.223774, "o", "> "]
[160.223885, "o", "    if [[ $text =~ ^[[:space:]]*Exec(Start|StartPre|StartPost|Stop)?[[:space:]]*= ]]; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.22391, "o", "      value=${text#*=}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.223997, "o", "      value=${value#\"${value%%[![:space:]]*}\"}\r\n\u001b[?2004l\r"]
[160.224025, "o", "\u001b[?2004h> "]
[160.224093, "o", "      value=${value#-}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.224205, "o", "      if [[ -z $hitline ]] && is_suspicious \"$value\"; then\r\n\u001b[?2004l\r\u001b[?2004h>         hitline=$n\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.224342, "o", ">         hittext=$text\r\n\u001b[?2004l\r\u001b[?2004h>       fi\r\n\u001b[?2004l\r\u001b[?2004h>     fi\r\n\u001b[?2004l\r"]
[160.224427, "o", "\u001b[?2004h>   done < \"$f\" 2>/dev/null\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.224526, "o", "  if (( hidden )) || [[ -n $hitline ]]; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.224546, "o", "    if [[ -n $hitline ]]; then\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.224611, "o", ">       preview=$hittext\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.22464, "o", ">     else\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.224712, "o", "      preview=\"hidden unit file: $base\"\r\n\u001b[?2004l\r\u001b[?2004h>     fi\r\n\u001b[?2004l\r"]
[160.224733, "o", "\u001b[?2004h"]
[160.22479, "o", "> "]
[160.224885, "o", "    add_record systemd_unit \"$f\" \"$hitline\" \"$preview\" \"\"\r\n\u001b[?2004l\r\u001b[?2004h>   fi\r\n\u001b[?2004l\r"]
[160.224909, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[160.22497, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.225042, "o", "scan_rclocal_file() {\r\n\u001b[?2004l\r\u001b[?2004h>   local f=$1 n=0 line t\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.225161, "o", "  while IFS= read -r line || [[ -n $line ]]; do\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.225184, "o", "    n=$((n+1))\r\n\u001b[?2004l\r"]
[160.225287, "o", "\u001b[?2004h>     t=${line#\"${line%%[![:space:]]*}\"}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.225309, "o", "    t=${t%\"${t##*[![:space:]]}\"}\r\n"]
[160.225322, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[160.225415, "o", "    [[ -z $t || $t == \"#\"* || $t == \"exit 0\" ]] && continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.225564, "o", "    add_record rc_local \"$f\" \"$n\" \"$t\" \"\"\r\n\u001b[?2004l\r\u001b[?2004h>   done < \"$f\" 2>/dev/null\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.225684, "o", "> }"]
[160.225705, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[160.225818, "o", "\u001b[?2004h> scan_ssh_file() {\r\n\u001b[?2004l\r"]
[160.225844, "o", "\u001b[?2004h> "]
[160.225921, "o", "  local f=$1 n=0 line t user=root\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.226032, "o", "  if [[ $f =~ /home/([^/]+)/[.]ssh/authorized_keys$ ]]; then\r\n\u001b[?2004l\r\u001b[?2004h>     user=${BASH_REMATCH[1]}\r\n\u001b[?2004l\r\u001b[?2004h>   fi\r\n\u001b[?2004l\r"]
[160.226074, "o", "\u001b[?2004h"]
[160.226148, "o", ">   while IFS= read -r line || [[ -n $line ]]; do\r\n\u001b[?2004l\r"]
[160.226254, "o", "\u001b[?2004h>     n=$((n+1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.226316, "o", "    t=${line#\"${line%%[![:space:]]*}\"}\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.226324, "o", "> "]
[160.226425, "o", "    t=${t%\"${t##*[![:space:]]}\"}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.226529, "o", "    [[ -z $t || $t == \"#\"* ]] && continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.226622, "o", "    [[ -n ${KNOWN[$t]:-} ]] && continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.226684, "o", "    add_record ssh_key \"$f\" \"$n\" \"$t\" \"$user\"\r\n\u001b[?2004l\r"]
[160.226725, "o", "\u001b[?2004h> "]
[160.226768, "o", "  done < \"$f\" 2>/dev/null\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[160.226852, "o", "\u001b[?2004h> walk_dir() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.226881, "o", "> "]
[160.22693, "o", "  local d=$1 cb=$2 e r\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.226952, "o", "> "]
[160.227018, "o", "  while IFS= read -r -d '' e; do\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.227129, "o", "    r=$(resolve \"$e\") || continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.227261, "o", "    seen_once \"$cb\" \"$r\" || continue\r\n\u001b[?2004l\r\u001b[?2004h>     \"$cb\" \"$r\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.227348, "o", "  done < <(find \"$d\" -mindepth 1 -maxdepth 1 -print0 2>/dev/null | sort -z)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.227425, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> scan_file_list() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.227504, "o", "  local cb=$1 p r\r\n\u001b[?2004l\r\u001b[?2004h>   shift\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.227686, "o", "  for p in \"$@\"; do\r\n\u001b[?2004l\r\u001b[?2004h>     r=$(resolve \"$p\") || continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.22771, "o", "    seen_once \"$cb\" \"$r\" || continue\r\n\u001b[?2004l\r"]
[160.227851, "o", "\u001b[?2004h>     \"$cb\" \"$r\"\r\n\u001b[?2004l\r\u001b[?2004h>   done\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.227957, "o", "for d in /etc/cron.d /var/spool/cron/crontabs /app_target/etc/cron.d /app_target/var/spool/cron/crontabs; do\r\n\u001b[?2004l\r\u001b[?2004h>   walk_dir \"$d\" scan_cron_file\r\n\u001b[?2004l\r"]
[160.228091, "o", "\u001b[?2004h> done\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.228251, "o", "scan_file_list scan_cron_file /etc/crontab /app_target/etc/crontab\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.228377, "o", "for d in /etc/systemd/system /usr/lib/systemd/system /run/systemd/system /app_target/etc/systemd/system /app_target/usr/lib/systemd/system /app_target/run/systemd/system; do\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.228462, "o", "  walk_dir \"$d\" scan_systemd_file\r\n\u001b[?2004l\r\u001b[?2004h> done\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.228618, "o", "scan_file_list scan_rclocal_file /etc/rc.local /etc/rc.d/rc.local /app_target/etc/rc.local /app_target/etc/rc.d/rc.local\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.228778, "o", "scan_file_list scan_ssh_file /root/.ssh/authorized_keys /app_target/root/.ssh/authorized_keys /home/*/.ssh/authorized_keys /app_target/home/*/.ssh/authorized_keys\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[160.228799, "o", "> "]
[160.228804, "o", "mkdir -p /app\r\n\u001b[?2004l\r"]
[160.228853, "o", "\u001b[?2004h> "]
[160.228899, "o", "TMP=\"${OUT}.tmp.$$\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.228968, "o", "SORTED=$(printf '%s' \"$RECORDS\" | sort -t \"$SEP\" -k1,1 -k2,2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.228996, "o", "> "]
[160.229075, "o", "total=0; c_cron=0; c_sys=0; c_rc=0; c_ssh=0\r\n\u001b[?2004l\r"]
[160.229175, "o", "\u001b[?2004h> items=\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.229256, "o", "while IFS=\"$SEP\" read -r type path sha line preview user; do\r\n\u001b[?2004l\r\u001b[?2004h>   [[ -z $type ]] && continue\r\n\u001b[?2004l\r"]
[160.229297, "o", "\u001b[?2004h"]
[160.229345, "o", "> "]
[160.22943, "o", "  total=$((total + 1))\r\n\u001b[?2004l\r\u001b[?2004h>   case $type in\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.229507, "o", "    cron_job) c_cron=$((c_cron + 1)) ;;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.229589, "o", "    systemd_unit) c_sys=$((c_sys + 1)) ;;\r\n\u001b[?2004l\r\u001b[?2004h>     rc_local) c_rc=$((c_rc + 1)) ;;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.229666, "o", "    ssh_key) c_ssh=$((c_ssh + 1)) ;;\r\n\u001b[?2004l\r\u001b[?2004h>   esac\r\n\u001b[?2004l\r"]
[160.229673, "o", "\u001b[?2004h>   lj=$line\r\n\u001b[?2004l\r"]
[160.229728, "o", "\u001b[?2004h> "]
[160.229788, "o", "  [[ -z $lj || $lj == null ]] && lj=null\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.229846, "o", "  uj=null\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.229908, "o", "  [[ -n $user ]] && uj=$(printf '\"%s\"' \"$(json_escape \"$user\")\")\r\n\u001b[?2004l\r"]
[160.229928, "o", "\u001b[?2004h> "]
[160.230223, "o", "  item=$(printf '    {\\n      \"type\": \"%s\",\\n      \"path\": \"%s\",\\n      \"sha256\": \"%s\",\\n      \"details\": {\\n        \"line_number\": %s,\\n        \"content_preview\": \"%s\",\\n        \"user\": %s\\n      }\\n    }' \"$type\" \"$(json_escape \"$path\")\" \"$sha\" \"$lj\" \"$(json_escape \"$preview\")\" \"$uj\")\r\n\u001b[?2004l\r"]
[160.23024, "o", "\u001b[?2004h> "]
[160.230306, "o", "  items+=${items:+,$'\\n'}$item\r\n\u001b[?2004l\r\u001b[?2004h> done <<< \"$SORTED\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.230329, "o", "> \r\n\u001b[?2004l\r"]
[160.230367, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.230614, "o", "  printf '{\\n  \"summary\": {\\n    \"total_artifacts\": %d,\\n    \"cron_jobs\": %d,\\n    \"systemd_units\": %d,\\n    \"rc_local_modifications\": %d,\\n    \"ssh_keys\": %d\\n  },\\n  \"artifacts\": [' \"$total\" \"$c_cron\" \"$c_sys\" \"$c_rc\" \"$c_ssh\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.230712, "o", "  if [[ -n $items ]]; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.230735, "o", "    printf '\\n%s\\n  ]\\n}\\n' \"$items\"\r\n\u001b[?2004l\r\u001b[?2004h>   else\r\n\u001b[?2004l\r\u001b[?2004h>     printf ']\\n}\\n'\r\n\u001b[?2004l\r"]
[160.23074, "o", "\u001b[?2004h> "]
[160.230814, "o", "  fi\r\n\u001b[?2004l\r\u001b[?2004h> } > \"$TMP\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.230902, "o", "mv -f \"$TMP\" \"$OUT\" 2>/dev/null\r\n\u001b[?2004l\r\u001b[?2004h> exit 0\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[160.272964, "o", "\u001b[?2004hroot@0d5a608a53ec:/app# "]
[160.273172, "o", "chmod +x /app/scan_persistence.sh && echo 'script written'\r\n\u001b[?2004l\r"]
[160.273618, "o", "script written\r\n\u001b[?2004h"]
[160.273637, "o", "root@0d5a608a53ec:/app# "]
