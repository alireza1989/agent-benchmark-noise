[199.239156, "i", "ext\n      fi\n    fi\n  done < \"$f\" 2>/dev/null\n  if (( hidden )) || [[ -n $hitline ]]; then\n    if [[ -n $hitline ]]; then\n      preview=$hittext\n    else\n      preview=\"hidden unit file: $base\"\n    fi\n    add_record systemd_unit \"$f\" \"$hitline\" \"$preview\" \"\"\n  fi\n}\n\nscan_rclocal_file() {\n  local f=$1 n=0 line t\n  while IFS= read -r line || [[ -n $line ]]; do\n    n=$((n+1))\n    t=${line#\"${line%%[![:space:]]*}\"}\n    t=${t%\"${t##*[![:space:]]}\"}\n    [[ -z $t || $t == \"#\"* || $t == \"exit 0\" ]] && continue\n    add_record rc_local \"$f\" \"$n\" \"$t\" \"\"\n  done < \"$f\" 2>/dev/null\n}\n\nscan_ssh_file() {\n  local f=$1 n=0 line t user=root\n  if [[ $f =~ /home/([^/]+)/[.]ssh/authorized_keys$ ]]; then\n    user=${BASH_REMATCH[1]}\n  fi\n  while IFS= read -r line || [[ -n $line ]]; do\n    n=$((n+1))\n    t=${line#\"${line%%[![:space:]]*}\"}\n    t=${t%\"${t##*[![:space:]]}\"}\n    [[ -z $t || $t == \"#\"* ]] && continue\n    [[ -n ${KNOWN[$t]:-} ]] && continue\n    add_record ssh_key \"$f\" \"$n\" \"$t\" \"$user\"\n  done < \"$f\" 2>/dev/null\n}\n\nwalk_di"]
