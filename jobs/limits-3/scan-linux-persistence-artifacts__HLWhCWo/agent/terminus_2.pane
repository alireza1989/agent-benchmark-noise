scan_cron_file() {
  local f=$1 spool=0 n=0 line t user idx
  local -a F
  [[ $f == */spool/cron/* ]] && spool=1
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n+1))
    t=${line#"${line%%[![:space:]]*}"}
    [[ -z $t || $t == "#"* ]] && continue
    [[ $t =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && continue
    if is_stock_cron "$t"; then continue; fi
    user=""
    if (( spool )); then
      user=$(basename -- "$f")
    else
      read -ra F <<< "$t"
      idx=5
      [[ ${F[0]} == @* ]] && idx=1
      [[ -n ${F[$idx]:-} ]] && user=${F[$idx]}
    fi
    if is_every_minute "$t" || is_suspicious "$t"; then
      add_record cron_job "$f" "$n" "$t" "$user"
    fi
  done < "$f" 2>/dev/null
}

scan_systemd_file() {
  local f=$1 base hidden=0 n=0 text value hitline="" hittext="" preview
  base=$(basename -- "$f")
  [[ $base == .* ]] && hidden=1
  while IFS= read -r text || [[ -n $text ]]; do
    n=$((n+1))
    if [[ $text =~ ^[[:space:]]*Exec(Start|StartPre|StartPost|Stop)?[[:space:]]*= ]]; then
      value=${text#*=}
      value=${value#"${value%%[![:space:]]*}"}
      value=${value#-}
      if [[ -z $hitline ]] && is_suspicious "$value"; then
        hitline=$n
        hittext=$text
      fi
    fi
  done < "$f" 2>/dev/null
  if (( hidden )) || [[ -n $hitline ]]; then
    if [[ -n $hitline ]]; then
      preview=$hittext
    else
      preview="hidden unit file: $base"
    fi
    add_record systemd_unit "$f" "$hitline" "$preview" ""
  fi
}

scan_rclocal_file() {
  local f=$1 n=0 line t
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n+1))
    t=${line#"${line%%[![:space:]]*}"}
    t=${t%"${t##*[![:space:]]}"}
    [[ -z $t || $t == "#"* || $t == "exit 0" ]] && continue
    add_record rc_local "$f" "$n" "$t" ""
  done < "$f" 2>/dev/null
}

