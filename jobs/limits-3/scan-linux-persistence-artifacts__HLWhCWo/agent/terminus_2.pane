resolve() {
  local r
  r=$(readlink -f -- "$1" 2>/dev/null) || return 1
  [[ -n $r && -f $r && -r $r ]] || return 1
  printf '%s' "$r"
}

seen_once() {
  local key="$1|$2"
  [[ -n ${SEEN[$key]:-} ]] && return 1
  SEEN[$key]=1
  return 0
}

is_every_minute() {
  [[ $1 =~ ^([*]|[*]/1)([[:space:]]+([*]|[*]/1)){4}([[:space:]]|$) ]]
}

is_suspicious() {
  local t=$1 tok
  local -a toks
  grep -Eqi -- "$SUSP_RE" <<< "$t" && return 0
  read -ra toks <<< "$t"
  for tok in "${toks[@]}"; do
    case $tok in
      /*)
        case $tok in
          /usr/bin/*|/bin/*|/sbin/*|/usr/sbin/*|/usr/lib/*|/usr/libexec/*|/lib/*|/etc/*|/run/systemd/*|/dev/null|/proc/*|/sys/*|/) ;;
          *) return 0 ;;
        esac ;;
    esac
  done
  return 1
}

scan_cron_file() {
  local f=$1 spool=0 n=0 line t user idx
  local -a F
  [[ $f == */spool/cron/* ]] && spool=1
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n+1))
    t=${line#"${line%%[![:space:]]*}"}
    [[ -z $t || $t == "#"* ]] && continue
    [[ $t =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && continue
    user=""
    if (( spool )); then
      user=$(basename -- "$f")
    else
      read -ra F <<< "$t"
      idx=5
      [[ ${F[0]} == @* ]] && idx=1
      [[ -n ${F[$idx]:-} ]] && user=${F[$idx]}
    fi
    if is_every_minute "$t" || is_suspicious "$t"; then
      add_record cron_job "$f" "$n" "$t" "$user"
    fi
  done < "$f" 2>/dev/null
}

scan_systemd_file() {
  local f=$1 base hidden=0 n=0 text value hitline="" hittext="" preview
  base=$(basename -- "$f")
  [[ $base == .* ]] && hidden=1
  while IFS= read -r text || [[ -n $text ]]; do
    n=$((n+1))
    if [[ $text =~ ^[[:space:]]*Exec(Start|StartPre|StartPost|Stop)?[[:space:]]*= ]]; then
      value=${text#*=}
      value=${value#"${value%%[![:space:]]*}"}
      value=${value#-}
      if [[ -z $hitline ]] && is_suspicious "$value"; then
        hitline=$n
        hittext=$text
      fi
    fi
  done < "$f" 2>/dev/null
  if (( hidden )) || [[ -n $hitline ]]; then
    if [[ -n $hitline ]]; then
      preview=$hittext
    else
      preview="hidden unit file: $base"
    fi
    add_record systemd_unit "$f" "$hitline" "$preview" ""
  fi
}

scan_rclocal_file() {
  local f=$1 n=0 line t
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n+1))
    t=${line#"${line%%[![:space:]]*}"}
    t=${t%"${t##*[![:space:]]}"}
    [[ -z $t || $t == "#"* || $t == "exit 0" ]] && continue
    add_record rc_local "$f" "$n" "$t" ""
  done < "$f" 2>/dev/null
}

scan_ssh_file() {
  local f=$1 n=0 line t user=root
  if [[ $f =~ /home/([^/]+)/[.]ssh/authorized_keys$ ]]; then
    user=${BASH_REMATCH[1]}
  fi
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n+1))
    t=${line#"${line%%[![:space:]]*}"}
    t=${t%"${t##*[![:space:]]}"}
    [[ -z $t || $t == "#"* ]] && continue
    [[ -n ${KNOWN[$t]:-} ]] && continue
    add_record ssh_key "$f" "$n" "$t" "$user"
  done < "$f" 2>/dev/null
}

