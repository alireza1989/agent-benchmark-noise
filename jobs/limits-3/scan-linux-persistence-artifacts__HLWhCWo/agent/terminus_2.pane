    user=${BASH_REMATCH[1]}
  fi
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n+1))
    t=${line#"${line%%[![:space:]]*}"}
    t=${t%[?2004h> # scan_persistence.sh - read-only scanner for seeded persistence artifacts
