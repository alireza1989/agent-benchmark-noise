def make_token(sub, ttype, ttl):
    now = dt.datetime.now(dt.timezone.utc)
    claims = {'iss': ISSUER, 'sub': sub, 'iat': now, 'exp': now + ttl,
              'jti': str(uuid.uuid4()), 'type': ttype}
    return jwt.encode(claims, PRIVATE, algorithm='RS256')


def verify(token):
    return jwt.decode(token, PUBLIC, algorithms=['RS256'], issuer=ISSUER,
                      options={'require': ['exp', 'iat', 'jti', 'sub', 'iss']})


def check(token, expected_type=None):
    try:
        claims = verify(token)
    except jwt.ExpiredSignatureError:
        return None, ('token expired', 401)
    except jwt.InvalidTokenError as e:
        return None, ('invalid token: ' + str(e), 401)
    if expected_type and claims.get('type') != expected_type:
