[92.58388, "i", "r = validate_token(d['access_token'])\n    if r.status_code == 401 and d.get('refresh_token'):\n        print('access token expired or invalid; attempting refresh')\n        if do_refresh(d):\n            r = validate_token(d['access_token'])\n    print(r.status_code, r.text)\n    if r.status_code == 200:\n        print('VALID')\n        return 0\n    print('INVALID (expired)' if r.status_code == 401 else 'INVALID (revoked)')\n    if r.status_code == 401:\n        log.warning('validate: token expired or invalid')\n    return 3 if r.status_code == 403 else 1\n\n\ndef cmd_revoke(args):\n    d = load()\n    keys = ['access_token', 'refresh_token'] if args.which == 'both' else [args.which + '_token']\n    for k in keys:\n        if k not in d:\n            continue\n        r = post('/auth/revoke', token=d[k])\n        print(k, r.status_code, r.text)\n        if r.status_code == 200:\n            log.info('revoked %s', k)\n        else:\n            log.error('revoke of %s failed: %s %s', k, r.status_code, r.text)\n        if r.status_code"]
[92.584025, "o", "\u001b[?2004h> #!/usr/bin/env python3\r\n\u001b[?2004l\rr = validate_token(d['access_token'])\r\n    if r.status_code == 401 and d.get('refresh_token'):\r\n        print('access token expired or invalid; attempting refresh')\r\n        if do_refresh(d):\r\n            r = validate_token(d['access_token'])\r\n    print(r.status_code, r.text)\r\n    if r.status_code == 200:\r\n        print('VALID')\r\n        return 0\r\n    print('INVALID (expired)' if r.status_code == 401 else 'INVALID (revoked)')\r\n    if r.status_code == 401:\r\n        log.warning('validate: token expired or invalid')\r\n    return 3 if r.status_code == 403 else 1\r\n\r\n\r\ndef cmd_revoke(args):\r\n    d = load()\r\n    keys = ['access_token', 'refresh_token'] if args.which == 'both' else [args.which + '_token']\r\n    for k in keys:\r\n        if k not in d:\r\n            continue\r\n        r = post('/auth/revoke', token=d[k])\r\n        print(k, r.status_code, r.text)\r\n        if r.status_code == 200:\r\n            log.info('revoked %s', k)\r\n        else:\r\n            log.error('revoke of "]
[92.584054, "i", " in (200, 401):\n            d.pop(k, None)\n    save(d)\n    return 0\n\n\ndef cmd_retry(args):\n    for i in range(1, args.attempts + 1):\n        d = load()\n        if d.get('access_token') and validate_token(d['access_token']).status_code == 200:\n            print('tokens valid; nothing to retry')\n            return 0\n        if do_refresh(d):\n            return 0\n        if do_login(args.username, args.password):\n            return 0\n        wait = 2 ** (i - 1)\n        print('attempt %d failed; retrying in %ds' % (i, wait))\n        time.sleep(wait)\n    print('giving up after %d attempts' % args.attempts, file=sys.stderr)\n    return 1\n\n\ndef main():\n    p = argparse.ArgumentParser(description='JWT auth CLI')\n    sub = p.add_subparsers(dest='cmd', required=True)\n    a = sub.add_parser('acquire')\n    a.add_argument('--username', default='admin')\n    a.add_argument('--password', default='password123')\n    sub.add_parser('validate')\n    rv = sub.add_parser('revoke')\n    rv.add_argument('--which', choices=['access', 'r"]
