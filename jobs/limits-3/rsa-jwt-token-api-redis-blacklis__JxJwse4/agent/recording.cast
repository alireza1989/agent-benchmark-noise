[92.592836, "o", "def cmd_revoke(args):\r\n\u001b[?2004l\r\u001b[?2004h>     d = load()\r\n\u001b[?2004l\r"]
[92.592865, "o", "\u001b[?2004h> "]
[92.593084, "o", "    keys = ['access_token', 'refresh_token'] if args.which == 'both' else [args.which + '_token']\r\n\u001b[?2004l\r\u001b[?2004h>     for k in keys:"]
[92.593171, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.593201, "o", "        if k not in d:\r\n\u001b[?2004l\r"]
[92.593309, "o", "\u001b[?2004h> "]
[92.593471, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.593503, "o", "        r = post('/auth/revoke', token=d[k])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.593647, "o", "        print(k, r.status_code, r.text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.593758, "o", "        if r.status_code == 200:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.593913, "o", "            log.info('revoked %s', k)\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.593946, "o", ">         else:\r\n\u001b[?2004l\r"]
[92.593987, "o", "\u001b[?2004h> "]
[92.594192, "o", "            log.error('revoke of %s failed: %s %s', k, r.status_code, r.text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.594298, "o", "        if r.status_code in (200, 401):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.59441, "o", "            d.pop(k, None)\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.594483, "o", ">     save(d)\r\n\u001b[?2004l\r\u001b[?2004h>     return 0"]
[92.594548, "o", "\r\n\u001b[?2004l\r"]
[92.594659, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.594748, "o", "def cmd_retry(args):\r\n\u001b[?2004l\r"]
[92.594871, "o", "\u001b[?2004h> "]
[92.594996, "o", "    for i in range(1, args.attempts + 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.595032, "o", "        d = load()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.595151, "o", "        if d.get('access_token') and validate_token(d['access_token']).status_code == 200:\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.595185, "o", "> "]
[92.595366, "o", "            print('tokens valid; nothing to retry')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.59541, "o", "            return 0\r\n\u001b[?2004l\r"]
[92.59554, "o", "\u001b[?2004h>         if do_refresh(d):"]
[92.595729, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.595754, "o", "            return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.595834, "o", "        if do_login(args.username, args.password):\r\n\u001b[?2004l\r\u001b[?2004h>             return 0"]
[92.595861, "o", "\r\n\u001b[?2004l\r"]
[92.595975, "o", "\u001b[?2004h>         wait = 2 ** (i - 1)\r\n\u001b[?2004l\r"]
[92.596069, "o", "\u001b[?2004h> "]
[92.596136, "o", "        print('attempt %d failed; retrying in %ds' % (i, wait))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.596228, "o", "        time.sleep(wait)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.596308, "o", "    print('giving up after %d attempts' % args.attempts, file=sys.stderr)\r\n\u001b[?2004l\r\u001b[?2004h>     return 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.596327, "o", "\r\n\u001b[?2004l\r"]
[92.596407, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main():\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.596428, "o", "> "]
[92.596532, "o", "    p = argparse.ArgumentParser(description='JWT auth CLI')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.59663, "o", "    sub = p.add_subparsers(dest='cmd', required=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.596711, "o", "    a = sub.add_parser('acquire')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.596812, "o", "    a.add_argument('--username', default='admin')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.596941, "o", "    a.add_argument('--password', default='password123')\r\n\u001b[?2004l\r\u001b[?2004h>     sub.add_parser('validate')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.597043, "o", "    rv = sub.add_parser('revoke')\r\n\u001b[?2004l\r"]
[92.597194, "o", "\u001b[?2004h> "]
[92.597266, "o", "    rv.add_argument('--which', choices=['access', 'refresh', 'both'], default='both')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.597365, "o", "    rt = sub.add_parser('retry')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.59745, "o", "    rt.add_argument('--attempts', type=int, default=3)\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.597468, "o", "> "]
[92.597557, "o", "    rt.add_argument('--username', default='admin')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.59763, "o", "    rt.add_argument('--password', default='password123')\r\n\u001b[?2004l\r\u001b[?2004h>     args = p.parse_args()\r\n\u001b[?2004l\r"]
[92.597705, "o", "\u001b[?2004h> "]
[92.597829, "o", "    handlers = {'acquire': cmd_acquire, 'validate': cmd_validate,\r\n\u001b[?2004l\r\u001b[?2004h>                 'revoke': cmd_revoke, 'retry': cmd_retry}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.597905, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.597928, "o", "        return handlers[args.cmd](args)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.598045, "o", "    except requests.RequestException as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.598113, "o", "        log.error('API unreachable at %s: %s', API, e)\r\n\u001b[?2004l\r"]
[92.598148, "o", "\u001b[?2004h> "]
[92.598258, "o", "        print('error: API unreachable at', API, file=sys.stderr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.598358, "o", "        return 2\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.598445, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.59851, "o", "    sys.exit(main())\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[92.599627, "o", "\u001b[?2004hroot@dd05d7035ebf:/app# "]
[92.599695, "o", "chmod +x /app/cli.py && echo WROTE_CLI\r\n\u001b[?2004l\r"]
[92.600254, "o", "WROTE_CLI\r\n\u001b[?2004hroot@dd05d7035ebf:/app# "]
