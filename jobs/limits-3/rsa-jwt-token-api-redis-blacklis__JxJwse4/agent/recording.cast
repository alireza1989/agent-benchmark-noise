[92.584141, "i", "efresh', 'both'], default='both')\n    rt = sub.add_parser('retry')\n    rt.add_argument('--attempts', type=int, default=3)\n    rt.add_argument('--username', default='admin')\n    rt.add_argument('--password', default='password123')\n    args = p.parse_args()\n    handlers = {'acquire': cmd_acquire, 'validate': cmd_validate,\n                'revoke': cmd_revoke, 'retry': cmd_retry}\n    try:\n        return handlers[args.cmd](args)\n    except requests.RequestException as e:\n        log.error('API unreachable at %s: %s', API, e)\n        print('error: API unreachable at', API, file=sys.stderr)\n        return 2\n\n\nif __name__ == '__main__':\n    sys.exit(main())\nEOF\nchmod +x /app/cli.py && echo WROTE_CLI\n"]
