[112.022164, "o", " * Running on http://172.20.0.2:5000\r\n2026-10-26 01:29:42,864 INFO api: \u001b[33mPress CTRL+C to quit\u001b[0m\r\n2026-10-26 01:29:45,818 INFO api: login ok for user admin\r\n2026-10-26 01:29:45,819 INFO api: 127.0.0.1 - - [26/Oct/2026 01:29:45] \"POST /auth/login HTTP/1.1\" 200 -\r\n2026-10-26 01:29:46,212 INFO api: login ok for user admin\r\n2026-10-26 01:29:46,212 INFO api: 127.0.0.1 - - [26/Oct/2026 01:29:46] \"POST /auth/login HTTP/1.1\" 200 -\r\n2026-10-26 01:29:46,303 INFO api: 127.0.0.1 - - [26/Oct/2026 01:29:46] \"GET /auth/validate HTTP/1.1\" 200 -\r\n2026-10-26 01:29:54,975 INFO api: revoked jti 44147b06-4a78-4d8c-91f8-706ae9af094c\r\n2026-10-26 01:29:54,975 INFO api: 127.0.0.1 - - [26/Oct/2026 01:29:54] \"POST /auth/revoke HTTP/1.1\" 200 -\r\n2026-10-26 01:29:54,976 INFO cli: revoked access_token\r\n2026-10-26 01:29:56,424 INFO api: 127.0.0.1 - - [26/Oct/2026 01:29:56] \"\u001b[31m\u001b[1mGET /auth/validate HTTP/1.1\u001b[0m\" 401 -\r\n2026-10-26 01:29:57,531 INFO api: 127.0.0.1 - - [26/Oct/2026 01:29:57] \"POST /auth/refresh HTTP/1.1\" 200 -\r\n2026-10"]
