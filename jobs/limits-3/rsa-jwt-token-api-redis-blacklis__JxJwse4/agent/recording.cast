[123.02032, "i", "cat > /tmp/test_flow.py << 'EOF'\nimport requests, jwt, datetime as dt, uuid\nAPI = 'http://localhost:5000'\nr = requests.post(API + '/auth/login', json={'username': 'admin', 'password': 'password123'}).json()\nacc, ref = r['access_token'], r['refresh_token']\nH = lambda t: {'Authorization': 'Bearer ' + t}\nprint('fresh validate:', requests.get(API + '/auth/validate', headers=H(acc)).status_code)\nprint('revoke access:', requests.post(API + '/auth/revoke', json={'token': acc}).status_code)\nx = requests.get(API + '/auth/validate', headers=H(acc))\nprint('revoked validate:', x.status_code, x.text)\npriv = open('/app/keys/private.pem').read()\nnow = dt.datetime.now(dt.timezone.utc)\nexpired = jwt.encode({'iss': 'rsa-jwt-api', 'sub': 'admin', 'iat': now - dt.timedelta(minutes=30), 'exp': now - dt.timedelta(minutes=15), 'jti': str(uuid.uuid4()), 'type': 'access'}, priv, algorithm='RS256')\nx = requests.get(API + '/auth/validate', headers=H(expired))\nprint('expired validate:', x.status_code, x.text)\nprint('revoke refresh:', re"]
[123.021133, "o", "cat > /tmp/test_flow.py << 'EOF'\r\n\u001b[?2004l\r"]
[123.021247, "i", "quests.post(API + '/auth/revoke', json={'token': ref}).status_code)\nx = requests.post(API + '/auth/refresh', json={'refresh_token': ref})\nprint('revoked refresh:', x.status_code, x.text)\nEOF\npython3 /tmp/test_flow.py; echo ---BLACKLIST---; redis-cli keys 'blacklist:*'; echo ---LOG---; tail -n 8 /app/logs/app.log\n"]
