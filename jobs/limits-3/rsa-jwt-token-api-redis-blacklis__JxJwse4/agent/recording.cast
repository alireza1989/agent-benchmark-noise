[92.583611, "i", "cat > /app/cli.py << 'EOF'\n#!/usr/bin/env python3\nimport argparse, json, logging, os, sys, time\nimport requests\n\nBASE = '/app'\nTOKENS = BASE + '/tokens.json'\nAPI = os.environ.get('API_URL', 'http://localhost:5000')\nos.makedirs(BASE + '/logs', exist_ok=True)\nlogging.basicConfig(filename=BASE + '/logs/app.log', level=logging.INFO,\n                    format='%(asctime)s %(levelname)s cli: %(message)s')\nlog = logging.getLogger('cli')\n\n\ndef load():\n    if not os.path.exists(TOKENS):\n        return {}\n    with open(TOKENS) as f:\n        return json.load(f)\n\n\ndef save(d):\n    with open(TOKENS, 'w') as f:\n        json.dump(d, f, indent=2)\n\n\ndef post(path, **body):\n    return requests.post(API + path, json=body, timeout=10)\n\n\ndef validate_token(tok):\n    return requests.get(API + '/auth/validate',\n                        headers={'Authorization': 'Bearer ' + tok}, timeout=10)\n\n\ndef do_login(user, pw):\n    r = post('/auth/login', username=user, password=pw)\n    if r.status_code != 200:\n        log.error('login failed "]
[92.583823, "i", "for %s: %s %s', user, r.status_code, r.text)\n        print('login failed:', r.status_code, r.text, file=sys.stderr)\n        return False\n    d = r.json()\n    save({'username': user, 'access_token': d['access_token'],\n          'refresh_token': d['refresh_token']})\n    print('tokens acquired and saved to', TOKENS)\n    return True\n\n\ndef do_refresh(d):\n    if not d.get('refresh_token'):\n        return False\n    r = post('/auth/refresh', refresh_token=d['refresh_token'])\n    if r.status_code != 200:\n        log.error('refresh failed: %s %s', r.status_code, r.text)\n        print('refresh failed:', r.status_code, r.text, file=sys.stderr)\n        return False\n    d['access_token'] = r.json()['access_token']\n    save(d)\n    print('access token refreshed')\n    return True\n\n\ndef cmd_acquire(args):\n    return 0 if do_login(args.username, args.password) else 1\n\n\ndef cmd_validate(args):\n    d = load()\n    if 'access_token' not in d:\n        print('no tokens found; run acquire first', file=sys.stderr)\n        return 1\n    "]
