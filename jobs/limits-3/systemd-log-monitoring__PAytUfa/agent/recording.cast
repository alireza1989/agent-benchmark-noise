[53.319032, "o", "\u001b[?2004hroot@fe59e176b225:/opt/myapp# "]
[53.824891, "i", "cat > /etc/rsyslog.d/50-myapp.conf << 'EOF'\n# Read journald messages (systemd-journal integration)\nmodule(load=\"imjournal\" StateFile=\"imjournal.state\")\n\n# Files created by rsyslog are owned by the myapp user\n$FileOwner myapp\n$FileGroup myapp\n$FileCreateMode 0644\n\n# Route only ERROR-level JSON events to the errors file\nif $programname == 'myapp' and $msg contains '\"level\":\"ERROR\"' then /var/log/app_errors.log\n\n# Route all INFO, WARN and ERROR events to the events file\nif $programname == 'myapp' then /var/log/app_events.log\nEOF\ncat /etc/rsyslog.d/50-myapp.conf | tail -3\n"]
[53.825129, "o", "cat > /etc/rsyslog.d/50-myapp.conf << 'EOF'\r\n\u001b[?2004l\r"]
[53.825216, "o", "\u001b[?2004h"]
[53.825568, "o", "> # Read journald messages (systemd-journal integration)\r\n\u001b[?2004l\r\u001b[?2004h> module(load=\"imjournal\" StateFile=\"imjournal.state\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.826389, "o", "# Files created by rsyslog are owned by the myapp user\r\n\u001b[?2004l\r\u001b[?2004h> $FileOwner myapp\r\n\u001b[?2004l\r\u001b[?2004h> $FileGroup myapp\r\n\u001b[?2004l\r\u001b[?2004h> $FileCreateMode 0644\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Route only ERROR-level JSON events to the errors file\r\n\u001b[?2004l\r\u001b[?2004h> if $programname == 'myapp' and $msg contains '\"level\":\"ERROR\"' then /var/log/app_errors.log\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.826568, "o", "# Route all INFO, WARN and ERROR events to the events file\r\n\u001b[?2004l\r\u001b[?2004h> if $programname == 'myapp' then /var/log/app_events.log\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[53.829688, "o", "\u001b[?2004hroot@fe59e176b225:/opt/myapp# "]
[53.829727, "o", "cat /etc/rsyslog.d/50-myapp.conf | tail -3\r\n\u001b[?2004l\r"]
[53.830448, "o", "\r\n# Route all INFO, WARN and ERROR events to the events file\r\nif $programname == 'myapp' then /var/log/app_events.log\r\n"]
[53.830639, "o", "\u001b[?2004hroot@fe59e176b225:/opt/myapp# "]
[54.292939, "i", "cat > /etc/logrotate.d/myapp << 'EOF'\n/var/log/app_events.log /var/log/app_errors.log {\n    daily\n    rotate 7\n    compress\n    delaycompress\n    missingok\n    notifempty\n    create 0644 myapp myapp\n    sharedscripts\n    postrotate\n        systemctl kill -s HUP rsyslog.service 2>/dev/null || killall -HUP rsyslogd 2>/dev/null || true\n    endscript\n}\nEOF\ntouch /var/log/app_events.log /var/log/app_errors.log && chown myapp:myapp /var/log/app_events.log /var/log/app_errors.log && chmod 644 /var/log/app_events.log /var/log/app_errors.log && ls -l /var/log/app_*.log\n"]
[54.293365, "o", "cat > /etc/logrotate.d/myapp << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> /var/log/app_events.log /var/log/app_errors.log {\r\n\u001b[?2004l\r"]
[54.293569, "o", "\u001b[?2004h>     daily\r\n\u001b[?2004l\r\u001b[?2004h>     rotate 7\r\n\u001b[?2004l\r\u001b[?2004h>     compress\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.293763, "o", "    delaycompress\r\n\u001b[?2004l\r\u001b[?2004h>     missingok\r\n\u001b[?2004l\r"]
[54.293876, "o", "\u001b[?2004h>     notifempty\r\n\u001b[?2004l\r\u001b[?2004h>     create 0644 myapp myapp\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.294128, "o", "    sharedscripts\r\n\u001b[?2004l\r\u001b[?2004h>     postrotate\r\n\u001b[?2004l\r\u001b[?2004h>         systemctl kill -s HUP rsyslog.service 2>/dev/null || killall -HUP rsyslogd 2>/dev/null || true\r\n\u001b[?2004l\r\u001b[?2004h>     endscript\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
