[53.312581, "i", "cat > /etc/systemd/system/myapp.service << 'EOF'\n[Unit]\nDescription=myapp JSON event logger\nAfter=network.target\n\n[Service]\nType=simple\nUser=myapp\nGroup=myapp\nWorkingDirectory=/opt/myapp\nExecStart=/opt/myapp/app.py --log-level=INFO\nRestart=on-failure\nRestartSec=5\nEnvironment=PYTHONUNBUFFERED=1\nStandardOutput=journal\nStandardError=journal\nSyslogIdentifier=myapp\n\n[Install]\nWantedBy=multi-user.target\nEOF\ncat /etc/systemd/system/myapp.service | head -3\n"]
