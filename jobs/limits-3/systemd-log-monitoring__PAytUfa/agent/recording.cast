[54.302495, "o", "root@fe59e176b225:/opt/myapp# "]
[55.323952, "i", "cat > /usr/local/bin/check_service_health.sh << 'EOF'\n#!/bin/bash\n# Reports restart and error statistics for myapp over the last 5 minutes.\nSERVICE=\"myapp\"\nWINDOW=\"5 minutes\"\nLOOP_THRESHOLD=3\n\nif command -v journalctl >/dev/null 2>&1; then\n    LOGS=$(journalctl -u \"$SERVICE\" --since \"5 minutes ago\" -o cat --no-pager 2>/dev/null)\n    RESTART_PATTERN='Started myapp.service'\nelse\n    # Fallback when journald is unavailable: use the rsyslog-generated events file\n    LOGS=$(tail -n 1000 /var/log/app_events.log 2>/dev/null)\n    RESTART_PATTERN='Service started'\nfi\n\nRESTARTS=$(printf '%s\\n' \"$LOGS\" | grep -c \"$RESTART_PATTERN\" || true)\nERRORS=$(printf '%s\\n' \"$LOGS\" | grep -c 'ERROR' || true)\nRESTART_LOOP=false\nif [ \"$RESTARTS\" -gt \"$LOOP_THRESHOLD\" ]; then\n    RESTART_LOOP=true\nfi\nTS=$(date -u +%Y-%m-%dT%H:%M:%SZ)\n\nprintf '{\\n  \"service\": \"%s\",\\n  \"time_window\": \"%s\",\\n  \"restarts\": %d,\\n  \"errors\": %d,\\n  \"restart_loop_detected\": %s,\\n  \"timestamp\": \"%s\"\\n}\\n' \"$SERVICE\" \"$WINDOW\" \"$RESTARTS\" \"$ERRORS\" \"$RESTART_L"]
[55.324089, "i", "OOP\" \"$TS\"\nEOF\nchmod 755 /usr/local/bin/check_service_health.sh && bash -n /usr/local/bin/check_service_health.sh && echo SYNTAX_OK\n"]
[55.324648, "o", "cat > /usr/local/bin/check_service_health.sh << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #!/bin/bash\r\n\u001b[?2004l\r\u001b[?2004h> "]
