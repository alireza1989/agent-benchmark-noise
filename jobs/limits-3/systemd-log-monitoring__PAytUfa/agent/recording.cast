[43.305202, "i", "cat > /opt/myapp/app.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"Simple application that logs JSON-formatted events to stdout.\"\"\"\nimport argparse\nimport datetime\nimport json\nimport logging\nimport signal\nimport sys\nimport time\n\nSERVICE = \"myapp\"\n\n\nclass JsonFormatter(logging.Formatter):\n    def format(self, record):\n        ts = datetime.datetime.fromtimestamp(record.created, datetime.timezone.utc)\n        payload = {\n            \"timestamp\": ts.strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n            \"level\": record.levelname,\n            \"message\": record.getMessage(),\n            \"service\": SERVICE,\n        }\n        return json.dumps(payload, separators=(\",\", \":\"))\n\n\ndef parse_args(argv):\n    parser = argparse.ArgumentParser(description=\"myapp JSON logger\")\n    parser.add_argument(\"--log-level\", default=\"INFO\", type=str.upper,\n                        choices=[\"INFO\", \"WARN\", \"ERROR\"],\n                        help=\"minimum level to emit (INFO, WARN, ERROR)\")\n    return parser.parse_args(argv)\n\n\ndef main(argv=None):\n    args ="]
[43.305249, "i", " parse_args(argv if argv is not None else sys.argv[1:])\n    logging.addLevelName(logging.WARNING, \"WARN\")\n\n    handler = logging.StreamHandler(sys.stdout)\n    handler.setFormatter(JsonFormatter())\n    logger = logging.getLogger(SERVICE)\n    logger.handlers = [handler]\n    logger.propagate = False\n    logger.setLevel(getattr(logging, args.log_level))\n\n    # Treat SIGTERM (systemd stop) as a clean exit.\n    signal.signal(signal.SIGTERM, lambda signum, frame: sys.exit(0))\n\n    logger.info(\"Service started\")\n    counter = 0\n    try:\n        while True:\n            time.sleep(5)\n            counter += 1\n            logger.info(\"Heartbeat %d\", counter)\n            if counter % 3 == 0:\n                logger.warning(\"Queue depth elevated\")\n            if counter % 4 == 0:\n                logger.error(\"Failed to process request batch %d\", counter)\n    except KeyboardInterrupt:\n        logger.info(\"Service stopping\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\nEOF\nchmod 755 /opt/myapp/app.py && chow"]
[43.305257, "i", "n -R myapp:myapp /opt/myapp && ls -l /opt/myapp\n"]
