[?2004l[?2004h>     RESTART_PATTERN='Started myapp.service'
[?2004l[?2004h> else
[?2004l[?2004h>     # Fallback when journald is unavailable: use the rsyslog-generated events file
[?2004l[?2004h>     LOGS=$(tail -n 1000 /var/log/app_events.log 2>/dev/null)
[?2004l[?2004h>     RESTART_PATTERN='Service started'
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> RESTARTS=$(printf '%s\n' "$LOGS" | grep -c "$RESTART_PATTERN" || true)
[?2004l[?2004h> ERRORS=$(printf '%s\n' "$LOGS" | grep -c 'ERROR' || true)
[?2004l[?2004h> RESTART_LOOP=false
