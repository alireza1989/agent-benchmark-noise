[32.686985, "o", "    type1: str = Query(..., description='Type1 value to filter by'),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.687063, "o", "    type2: str = Query(..., description='Type2 value to filter by')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.687095, "o", ") -> List[Record]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
