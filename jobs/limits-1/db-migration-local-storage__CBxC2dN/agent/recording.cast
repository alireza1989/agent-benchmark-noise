[32.687607, "o", "    last_loaded_type1_values = set()\r\n\u001b[?2004l\r\u001b[?2004h>     last_loaded_type2_values = set()\r\n\u001b[?2004l\r"]
[32.68769, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
