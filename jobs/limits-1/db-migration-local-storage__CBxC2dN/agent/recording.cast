[13.16376, "o", "\u001b[?2004hroot@4c46ac1f5180:/app# "]
[32.68004, "i", "cat > /app/service.py << 'EOF'\nimport csv\nimport os\nimport shutil\nfrom typing import List, Dict, Tuple, Set\nfrom fastapi import FastAPI, HTTPException, Query\nfrom pydantic import BaseModel\n\napp = FastAPI()\n\n# Source data and the directory holding one CSV chunk per (Type1, Type2) combination\nDATA_CSV_PATH = '/app/data.csv'\nCHUNK_DIR = '/app/chunks'\nFIELDNAMES = ['Type1', 'Type2', 'Text', 'ID']\n\n# (Type1, Type2) -> chunk file path. Lookups go through this dict only.\nchunk_index: Dict[Tuple[str, str], str] = {}\nall_type1_values: Set[str] = set()\nall_type2_values: Set[str] = set()\ntotal_records = 0\n\n# Values from the most recent query's loaded chunk\nlast_loaded_type1_values: Set[str] = set()\nlast_loaded_type2_values: Set[str] = set()\n\n\nclass Record(BaseModel):\n    Type1: str\n    Type2: str\n    Text: str\n    ID: int\n\n\ndef build_chunks():\n    \"\"\"Split data.csv into one CSV file per (Type1, Type2) combination.\"\"\"\n    global total_records\n\n    if os.path.isdir(CHUNK_DIR):\n        shutil.rmtree(CHUNK_DIR)\n    os.makedirs(CHUNK_DIR)\n\n    groups: Dict[Tuple[str, str], List[dict]] = {}\n    with open(DATA_CSV_PATH, 'r', newline='') as f:\n        for row in csv.DictReader(f):\n            rec = {\n                'Type1': row['Type1'],\n                'Type2': row['Type2'],\n                'Text': row['Text'],\n                'ID': int(row['ID']),\n            }\n            groups.setdefault((rec['Type1'], rec['Type2']), []).append(rec)\n\n    chunk_index.clear()\n    all_type1_values.clear()\n    all_type2_values.clear()\n    total_records = 0\n\n    for n, (key, recs) in enumerate(sorted(groups.items())):\n        recs.sort(key=lambda r: r['ID'])\n        path = os.path.join(CHUNK_DIR, 'chunk_%04d.csv' % n)\n        with open(path, 'w', newline='') as f:\n            writer = csv.DictWriter(f, fieldnames=FIELDNAMES)\n            writer.writeheader()\n            writer.writerows(recs)\n        chunk_index[key] = path\n        all_type1_values.add(key[0])\n        all_type2_values.add(key[1])\n        total_records += len(recs)\n\n    print('Wrote %d chunks for %d records into %s' % (len(chunk_index), total_records, CHUNK_DIR))\n\n\ndef load_chunk(path: str) -> List[dict]:\n    \"\"\"Load exactly one chunk file into memory.\"\"\"\n    rows = []\n    with open(path, 'r', newline='') as f:\n        for row in csv.DictReader(f):\n            rows.append({\n                'Type1': row['Type1'],\n                'Type2': row['Type2'],\n                'Text': row['Text'],\n                'ID': int(row['ID']),\n            })\n    return rows\n\n\n@app.on_event('startup')\nasync def startup_event():\n    \"\"\"Build per-combination chunks on startup\"\"\"\n    build_chunks()\n\n\n@app.get('/')\nasync def root():\n    \"\"\"Health check endpoint\"\"\"\n    return {'status': 'healthy', 'message': 'Service is running'}\n\n\n@app.get('/query')\nasync def query_records(\n    type1: str = Query(..., description='Type1 value to filter by'),\n    type2: str = Query(..., description='Type2 value to filter by')\n) -> List[Record]:\n    \"\"\"Query records by Type1 and Type2. Both parameters are required.\"\"\"\n    global last_loaded_type1_values, last_loaded_type2_values\n\n    if not type1 or not type2:\n        raise HTTPException(status_code=400, detail='Both type1 and type2 are required')\n\n    # Reset tracking\n    last_loaded_type1_values = set()\n    last_loaded_type2_values = set()\n\n    path = chunk_index.get((type1, type2))\n    if path is None:\n        return []\n\n    results = []\n    for row in load_chunk(path):\n        results.append(Record(**row))\n        last_loaded_type1_values.add(row['Type1'])\n        last_loaded_type2_values.add(row['Type2'])\n\n    return results\n\n\n@app.get('/get_all_loaded_types_and_subtypes')\nasync def get_all_loaded_types_and_subtypes() -> dict:\n    \"\"\"Returns the Type1 and Type2 values from the most recent query's loaded chunk.\"\"\"\n    return {\n        'type1_values': sorted(last_loaded_type1_values),\n        'type2_values': sorted(last_loaded_type2_values)\n    }\n\n\n@app.get('/get_all_available_types_and_subtypes')\nasync def get_all_available_types_and_subtypes() -> dict:\n    \"\"\"Returns ALL unique"]
[32.680228, "i", " Type1 and Type2 values in the storage system.\"\"\"\n    return {\n        'type1_values': sorted(all_type1_values),\n        'type2_values': sorted(all_type2_values)\n    }\n\n\n@app.get('/stats')\nasync def get_stats():\n    \"\"\"Get storage statistics\"\"\"\n    return {\n        'total_records': total_records,\n        'unique_type1': len(all_type1_values),\n        'unique_type2': len(all_type2_values),\n        'storage_backend': 'CSV_CHUNKS'\n    }\n\n\nif __name__ == '__main__':\n    import uvicorn\n    uvicorn.run(app, host='0.0.0.0', port=8000, log_level='info')\nEOF\n"]
