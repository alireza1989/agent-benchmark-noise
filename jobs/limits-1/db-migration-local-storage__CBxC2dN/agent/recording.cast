[32.687366, "o", "    global last_loaded_type1_values, last_loaded_type2_values\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if not type1 or not type2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
