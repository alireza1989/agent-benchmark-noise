[52.632877, "i", "cat > /app/canonicalize.py << 'PYEOF'\nimport re\n\nMETHODS = {'DELETE', 'GET', 'PATCH', 'POST', 'PUT'}\nPERMS = {'ALLOW', 'DENY'}\nVAR_RE = re.compile(r'\\{[A-Za-z0-9_-]+\\}')\n\n\ndef norm(path):\n    return VAR_RE.sub('{var}', path)\n\n\ndef segs(path):\n    return [s for s in path.split('/') if s]\n\n\ndef main():\n    try:\n        with open('/app/input.txt') as f:\n            lines = f.read().splitlines()\n    except FileNotFoundError:\n        lines = []\n    i = 0\n    ep_lines = []\n    while i < len(lines) and lines[i].strip() != '':\n        ep_lines.append(lines[i])\n        i += 1\n    rest = lines[i:]\n\n    base = None\n    excl = set()\n    plan_lines = []\n    in_meta = True\n    for line in rest:\n        parts = line.split()\n        if not parts:\n            continue\n        if in_meta and parts[0].lower() in ('base', 'exclude'):\n            if parts[0].lower() == 'base':\n                if len(parts) >= 2 and base is None:\n                    base = parts[1]\n            else:\n                excl.update(parts[1:])\n        e"]
[52.632946, "i", "lse:\n            in_meta = False\n            plan_lines.append(line)\n\n    eps = []\n    for line in ep_lines:\n        parts = line.split()\n        if len(parts) != 4:\n            break\n        path, method, role, perm = parts\n        method = method.upper()\n        perm = perm.upper()\n        if not path or method not in METHODS or perm not in PERMS or not role:\n            break\n        eps.append((path, method, role, perm))\n\n    plan = []\n    for line in plan_lines:\n        parts = line.split()\n        if len(parts) != 2:\n            break\n        path, method = parts[0], parts[1].upper()\n        if method not in METHODS:\n            break\n        plan.append((norm(path), method))\n\n    varname = {}\n    for path, _, _, _ in eps:\n        varname.setdefault(norm(path), path)\n\n    eligible = []\n    for path, method, role, perm in eps:\n        if base is not None and not path.startswith(base):\n            continue\n        if role in excl:\n            continue\n        eligible.append((norm(path), method, role, per"]
[52.633179, "i", "m))\n\n    if not plan:\n        selected = eligible\n    else:\n        planset = set(plan)\n        eligible_paths = set(e[0] for e in eligible)\n        parents = set()\n        for pp, _ in planset:\n            ps = segs(pp)\n            for cand in eligible_paths:\n                if cand == pp:\n                    continue\n                cs = segs(cand)\n                if len(cs) < len(ps) and ps[:len(cs)] == cs:\n                    parents.add(cand)\n        selected = [e for e in eligible\n                    if (e[0], e[1]) in planset or e[0] in parents]\n\n    seen = set()\n    rows = []\n    for np_, m, r, perm in selected:\n        key = (np_, m, r)\n        if key in seen:\n            continue\n        seen.add(key)\n        rows.append((np_, m, r, perm))\n\n    rows.sort(key=lambda x: (-len(segs(x[0])), x[1], x[2], x[3]))\n    out = ''.join('%s %s %s %s\\n' % (varname[np_], m, r, perm)\n                  for np_, m, r, perm in rows)\n    if not out:\n        out = '\\n'\n    with open('/app/output.txt', 'w') as f:\n        "]
