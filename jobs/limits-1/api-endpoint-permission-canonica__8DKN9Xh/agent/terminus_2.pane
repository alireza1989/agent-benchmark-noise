        parents = set()
        for pp, pm in planset:
            ps = segs(pp)
            for cand in eligible_paths:
                if cand == pp:
                    continue
                cs = segs(cand)
                if len(cs) < len(ps) and ps[:len(cs)] == cs:
                    parents.add(cand)
        selected = [e for e in eligible
                    if (e[0], e[1]) in planset or e[0] in parents]

    seen = set()
    rows = []
    for np_, m, r, perm in selected:
        key = (np_, m, r)
        if key in seen:
            continue
        seen.add(key)
        rows.append((np_, m, r, perm))

    rows.sort(key=lambda x: (-len(segs(x[0])), x[1], x[2], x[3]))
    out = ''.join('%s %s %s %s\n' % (varname[np_], m, r, perm)
                  for np_, m, r, perm in rows)
    if not out:
        out = '\n'
    with open('/app/output.txt', 'w') as f:
        f.write(out)


