[65.709386, "i", "for p in /proc/[0-9]*; do if tr '\\0' ' ' < $p/cmdline 2>/dev/null | grep -q 'app.py'; then echo \"killing ${p#/proc/}\"; kill ${p#/proc/} 2>/dev/null; fi; done; sleep 1; for p in /proc/[0-9]*; do tr '\\0' ' ' < $p/cmdline 2>/dev/null | grep -q 'app.py' && echo \"still running: ${p#/proc/}\"; done; echo check-done\n"]
[65.710004, "o", "for p in /proc/[0-9]*; do if tr '\\0' ' ' < $p/cmdline 2>/dev/null | grep -q 'app.py'; then echo \"killing ${p#/proc/}\"; kill ${p#/proc/} 2>/dev/null; fi; done; sleep 1; for p in /proc/[0-9]*; do tr '\\0' ' ' < $p/cmdline 2>/dev/null | grep -q 'app.py' && echo \"still running: ${p#/proc/}\"; done; echo check-done\r\n\u001b[?2004l\r"]
