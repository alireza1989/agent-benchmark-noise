[41.464344, "o", "# Load journal input so systemd/journald messages reach rsyslog\r\nmodule(load=\"imjournal\" StateFile=\"imjournal.state\")\r\n\r\n# File ownership and permissions for myapp log files\r\n$FileOwner myapp\r\n$FileGroup myapp\r\n$FileCreateMode 0644\r\n\r\n# All myapp events (INFO, WARN, ERROR) go to the events log\r\nif $programname == 'myapp' then /var/log/app_events.log\r\n\r\n# Only ERROR events go to the errors log\r\nif $programname == 'myapp' and $msg contains '\"level\":\"ERROR\"' then /var/log/app_errors.log\r\n"]
[41.464481, "o", "\u001b[?2004hroot@9c4590ab028b:/opt/myapp# "]
[41.963694, "i", "cat > /etc/logrotate.d/myapp <<'EOF'\n/var/log/app_events.log /var/log/app_errors.log {\n    daily\n    rotate 7\n    compress\n    delaycompress\n    missingok\n    notifempty\n    create 0644 myapp myapp\n    sharedscripts\n    postrotate\n        systemctl kill -s HUP rsyslog.service 2>/dev/null || kill -HUP $(cat /run/rsyslogd.pid 2>/dev/null) 2>/dev/null || true\n    endscript\n}\nEOF\ncat /etc/logrotate.d/myapp\n"]
