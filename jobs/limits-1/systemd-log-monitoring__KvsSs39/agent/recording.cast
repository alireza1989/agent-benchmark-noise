[42.47092, "i", "cat > /usr/local/bin/check_service_health.sh <<'EOF'\n#!/bin/bash\n# Analyze myapp journal entries from the last 5 minutes and emit a JSON report.\nSERVICE=myapp\nWINDOW_MIN=5\nTHRESHOLD=3\n\nLOGS=$(journalctl -u \"${SERVICE}.service\" --since \"${WINDOW_MIN} minutes ago\" --no-pager -o cat 2>/dev/null || true)\n\nrestarts=$(printf '%s\\n' \"$LOGS\" | grep -c 'Started myapp.service' || true)\nerrors=$(printf '%s\\n' \"$LOGS\" | grep -c 'ERROR' || true)\nrestarts=${restarts:-0}\nerrors=${errors:-0}\n\nloop=false\nif [ \"$restarts\" -gt \"$THRESHOLD\" ]; then\n    loop=true\nfi\n\nts=$(date -u +%Y-%m-%dT%H:%M:%SZ)\nprintf '{\"service\": \"%s\", \"time_window\": \"%s minutes\", \"restarts\": %s, \"errors\": %s, \"restart_loop_detected\": %s, \"timestamp\": \"%s\"}\\n' \\\n    \"$SERVICE\" \"$WINDOW_MIN\" \"$restarts\" \"$errors\" \"$loop\" \"$ts\"\nEOF\nchmod 755 /usr/local/bin/check_service_health.sh && ls -l /usr/local/bin/check_service_health.sh\n"]
[42.471181, "o", "cat > /usr/local/bin/check_service_health.sh <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.471352, "o", "#!/bin/bash\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.471499, "o", "# Analyze myapp journal entries from the last 5 minutes and emit a JSON report.\r\n\u001b[?2004l\r\u001b[?2004h> SERVICE=myapp\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.471531, "o", "> WINDOW_MIN=5\r\n\u001b[?2004l\r"]
[42.471539, "o", "\u001b[?2004h> "]
[42.471647, "o", "THRESHOLD=3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.471877, "o", "LOGS=$(journalctl -u \"${SERVICE}.service\" --since \"${WINDOW_MIN} minutes ago\" --no-pager -o cat 2>/dev/null || true)"]
[42.472721, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> restarts=$(printf '%s\\n' \"$LOGS\" | grep -c 'Started myapp.service' || true)\r\n\u001b[?2004l\r\u001b[?2004h> errors=$(printf '%s\\n' \"$LOGS\" | grep -c 'ERROR' || true)\r\n\u001b[?2004l\r\u001b[?2004h> restarts=${restarts:-0}\r\n\u001b[?2004l\r\u001b[?2004h> errors=${errors:-0}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> loop=false\r\n\u001b[?2004l\r\u001b[?2004h> if [ \"$restarts\" -gt \"$THRESHOLD\" ]; then\r\n\u001b[?2004l\r\u001b[?2004h>     loop=true\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.472906, "o", "printf '{\"service\": \"%s\", \"time_window\": \"%s minutes\", \"restarts\": %s, \"errors\": %s, \"restart_loop_detected\": %s, \"timestamp\": \"%s\"}\\n' \\\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.47304, "o", "    \"$SERVICE\" \"$WINDOW_MIN\" \"$restarts\" \"$errors\" \"$loop\" \"$ts\"\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
