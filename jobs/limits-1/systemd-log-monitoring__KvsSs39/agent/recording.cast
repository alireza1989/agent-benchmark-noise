[41.459285, "i", "cat > /etc/rsyslog.d/50-myapp.conf <<'EOF'\n# Load journal input so systemd/journald messages reach rsyslog\nmodule(load=\"imjournal\" StateFile=\"imjournal.state\")\n\n# File ownership and permissions for myapp log files\n$FileOwner myapp\n$FileGroup myapp\n$FileCreateMode 0644\n\n# All myapp events (INFO, WARN, ERROR) go to the events log\nif $programname == 'myapp' then /var/log/app_events.log\n\n# Only ERROR events go to the errors log\nif $programname == 'myapp' and $msg contains '\"level\":\"ERROR\"' then /var/log/app_errors.log\nEOF\ncat /etc/rsyslog.d/50-myapp.conf\n"]
[41.459534, "o", "cat > /etc/rsyslog.d/50-myapp.conf <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
