[40.447074, "i", "cat /proc/1/comm; mkdir -p /opt/myapp && cat > /opt/myapp/app.py <<'EOF'\n#!/usr/bin/env python3\nimport argparse\nimport datetime\nimport json\nimport logging\nimport sys\nimport time\n\n\nclass JsonFormatter(logging.Formatter):\n    def format(self, record):\n        ts = datetime.datetime.fromtimestamp(record.created, datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')\n        payload = {\n            'timestamp': ts,\n            'level': record.levelname,\n            'message': record.getMessage(),\n            'service': 'myapp',\n        }\n        return json.dumps(payload, separators=(',', ':'))\n\n\ndef parse_args():\n    parser = argparse.ArgumentParser(description='myapp JSON event logger')\n    parser.add_argument('--log-level', default='INFO', type=lambda s: s.upper(), choices=['INFO', 'WARN', 'ERROR'])\n    return parser.parse_args()\n\n\ndef main():\n    args = parse_args()\n    level = {'INFO': logging.INFO, 'WARN': logging.WARNING, 'ERROR': logging.ERROR}[args.log_level]\n    handler = logging.StreamHandler(sys.stdout"]
[40.447562, "o", "cat /proc/1/comm; mkdir -p /opt/myapp && cat > /opt/myapp/app.py <<'EOF'\r\n\u001b[?2004l\r"]
[40.447618, "i", ")\n    handler.setFormatter(JsonFormatter())\n    logger = logging.getLogger('myapp')\n    logger.setLevel(level)\n    logger.addHandler(handler)\n    logger.propagate = False\n\n    logger.info('Service started')\n    counter = 0\n    while True:\n        time.sleep(10)\n        counter += 1\n        logger.info('Heartbeat %d', counter)\n        if counter % 6 == 0:\n            logger.warning('Queue depth elevated')\n        if counter % 12 == 0:\n            logger.error('Simulated processing failure')\n\n\nif __name__ == '__main__':\n    try:\n        main()\n    except KeyboardInterrupt:\n        sys.exit(0)\nEOF\nchmod 755 /opt/myapp/app.py && chown myapp:myapp /opt/myapp/app.py && ls -l /opt/myapp/app.py\n"]
