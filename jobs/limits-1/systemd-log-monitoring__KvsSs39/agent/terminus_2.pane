[?2004l[?2004h> THRESHOLD=3
[?2004l[?2004h> 
[?2004l[?2004h> LOGS=$(journalctl -u "${SERVICE}.service" --since "${WINDOW_MIN} minutes ago" --no-pager -o cat 2>/dev/null || true)
[?2004l[?2004h> 
[?2004l[?2004h> restarts=$(printf '%s\n' "$LOGS" | grep -c 'Started myapp.service' || true)
[?2004l[?2004h> errors=$(printf '%s\n' "$LOGS" | grep -c 'ERROR' || true)
[?2004l[?2004h> restarts=${restarts:-0}
[?2004l[?2004h> errors=${errors:-0}
[?2004l[?2004h> 
[?2004l[?2004h> loop=false
[?2004l[?2004h> if [ "$restarts" -gt "$THRESHOLD" ]; then
[?2004l[?2004h>     loop=true
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
