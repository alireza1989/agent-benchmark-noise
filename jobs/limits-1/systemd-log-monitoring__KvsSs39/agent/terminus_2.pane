[?2004l# Load journal input so systemd/journald messages reach rsyslog
module(load="imjournal" StateFile="imjournal.state")

# File ownership and permissions for myapp log files
$FileOwner myapp
$FileGroup myapp
$FileCreateMode 0644

# All myapp events (INFO, WARN, ERROR) go to the events log
if $programname == 'myapp' then /var/log/app_events.log

# Only ERROR events go to the errors log
if $programname == 'myapp' and $msg contains '"level":"ERROR"' then /var/log/app_errors.log
