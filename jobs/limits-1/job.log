s() if len(s) > 1)\nout = {\n    'basic_metrics': {\n        'total_storage_bytes': total,\n        'deduplicated_storage_bytes': uniq,\n        'storage_savings_percent': savings,\n        'cache_hit_ratio': hit\n    },\n    'advanced_metrics': {\n        'compressed_storage_bytes': comp,\n        'monthly_storage_cost_usd': cost,\n        'network_transfer_time_seconds': ttime,\n        'average_layer_age_days': avg_age,\n        'access_frequency_std_dev': sd\n    },\n    'top_layers_by_size': top_out,\n    'recent_access_summary': {\n        'layers_accessed_last_7_days': recent_n,\n        'most_recent_layers': most_recent\n    },\n    'shared_layer_analysis': {\n        'images_with_shared_layers': shared_imgs,\n        'total_shared_layer_count': shared_total\n    }\n}\njson.dump(out, open('/workspace/output.json', 'w'), indent=2)\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
