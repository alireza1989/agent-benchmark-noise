Sending keys: ["cat > /app/api.py << 'EOF'\nimport os, uuid, time, logging, datetime as dt\nimport jwt, bcrypt, redis\nfrom flask import Flask, request, jsonify\n\nBASE = '/app'\nKEYS = os.path.join(BASE, 'keys')\nLOG_DIR = os.path.join(BASE, 'logs')\nos.makedirs(LOG_DIR, exist_ok=True)\nlogging.basicConfig(filename=os.path.join(LOG_DIR, 'app.log'), level=logging.INFO, format='%(asctime)s %(levelname)s %(name)s %(message)s')\nlog = logging.getLogger('api')\n\nISSUER = 'rsa-jwt-api'\nACCESS_TTL = dt.timedelta(minutes=15)\nREFRESH_TTL = dt.timedelta(days=7)\n\nwith open(os.path.join(KEYS, 'private.pem'), 'rb') as f:\n    PRIVATE_KEY = f.read()\nwith open(os.path.join(KEYS, 'public.pem'), 'rb') as f:\n    PUBLIC_KEY = f.read()\n\nUSERS = {'admin': bcrypt.hashpw(b'password123', bcrypt.gensalt())}\n\nredis_client = redis.Redis(host=os.environ.get('REDIS_HOST', 'localhost'), port=int(os.environ.get('REDIS_PORT', '6379')), db=0, decode_responses=True, socket_timeout=3)\n\napp = Flask(__name__)\n\ndef make_token(sub, ttl, ttype):\n    now = dt.datetime.now(dt.timezone.utc)\n    payload = {'iss': ISSUER, 'sub': sub, 'iat': now, 'exp': now + ttl, 'jti': str(uuid.uuid4()), 'type': ttype}\n    return jwt.encode(payload, PRIVATE_KEY, algorithm='RS256')\n\ndef err(code, msg):\n    log.warning('HTTP %s: %s', code, msg)\n    return jsonify({'error': msg}), code\n\ndef check_token(token, expected_type=None):\n    if not token:\n        return None, (401, 'token missing')\n    try:\n        payload = jwt.decode(token, PUBLIC_KEY, algorithms=['RS256'], issuer=ISSUER, options={'require': ['exp', 'iat', 'jti', 'sub', 'iss']})\n    except jwt.ExpiredSignatureError:\n        return None, (401, 'token expired')\n    except jwt.InvalidTokenError as e:\n        return None, (401, 'invalid token: %s' % e)\n    if expected_type and payload.get('type') != expected_type:\n        return None, (401, 'wrong token type')\n    try:\n        revoked = redis_client.exists('blacklist:%s' % payload['jti'])\n    except redis.RedisError as e:\n        log.error('redis unavailable during blacklist check: %s', e)\n        return None, (503, 'blacklist unavailable')\n    if revoked:\n        return None, (403, 'token revoked')\n    return payload, None\n\n@app.route('/auth/public-key', methods=['GET'])\ndef public_key():\n    return PUBLIC_KEY, 200, {'Content-Type': 'application/x-pem-file'}\n\n@app.route('/auth/login', methods=['POST'])\ndef login():\n    data = request.get_json(silent=True) or {}\n    username = data.get('username', '')\n    password = data.get('password', '')\n    hashed = USERS.get(username)\n    if not hashed or not bcrypt.checkpw(password.encode(), hashed):\n        return err(401, 'invalid credentials')\n    access = make_token(username, ACCESS_TTL, 'access')\n    refresh = make_token(username, REFRESH_TTL, 'refresh')\n    log.info('login success for %s', username)\n    return jsonify({'access_token': access, 'refresh_token': refresh, 'token_type': 'Bearer', 'expires_in': int(ACCESS_TTL.total_seconds())}), 200\n\n@app.route('/auth/refresh', methods=['POST'])\ndef refresh():\n    data = request.get_json(silent=True) or {}\n    payload, error = check_token(data.get('refresh_token'), 'refresh')\n    if error:\n        return err(*error)\n    access = make_token(payload['sub'], ACCESS_TTL, 'access')\n    log.info('access token refreshed for %s', payload['sub'])\n    return jsonify({'access_token': access, 'token_type': 'Bearer', 'expires_in': int(ACCESS_TTL.total_seconds())}), 200\n\n@app.route('/auth/revoke', methods=['POST'])\ndef revoke():\n    data = request.get_json(silent=True) or {}\n    token = data.get('token')\n    if not token:\n        return err(400, 'token required')\n    try:\n        payload = jwt.decode(token, PUBLIC_KEY, algorithms=['RS256'], issuer=ISSUER, options={'require': ['exp', 'jti']})\n    except jwt.ExpiredSignatureError:\n        return err(401, 'token expired')\n    except jwt.InvalidTokenError as e:\n        return err