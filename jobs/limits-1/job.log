Sending keys: ["cat > /workspace/do_merge.py << 'EOF'\nimport json\nimport csv\nimport pandas as pd\n\nUSERS = '/workspace/users.csv'\nRECORDS = '/workspace/records.jsonl'\nPROFILES = '/workspace/profiles.json'\nOUT = '/workspace/merged_records.csv'\n\nmerged = {}\n\n\ndef clean(v):\n    if v is None:\n        return None\n    if isinstance(v, float) and pd.isna(v):\n        return None\n    s = str(v).strip()\n    return s if s and s.lower() != 'nan' else None\n\n\ndef add(email, phone=None, status=None):\n    email = clean(email)\n    if not email:\n        return\n    key = email.lower()\n    rec = merged.setdefault(key, {'email': email, 'phone': None, 'status': None})\n    if rec['phone'] is None and clean(phone):\n        rec['phone'] = clean(phone)\n    if rec['status'] is None and clean(status):\n        rec['status'] = clean(status)\n\n\n# users.csv\ndf = pd.read_csv(USERS, dtype=str, keep_default_na=False)\nfor _, row in df.iterrows():\n    add(row.get('email'), row.get('phone'), row.get('status'))\n\n# records.jsonl\nwith open(RECORDS, encoding='utf-8') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        obj = json.loads(line)\n        other = obj.get('other_info') or {}\n        phone = obj.get('phone') or other.get('phone')\n        add(obj.get('email'), phone, obj.get('status'))\n\n# profiles.json\nwith open(PROFILES, encoding='utf-8') as f:\n    profiles = json.load(f)\nif isinstance(profiles, dict):\n    items = [(k, v) for k, v in profiles.items()]\nelse:\n    items = [(None, v) for v in profiles]\nfor key, p in items:\n    if not isinstance(p, dict):\n        continue\n    other = p.get('other_info') or {}\n    phone = p.get('phone') or other.get('phone')\n    add(p.get('email') or key, phone, p.get('status'))\n\nwith open(OUT, 'w', newline='', encoding='utf-8') as f:\n    writer = csv.writer(f)\n    writer.writerow(['email', 'phone', 'status'])\n    for key in sorted(merged):\n        r = merged[key]\n        writer.writerow([r['email'], r['phone'] or '', r['status'] or ''])\n\nprint('Wrote %d records to %s' % (len(merged), OUT))\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
