G['team_fatigue_reduction'])\n        if team[t] + 1 > lim:\n            continue\n        if gcrit + c > G['max_global_critical_per_wave']:\n            continue\n        ok = True\n        for did in dcs:\n            d = dc[did]\n            if w in d['blackout_waves'] or used[did] + ru > d['capacity_per_wave'] or crit[did] + c > d['max_critical_per_wave'] or hi[did] + h > d['high_resource_slots'] or tdc[(did, t)] + 1 > d['max_team_services_per_wave']:\n                ok = False\n                break\n        if not ok:\n            continue\n        for did in dcs:\n            used[did] += ru\n            crit[did] += c\n            hi[did] += h\n            tdc[(did, t)] += 1\n        gcrit += c\n        team[t] += 1\n        done[s] = w\n        placed.append(s)\n    prev_team = dict(team)\n    waves.append(placed)\nif len(done) < len(svc):\n    print('WARNING unplaced', len(svc) - len(done))\nplan_waves = []\ntotal = 0\nfor i, placed in enumerate(waves, 1):\n    if not placed:\n        continue\n    deps_list = []\n    mx = 0\n    for s in placed:\n        info = svc[s]\n        mx = max(mx, info['deploy_time_minutes'])\n        for r in info['required_regions']:\n            if r in dc_by_region:\n                deps_list.append({'service_id': s, 'datacenter_id': dc_by_region[r]['id'], 'deploy_time_minutes': info['deploy_time_minutes']})\n    total += mx\n    plan_waves.append({'wave_number': len(plan_waves) + 1, 'deployments': deps_list})\nplan = {'generated_at': datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'), 'total_waves': len(plan_waves), 'estimated_duration_minutes': total, 'waves': plan_waves}\nwith open(O, 'w') as f:\n    json.dump(plan, f, indent=2)\nprint('waves', len(plan_waves), 'services', len(done), 'of', len(svc))\nEOF\npython3 /app/solver.py && python3 /app/task_file/scripts/model.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
