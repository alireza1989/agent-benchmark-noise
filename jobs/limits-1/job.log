= f <= 128:\n                return False\n            if i + 2 >= n or layers[i + 1] != 'BatchNorm':\n                return False\n            nxt = layers[i + 2]\n            if not (nxt == 'MaxPool2D_2x2' or nxt.startswith('Conv2D_')):\n                return False\n        elif L == 'BatchNorm':\n            if i == 0 or not layers[i - 1].startswith('Conv2D_'):\n                return False\n        elif L == 'MaxPool2D_2x2':\n            if i == 0 or layers[i - 1] != 'BatchNorm':\n                return False\n        else:\n            return False\n    n_dense = int(layers[-1].split('_')[1])\n    if not 10 <= n_dense <= 100:\n        return False\n    m = metrics(layers)\n    if m['pools'] > 2 or m['H'] < 7 or m['W'] < 7:\n        return False\n    if not 1000 <= m['params'] <= 5000000:\n        return False\n    if m['flops'] > 1000000000:\n        return False\n    return True\n\n\ndef random_arch():\n    while True:\n        nb = rng.randint(1, 3)\n        blocks = []\n        for i in range(nb):\n            b = ['Conv2D_%d' % rng.choice(CONV_FILTERS), 'BatchNorm']\n            if i == nb - 1 or rng.random() < 0.5:\n                b.append('MaxPool2D_2x2')\n            blocks.append(b)\n        layers = build(blocks, rng.randint(10, 100))\n        if is_valid(layers):\n            return layers\n\n\ndef crossover(a, b):\n    ba, _ = parse_blocks(a)\n    bb, db = parse_blocks(b)\n    da = int(a[-1].split('_')[1])\n    cut = rng.randint(0, len(ba))\n    child = [list(x) for x in ba[:cut] + bb[cut:]]\n    if not child:\n        child = [list(x) for x in ba]\n    child = child[:3]\n    if 'MaxPool2D_2x2' not in child[-1]:\n        child[-1].append('MaxPool2D_2x2')\n    c = build(child, rng.choice([da, db]))\n    return c if is_valid(c) else list(a)\n\n\ndef mutate(layers, mrate):\n    blocks, dense = parse_blocks(layers)\n    blocks = [list(x) for x in blocks]\n    if rng.random() < mrate:\n        i = rng.randrange(len(blocks))\n        blocks[i][0] = 'Conv2D_%d' % rng.choice(CONV_FILTERS)\n    if rng.random() < mrate:\n        dense = rng.randint(10, 100)\n    if rng.random() < mrate and len(blocks) > 1:\n        i = rng.randrange(len(blocks) - 1)\n        if 'MaxPool2D_2x2' in blocks[i]:\n            blocks[i].remove('MaxPool2D_2x2')\n        else:\n            blocks[i].append('MaxPool2D_2x2')\n    if rng.random() < mrate and len(blocks) < 3:\n        blocks.insert(rng.randrange(len(blocks)), ['Conv2D_%d' % rng.choice(CONV_FILTERS), 'BatchNorm'])\n    if rng.random() < mrate and len(blocks) > 1:\n        del blocks[rng.randrange(len(blocks) - 1)]\n    if 'MaxPool2D_2x2' not in blocks[-1]:\n        blocks[-1].append('MaxPool2D_2x2')\n    c = build(blocks, dense)\n    return c if is_valid(c) else list(layers)\n\n\nCOUNTER = [0]\nALL = []\n\n\ndef new_arch(layers):\n    COUNTER[0] += 1\n    idx = COUNTER[0]\n    ds = DATASETS[(idx - 1) % len(DATASETS)]\n    m = metrics(layers)\n    n_conv = sum(1 for L in layers if L.startswith('Conv2D_'))\n    rf = min(1.0, 0.20 + 0.10 * n_conv + 0.05 * m['pools'])\n    info = min(1.0, 0.85 + 0.02 * n_conv)\n    acc = 0.60 + 0.20 * min(1.0, math.log10(m['params']) / 6.5) + 0.02 * n_conv - 0.01 * (ds['classes'] - 2) / 8.0\n    acc = min(1.0, max(0.0, acc))\n    eff = max(0.0, 1.0 - math.log10(max(m['flops'], 1)) / 9.0)\n    arch = {\n        'id': 'arch_%05d' % idx,\n        'layers': layers,\n        'dataset': ds['name'],\n        'rf': round(rf, 4),\n        'info': round(info, 4),\n        'grad': True,\n        'mem': m['params'] * 4,\n        'flops': m['flops'],\n        'acc': round(acc, 4),\n        'eff': round(eff, 4),\n        'div': 0.0,\n        'rank': 0,\n        'crowd': 0.0,\n    }\n    ALL.append(arch)\n    return arch\n\n\ndef violates(a):\n    return (a['rf'] < 0.25 or a['info'] < 0.80 or a['grad'] is not True\n            or not (1000 <= a['mem'] <= 100000000) or a['flops'] > 1000000000\n            or not is_valid(a['layers']))\n\n\ndef compute_div(pop):\n    for a in pop:\n        hs = [len(set(a['layers']) ^ set(b['layers'])) for b in pop if b is not a]\n        a['div'] = round(min(1.0, (sum(hs) / len(hs)) / 10.0), 4) if hs else 0.0\n\n\ndef dominates(a, b):\n    oa = (a['acc'], a['eff'], a['div'])\n    ob = (b['acc'], b['eff'], b['div'])\n    return all(x >= y for x, y in zip(oa, ob)) and any(x > y for x, y in zip(oa, ob))\n\n\ndef nd_sort(pop):\n    n = [0] * len(pop)\n    S = [[] for _ in pop]\n    fronts = [[]]\n    for p in range(len(pop)):\n        for q in range(len(pop)):\n            if p == q:\n                continue\n            if dominates(pop[p], pop[q]):\n                S[p].append(q)\n            elif dominates(pop[q], pop[p]):\n                n[p] += 1\n        if n[p] == 0:\n            pop[p]['rank'] = 1\n            fronts[0].append(p)\n    i = 0\n    while fronts[i]:\n        nxt = []\n        for p in fronts[i]:\n            for q in S[p]:\n                n[q] -= 1\n                if n[q] == 0:\n                    pop[q]['rank'] = i + 2\n                    nxt.append(q)\n        fronts.append(nxt)\n        i += 1\n    return [[pop[j] for j in f] for f in fronts if f]\n\n\ndef crowding(front):\n    for a in front:\n        a['crowd'] = 0.0\n    if len(front) <= 2:\n        for a in front:\n            a['crowd'] = 1000.0\n        return\n    for k in ('acc', 'eff', 'div'):\n        s = sorted(front, key=lambda a: a[k])\n        lo, hi = s[0][k], s[-1][k]\n        s[0]['crowd'] = 1000.0\n        s[-1]['crowd'] = 1000.0\n        if hi - lo < 1e-12:\n            continue\n        for i in range(1, len(s) - 1):\n            s[i]['crowd'] += (s[i + 1][k] - s[i - 1][k]) / (hi - lo)\n\n\ndef select(pool, n):\n    chosen = []\n    for front in nd_sort(pool):\n        crowding(front)\n        room = n - len(chosen)\n        if len(front) <= room:\n            chosen.extend(front)\n        else:\n            chosen.extend(sorted(front, key=lambda a: -a['crowd'])[:room])\n            break\n    return chosen\n\n\ndef refresh(pop):\n    compute_div(pop)\n    fronts = nd_sort(pop)\n    for f in fronts:\n        crowding(f)\n    return fronts\n\n\ndef tournament(pop):\n    a, b = rng.sample(pop, 2)\n    ka = (a['rank'], -a['crowd'])\n    kb = (b['rank'], -b['crowd'])\n    return a if ka <= kb else b\n\n\ndef hypervolume(pts):\n    if not pts:\n        return 0.0\n    c = 0\n    for s in HV_SAMPLES:\n        for p in pts:\n            if s[0] <= p[0] and s[1] <= p[1] and s[2] <= p[2]:\n                c += 1\n                break\n    return c / len(HV_SAMPLES)\n\n\ndef dump(obj, ind=0):\n    pad = '  ' * ind\n    if isinstance(obj, dict):\n        if not obj:\n            return '{}'\n        parts = [pad + '  ' + json.dumps(k) + ': ' + dump(v, ind + 1) for k, v in obj.items()]\n        return '{' + NL + (',' + NL).join(parts) + NL + pad + '}'\n    if isinstance(obj, list):\n        if not obj:\n            return '[]'\n        parts = [pad + '  ' + dump(v, ind + 1) for v in obj]\n        return '[' + NL + (',' + NL).join(parts) + NL + pad + ']'\n    if isinstance(obj, bool):\n        return 'true' if obj else 'false'\n    if isinstance(obj, float):\n        return '%.4f' % obj\n    if isinstance(obj, int):\n        return str(obj)\n    return json.dumps(obj)\n\n\n# ---------------- evolution ----------------\npop = [new_arch(random_arch()) for _ in range(POP)]\nhistory = []\nfor g in range(GENS):\n    fronts = refresh(pop)\n    rank1 = fronts[0]\n    hv = round(hypervolume([(a['acc'], a['eff'], a['div']) for a in rank1]), 4)\n    mean_div = sum(a['div'] for a in pop) / len(pop)\n    mrate = min(0.9, max(0.1, 0.2 + 0.6 * (1.0 - mean_div)))\n    history.append({'generation': g, 'population_size': len(pop), 'solutions': len(rank1),\n                    'hypervolume': hv, 'mutation_rate': round(mrate, 4), 'mean_diversity': round(mean_div, 4)})\n    if g == GENS - 1:\n        break\n    children = []\n    while len(children) < POP:\n        p1 = tournament(pop)\n     