se):\n            continue\n        if role in excl:\n            continue\n        eligible.append((norm(path), method, role, perm))\n\n    if not plan:\n        selected = eligible\n    else:\n        planset = set(plan)\n        eligible_paths = set(e[0] for e in eligible)\n        parents = set()\n        for pp, pm in planset:\n            ps = segs(pp)\n            for cand in eligible_paths:\n                if cand == pp:\n                    continue\n                cs = segs(cand)\n                if len(cs) < len(ps) and ps[:len(cs)] == cs:\n                    parents.add(cand)\n        selected = [e for e in eligible\n                    if (e[0], e[1]) in planset or e[0] in parents]\n\n    seen = set()\n    rows = []\n    for np_, m, r, perm in selected:\n        key = (np_, m, r)\n        if key in seen:\n            continue\n        seen.add(key)\n        rows.append((np_, m, r, perm))\n\n    rows.sort(key=lambda x: (-len(segs(x[0])), x[1], x[2], x[3]))\n    out = ''.join('%s %s %s %s\\n' % (varname[np_], m, r, perm)\n                  for np_, m, r, perm in rows)\n    if not out:\n        out = '\\n'\n    with open('/app/output.txt', 'w') as f:\n        f.write(out)\n\n\nif __name__ == '__main__':\n    main()\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
