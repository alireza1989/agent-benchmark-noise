Sending keys: ["cat > /app/src/activation.py << 'PYEOF'\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass ReLU(BaseLayer):\n    def __init__(self):\n        super().__init__()\n\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        return np.maximum(0.0, x).astype(np.float64)\n\n\nclass LeakyReLU(BaseLayer):\n    def __init__(self, negative_slope=0.01):\n        super().__init__()\n        self.negative_slope = float(negative_slope)\n\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        return np.where(x > 0, x, self.negative_slope * x).astype(np.float64)\n\n\nclass Sigmoid(BaseLayer):\n    def __init__(self):\n        super().__init__()\n\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        out = np.empty_like(x, dtype=np.float64)\n        pos = x >= 0\n        out[pos] = 1.0 / (1.0 + np.exp(-x[pos]))\n        neg = ~pos\n        ex = np.exp(x[neg])\n        out[neg] = ex / (1.0 + ex)\n        return out\nPYEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
