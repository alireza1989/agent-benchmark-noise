.add(v)\n                find(v)\n            if k == 'Alias':\n                for v in vals:\n                    union(b['name'], v)\n\n    comp_min = {}\n    for x in list(parent.keys()):\n        r = find(x)\n        if r not in comp_min or x < comp_min[r]:\n            comp_min[r] = x\n\n    def canon(x):\n        return comp_min[find(x)]\n\n    ordered = [b for b in blocks if b['kind'] == 'T']\n    ordered += sorted([b for b in blocks if b['kind'] == 'O'], key=lambda b: b['id'])\n\n    # Node discovery order\n    node_list = []\n    node_set = set()\n\n    def add_node(n):\n        if n not in node_set:\n            node_set.add(n)\n            node_list.append(n)\n\n    edges = set()\n    for b in ordered:\n        U = canon(b['name'])\n        add_node(U)\n        for k, vals in b['dirs']:\n            if k == 'Phony':\n                continue\n            for v in vals:\n                add_node(canon(v))\n            if k == 'Alias':\n                continue\n            for v in vals:\n                c = canon(v)\n                if k in ('Depends', 'After'):\n                    edges.add((c, U))\n                else:\n                    edges.add((U, c))\n    for u in sorted(universe):\n        add_node(canon(u))\n\n    n = len(node_list)\n    index_of = {name: i for i, name in enumerate(node_list)}\n    adj = [[] for _ in range(n)]\n    self_loop = [False] * n\n    for a, bb in edges:\n        ia, ib = index_of[a], index_of[bb]\n        adj[ia].append(ib)\n        if ia == ib:\n            self_loop[ia] = True\n\n    # Tarjan SCC\n    counter = [0]\n    idx = {}\n    low = {}\n    stack = []\n    onstack = set()\n    comps = []\n\n    def strong(v):\n        idx[v] = low[v] = counter[0]\n        counter[0] += 1\n        stack.append(v)\n        onstack.add(v)\n        for w in adj[v]:\n            if w not in idx:\n                strong(w)\n                low[v] = min(low[v], low[w])\n            elif w in onstack:\n                low[v] = min