[33.151735, "i", "cat > /app/src/pooling.py << 'PYEOF'\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass _Pool2D(BaseLayer):\n    def __init__(self, kernel_size, stride=None):\n        super().__init__()\n        self.kernel_size = int(kernel_size)\n        self.stride = int(stride) if stride is not None else self.kernel_size\n\n    def _patches(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        n, h, w, c = x.shape\n        k, s = self.kernel_size, self.stride\n        oh = (h - k) // s + 1\n        ow = (w - k) // s + 1\n        patches = []\n        for i in range(k):\n            for j in range(k):\n                patches.append(x[:, i:i + s * (oh - 1) + 1:s, j:j + s * (ow - 1) + 1:s, :])\n        return patches\n\n\nclass MaxPool2D(_Pool2D):\n    def forward(self, x):\n        patches = self._patches(x)\n        return np.max(np.stack(patches, axis=0), axis=0).astype(np.float64)\n\n\nclass AvgPool2D(_Pool2D):\n    def forward(self, x):\n        patches = self._patches(x)\n        return np.mean(np.stack(patches, axis=0), axis=0).a"]
[33.151869, "i", "stype(np.float64)\nPYEOF\n"]
