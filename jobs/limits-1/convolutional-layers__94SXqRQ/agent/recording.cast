[31.765284, "i", "cat > /app/src/base.py << 'PYEOF'\nfrom abc import ABC, abstractmethod\n\n\nclass BaseLayer(ABC):\n    def __init__(self):\n        pass\n\n    def __call__(self, x, *args, **kwargs):\n        return self.forward(x, *args, **kwargs)\n\n    @abstractmethod\n    def forward(self, x):\n        raise NotImplementedError\nPYEOF\n"]
[31.766041, "o", "cat > /app/src/base.py << 'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[31.766376, "o", "> from abc import ABC, abstractmethod\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class BaseLayer(ABC):\r\n\u001b[?2004l\r\u001b[?2004h>     def __init__(self):\r\n\u001b[?2004l\r\u001b[?2004h>         pass\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
