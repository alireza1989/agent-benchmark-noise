[46.022246, "i", "cat > /app/output/verify.py << 'PYEOF'\nimport sys\nsys.path.insert(0, '/app')\nimport numpy as np\nfrom src import Conv2D, Conv2DTranspose, MaxPool2D, AvgPool2D, BatchNorm2D\n\nnp.random.seed(0)\n\n# Conv2D naive reference with dilation and stride\nx = np.random.randn(2, 9, 9, 3)\nc = Conv2D(3, 4, 3, stride=2, padding=1, dilation=2)\nc.bias = np.random.randn(4)\ny = c(x)\nxp = np.pad(x, ((0,0),(1,1),(1,1),(0,0)))\nref = np.zeros_like(y)\nfor n in range(2):\n    for oh in range(y.shape[1]):\n        for ow in range(y.shape[2]):\n            for co in range(4):\n                s = c.bias[co]\n                for i in range(3):\n                    for j in range(3):\n                        s += np.sum(xp[n, oh*2 + i*2, ow*2 + j*2, :] * c.weights[co, :, i, j])\n                ref[n, oh, ow, co] = s\nprint('conv max err', np.abs(y - ref).max())\n\n# Conv2DTranspose naive reference\nt = Conv2DTranspose(3, 5, 3, stride=2, padding=1)\nt.bias = np.random.randn(5)\nxi = np.random.randn(2, 4, 4, 3)\nyt = t(xi)\nH = (4 - 1) * 2 + 3\nfull = np.zero"]
[46.022594, "i", "s((2, H, H, 5))\nfor n in range(2):\n    for ih in range(4):\n        for iw in range(4):\n            for ci in range(3):\n                for i in range(3):\n                    for j in range(3):\n                        full[n, ih*2 + i, iw*2 + j, :] += xi[n, ih, iw, ci] * t.weights[ci, :, i, j]\nref_t = full[:, 1:H-1, 1:H-1, :] + t.bias\nprint('convT shape', yt.shape, 'max err', np.abs(yt - ref_t).max())\n\n# Pooling\np = np.arange(16, dtype=np.float64).reshape(1, 4, 4, 1)\nprint('maxpool', MaxPool2D(2)(p).ravel(), 'avgpool', AvgPool2D(2)(p).ravel())\n\n# BatchNorm\nb = BatchNorm2D(3)\nxb = np.random.randn(4, 5, 5, 3) * 3 + 2\nout = b(xb)\nprint('bn out mean', out.mean(axis=(0,1,2)).round(6), 'std', out.std(axis=(0,1,2)).round(4))\nprint('running_mean', b.running_mean.round(4), 'running_var', b.running_var.round(4))\nPYEOF\ncd /app && python3 /app/output/verify.py\n"]
