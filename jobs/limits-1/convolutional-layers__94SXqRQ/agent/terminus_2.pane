[?2004l[?2004h> 
[?2004l[?2004h> class LeakyReLU(BaseLayer):
[?2004l[?2004h>     def __init__(self, negative_slope=0.01):
[?2004l[?2004h>         super().__init__()
[?2004l[?2004h>         self.negative_slope = float(negative_slope)
[?2004l[?2004h> 
[?2004l[?2004h>     def forward(self, x):
[?2004l[?2004h>         x = np.asarray(x, dtype=np.float64)
[?2004l[?2004h>         return np.where(x > 0, x, self.negative_slope * x).astype(np.float64)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> class Sigmoid(BaseLayer):
[?2004l[?2004h>     def __init__(self):
