[?2004l[?2004h>         out = np.empty_like(x, dtype=np.float64)
[?2004l[?2004h>         pos = x >= 0
[?2004l[?2004h>         out[pos] = 1.0 / (1.0 + np.exp(-x[pos]))
[?2004l[?2004h>         neg = ~pos
[?2004l[?2004h>         ex = np.exp(x[neg])
[?2004l[?2004h>         out[neg] = ex / (1.0 + ex)
[?2004l[?2004h>         return out
