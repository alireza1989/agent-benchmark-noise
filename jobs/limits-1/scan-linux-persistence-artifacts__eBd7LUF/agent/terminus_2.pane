# scan_cron FILE MODE(cron|spool)
scan_cron() {
  local f=$1 mode=$2 real ln=0 line t u="" prev
  [ -f "$f" ] || return 0
  real=$(readlink -f -- "$f" 2>/dev/null) || return 0
  [ -n "$real" ] && [ -r "$real" ] || return 0
  [ "$mode" = spool ] && u=$(basename -- "$real")
  while IFS= read -r line || [ -n "$line" ]; do
    ln=$((ln+1))
