[134.510783, "i", " path sha line preview user; do\n    [ -n \"$type\" ] || continue\n    if [ $first -eq 0 ]; then echo '    ,'; fi\n    first=0\n    echo '    {'\n    echo '      \"type\": \"'\"$type\"'\",'\n    echo '      \"path\": \"'\"$(json_esc \"$path\")\"'\",'\n    echo '      \"sha256\": \"'\"$sha\"'\",'\n    echo '      \"details\": {'\n    echo '        \"line_number\": '\"${line:-null}\"','\n    echo '        \"content_preview\": \"'\"$(json_esc \"$preview\")\"'\",'\n    if [ -n \"$user\" ]; then\n      echo '        \"user\": \"'\"$(json_esc \"$user\")\"'\"'\n    else\n      echo '        \"user\": null'\n    fi\n    echo '      }'\n    echo '    }'\n  done < <(sort -t \"$SEP\" -k1,1 -k2,2 \"$TMP\")\n  echo '  ]'\n  echo '}'\n} > \"$OUT\"\n\nexit 0\nEOF\nchmod +x /app/scan_persistence.sh\n"]
