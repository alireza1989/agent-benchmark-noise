[214.349934, "o", "    ln=$((ln+1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.350124, "o", "    t=$(printf '%s' \"$line\" | sed 's/^[[:space:]]*//')\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.350211, "o", ">     [ -z \"$t\" ] && continue\r\n\u001b[?2004l\r"]
[214.35024, "o", "\u001b[?2004h> "]
[214.350302, "o", "    case $t in '#'*) continue ;; esac\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.350401, "o", "    if [[ $t =~ $SUSP_RE ]] || [[ $t =~ $EVERY_MIN_RE ]]; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.350502, "o", "      if [ \"$mode\" = cron ]; then u=$(printf '%s' \"$t\" | awk '{print $6}'); fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.350609, "o", "      add cron_job \"$real\" \"$ln\" \"$t\" \"$u\"\r\n\u001b[?2004l\r\u001b[?2004h>     fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.350672, "o", "  done < \"$real\"\r\n\u001b[?2004l\r"]
[214.35075, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.350814, "o", "scan_rc() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.350873, "o", "  local f=$1 real ln=0 line t\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.350969, "o", "  real=$(readlink -f -- \"$f\" 2>/dev/null) || return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.35103, "o", "  [ -n \"$real\" ] && [ -f \"$real\" ] && [ -r \"$real\" ] || return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.351108, "o", "  while IFS= read -r line || [ -n \"$line\" ]; do\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.351202, "o", "    ln=$((ln+1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.351384, "o", "    t=$(printf '%s' \"$line\" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')\r\n\u001b[?2004l\r"]
[214.351412, "o", "\u001b[?2004h> "]
[214.351451, "o", "    [ -z \"$t\" ] && continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.351532, "o", "> "]
[214.351557, "o", "    case $t in '#'*|'exit 0') continue ;; esac\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.351602, "o", "> "]
[214.351676, "o", "    add rc_local \"$real\" \"$ln\" \"$t\" \"\"\r\n\u001b[?2004l\r\u001b[?2004h>   done < \"$real\"\r\n\u001b[?2004l\r"]
[214.351759, "o", "\u001b[?2004h> "]
[214.351861, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> scan_units() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.351985, "o", "  local d=$1 f base real line t hit prev\r\n\u001b[?2004l\r\u001b[?2004h>   [ -d \"$d\" ] || return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.352059, "o", "  for f in \"$d\"/* \"$d\"/.*; do\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.352145, "o", "    [ -f \"$f\" ] || continue\r\n\u001b[?2004l\r"]
[214.35221, "o", "\u001b[?2004h> "]
[214.352234, "o", "    base=$(basename -- \"$f\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.35224, "o", "> "]
[214.35236, "o", "    case $base in *.service|.*) ;; *) continue ;; esac\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.352489, "o", "    real=$(readlink -f -- \"$f\" 2>/dev/null) || continue\r\n\u001b[?2004l\r"]
[214.352517, "o", "\u001b[?2004h> "]
[214.352648, "o", "    [ -n \"$real\" ] && [ -f \"$real\" ] && [ -r \"$real\" ] || continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.35273, "o", "    hit=\"\"; prev=\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.352748, "o", "    while IFS= read -r line || [ -n \"$line\" ]; do\r\n\u001b[?2004l\r"]
[214.352854, "o", "\u001b[?2004h>       t=$(printf '%s' \"$line\" | sed 's/^[[:space:]]*//')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.352946, "o", "      case $t in Exec*) ;; *) continue ;; esac\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.353046, "o", "      [ -z \"$prev\" ] && prev=$t\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.353128, "o", "> "]
[214.353204, "o", "      if [ -z \"$hit\" ] && [[ $t =~ $SUSP_RE ]]; then hit=$t; fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.353241, "o", "    done < \"$real\"\r\n\u001b[?2004l\r"]
[214.353245, "o", "\u001b[?2004h> "]
[214.353364, "o", "    case $base in .*) [ -z \"$hit\" ] && hit=${prev:-$base} ;; esac\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.35348, "o", "    [ -n \"$hit\" ] && add systemd_unit \"$real\" \"\" \"$hit\" \"\"\r\n\u001b[?2004l\r\u001b[?2004h>   done\r\n\u001b[?2004l\r"]
[214.353551, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> scan_keys() {"]
[214.35365, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.35372, "o", "> "]
[214.35378, "o", "  local f=$1 real ln=0 line t u\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.353836, "o", "  real=$(readlink -f -- \"$f\" 2>/dev/null) || return 0\r\n\u001b[?2004l\r"]
[214.353923, "o", "\u001b[?2004h> "]
[214.354035, "o", "  [ -n \"$real\" ] && [ -f \"$real\" ] && [ -r \"$real\" ] || return 0\r\n\u001b[?2004l\r"]
[214.354133, "o", "\u001b[?2004h>   u=$(basename -- \"$(dirname -- \"$(dirname -- \"$f\")\")\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.354259, "o", "  while IFS= read -r line || [ -n \"$line\" ]; do\r\n\u001b[?2004l\r\u001b[?2004h>     ln=$((ln+1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.354357, "o", "    t=$(printf '%s' \"$line\" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.354382, "o", "    [ -z \"$t\" ] && continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.354451, "o", ">     case $t in '#'*) continue ;; esac\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.35463, "o", "    if [ -f \"$WHITELIST\" ] && grep -qxF -- \"$t\" \"$WHITELIST\"; then continue; fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.354715, "o", "    add ssh_key \"$real\" \"$ln\" \"$t\" \"$u\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.354794, "o", "  done < \"$real\"\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[214.354908, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[214.354932, "o", "> "]
[214.355047, "o", "for f in /etc/cron.d/* /etc/cron.d/.*; do scan_cron \"$f\" cron; done\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.35507, "o", "scan_cron /etc/crontab cron\r\n\u001b[?2004l\r"]
[214.355143, "o", "\u001b[?2004h> "]
[214.355227, "o", "for f in /var/spool/cron/crontabs/* /var/spool/cron/crontabs/.*; do scan_cron \"$f\" spool; done\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.355351, "o", "for f in /app_target/etc/cron.d/* /app_target/etc/cron.d/.*; do scan_cron \"$f\" cron; done\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.35542, "o", "scan_cron /app_target/etc/crontab cron\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.355552, "o", "for f in /app_target/var/spool/cron/crontabs/* /app_target/var/spool/cron/crontabs/.*; do scan_cron \"$f\" spool; done\r\n\u001b[?2004l\r"]
[214.35569, "o", "\u001b[?2004h> "]
[214.355818, "o", "for d in /etc/systemd/system /usr/lib/systemd/system /run/systemd/system /app_target/etc/systemd/system; do scan_units \"$d\"; done"]
[214.355869, "o", "\r\n\u001b[?2004l\r"]
[214.355882, "o", "\u001b[?2004h"]
[214.355952, "o", "> "]
[214.356103, "o", "for f in /etc/rc.local /etc/rc.d/rc.local /app_target/etc/rc.local /app_target/etc/rc.d/rc.local; do scan_rc \"$f\"; done\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.356273, "o", "for f in /root/.ssh/authorized_keys /home/*/.ssh/authorized_keys /app_target/root/.ssh/authorized_keys /app_target/home/*/.ssh/authorized_keys; do scan_keys \"$f\"; done\r\n\u001b[?2004l\r"]
[214.356353, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[214.356437, "o", "\u001b[?2004h> "]
[214.356533, "o", "cnt() { awk -F\"$SEP\" -v t=\"$1\" '$1==t{n++} END{print n+0}' \"$TMP\"; }"]
[214.356577, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.356684, "o", "n_cron=$(cnt cron_job)\r\n\u001b[?2004l\r\u001b[?2004h> n_sys=$(cnt systemd_unit)"]
[214.356714, "o", "\r\n\u001b[?2004l\r"]
[214.356767, "o", "\u001b[?2004h> n_rc=$(cnt rc_local)\r\n\u001b[?2004l\r"]
[214.356803, "o", "\u001b[?2004h> "]
[214.356861, "o", "n_ssh=$(cnt ssh_key)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.356901, "o", "n_total=$((n_cron + n_sys + n_rc + n_ssh))\r\n\u001b[?2004l\r"]
[214.35692, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[214.35693, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[214.356991, "o", "\u001b[?2004h> "]
[214.357254, "o", "  printf '{\\n  \"summary\": {\\n    \"total_artifacts\": %s,\\n    \"cron_jobs\": %s,\\n    \"systemd_units\": %s,\\n    \"rc_local_modifications\": %s,\\n    \"ssh_keys\": %s\\n  },\\n  \"artifacts\": [\\n' \"$n_total\" \"$n_cron\" \"$n_sys\" \"$n_rc\" \"$n_ssh\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.357347, "o", "  first=1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.357473, "o", "  sort -t \"$SEP\" -k1,1 -k2,2 \"$TMP\" | while IFS=\"$SEP\" read -r type path sha line preview user; do\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.357589, "o", "    if [ $first -eq 1 ]; then first=0; else printf '    ,\\n'; fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.357612, "o", "    printf '    {\\n'"]
[214.357702, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     printf '      \"type\": \"%s\",\\n' \"$type\"\r\n\u001b[?2004l\r"]
[214.357804, "o", "\u001b[?2004h> "]
[214.357871, "o", "    printf '      \"path\": \"%s\",\\n' \"$(json_esc \"$path\")\"\r\n\u001b[?2004l\r\u001b[?2004h>     printf '      \"sha256\": \"%s\",\\n' \"$sha\"\r\n\u001b[?2004l\r"]
[214.357985, "o", "\u001b[?2004h>     printf '      \"details\": {\\n'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.358049, "o", "    printf '        \"line_number\": %s,\\n' \"${line:-null}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.358128, "o", "    printf '        \"content_preview\": \"%s\",\\n' \"$(json_esc \"$preview\")\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.358287, "o", "    if [ -n \"$user\" ]; then printf '        \"user\": \"%s\"\\n' \"$(json_esc \"$user\")\"; else printf '        \"user\": null\\n'; fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.358397, "o", "    printf '      }\\n    }\\n'\r\n\u001b[?2004l\r\u001b[?2004h>   done\r\n\u001b[?2004l\r\u001b[?2004h>   printf '  ]\\n}\\n'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.358476, "o", "} > \"$OUT\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> exit 0\r\n\u001b[?2004l\r"]
