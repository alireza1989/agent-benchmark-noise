[214.347749, "i", "l}\"\n    printf '        \"content_preview\": \"%s\",\\n' \"$(json_esc \"$preview\")\"\n    if [ -n \"$user\" ]; then printf '        \"user\": \"%s\"\\n' \"$(json_esc \"$user\")\"; else printf '        \"user\": null\\n'; fi\n    printf '      }\\n    }\\n'\n  done\n  printf '  ]\\n}\\n'\n} > \"$OUT\"\n\nexit 0\nEOF\nchmod +x /app/scan_persistence.sh\n"]
