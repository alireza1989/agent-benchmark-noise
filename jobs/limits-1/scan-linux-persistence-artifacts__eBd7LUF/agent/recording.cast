[134.506083, "i", "cat > /app/scan_persistence.sh <<'EOF'\n#!/bin/bash\n# Read-only scanner for Linux persistence artifacts.\n# Writes a JSON report to /app/persistence_report.json (idempotent).\nset -u\nexport LC_ALL=C\nOUT=/app/persistence_report.json\nWHITELIST=/app/known_ssh_keys.txt\nSEP=$'\\037'\nTMP=$(mktemp 2>/dev/null) || TMP=/tmp/scan_persistence.$$\ntrap 'rm -f \"$TMP\"' EXIT\n: > \"$TMP\"\n\nSUSP_RE='(/tmp/|/var/tmp/|/dev/shm/|/app_target/|/usr/local/bin/|/home/|base64|eval|curl |wget |(^|[[:space:]|;&])nc[[:space:]]|[|][[:space:]]*(ba|z|da)?sh|/dev/tcp|python[0-9.]*[[:space:]]+-c|perl[[:space:]]+-e|attacker|backdoor|malicious)'\nEVERY_MIN_RE='^[*][[:space:]]+[*][[:space:]]+[*][[:space:]]+[*][[:space:]]+[*]([[:space:]]|$)'\n\njson_esc() {\n  local s=$1\n  s=${s//\\/\\\\}\n  s=${s//\"/\\\"}\n  s=${s//$'\\t'/\\t}\n  s=${s//$'\\r'/\\r}\n  s=${s//$'\\n'/\\n}\n  printf '%s' \"$s\"\n}\n\nclean() { printf '%s' \"$1\" | tr -d '[:cntrl:]'; }\n\nsha_of() { sha256sum -- \"$1\" 2>/dev/null | cut -d' ' -f1; }\n\n# add TYPE PATH LINE PREVIEW USER\nadd() {\n  local sha\n  sha=$(sha_of "]
[134.508769, "o", "cat > /app/scan_persistence.sh <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #!/bin/bash\r\n\u001b[?2004l\r\u001b[?2004h> # Read-only scanner for Linux persistence artifacts.\r\n\u001b[?2004l\r\u001b[?2004h> # Writes a JSON report to /app/persistence_report.json (idempotent).\r\n\u001b[?2004l\r\u001b[?2004h> set -u\r\n\u001b[?2004l\r\u001b[?2004h> export LC_ALL=C\r\n\u001b[?2004l\r\u001b[?2004h> OUT=/app/persistence_report.json\r\n\u001b[?2004l\r\u001b[?2004h> WHITELIST=/app/known_ssh_keys.txt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.508857, "i", "\"$2\")\n  [ -n \"$sha\" ] || return 0\n  printf '%s\\n' \"$1$SEP$2$SEP$sha$SEP$3$SEP$(clean \"$4\")$SEP$5\" >> \"$TMP\"\n}\n\n# scan_cron FILE MODE(cron|spool)\nscan_cron() {\n  local f=$1 mode=$2 real ln=0 line t u=\"\" prev\n  [ -f \"$f\" ] || return 0\n  real=$(readlink -f -- \"$f\" 2>/dev/null) || return 0\n  [ -n \"$real\" ] && [ -r \"$real\" ] || return 0\n  [ \"$mode\" = spool ] && u=$(basename -- \"$real\")\n  while IFS= read -r line || [ -n \"$line\" ]; do\n    ln=$((ln+1))\n    t=${line#\"${line%%[![:space:]]*}\"}\n    [ -z \"$t\" ] && continue\n    [[ $t == '#'* ]] && continue\n    if [[ $t =~ $SUSP_RE ]] || [[ $t =~ $EVERY_MIN_RE ]]; then\n      prev=${t:0:100}\n      if [ \"$mode\" = cron ]; then u=$(printf '%s' \"$t\" | awk '{print $6}'); fi\n      add cron_job \"$real\" \"$ln\" \"$prev\" \"$u\"\n    fi\n  done < \"$real\"\n}\n\n# scan_rc FILE\nscan_rc() {\n  local f=$1 real ln=0 line t\n  [ -f \"$f\" ] || return 0\n  real=$(readlink -f -- \"$f\" 2>/dev/null) || return 0\n  [ -n \"$real\" ] && [ -r \"$real\" ] || return 0\n  while IFS= read -r line || [ -n \"$line\" ]; do\n    ln"]
[134.510278, "o", "SEP=$'\\037'\r\n\u001b[?2004l\r\u001b[?2004h> TMP=$(mktemp 2>/dev/null) || TMP=/tmp/scan_persistence.$$\r\n\u001b[?2004l\r\u001b[?2004h> trap 'rm -f \"$TMP\"' EXIT\r\n\u001b[?2004l\r\u001b[?2004h> : > \"$TMP\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> SUSP_RE='(/tmp/|/var/tmp/|/dev/shm/|/app_target/|/usr/local/bin/|/home/|base64|eval|curl |wget |(^|[[:space:]|;&])nc[[:space:]]|[|][[:space:]]*(ba|z|da)?sh|/dev/tcp|python[0-9.]*[[:space:]]+-c|perl[[:space:]]+-e|attacker|backdoor|malicious)'\r\n\u001b[?2004l\r\u001b[?2004h> EVERY_MIN_RE='^[*][[:space:]]+[*][[:space:]]+[*][[:space:]]+[*][[:space:]]+[*]([[:space:]]|$)'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> json_esc() {\r\n\u001b[?2004l\r\u001b[?2004h>   local s=$1\r\n\u001b[?2004l\r\u001b[?2004h>   s=${s//\\/\\\\}\r\n\u001b[?2004l\r\u001b[?2004h>   s=${s//\"/\\\"}\r\n\u001b[?2004l\r\u001b[?2004h>   s=${s//$'\\t'/\\t}\r\n\u001b[?2004l\r\u001b[?2004h>   s=${s//$'\\r'/\\r}\r\n\u001b[?2004l\r\u001b[?2004h>   s=${s//$'\\n'/\\n}\r\n\u001b[?2004l\r\"$2\")\r\n  [ -n \"$sha\" ] || return 0\r\n  printf '%s\\n' \"$1$SEP$2$SEP$sha$SEP$3$SEP$(clean \"$4\")$SEP$5\" >> \"$TMP\"\r\n}\r\n\r\n# scan_cron FILE MODE(cron|spool)\r\nscan_cron() {\r\n  local f="]
[134.510294, "i", "=$((ln+1))\n    t=${line#\"${line%%[![:space:]]*}\"}\n    [ -z \"$t\" ] && continue\n    [[ $t == '#'* ]] && continue\n    [ \"$t\" = \"exit 0\" ] && continue\n    add rc_local \"$real\" \"$ln\" \"$t\" \"\"\n  done < \"$real\"\n}\n\n# scan_units DIR : flags hidden units and units with suspicious Exec lines\nscan_units() {\n  local d=$1 f base real line t hit=\"\" prev=\"\"\n  [ -d \"$d\" ] || return 0\n  for f in \"$d\"/* \"$d\"/.*; do\n    [ -f \"$f\" ] || continue\n    base=$(basename -- \"$f\")\n    case $base in *.service|.*) ;; *) continue ;; esac\n    real=$(readlink -f -- \"$f\" 2>/dev/null) || continue\n    [ -n \"$real\" ] && [ -r \"$real\" ] || continue\n    hit=\"\"; prev=\"\"\n    while IFS= read -r line || [ -n \"$line\" ]; do\n      t=${line#\"${line%%[![:space:]]*}\"}\n      [[ $t == Exec* ]] || continue\n      [ -z \"$prev\" ] && prev=$t\n      if [ -z \"$hit\" ] && [[ $t =~ $SUSP_RE ]]; then hit=$t; fi\n    done < \"$real\"\n    case $base in .*) hit=${hit:-${prev:-$base}} ;; esac\n    if [ -n \"$hit\" ]; then\n      add systemd_unit \"$real\" \"\" \"${hit:0:100}\" \"\"\n    fi\n  d"]
[134.51035, "o", "$1 mode=$2 real ln=0 line t u=\"\" prev\r\n  [ -f \"$f\" ] || return 0\r\n  real=$(readlink -f -- \"$f\" 2>/dev/null) || return 0\r\n  [ -n \"$real\" ] && [ -r \"$real\" ] || return 0\r\n  [ \"$mode\" = spool ] && u=$(basename -- \"$real\")\r\n  while IFS= read -r line || [ -n \"$line\" ]; do\r\n    ln=$((ln+1))\r\n    t=${line#\"${line%%[![:space:]]*}\"}\r\n    [ -z \"$t\" ] && continue\r\n    [[ $t == '#'* ]] && continue\r\n    if [[ $t =~ $SUSP_RE ]] || [[ $t =~ $EVERY_MIN_RE ]]; then\r\n      prev=${t:0:100}\r\n      if [ \"$mode\" = cron ]; then u=$(printf '%s' \"$t\" | awk '{print $6}'); fi\r\n      add cron_job \"$real\" \"$ln\" \"$prev\" \"$u\"\r\n    fi\r\n  done < \"$real\"\r\n}\r\n\r\n# scan_rc FILE\r\nscan_rc() {\r\n  local f=$1 real ln=0 line t\r\n  [ -f \"$f\" ] || return 0\r\n  real=$(readlink -f -- \"$f\" 2>/dev/null) || return 0\r\n  [ -n \"$real\" ] && [ -r \"$real\" ] || return 0\r\n  while IFS= read -r line || [ -n \"$line\" ]; do\r\n    ln\u001b[?2004h>   printf '%s' \"$s\"\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> clean() { printf '%s' \"$1\" | tr -d '[:cntrl:]'; }\r\n\u001b"]
[134.51059, "i", "one\n}\n\n# scan_keys FILE\nscan_keys() {\n  local f=$1 real ln=0 line t u\n  [ -f \"$f\" ] || return 0\n  real=$(readlink -f -- \"$f\" 2>/dev/null) || return 0\n  [ -n \"$real\" ] && [ -r \"$real\" ] || return 0\n  u=$(basename -- \"$(dirname -- \"$(dirname -- \"$f\")\")\")\n  while IFS= read -r line || [ -n \"$line\" ]; do\n    ln=$((ln+1))\n    t=${line#\"${line%%[![:space:]]*}\"}\n    [ -z \"$t\" ] && continue\n    [[ $t == '#'* ]] && continue\n    if [ -f \"$WHITELIST\" ] && grep -qxF -- \"$t\" \"$WHITELIST\"; then continue; fi\n    add ssh_key \"$real\" \"$ln\" \"$t\" \"$u\"\n  done < \"$real\"\n}\n\n# ---- cron ----\nfor f in /etc/cron.d/* /etc/cron.d/.*; do scan_cron \"$f\" cron; done\nscan_cron /etc/crontab cron\nfor f in /var/spool/cron/crontabs/* /var/spool/cron/crontabs/.*; do scan_cron \"$f\" spool; done\nfor f in /app_target/etc/cron.d/* /app_target/etc/cron.d/.*; do scan_cron \"$f\" cron; done\nscan_cron /app_target/etc/crontab cron\nfor f in /app_target/var/spool/cron/crontabs/* /app_target/var/spool/cron/crontabs/.*; do scan_cron \"$f\" spool; done\n\n# ---- syst"]
[134.510616, "o", "[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> sha_of() { sha256sum -- \"$1\" 2>/dev/null | cut -d' ' -f1; }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # add TYPE PATH LINE PREVIEW USER\r\n\u001b[?2004l\r\u001b[?2004h> add() {\r\n\u001b[?2004l\r\u001b[?2004h>   local sha\r\n\u001b[?2004l\r\u001b[?2004h>   sha=$(sha_of \"$2\")\r\n\u001b[?2004l\r\u001b[?2004h>   [ -n \"$sha\" ] || return 0\r\n\u001b[?2004l\r\u001b[?2004h>   printf '%s\\n' \"$1$SEP$2$SEP$sha$SEP$3$SEP$(clean \"$4\")$SEP$5\" >> \"$TMP\"\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # scan_cron FILE MODE(cron|spool)\r\n\u001b[?2004l\r\u001b[?2004h> scan_cron() {\r\n\u001b[?2004l\r\u001b[?2004h>   local f=$1 mode=$2 real ln=0 line t u=\"\" prev\r\n\u001b[?2004l\r\u001b[?2004h>   [ -f \"$f\" ] || return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.510749, "i", "emd ----\nfor d in /etc/systemd/system /usr/lib/systemd/system /run/systemd/system /app_target/etc/systemd/system; do scan_units \"$d\"; done\n\n# ---- rc.local ----\nfor f in /etc/rc.local /etc/rc.d/rc.local /app_target/etc/rc.local /app_target/etc/rc.d/rc.local; do scan_rc \"$f\"; done\n\n# ---- ssh keys ----\nfor f in /root/.ssh/authorized_keys /home/*/.ssh/authorized_keys /app_target/root/.ssh/authorized_keys /app_target/home/*/.ssh/authorized_keys; do scan_keys \"$f\"; done\n\n# ---- report ----\ncnt() { awk -F\"$SEP\" -v t=\"$1\" '$1==t{n++} END{print n+0}' \"$TMP\"; }\nn_cron=$(cnt cron_job)\nn_sys=$(cnt systemd_unit)\nn_rc=$(cnt rc_local)\nn_ssh=$(cnt ssh_key)\nn_total=$((n_cron + n_sys + n_rc + n_ssh))\n\n{\n  echo '{'\n  echo '  \"summary\": {'\n  echo '    \"total_artifacts\": '\"$n_total\"','\n  echo '    \"cron_jobs\": '\"$n_cron\"','\n  echo '    \"systemd_units\": '\"$n_sys\"','\n  echo '    \"rc_local_modifications\": '\"$n_rc\"','\n  echo '    \"ssh_keys\": '\"$n_ssh\"\n  echo '  },'\n  echo '  \"artifacts\": ['\n  first=1\n  while IFS=\"$SEP\" read -r type"]
