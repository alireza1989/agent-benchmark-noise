[214.344256, "i", "cat > /app/scan_persistence.sh <<'EOF'\n#!/bin/bash\n# Read-only scanner for Linux persistence artifacts. Writes /app/persistence_report.json.\nset -u\nexport LC_ALL=C\nOUT=/app/persistence_report.json\nWHITELIST=/app/known_ssh_keys.txt\nSEP=$'\\037'\nTMP=$(mktemp 2>/dev/null || echo /tmp/scan_persistence.$$)\ntrap 'rm -f \"$TMP\"' EXIT\n: > \"$TMP\"\nSUSP_RE='(/tmp/|/var/tmp/|/dev/shm/|/app_target/|/usr/local/bin/|/home/|base64|eval|curl |wget |(^|[[:space:]|;&])nc[[:space:]]|[|][[:space:]]*(ba|z|da)?sh|/dev/tcp|python[0-9.]*[[:space:]]+-c|perl[[:space:]]+-e|attacker|backdoor|malicious)'\nEVERY_MIN_RE='^[*][[:space:]]+[*][[:space:]]+[*][[:space:]]+[*][[:space:]]+[*]([[:space:]]|$)'\n\nclean() { printf '%s' \"$1\" | tr -d '[:cntrl:]' | cut -c1-100; }\njson_esc() { printf '%s' \"$1\" | sed -e 's/\\\\/\\\\\\\\/g' -e 's/\"/\\\\\"/g' | tr -d '\\n'; }\n\nadd() {\n  local sha\n  sha=$(sha256sum -- \"$2\" 2>/dev/null | cut -d' ' -f1)\n  [ -n \"$sha\" ] || return 0\n  printf '%s\\n' \"$1$SEP$2$SEP$sha$SEP$3$SEP$(clean \"$4\")$SEP$5\" >> \"$TMP\"\n}\n\nscan_cron() {\n  loc"]
[214.34536, "o", "cat > /app/scan_persistence.sh <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #!/bin/bash\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.345417, "i", "al f=$1 mode=$2 real ln=0 line t u=\"\"\n  real=$(readlink -f -- \"$f\" 2>/dev/null) || return 0\n  [ -n \"$real\" ] && [ -f \"$real\" ] && [ -r \"$real\" ] || return 0\n  [ \"$mode\" = spool ] && u=$(basename -- \"$real\")\n  while IFS= read -r line || [ -n \"$line\" ]; do\n    ln=$((ln+1))\n    t=$(printf '%s' \"$line\" | sed 's/^[[:space:]]*//')\n    [ -z \"$t\" ] && continue\n    case $t in '#'*) continue ;; esac\n    if [[ $t =~ $SUSP_RE ]] || [[ $t =~ $EVERY_MIN_RE ]]; then\n      if [ \"$mode\" = cron ]; then u=$(printf '%s' \"$t\" | awk '{print $6}'); fi\n      add cron_job \"$real\" \"$ln\" \"$t\" \"$u\"\n    fi\n  done < \"$real\"\n}\n\nscan_rc() {\n  local f=$1 real ln=0 line t\n  real=$(readlink -f -- \"$f\" 2>/dev/null) || return 0\n  [ -n \"$real\" ] && [ -f \"$real\" ] && [ -r \"$real\" ] || return 0\n  while IFS= read -r line || [ -n \"$line\" ]; do\n    ln=$((ln+1))\n    t=$(printf '%s' \"$line\" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')\n    [ -z \"$t\" ] && continue\n    case $t in '#'*|'exit 0') continue ;; esac\n    add rc_local \"$real\" \"$ln\" \"$t\" \"\"\n  done"]
[214.345541, "i", " < \"$real\"\n}\n\nscan_units() {\n  local d=$1 f base real line t hit prev\n  [ -d \"$d\" ] || return 0\n  for f in \"$d\"/* \"$d\"/.*; do\n    [ -f \"$f\" ] || continue\n    base=$(basename -- \"$f\")\n    case $base in *.service|.*) ;; *) continue ;; esac\n    real=$(readlink -f -- \"$f\" 2>/dev/null) || continue\n    [ -n \"$real\" ] && [ -f \"$real\" ] && [ -r \"$real\" ] || continue\n    hit=\"\"; prev=\"\"\n    while IFS= read -r line || [ -n \"$line\" ]; do\n      t=$(printf '%s' \"$line\" | sed 's/^[[:space:]]*//')\n      case $t in Exec*) ;; *) continue ;; esac\n      [ -z \"$prev\" ] && prev=$t\n      if [ -z \"$hit\" ] && [[ $t =~ $SUSP_RE ]]; then hit=$t; fi\n    done < \"$real\"\n    case $base in .*) [ -z \"$hit\" ] && hit=${prev:-$base} ;; esac\n    [ -n \"$hit\" ] && add systemd_unit \"$real\" \"\" \"$hit\" \"\"\n  done\n}\n\nscan_keys() {\n  local f=$1 real ln=0 line t u\n  real=$(readlink -f -- \"$f\" 2>/dev/null) || return 0\n  [ -n \"$real\" ] && [ -f \"$real\" ] && [ -r \"$real\" ] || return 0\n  u=$(basename -- \"$(dirname -- \"$(dirname -- \"$f\")\")\")\n  while IFS= read "]
[214.347034, "o", "# Read-only scanner for Linux persistence artifacts. Writes /app/persistence_report.json.\r\n\u001b[?2004l\r\u001b[?2004h> set -u\r\n\u001b[?2004l\r\u001b[?2004h> export LC_ALL=C\r\n\u001b[?2004l\r\u001b[?2004h> OUT=/app/persistence_report.json\r\n\u001b[?2004l\r\u001b[?2004h> WHITELIST=/app/known_ssh_keys.txt\r\n\u001b[?2004l\r\u001b[?2004h> SEP=$'\\037'\r\n\u001b[?2004l\r\u001b[?2004h> TMP=$(mktemp 2>/dev/null || echo /tmp/scan_persistence.$$)\r\n\u001b[?2004l\r\u001b[?2004h> trap 'rm -f \"$TMP\"' EXIT\r\n\u001b[?2004l\r\u001b[?2004h> : > \"$TMP\"\r\n\u001b[?2004l\r\u001b[?2004h> SUSP_RE='(/tmp/|/var/tmp/|/dev/shm/|/app_target/|/usr/local/bin/|/home/|base64|eval|curl |wget |(^|[[:space:]|;&])nc[[:space:]]|[|][[:space:]]*(ba|z|da)?sh|/dev/tcp|python[0-9.]*[[:space:]]+-c|perl[[:space:]]+-e|attacker|backdoor|malicious)'\r\n\u001b[?2004l\r\u001b[?2004h> EVERY_MIN_RE='^[*][[:space:]]+[*][[:space:]]+[*][[:space:]]+[*][[:space:]]+[*]([[:space:]]|$)'\r\n\u001b[?2004l\r"]
[214.347076, "i", "-r line || [ -n \"$line\" ]; do\n    ln=$((ln+1))\n    t=$(printf '%s' \"$line\" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')\n    [ -z \"$t\" ] && continue\n    case $t in '#'*) continue ;; esac\n    if [ -f \"$WHITELIST\" ] && grep -qxF -- \"$t\" \"$WHITELIST\"; then continue; fi\n    add ssh_key \"$real\" \"$ln\" \"$t\" \"$u\"\n  done < \"$real\"\n}\n\nfor f in /etc/cron.d/* /etc/cron.d/.*; do scan_cron \"$f\" cron; done\nscan_cron /etc/crontab cron\nfor f in /var/spool/cron/crontabs/* /var/spool/cron/crontabs/.*; do scan_cron \"$f\" spool; done\nfor f in /app_target/etc/cron.d/* /app_target/etc/cron.d/.*; do scan_cron \"$f\" cron; done\nscan_cron /app_target/etc/crontab cron\nfor f in /app_target/var/spool/cron/crontabs/* /app_target/var/spool/cron/crontabs/.*; do scan_cron \"$f\" spool; done\nfor d in /etc/systemd/system /usr/lib/systemd/system /run/systemd/system /app_target/etc/systemd/system; do scan_units \"$d\"; done\nfor f in /etc/rc.local /etc/rc.d/rc.local /app_target/etc/rc.local /app_target/etc/rc.d/rc.local; do scan_rc \"$f\"; done\nfor f in /r"]
[214.347091, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.3471, "i", "oot/.ssh/authorized_keys /home/*/.ssh/authorized_keys /app_target/root/.ssh/authorized_keys /app_target/home/*/.ssh/authorized_keys; do scan_keys \"$f\"; done\n\ncnt() { awk -F\"$SEP\" -v t=\"$1\" '$1==t{n++} END{print n+0}' \"$TMP\"; }\nn_cron=$(cnt cron_job)\nn_sys=$(cnt systemd_unit)\nn_rc=$(cnt rc_local)\nn_ssh=$(cnt ssh_key)\nn_total=$((n_cron + n_sys + n_rc + n_ssh))\n\n{\n  printf '{\\n  \"summary\": {\\n    \"total_artifacts\": %s,\\n    \"cron_jobs\": %s,\\n    \"systemd_units\": %s,\\n    \"rc_local_modifications\": %s,\\n    \"ssh_keys\": %s\\n  },\\n  \"artifacts\": [\\n' \"$n_total\" \"$n_cron\" \"$n_sys\" \"$n_rc\" \"$n_ssh\"\n  first=1\n  sort -t \"$SEP\" -k1,1 -k2,2 \"$TMP\" | while IFS=\"$SEP\" read -r type path sha line preview user; do\n    if [ $first -eq 1 ]; then first=0; else printf '    ,\\n'; fi\n    printf '    {\\n'\n    printf '      \"type\": \"%s\",\\n' \"$type\"\n    printf '      \"path\": \"%s\",\\n' \"$(json_esc \"$path\")\"\n    printf '      \"sha256\": \"%s\",\\n' \"$sha\"\n    printf '      \"details\": {\\n'\n    printf '        \"line_number\": %s,\\n' \"${line:-nul"]
