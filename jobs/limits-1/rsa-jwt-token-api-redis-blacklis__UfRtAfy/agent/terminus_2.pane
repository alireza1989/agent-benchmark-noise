def cmd_retry(args):
    t = load_tokens()
    if t:
        status, body = http('GET', '/auth/validate', token=t['access_token'])
        if status == 200:
            print('Access token still valid; nothing to retry.')
            return 0
        if t.get('refresh_token'):
            status, body = http('POST', '/auth/refresh', {'refresh_token': t['refresh_token']})
