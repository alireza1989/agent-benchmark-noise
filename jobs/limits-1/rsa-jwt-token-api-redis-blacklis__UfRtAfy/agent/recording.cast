[70.568426, "i", "cat > /app/cli.py << 'EOF'\n#!/usr/bin/env python3\nimport argparse, json, os, sys, time, logging, urllib.request, urllib.error\n\nBASE = '/app'\nTOKENS_FILE = os.path.join(BASE, 'tokens.json')\nAPI = os.environ.get('API_URL', 'http://127.0.0.1:5000')\nos.makedirs(os.path.join(BASE, 'logs'), exist_ok=True)\nlogging.basicConfig(filename=os.path.join(BASE, 'logs', 'app.log'), level=logging.INFO, format='%(asctime)s %(levelname)s %(name)s %(message)s')\nlog = logging.getLogger('cli')\n\ndef http(method, path, body=None, token=None):\n    data = json.dumps(body).encode() if body is not None else None\n    req = urllib.request.Request(API + path, data=data, method=method)\n    req.add_header('Content-Type', 'application/json')\n    if token:\n        req.add_header('Authorization', 'Bearer ' + token)\n    try:\n        with urllib.request.urlopen(req, timeout=10) as r:\n            return r.status, json.loads(r.read() or b'{}')\n    except urllib.error.HTTPError as e:\n        try:\n            body = json.loads(e.read() or b'{}')\n    "]
[70.568591, "o", "cat > /app/cli.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.568727, "i", "    except ValueError:\n            body = {}\n        return e.code, body\n    except urllib.error.URLError as e:\n        log.error('API unreachable at %s: %s', API, e)\n        return 0, {'error': str(e.reason)}\n\ndef load_tokens():\n    if not os.path.exists(TOKENS_FILE):\n        return None\n    with open(TOKENS_FILE) as f:\n        return json.load(f)\n\ndef save_tokens(data):\n    with open(TOKENS_FILE, 'w') as f:\n        json.dump(data, f, indent=2)\n    os.chmod(TOKENS_FILE, 0o600)\n\ndef do_login(username, password):\n    status, body = http('POST', '/auth/login', {'username': username, 'password': password})\n    if status != 200:\n        log.error('login failed for %s: %s %s', username, status, body)\n        print('Login failed (HTTP %s): %s' % (status, body.get('error', 'unknown error')))\n        return None\n    data = {'username': username, 'access_token': body['access_token'], 'refresh_token': body['refresh_token'], 'acquired_at': time.time()}\n    save_tokens(data)\n    print('Tokens acquired and saved to %s' % "]
[70.568804, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> import argparse, json, os, sys, time, logging, urllib.request, urllib.error\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.568925, "i", "TOKENS_FILE)\n    return data\n\ndef cmd_acquire(args):\n    return 0 if do_login(args.username, args.password) else 1\n\ndef cmd_validate(args):\n    t = load_tokens()\n    if not t:\n        print('No tokens found. Run acquire first.')\n        return 1\n    status, body = http('GET', '/auth/validate', token=t['access_token'])\n    if status == 200:\n        print('Access token VALID (jti=%s, sub=%s)' % (body['jti'], body['sub']))\n        return 0\n    print('Access token INVALID (HTTP %s): %s' % (status, body.get('error', 'unknown')))\n    if status == 401 and 'expired' in body.get('error', ''):\n        print('Token expired. Run: python3 /app/cli.py retry')\n    return 1\n\ndef cmd_revoke(args):\n    t = load_tokens()\n    if not t:\n        print('No tokens found. Run acquire first.')\n        return 1\n    key = args.type + '_token'\n    status, body = http('POST', '/auth/revoke', {'token': t[key]})\n    if status != 200:\n        log.error('revoke of %s token failed: %s %s', args.type, status, body)\n        print('Revoke failed "]
[70.568997, "o", "\u001b[?2004h> BASE = '/app'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.569108, "i", "(HTTP %s): %s' % (status, body.get('error', 'unknown')))\n        return 1\n    t['revoked_' + args.type] = body['jti']\n    save_tokens(t)\n    print('%s token revoked (jti=%s, ttl=%ss)' % (args.type, body['jti'], body['ttl']))\n    return 0\n\ndef cmd_retry(args):\n    t = load_tokens()\n    if t:\n        status, body = http('GET', '/auth/validate', token=t['access_token'])\n        if status == 200:\n            print('Access token still valid; nothing to retry.')\n            return 0\n        if t.get('refresh_token'):\n            status, body = http('POST', '/auth/refresh', {'refresh_token': t['refresh_token']})\n            if status == 200:\n                t['access_token'] = body['access_token']\n                save_tokens(t)\n                print('Access token refreshed using refresh token.')\n                return 0\n            print('Refresh failed (HTTP %s): %s' % (status, body.get('error', 'unknown')))\n    print('Acquiring new tokens...')\n    return 0 if do_login(args.username, args.password) else 1\n\ndef main"]
