[70.579142, "o", "\u001b[?2004h> def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.5792, "o", "    p = argparse.ArgumentParser(description='JWT token CLI')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.579287, "o", "    sub = p.add_subparsers(dest='command', required=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.579409, "o", "    a = sub.add_parser('acquire', help='login and save tokens')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.5795, "o", "    a.add_argument('--username', default='admin')\r\n\u001b[?2004l\r"]
[70.579523, "o", "\u001b[?2004h> "]
[70.579588, "o", "    a.add_argument('--password', default='password123')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.579699, "o", "    a.set_defaults(func=cmd_acquire)\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.579725, "o", "> "]
[70.579815, "o", "    v = sub.add_parser('validate', help='validate access token')\r\n\u001b[?2004l\r"]
[70.579845, "o", "\u001b[?2004h> "]
[70.579927, "o", "    v.set_defaults(func=cmd_validate)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.580045, "o", "    r = sub.add_parser('revoke', help='revoke a stored token')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.580158, "o", "    r.add_argument('--type', choices=['access', 'refresh'], default='access')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.580255, "o", "    r.set_defaults(func=cmd_revoke)\r\n\u001b[?2004l\r"]
[70.580332, "o", "\u001b[?2004h> "]
[70.580355, "o", "    t = sub.add_parser('retry', help='re-acquire tokens if expired')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.58046, "o", "    t.add_argument('--username', default='admin')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.580553, "o", "    t.add_argument('--password', default='password123')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.580646, "o", "    t.set_defaults(func=cmd_retry)\r\n\u001b[?2004l\r"]
[70.580715, "o", "\u001b[?2004h>     args = p.parse_args()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.580807, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.580873, "o", ">         sys.exit(args.func(args))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.580968, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.581031, "o", "        log.exception('unhandled CLI error: %s', e)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.581102, "o", "        print('Error: %s' % e)\r\n\u001b[?2004l\r\u001b[?2004h>         sys.exit(2)\r\n\u001b[?2004l\r"]
[70.581127, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.581241, "o", "\u001b[?2004h> if __name__ == '__main__':"]
[70.581263, "o", "\r\n\u001b[?2004l\r"]
[70.581329, "o", "\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n"]
