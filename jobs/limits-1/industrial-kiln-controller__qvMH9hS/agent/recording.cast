[49.84129, "i", "cat > /app/kiln_firmware.py << 'EOF'\nimport json\nimport csv\n\n\ndef run_firing_cycle(schedule_path, specs_path):\n    with open(specs_path) as f:\n        specs = json.load(f)\n    G = float(specs[\"gas_burner_power_c\"])\n    D = float(specs[\"damper_cooling_c\"])\n    A = float(specs[\"ambient_loss_c\"])\n    with open(schedule_path) as f:\n        targets = [float(r[\"target_temp\"]) for r in csv.DictReader(f)]\n    n = len(targets)\n    B = 200\n    nodes = []  # (parent_node, gas, damper)\n    # beam entries: (cost, T, g_t, g_{t-1}, node_id)\n    beam = [(0.0, targets[0], 0, 0, -1)]\n    for t in range(n):\n        tgt = targets[t + 1] if t + 1 < n else targets[t]\n        cand = {}\n        for (c, T, g1, g2, nid) in beam:\n            K = G * (0.3 * g1 + 0.6 * g2)\n            for g in range(6):\n                for d in range(6):\n                    Tn = T + K + G * 0.1 * g - D * d - A\n                    if Tn < T - 5.0:\n                        continue\n                    nc = c + abs(Tn - tgt) + 0.002 * g\n                    key = (round(Tn, 2), g, g1)\n                    if key not in cand or nc < cand[key][0]:\n                        cand[key] = (nc, Tn, g, g1, nid, d)\n        items = sorted(cand.values(), key=lambda x: x[0])[:B]\n        newbeam = []\n        for (nc, Tn, g, g1, pid, d) in items:\n            nodes.append((pid, g, d))\n            newbeam.append((nc, Tn, g, g1, len(nodes) - 1))\n        beam = newbeam\n    best = min(beam, key=lambda x: x[0])\n    seq = []\n    nid = best[4]\n    while nid != -1:\n        pid, g, d = nodes[nid]\n        seq.append({\"gas\": int(g), \"damper\": int(d)})\n        nid = pid\n    seq.reverse()\n    return seq\n\n\nif __name__ == \"__main__\":\n    res = run_firing_cycle(\"/app/firing_schedule.csv\", \"/app/kiln_specs.json\")\n    print(len(res))\nEOF\npython3 -c \"\nimport json,csv\nfrom kiln_firmware import run_firing_cycle\nres=run_firing_cycle('/app/firing_schedule.csv','/app/kiln_specs.json')\ns=json.load(open('/app/kiln_specs.json'))\nG,D,A=s['gas_burner_power_c'],s['damper_cooling_c'],s['ambient_loss_c']\ntg=[float(r['target_temp']) for r in csv.DictReader(open('/app/firing_schedule.csv'))]\nT=tg[0]; g1=g2=0; err=0; maxdrop=0; gas=0\nfor t in range(len(tg)):\n    err+=abs(T-tg[t])\n    r=res[t]; g=r['gas']; d=r['damper']\n    assert 0<=g<=5 and 0<=d<=5\n    gas+=g\n    eff=0.1*g+0.3*g1+0.6*g2\n    Tn=T+G*eff-(d*D+A)\n    maxdrop=max(maxdrop,T-Tn)\n    T=Tn; g2=g1; g1=g\nprint('rows',len(res),'gas',gas,'err',round(err,2),'maxdrop',round(maxdrop,3))\nprint('PASS' if gas<2100 and err<400 and maxdrop<=5 else 'FAIL')\n\"\n"]
