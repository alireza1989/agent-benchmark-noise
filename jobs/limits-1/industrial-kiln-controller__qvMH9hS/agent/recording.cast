[24.733078, "i", "cat > /app/kiln_firmware.py << 'EOF'\nimport json\nimport csv\n\n\ndef run_firing_cycle(schedule_path, specs_path):\n    with open(specs_path) as f:\n        specs = json.load(f)\n    G = float(specs[\"gas_burner_power_c\"])\n    D = float(specs[\"damper_cooling_c\"])\n    A = float(specs[\"ambient_loss_c\"])\n    with open(schedule_path) as f:\n        targets = [float(r[\"target_temp\"]) for r in csv.DictReader(f)]\n    n = len(targets)\n    T = targets[0]\n    g1 = 0  # gas at t-1\n    g2 = 0  # gas at t-2\n    out = []\n    for t in range(n):\n        K = G * (0.3 * g1 + 0.6 * g2)\n        tgt = targets[t + 1] if t + 1 < n else targets[t]\n        best = None\n        for g in range(6):\n            for d in range(6):\n                Tn = T + K + G * 0.1 * g - D * d - A\n                if Tn < T - 5.0:\n                    continue\n                cost = abs(Tn - tgt) + 0.005 * g + 0.001 * d\n                if best is None or cost < best[0]:\n                    best = (cost, g, d, Tn)\n        if best is None:\n            g, d = 0, 0\n            Tn = T + K - A\n        else:\n            _, g, d, Tn = best\n        out.append({\"gas\": int(g), \"damper\": int(d)})\n        T = Tn\n        g2, g1 = g1, g\n    return out\n\n\nif __name__ == \"__main__\":\n    res = run_firing_cycle(\"/app/firing_schedule.csv\", \"/app/kiln_specs.json\")\n    print(len(res))\nEOF\n"]
[24.734769, "o", "cat > /app/kiln_firmware.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import csv\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
