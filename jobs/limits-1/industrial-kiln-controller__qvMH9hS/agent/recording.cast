[49.848872, "o", "s=json.load(open('/app/kiln_specs.json'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.848971, "o", "G,D,A=s['gas_burner_power_c'],s['damper_cooling_c'],s['ambient_loss_c']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.849108, "o", "tg=[float(r['target_temp']) for r in csv.DictReader(open('/app/firing_schedule.csv'))]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.849262, "o", "T=tg[0]; g1=g2=0; err=0; maxdrop=0; gas=0\r\n\u001b[?2004l\r\u001b[?2004h> for t in range(len(tg)):\r\n\u001b[?2004l\r\u001b[?2004h>     err+=abs(T-tg[t])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.849367, "o", "    r=res[t]; g=r['gas']; d=r['damper']\r\n\u001b[?2004l\r\u001b[?2004h>     assert 0<=g<=5 and 0<=d<=5\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.849454, "o", ">     gas+=g\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.849493, "o", "    eff=0.1*g+0.3*g1+0.6*g2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.849593, "o", "    Tn=T+G*eff-(d*D+A)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.849639, "o", "    maxdrop=max(maxdrop,T-Tn)\r\n\u001b[?2004l\r"]
[49.849711, "o", "\u001b[?2004h>     T=Tn; g2=g1; g1=g\r\n\u001b[?2004l\r"]
[49.849812, "o", "\u001b[?2004h> "]
[49.849869, "o", "print('rows',len(res),'gas',gas,'err',round(err,2),'maxdrop',round(maxdrop,3))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.849985, "o", "print('PASS' if gas<2100 and err<400 and maxdrop<=5 else 'FAIL')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.850062, "o", "\"\r\n\u001b[?2004l\r"]
[53.248351, "o", "rows 1000 gas 1630 err 170.61 maxdrop 0.8\r\nPASS\r\n"]
[53.251903, "o", "\u001b[?2004hroot@d44da5252d08:/app# "]
