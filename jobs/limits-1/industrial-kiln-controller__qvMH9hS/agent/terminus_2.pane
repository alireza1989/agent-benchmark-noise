[?2004l[?2004h> def run_firing_cycle(schedule_path, specs_path):
[?2004l[?2004h>     with open(specs_path) as f:
[?2004l[?2004h>         specs = json.load(f)
[?2004l[?2004h>     G = float(specs["gas_burner_power_c"])
[?2004l[?2004h>     D = float(specs["damper_cooling_c"])
[?2004l[?2004h>     A = float(specs["ambient_loss_c"])
[?2004l[?2004h>     with open(schedule_path) as f:
[?2004l[?2004h>         targets = [float(r["target_temp"]) for r in csv.DictReader(f)]
[?2004l[?2004h>     n = len(targets)
[?2004l[?2004h>     T = targets[0]
[?2004l[?2004h>     g1 = 0  # gas at t-1
[?2004l[?2004h>     g2 = 0  # gas at t-2
[?2004l[?2004h>     out = []
[?2004l[?2004h>     for t in range(n):
[?2004l[?2004h>         K = G * (0.3 * g1 + 0.6 * g2)
[?2004l[?2004h>         tgt = targets[t + 1] if t + 1 < n else targets[t]
[?2004l[?2004h>         best = None
[?2004l[?2004h>         for g in range(6):
[?2004l[?2004h>             for d in range(6):
[?2004l[?2004h>                 Tn = T + K + G * 0.1 * g - D * d - A
[?2004l[?2004h>                 if Tn < T - 5.0:
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 cost = abs(Tn - tgt) + 0.005 * g + 0.001 * d
[?2004l[?2004h>                 if best is None or cost < best[0]:
[?2004l[?2004h>                     best = (cost, g, d, Tn)
[?2004l[?2004h>         if best is None:
[?2004l[?2004h>             g, d = 0, 0
