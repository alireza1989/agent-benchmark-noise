[?2004l[?2004h>         else:
[?2004l[?2004h>             _, g, d, Tn = best
[?2004l[?2004h>         out.append({"gas": int(g), "damper": int(d)})
[?2004l[?2004h>         T = Tn
[?2004l[?2004h>         g2, g1 = g1, g
[?2004l[?2004h>     return out
