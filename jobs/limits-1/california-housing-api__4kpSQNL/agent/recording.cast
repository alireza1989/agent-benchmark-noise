[93.863449, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.863511, "o", "        'model_name': MODEL_NAME,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.863613, "o", "        'model_type': type(state['model']).__name__,\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.863648, "o", "> "]
[93.863715, "o", "        'features_count': 8,\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.863755, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[93.863817, "o", "\u001b[?2004h> @app.post('/predict-batch')"]
[93.863912, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.863938, "o", "def predict_batch(req: BatchRequest):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.864004, "o", "    preds = state['model'].predict(req.features_list)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.864031, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.86413, "o", "        'predictions': [float(p) for p in preds],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.864161, "o", "        'model_name': MODEL_NAME,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.864228, "o", "        'count': len(req.features_list),\r\n\u001b[?2004l\r"]
[93.864259, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.864316, "o", "EOF\r\n\u001b[?2004l\r"]
[93.865911, "o", "\u001b[?2004hroot@f83be0177232:/app# "]
[93.866042, "o", "cd /app && nohup python3 -m uvicorn api.app:app --host 0.0.0.0 --port 8000 > /app/output/server.log 2>&1 &\r\n\u001b[?2004l\r"]
[93.866153, "o", "[1] 202\r\n"]
[93.866213, "o", "\u001b[?2004hroot@f83be0177232:/app# "]
[93.8663, "o", "sleep 6 && curl -s http://localhost:8000/health\r\n\u001b[?2004l\r"]
[99.893865, "o", "{\"status\":\"healthy\",\"model_loaded\":true}"]
[99.894829, "o", "\u001b[?2004hroot@f83be0177232:/app# "]
[112.278786, "i", "cat > /app/api_test.py << 'EOF'\nimport json, pickle\nimport numpy as np\nimport pandas as pd\nimport requests\nfrom sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error\n\ndf = pd.read_csv('/app/data/train.csv').reset_index(drop=True)\nfeatures = [c for c in df.columns if c != 'target']\nsplit = json.load(open('/app/output/split_info.json'))\nva_idx = split['validation_indices']\nX_val = df.iloc[va_idx][features]\ny_val = df.iloc[va_idx]['target'].values\n\nrows = []\nfor i, (_, row) in enumerate(X_val.iterrows()):\n    r = requests.post('http://localhost:8000/predict', json={'features': [float(v) for v in row.values]})\n    r.raise_for_status()\n    rows.append({'sample_index': i, 'y_true': float(y_val[i]), 'y_pred': r.json()['prediction']})\n\nout = pd.DataFrame(rows)\nout['absolute_error'] = (out['y_true'] - out['y_pred']).abs()\nout.to_csv('/app/output/api_predictions.csv', index=False)\n\ny_true = out['y_true'].values\ny_pred = out['y_pred'].values\nmse = float(mean_squared_error(y_true, y_pred))\nmetrics = {\n"]
[112.279132, "i", "    'sample_count': int(len(out)),\n    'mae': float(mean_absolute_error(y_true, y_pred)),\n    'mse': mse,\n    'rmse': float(np.sqrt(mse)),\n    'r2_score': float(r2_score(y_true, y_pred)),\n}\njson.dump(metrics, open('/app/output/api_metrics.json', 'w'), indent=2)\nprint(metrics)\n\nmodel = pickle.load(open('/app/models/best_model.pkl', 'rb'))\ndirect = model.predict(X_val.values)\nprint('max abs diff API vs direct:', float(np.max(np.abs(direct - y_pred))))\nEOF\ncd /app && python3 api_test.py && head -3 /app/output/api_predictions.csv && cat /app/output/api_metrics.json\n"]
