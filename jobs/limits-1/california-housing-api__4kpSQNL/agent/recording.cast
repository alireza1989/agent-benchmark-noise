[27.587748, "i", "cat > /app/train.py << 'EOF'\nimport json, pickle\nimport numpy as np\nimport pandas as pd\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.linear_model import LinearRegression, Ridge\nfrom sklearn.ensemble import RandomForestRegressor\nfrom sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error\n\ndf = pd.read_csv('/app/data/train.csv').reset_index(drop=True)\nfeatures = [c for c in df.columns if c != 'target']\nX = df[features]\ny = df['target']\n\nidx = np.arange(len(df))\ntr_idx, va_idx = train_test_split(idx, test_size=0.2, random_state=42)\ntr_idx = sorted(int(i) for i in tr_idx)\nva_idx = sorted(int(i) for i in va_idx)\n\nsplit_info = {\n    'train_size': len(tr_idx),\n    'validation_size': len(va_idx),\n    'random_state': 42,\n    'test_size': 0.2,\n    'train_indices': tr_idx,\n    'validation_indices': va_idx,\n}\nwith open('/app/output/split_info.json', 'w') as f:\n    json.dump(split_info, f)\n\nX_train, y_train = X.iloc[tr_idx], y.iloc[tr_idx]\nX_val, y_val = X.iloc[va_idx], y.iloc[va_idx"]
[27.588067, "i", "]\n\nmodels = {\n    'linear_regression': LinearRegression(),\n    'ridge': Ridge(alpha=1.0, random_state=42),\n    'random_forest': RandomForestRegressor(n_estimators=100, random_state=42, n_jobs=-1),\n}\n\nresults = []\nfitted = {}\nfor name, model in models.items():\n    model.fit(X_train, y_train)\n    pred_tr = model.predict(X_train)\n    pred_va = model.predict(X_val)\n    mse = float(mean_squared_error(y_val, pred_va))\n    res = {\n        'model_name': name,\n        'train_r2': float(r2_score(y_train, pred_tr)),\n        'val_r2': float(r2_score(y_val, pred_va)),\n        'mae': float(mean_absolute_error(y_val, pred_va)),\n        'mse': mse,\n        'rmse': float(np.sqrt(mse)),\n    }\n    results.append(res)\n    fitted[name] = model\n    with open('/app/models/%s.pkl' % name, 'wb') as f:\n        pickle.dump(model, f)\n    print(res)\n\nbest = max(results, key=lambda r: r['val_r2'])\nbest_name = best['model_name']\nwith open('/app/models/best_model.pkl', 'wb') as f:\n    pickle.dump(fitted[best_name], f)\n\ncomparison = {'models"]
[27.588084, "o", "cat > /app/train.py << 'EOF'\r\n\u001b[?2004l\r"]
[27.5881, "i", "': results, 'best_model_name': best_name}\nwith open('/app/output/model_comparison.json', 'w') as f:\n    json.dump(comparison, f, indent=2)\nprint('best:', best_name)\nEOF\npython3 /app/train.py\n"]
