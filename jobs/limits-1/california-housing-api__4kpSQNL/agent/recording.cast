[93.859638, "i", "cat > /app/api/app.py << 'EOF'\nimport pickle\nfrom contextlib import asynccontextmanager\nfrom typing import List\n\nfrom fastapi import FastAPI\nfrom pydantic import BaseModel, conlist\n\nMODEL_PATH = '/app/models/best_model.pkl'\nMODEL_NAME = 'random_forest'\nstate = {'model': None}\n\n\n@asynccontextmanager\nasync def lifespan(app):\n    with open(MODEL_PATH, 'rb') as f:\n        state['model'] = pickle.load(f)\n    yield\n\n\napp = FastAPI(title='California Housing Price API', lifespan=lifespan)\n\n\nclass PredictRequest(BaseModel):\n    features: conlist(float, min_length=8, max_length=8)\n\n\nclass BatchRequest(BaseModel):\n    features_list: List[conlist(float, min_length=8, max_length=8)]\n\n\n@app.post('/predict')\ndef predict(req: PredictRequest):\n    pred = state['model'].predict([req.features])[0]\n    return {'prediction': float(pred), 'model_name': MODEL_NAME}\n\n\n@app.get('/health')\ndef health():\n    return {'status': 'healthy', 'model_loaded': state['model'] is not None}\n\n\n@app.get('/model-info')\ndef model_info():\n    return {"]
[93.861245, "o", "cat > /app/api/app.py << 'EOF'\r\n\u001b[?2004l\r"]
[93.861438, "i", "\n        'model_name': MODEL_NAME,\n        'model_type': type(state['model']).__name__,\n        'features_count': 8,\n    }\n\n\n@app.post('/predict-batch')\ndef predict_batch(req: BatchRequest):\n    preds = state['model'].predict(req.features_list)\n    return {\n        'predictions': [float(p) for p in preds],\n        'model_name': MODEL_NAME,\n        'count': len(req.features_list),\n    }\nEOF\ncd /app && nohup python3 -m uvicorn api.app:app --host 0.0.0.0 --port 8000 > /app/output/server.log 2>&1 &\nsleep 6 && curl -s http://localhost:8000/health\n"]
