[?2004l[?2004h>         'rmse': float(np.sqrt(mse)),
[?2004l[?2004h>     }
[?2004l[?2004h>     results.append(res)
[?2004l[?2004h>     fitted[name] = model
[?2004l[?2004h>     with open('/app/models/%s.pkl' % name, 'wb') as f:
[?2004l[?2004h>         pickle.dump(model, f)
[?2004l[?2004h>     print(res)
[?2004l[?2004h> 
[?2004l[?2004h> best = max(results, key=lambda r: r['val_r2'])
[?2004l[?2004h> best_name = best['model_name']
