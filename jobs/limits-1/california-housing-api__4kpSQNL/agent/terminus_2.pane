[?2004hroot@f83be0177232:/app# cat > /app/api/app.py << 'EOF'
[?2004l[?2004h> import pickle
[?2004l[?2004h> from contextlib import asynccontextmanager
[?2004l[?2004h> from typing import List
[?2004l[?2004h> 
[?2004l[?2004h> from fastapi import FastAPI
[?2004l[?2004h> from pydantic import BaseModel, conlist
[?2004l[?2004h> 
[?2004l[?2004h> MODEL_PATH = '/app/models/best_model.pkl'
[?2004l[?2004h> MODEL_NAME = 'random_forest'
[?2004l[?2004h> state = {'model': None}
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @asynccontextmanager
[?2004l[?2004h> async def lifespan(app):
[?2004l[?2004h>     with open(MODEL_PATH, 'rb') as f:
[?2004l[?2004h>         state['model'] = pickle.load(f)
[?2004l[?2004h>     yield
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> app = FastAPI(title='California Housing Price API', lifespan=lifespan)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> class PredictRequest(BaseModel):
[?2004l[?2004h>     features: conlist(float, min_length=8, max_length=8)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> class BatchRequest(BaseModel):
[?2004l[?2004h>     features_list: List[conlist(float, min_length=8, max_length=8)]
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @app.post('/predict')
[?2004l[?2004h> def predict(req: PredictRequest):
[?2004l[?2004h>     pred = state['model'].predict([req.features])[0]
[?2004l[?2004h>     return {'prediction': float(pred), 'model_name': MODEL_NAME}
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @app.get('/health')
[?2004l[?2004h> def health():
[?2004l[?2004h>     return {'status': 'healthy', 'model_loaded': state['model'] is not None}
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @app.get('/model-info')
[?2004l[?2004h> def model_info():
[?2004l[?2004h>     return {
[?2004l[?2004h>         'model_name': MODEL_NAME,
[?2004l[?2004h>         'model_type': type(state['model']).__name__,
[?2004l[?2004h>         'features_count': 8,
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @app.post('/predict-batch')
[?2004l[?2004h> def predict_batch(req: BatchRequest):
[?2004l[?2004h>     preds = state['model'].predict(req.features_list)
[?2004l[?2004h>     return {
[?2004l[?2004h>         'predictions': [float(p) for p in preds],
[?2004l[?2004h>         'model_name': MODEL_NAME,
[?2004l[?2004h>         'count': len(req.features_list),
[?2004l[?2004h>     }
