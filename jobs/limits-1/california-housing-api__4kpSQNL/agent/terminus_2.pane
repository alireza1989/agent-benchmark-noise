[?2004l[?2004h> split_info = {
[?2004l[?2004h>     'train_size': len(tr_idx),
[?2004l[?2004h>     'validation_size': len(va_idx),
[?2004l[?2004h>     'random_state': 42,
[?2004l[?2004h>     'test_size': 0.2,
[?2004l[?2004h>     'train_indices': tr_idx,
[?2004l[?2004h>     'validation_indices': va_idx,
[?2004l[?2004h> }
[?2004l[?2004h> with open('/app/output/split_info.json', 'w') as f:
[?2004l[?2004h>     json.dump(split_info, f)
