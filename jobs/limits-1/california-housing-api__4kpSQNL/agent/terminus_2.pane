[?2004l[?2004h> X_train, y_train = X.iloc[tr_idx], y.iloc[tr_idx]
[?2004l[?2004h> X_val, y_val = X.iloc[va_idx], y.iloc[va_idx]
[?2004l[?2004h> 
[?2004l[?2004h> models = {
[?2004l[?2004h>     'linear_regression': LinearRegression(),
[?2004l[?2004h>     'ridge': Ridge(alpha=1.0, random_state=42),
[?2004l[?2004h>     'random_forest': RandomForestRegressor(n_estimators=100, random_state=42, n_jobs=-1),
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = []
[?2004l[?2004h> fitted = {}
[?2004l[?2004h> for name, model in models.items():
[?2004l[?2004h>     model.fit(X_train, y_train)
[?2004l[?2004h>     pred_tr = model.predict(X_train)
[?2004l[?2004h>     pred_va = model.predict(X_val)
[?2004l[?2004h>     mse = float(mean_squared_error(y_val, pred_va))
[?2004l[?2004h>     res = {
[?2004l[?2004h>         'model_name': name,
[?2004l[?2004h>         'train_r2': float(r2_score(y_train, pred_tr)),
[?2004l[?2004h>         'val_r2': float(r2_score(y_val, pred_va)),
[?2004l[?2004h>         'mae': float(mean_absolute_error(y_val, pred_va)),
