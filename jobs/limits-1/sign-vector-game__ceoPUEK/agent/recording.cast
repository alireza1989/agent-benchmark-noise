[7.15342, "o", "\u001b[?2004hroot@d6b239fd3e02:/app# "]
[22.050195, "i", "cat > solve.py << 'EOF'\nimport math\nS = []\nwith open('signs.txt') as f:\n    for line in f:\n        p = line.split()\n        if p:\n            S.append([float(x) for x in p])\ny = [float(x) for x in open('sum.txt').read().split()]\nn = len(S)\nd = len(y)\n\ndef solve(idx):\n    k = len(idx)\n    G = [[sum(S[a][t] * S[b][t] for t in range(d)) for b in idx] for a in idx]\n    b = [sum(S[a][t] * y[t] for t in range(d)) for a in idx]\n    M = [G[i][:] + [b[i]] for i in range(k)]\n    for c in range(k):\n        p = max(range(c, k), key=lambda r: abs(M[r][c]))\n        M[c], M[p] = M[p], M[c]\n        if abs(M[c][c]) < 1e-12:\n            continue\n        for r in range(k):\n            if r != c:\n                f = M[r][c] / M[c][c]\n                for j in range(c, k + 1):\n                    M[r][j] -= f * M[c][j]\n    coef = [M[i][k] / M[i][i] for i in range(k)]\n    res = [y[t] - sum(coef[j] * S[idx[j]][t] for j in range(k)) for t in range(d)]\n    return coef, math.sqrt(sum(r * r for r in res)), res\n\nsel = []\nres = y[:]\nfor step in range(16):\n    best = None\n    bv = -1.0\n    for i in range(n):\n        if i in sel:\n            continue\n        v = abs(sum(S[i][t] * res[t] for t in range(d)))\n        if v > bv:\n            bv = v\n            best = i\n    sel.append(best)\n    coef, nr, res = solve(sel)\n    print(step + 1, best + 1, round(nr, 6), flush=True)\nfinal = sorted(i + 1 for i in sel)\nprint(final)\nprint('coefs', [round(c, 4) for c in coef])\nwith open('players.txt', 'w') as f:\n    for i in final:\n        f.write(str(i) + '\\n')\nEOF\n"]
