[?2004l[?2004h> import math
[?2004l[?2004h> S = []
[?2004l[?2004h> with open('signs.txt') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         p = line.split()
[?2004l[?2004h>         if p:
[?2004l[?2004h>             S.append([float(x) for x in p])
[?2004l[?2004h> y = [float(x) for x in open('sum.txt').read().split()]
[?2004l[?2004h> n = len(S)
[?2004l[?2004h> d = len(y)
[?2004l[?2004h> 
[?2004l[?2004h> def solve(idx):
[?2004l[?2004h>     k = len(idx)
[?2004l[?2004h>     G = [[sum(S[a][t] * S[b][t] for t in range(d)) for b in idx] for a in idx]
[?2004l[?2004h>     b = [sum(S[a][t] * y[t] for t in range(d)) for a in idx]
[?2004l[?2004h>     M = [G[i][:] + [b[i]] for i in range(k)]
[?2004l[?2004h>     for c in range(k):
[?2004l[?2004h>         p = max(range(c, k), key=lambda r: abs(M[r][c]))
[?2004l[?2004h>         M[c], M[p] = M[p], M[c]
[?2004l[?2004h>         if abs(M[c][c]) < 1e-12:
[?2004l[?2004h>             continue
[?2004l[?2004h>         for r in range(k):
[?2004l[?2004h>             if r != c:
[?2004l[?2004h>                 f = M[r][c] / M[c][c]
[?2004l[?2004h>                 for j in range(c, k + 1):
[?2004l[?2004h>                     M[r][j] -= f * M[c][j]
[?2004l[?2004h>     coef = [M[i][k] / M[i][i] for i in range(k)]
[?2004l[?2004h>     res = [y[t] - sum(coef[j] * S[idx[j]][t] for j in range(k)) for t in range(d)]
[?2004l[?2004h>     return coef, math.sqrt(sum(r * r for r in res)), res
[?2004l[?2004h> 
[?2004l[?2004h> sel = []
[?2004l[?2004h> res = y[:]
[?2004l[?2004h> for step in range(16):
[?2004l[?2004h>     best = None
[?2004l[?2004h>     bv = -1.0
[?2004l[?2004h>     for i in range(n):
[?2004l[?2004h>         if i in sel:
[?2004l[?2004h>             continue
[?2004l[?2004h>         v = abs(sum(S[i][t] * res[t] for t in range(d)))
[?2004l[?2004h>         if v > bv:
[?2004l[?2004h>             bv = v
[?2004l[?2004h>             best = i
[?2004l[?2004h>     sel.append(best)
[?2004l[?2004h>     coef, nr, res = solve(sel)
[?2004l[?2004h>     print(step + 1, best + 1, round(nr, 6), flush=True)
[?2004l[?2004h> final = sorted(i + 1 for i in sel)
[?2004l[?2004h> print(final)
[?2004l[?2004h> print('coefs', [round(c, 4) for c in coef])
