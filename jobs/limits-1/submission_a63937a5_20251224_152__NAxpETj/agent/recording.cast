[7.901092, "o", "cat /app/bandit; echo; which python3; python3 --version\r\n\u001b[?2004l\r"]
[7.90171, "o", "#!/bin/bash\r\nexec python3 /app/bandit.pyc \"$@\"\r\n"]
[7.901865, "o", "\r\n"]
[7.903305, "o", "/usr/local/bin/python3\r\n"]
[7.90657, "o", "Python 3.11.17\r\n"]
[7.906978, "o", "\u001b[?2004hroot@268f9a13b332:/app# "]
[21.783771, "i", "cat > /app/play.py << 'EOF'\nimport subprocess, sys, math\nfrom collections import deque\n\ndef play(seed, W=30, c=0.5):\n    p = subprocess.Popen(['/app/bandit', '--seed', str(seed)], stdin=subprocess.PIPE, stdout=subprocess.PIPE, universal_newlines=True, bufsize=1)\n    def readline():\n        return p.stdout.readline().strip()\n    hdr = readline()\n    while hdr != 'READY':\n        hdr = readline()\n    n = 10\n    windows = [deque(maxlen=W) for _ in range(n)]\n    done = None\n    while True:\n        line = readline()\n        if not line:\n            break\n        if line.startswith('DONE'):\n            done = line\n            break\n        if line.startswith('TURN'):\n            untried = [i for i in range(n) if len(windows[i]) == 0]\n            if untried:\n                arm = untried[0]\n            else:\n                total = sum(len(w) for w in windows)\n                best, besti = -1e9, 0\n                for i in range(n):\n                    m = sum(windows[i]) / len(windows[i])\n                    bonus = c * math.sqrt(2 * math.log(min(total, W * n) + 1) / len(windows[i]))\n                    v = m + bonus\n                    if v > best:\n                        best, besti = v, i\n                arm = besti\n            p.stdin.write(str(arm) + chr(10))\n            p.stdin.flush()\n            rline = readline()\n            r = float(rline.split()[1])\n            windows[arm].append(r)\n    p.stdin.close()\n    p.wait()\n    return done\n\nif __name__ == '__main__':\n    print(play(int(sys.argv[1])))\nEOF\npython3 /app/play.py 42\n"]
[21.784063, "o", "cat > /app/play.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[21.78417, "o", "> import subprocess, sys, math\r\n\u001b[?2004l\r\u001b[?2004h"]
