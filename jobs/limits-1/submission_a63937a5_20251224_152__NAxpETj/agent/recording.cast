[56.662896, "i", "python3 /app/play.py 42 > /tmp/r42.txt && python3 /app/play.py 43 > /tmp/r43.txt && python3 /app/play.py 44 > /tmp/r44.txt && cat /tmp/r42.txt /tmp/r43.txt /tmp/r44.txt && python3 -c \"import re;vals=[re.findall(r'total_reward=([-\\d.]+) oracle_reward=([-\\d.]+) regret=([-\\d.]+)',open(f'/tmp/r{s}.txt').read())[0] for s in (42,43,44)];tr=sum(float(v[0]) for v in vals)/3;rg=sum(float(v[2]) for v in vals)/3;open('/app/answer.txt','w').write(f'total_reward={tr:.3f}\\nregret={rg:.3f}\\n')\" && cat /app/answer.txt\n"]
