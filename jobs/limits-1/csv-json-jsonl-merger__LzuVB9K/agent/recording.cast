[37.049448, "i", "python3 -c \"import json,csv,collections; u=list(csv.DictReader(open('/workspace/users.csv'))); print('users rows',len(u),'blank email',sum(1 for x in u if not x['email'].strip())); print('users emails',len({x['email'].strip().lower() for x in u if x['email'].strip()})); r=[json.loads(l) for l in open('/workspace/records.jsonl') if l.strip()]; print('records rows',len(r),'emails',len({x.get('email','').lower() for x in r if x.get('email')}), 'keys',sorted({k for x in r for k in x})); p=json.load(open('/workspace/profiles.json')); print('profiles type',type(p).__name__,'n',len(p)); vals=list(p.values()) if isinstance(p,dict) else p; print('profile keys',sorted({k for v in vals for k in v})); print('profile other_info keys',sorted({k for v in vals for k in (v.get('other_info') or {})})); print('profiles missing email',sum(1 for v in vals if not v.get('email')))\"\n"]
[37.050521, "o", "python3 -c \"import json,csv,collections; u=list(csv.DictReader(open('/workspace/users.csv'))); print('users rows',len(u),'blank email',sum(1 for x in u if not x['email'].strip())); print('users emails',len({x['email'].strip().lower() for x in u if x['email'].strip()})); r=[json.loads(l) for l in open('/workspace/records.jsonl') if l.strip()]; print('records rows',len(r),'emails',len({x.get('email','').lower() for x in r if x.get('email')}), 'keys',sorted({k for x in r for k in x})); p=json.load(open('/workspace/profiles.json')); print('profiles type',type(p).__name__,'n',len(p)); vals=list(p.values()) if isinstance(p,dict) else p; print('profile keys',sorted({k for v in vals for k in v})); print('profile other_info keys',sorted({k for v in vals for k in (v.get('other_info') or {})})); print('profiles missing email',sum(1 for v in vals if not v.get('email')))\""]
