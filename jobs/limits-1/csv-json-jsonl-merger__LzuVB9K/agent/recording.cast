[43.267107, "i", "python3 -c \"import json,csv; u={x['email'].strip().lower() for x in csv.DictReader(open('/workspace/users.csv')) if x['email'].strip()}; r={json.loads(l)['email'].strip().lower() for l in open('/workspace/records.jsonl') if l.strip()}; p=json.load(open('/workspace/profiles.json')); pe={v['email'].strip().lower() for v in p.values()}; out={x['email'].lower() for x in csv.DictReader(open('/workspace/merged_records.csv'))}; un=u|r|pe; print('union',len(un),'output',len(out),'match',un==out); print('in_multiple', sorted(e for e in un if [e in u, e in r, e in pe].count(True)>1))\"\n"]
[43.268095, "o", "python3 -c \"import json,csv; u={x['email'].strip().lower() for x in csv.DictReader(open('/workspace/users.csv')) if x['email'].strip()}; r={json.loads(l)['email'].strip().lower() for l in open('/workspace/records.jsonl') if l.strip()}; p=json.load(open('/workspace/profiles.json')); pe={v['email'].strip().lower() for v in p.values()}; out={x['email'].lower() for x in csv.DictReader(open('/workspace/merged_records.csv'))}; un=u|r|pe; print('union',len(un),'output',len(out),'match',un==out); print('in_multiple', sorted(e for e in un if [e in u, e in r, e in pe].count(True)>1))\"\r\n\u001b[?2004l\r"]
