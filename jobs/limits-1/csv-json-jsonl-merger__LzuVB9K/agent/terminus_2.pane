[?2004hroot@c2b781e08677:/workspace# cat > /workspace/do_merge.py << 'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> import csv
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> USERS = '/workspace/users.csv'
[?2004l[?2004h> RECORDS = '/workspace/records.jsonl'
[?2004l[?2004h> PROFILES = '/workspace/profiles.json'
[?2004l[?2004h> OUT = '/workspace/merged_records.csv'
[?2004l[?2004h> 
[?2004l[?2004h> merged = {}
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def clean(v):
[?2004l[?2004h>     if v is None:
[?2004l[?2004h>         return None
[?2004l[?2004h>     if isinstance(v, float) and pd.isna(v):
[?2004l[?2004h>         return None
[?2004l[?2004h>     s = str(v).strip()
[?2004l[?2004h>     return s if s and s.lower() != 'nan' else None
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def add(email, phone=None, status=None):
[?2004l[?2004h>     email = clean(email)
[?2004l[?2004h>     if not email:
[?2004l[?2004h>         return
[?2004l[?2004h>     key = email.lower()
[?2004l[?2004h>     rec = merged.setdefault(key, {'email': email, 'phone': None, 'status': None})
[?2004l[?2004h>     if rec['phone'] is None and clean(phone):
[?2004l[?2004h>         rec['phone'] = clean(phone)
[?2004l[?2004h>     if rec['status'] is None and clean(status):
[?2004l[?2004h>         rec['status'] = clean(status)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> # users.csv
[?2004l[?2004h> df = pd.read_csv(USERS, dtype=str, keep_default_na=False)
[?2004l[?2004h> for _, row in df.iterrows():
[?2004l[?2004h>     add(row.get('email'), row.get('phone'), row.get('status'))
[?2004l[?2004h> 
[?2004l[?2004h> # records.jsonl
[?2004l[?2004h> with open(RECORDS, encoding='utf-8') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line = line.strip()
[?2004l[?2004h>         if not line:
[?2004l[?2004h>             continue
[?2004l[?2004h>         obj = json.loads(line)
[?2004l[?2004h>         other = obj.get('other_info') or {}
[?2004l[?2004h>         phone = obj.get('phone') or other.get('phone')
[?2004l[?2004h>         add(obj.get('email'), phone, obj.get('status'))
[?2004l[?2004h> 
[?2004l[?2004h> # profiles.json
[?2004l[?2004h> with open(PROFILES, encoding='utf-8') as f:
[?2004l[?2004h>     profiles = json.load(f)
[?2004l[?2004h> if isinstance(profiles, dict):
[?2004l[?2004h>     items = [(k, v) for k, v in profiles.items()]
[?2004l[?2004h> else:
[?2004l[?2004h>     items = [(None, v) for v in profiles]
[?2004l[?2004h> for key, p in items:
[?2004l[?2004h>     if not isinstance(p, dict):
[?2004l[?2004h>         continue
[?2004l[?2004h>     other = p.get('other_info') or {}
[?2004l[?2004h>     phone = p.get('phone') or other.get('phone')
[?2004l[?2004h>     add(p.get('email') or key, phone, p.get('status'))
[?2004l[?2004h> 
[?2004l[?2004h> with open(OUT, 'w', newline='', encoding='utf-8') as f:
[?2004l[?2004h>     writer = csv.writer(f)
[?2004l[?2004h>     writer.writerow(['email', 'phone', 'status'])
[?2004l[?2004h>     for key in sorted(merged):
[?2004l[?2004h>         r = merged[key]
[?2004l[?2004h>         writer.writerow([r['email'], r['phone'] or '', r['status'] or ''])
[?2004l[?2004h> 
[?2004l[?2004h> print('Wrote %d records to %s' % (len(merged), OUT))
