[55.627491, "i", "cat > /app/run.py << 'EOF'\nimport pandas as pd, numpy as np, json, math\nimp = pd.read_csv('/app/data/impressions.csv')\nconv = pd.read_csv('/app/data/conversions.csv')\ntc = pd.read_csv('/app/data/test_contexts.csv')\nmeta = json.load(open('/app/data/arms_metadata.json'))\nnarms = len(meta['arms'])\nd = conv.delay_hours.values\nd = d[d > 0]\nld = np.log(d)\nmu = float(ld.mean())\nsg = float(ld.std(ddof=0))\ncutoff = float(max(imp.timestamp.max(), conv.conversion_timestamp.max()))\nerf = np.vectorize(math.erf)\ndef F(x):\n    x = np.clip(x, 1e-6, 72.0)\n    return 0.5 * (1 + erf((np.log(x) - mu) / (sg * np.sqrt(2))))\nm = imp.merge(conv[['impression_id', 'delay_hours', 'conversion_value']], on='impression_id', how='left')\nm['conv'] = m.delay_hours.notna().astype(float)\nm['val'] = m.conversion_value\nwin = (cutoff - m.timestamp.astype(float)) / 3600.0\nm['p'] = F(win.values)\nm['biz'] = ((m.hour_of_day >= 9) & (m.hour_of_day <= 17)).astype(int)\ntc['biz'] = ((tc.hour_of_day >= 9) & (tc.hour_of_day <= 17)).astype(int)\nprint('cutof"]
[55.628585, "o", "cat > /app/run.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd, numpy as np, json, math\r\n\u001b[?2004l\r\u001b[?2004h> imp = pd.read_csv('/app/data/impressions.csv')\r\n\u001b[?2004l\r\u001b[?2004h> conv = pd.read_csv('/app/data/conversions.csv')\r\n\u001b[?2004l\r\u001b[?2004h> tc = pd.read_csv('/app/data/test_contexts.csv')\r\n\u001b[?2004l\r"]
[55.628713, "i", "f', cutoff, 'mu', mu, 'sigma', sg)\ndef grp(cols):\n    return m.groupby(cols).agg(c=('conv', 'sum'), f=('p', 'sum')).reset_index()\nK = 200.0\ng1 = grp(['arm_id'])\ng1['r'] = g1.c / g1.f\nr1 = dict(zip(g1.arm_id, g1.r))\ng2 = grp(['arm_id', 'user_segment', 'device_type'])\ng2['prior'] = g2.arm_id.map(r1)\ng2['r'] = (g2.c + K * g2.prior) / (g2.f + K)\ng3 = grp(['arm_id', 'user_segment', 'device_type', 'biz'])\ng3 = g3.merge(g2[['arm_id', 'user_segment', 'device_type', 'r']].rename(columns={'r': 'prior'}), on=['arm_id', 'user_segment', 'device_type'], how='left')\ng3['r'] = (g3.c + K * g3.prior) / (g3.f + K)\narms = pd.DataFrame({'arm_id': range(narms)})\nctx = tc.merge(arms, how='cross')\nctx = ctx.merge(g3[['arm_id', 'user_segment', 'device_type', 'biz', 'r', 'f']].rename(columns={'r': 'r3', 'f': 'f3'}), on=['arm_id', 'user_segment', 'device_type', 'biz'], how='left')\nctx = ctx.merge(g2[['arm_id', 'user_segment', 'device_type', 'r', 'f']].rename(columns={'r': 'r2', 'f': 'f2'}), on=['arm_id', 'user_segment', 'device_type'],"]
[55.628764, "o", "\u001b[?2004h> "]
[55.628935, "i", " how='left')\nctx['rate'] = ctx.r3.fillna(ctx.r2).fillna(ctx.arm_id.map(r1))\nctx['f_use'] = ctx.f3.fillna(ctx.f2).fillna(1.0)\navgval = m[m.conv == 1].groupby('arm_id').val.mean()\nctx['val'] = ctx.arm_id.map(avgval)\nctx['ev'] = ctx.rate * ctx.val\nctx['se'] = np.sqrt(ctx.rate * (1 - ctx.rate) / ctx.f_use.clip(lower=1.0))\nz = 1.2815515655\nctx['lo'] = np.maximum(0.0, ctx.rate - z * ctx.se) * ctx.val\nctx['hi'] = (ctx.rate + z * ctx.se) * ctx.val\nbest = ctx.sort_values('ev', ascending=False).drop_duplicates('context_id')\nbest = best.set_index('context_id').loc[tc.context_id].reset_index()\nout = pd.DataFrame({'context_id': best.context_id, 'selected_arm': best.arm_id.astype(int), 'expected_reward': best.ev, 'confidence_lower': best.lo, 'confidence_upper': best.hi})\nout.to_csv('/app/output/predictions.csv', index=False)\nast = pd.DataFrame({'arm_id': range(narms)})\nast['estimated_conversion_rate'] = ast.arm_id.map(r1)\nast['estimated_avg_value'] = ast.arm_id.map(avgval)\nast['total_impressions'] = ast.arm_id.map(m.groupb"]
[55.628973, "o", "meta = json.load(open('/app/data/arms_metadata.json'))"]
[55.628991, "i", "y('arm_id').size()).astype(int)\nast['total_conversions'] = ast.arm_id.map(m.groupby('arm_id').conv.sum()).astype(int)\nast.to_csv('/app/output/arm_statistics.csv', index=False)\ntot_c = float(m.conv.sum())\ntot_f = float(m.p.sum())\ndm = {'distribution_type': 'lognormal', 'parameters': {'mu': mu, 'sigma': sg}, 'median_delay_hours': math.exp(mu), 'p90_delay_hours': math.exp(mu + z * sg), 'conversion_rate_estimate': tot_c / tot_f}\njson.dump(dm, open('/app/output/delay_model.json', 'w'), indent=2)\nprint(ast.to_string())\nprint(json.dumps(dm, indent=2))\nprint(out.shape, out.selected_arm.value_counts().to_dict())\nprint(out.isna().sum().to_dict())\nEOF\npython3 /app/run.py && head -3 /app/output/predictions.csv && wc -l /app/output/predictions.csv\n"]
