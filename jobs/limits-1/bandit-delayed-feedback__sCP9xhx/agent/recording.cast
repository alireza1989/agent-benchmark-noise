[11.933338, "i", "python3 -c \"import pandas as pd, numpy as np; imp=pd.read_csv('/app/data/impressions.csv'); conv=pd.read_csv('/app/data/conversions.csv'); tc=pd.read_csv('/app/data/test_contexts.csv'); print(imp.shape, conv.shape, tc.shape); print('imp ts', imp.timestamp.min(), imp.timestamp.max()); print('test ts', tc.timestamp.min(), tc.timestamp.max()); print(conv.delay_hours.describe()); d=np.log(conv.delay_hours[conv.delay_hours>0]); print('mu',d.mean(),'sigma',d.std(ddof=0)); print(conv.conversion_value.describe()); print('dup imp in conv', conv.impression_id.duplicated().sum()); print('conv not in imp', (~conv.impression_id.isin(imp.impression_id)).sum()); m=imp.merge(conv[['impression_id','conversion_value']], on='impression_id', how='left'); m['conv']=m.conversion_value.notna(); g=m.groupby('arm_id').agg(n=('conv','size'), rate=('conv','mean'), val=('conversion_value','mean')); print(g); print(imp.arm_id.value_counts().sort_index()); print(imp.user_segment.value_counts(), imp.device_type.value_counts())\"\n"]
[11.936918, "o", "python3 -c \"import pandas as pd, numpy as np; imp=pd.read_csv('/app/data/impressions.csv'); conv=pd.read_csv('/app/data/conversions.csv'); tc=pd.read_csv('/app/data/test_contexts.csv'); print(imp.shape, conv.shape, tc.shape); print('imp ts', imp.timestamp.min(), imp.timestamp.max()); print('test ts', tc.timestamp.min(), tc.timestamp.max()); print(conv.delay_hours.describe()); d=np.log(conv.delay_hours[conv.delay_hours>0]); print('mu',d.mean(),'sigma',d.std(ddof=0)); print(conv.conversion_value.describe()); print('dup imp in conv', conv.impression_id.duplicated().sum()); print('conv not in imp', (~conv.impression_id.isin(imp.impression_id)).sum()); m=imp.merge(conv[['impression_id','conversion_value']], on='impression_id', how='left'); m['conv']=m.conversion_value.notna(); g=m.groupby('arm_id').agg(n=('conv','size'), rate=('conv','mean'), val=('conversion_value','mean')); print(g); print(imp.arm_id.value_counts().sort_index()); print(imp.user_segment.value_counts(), imp.device_type.value_counts())\"\r\n\u001b[?2004l\r"]
