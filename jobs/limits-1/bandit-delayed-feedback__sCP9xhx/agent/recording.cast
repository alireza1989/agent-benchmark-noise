[55.636673, "o", "z = 1.2815515655\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.636903, "o", "ctx['lo'] = np.maximum(0.0, ctx.rate - z * ctx.se) * ctx.val\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.6371, "o", "ctx['hi'] = (ctx.rate + z * ctx.se) * ctx.val\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.637246, "o", "best = ctx.sort_values('ev', ascending=False).drop_duplicates('context_id')\r\n\u001b[?2004l\r"]
[55.637317, "o", "\u001b[?2004h> "]
[55.637431, "o", "best = best.set_index('context_id').loc[tc.context_id].reset_index()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.637796, "o", "out = pd.DataFrame({'context_id': best.context_id, 'selected_arm': best.arm_id.astype(int), 'expected_reward': best.ev, 'confidence_lower': best.lo, 'confidence_upper': best.hi})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.637918, "o", "out.to_csv('/app/output/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.637995, "o", "> "]
[55.638144, "o", "ast = pd.DataFrame({'arm_id': range(narms)})\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.638251, "o", "> "]
[55.638361, "o", "ast['estimated_conversion_rate'] = ast.arm_id.map(r1)\r\n\u001b[?2004l\r"]
[55.638508, "o", "\u001b[?2004h> "]
[55.638597, "o", "ast['estimated_avg_value'] = ast.arm_id.map(avgval)\r\n\u001b[?2004l\r"]
[55.638712, "o", "\u001b[?2004h> "]
[55.638868, "o", "ast['total_impressions'] = ast.arm_id.map(m.groupby('arm_id').size()).astype(int)\r\n\u001b[?2004l\r"]
[55.638894, "o", "\u001b[?2004h"]
[55.638979, "o", "> "]
[55.63915, "o", "ast['total_conversions'] = ast.arm_id.map(m.groupby('arm_id').conv.sum()).astype(int)"]
[55.639215, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.639319, "o", "ast.to_csv('/app/output/arm_statistics.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.639407, "o", "> "]
[55.639506, "o", "tot_c = float(m.conv.sum())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.639534, "o", "tot_f = float(m.p.sum())"]
[55.639644, "o", "\r\n"]
[55.639768, "o", "\u001b[?2004l\r"]
[55.639792, "o", "\u001b[?2004h> "]
[55.640128, "o", "dm = {'distribution_type': 'lognormal', 'parameters': {'mu': mu, 'sigma': sg}, 'median_delay_hours': math.exp(mu), 'p90_delay_hours': math.exp(mu + z * sg), 'conversion_rate_estimate': tot_c / tot_f}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.64027, "o", "json.dump(dm, open('/app/output/delay_model.json', 'w'), indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> print(ast.to_string())\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.640288, "o", "> "]
[55.640336, "o", "print(json.dumps(dm, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.640403, "o", "print(out.shape, out.selected_arm.value_counts().to_dict())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.640458, "o", "print(out.isna().sum().to_dict())\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
