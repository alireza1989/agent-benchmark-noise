[?2004hroot@ca768b2521b4:/app# cat > /app/run.py << 'EOF'
[?2004l[?2004h> import pandas as pd, numpy as np, json, math
[?2004l[?2004h> imp = pd.read_csv('/app/data/impressions.csv')
[?2004l[?2004h> conv = pd.read_csv('/app/data/conversions.csv')
[?2004l[?2004h> tc = pd.read_csv('/app/data/test_contexts.csv')
[?2004l[?2004h> meta = json.load(open('/app/data/arms_metadata.json'))
[?2004l[?2004h> narms = len(meta['arms'])
[?2004l[?2004h> d = conv.delay_hours.values
[?2004l[?2004h> d = d[d > 0]
[?2004l[?2004h> ld = np.log(d)
[?2004l[?2004h> mu = float(ld.mean())
[?2004l[?2004h> sg = float(ld.std(ddof=0))
[?2004l[?2004h> cutoff = float(max(imp.timestamp.max(), conv.conversion_timestamp.max()))
[?2004l[?2004h> erf = np.vectorize(math.erf)
[?2004l[?2004h> def F(x):
[?2004l[?2004h>     x = np.clip(x, 1e-6, 72.0)
[?2004l[?2004h>     return 0.5 * (1 + erf((np.log(x) - mu) / (sg * np.sqrt(2))))
[?2004l[?2004h> m = imp.merge(conv[['impression_id', 'delay_hours', 'conversion_value']], on='impression_id', how='left')
[?2004l[?2004h> m['conv'] = m.delay_hours.notna().astype(float)
[?2004l[?2004h> m['val'] = m.conversion_value
[?2004l[?2004h> win = (cutoff - m.timestamp.astype(float)) / 3600.0
[?2004l[?2004h> m['p'] = F(win.values)
[?2004l[?2004h> m['biz'] = ((m.hour_of_day >= 9) & (m.hour_of_day <= 17)).astype(int)
[?2004l[?2004h> tc['biz'] = ((tc.hour_of_day >= 9) & (tc.hour_of_day <= 17)).astype(int)
[?2004l[?2004h> print('cutoff', cutoff, 'mu', mu, 'sigma', sg)
[?2004l[?2004h> def grp(cols):
[?2004l[?2004h>     return m.groupby(cols).agg(c=('conv', 'sum'), f=('p', 'sum')).reset_index()
[?2004l[?2004h> K = 200.0
[?2004l[?2004h> g1 = grp(['arm_id'])
[?2004l[?2004h> g1['r'] = g1.c / g1.f
[?2004l[?2004h> r1 = dict(zip(g1.arm_id, g1.r))
[?2004l[?2004h> g2 = grp(['arm_id', 'user_segment', 'device_type'])
[?2004l[?2004h> g2['prior'] = g2.arm_id.map(r1)
[?2004l[?2004h> g2['r'] = (g2.c + K * g2.prior) / (g2.f + K)
[?2004l[?2004h> g3 = grp(['arm_id', 'user_segment', 'device_type', 'biz'])
[?2004l[?2004h> g3 = g3.merge(g2[['arm_id', 'user_segment', 'device_type', 'r']].rename(columns={'r': 'prior'}), on=['arm_id', 'user_segment', 'device_type'], how='left')
[?2004l[?2004h> g3['r'] = (g3.c + K * g3.prior) / (g3.f + K)
[?2004l[?2004h> arms = pd.DataFrame({'arm_id': range(narms)})
[?2004l[?2004h> ctx = tc.merge(arms, how='cross')
[?2004l[?2004h> ctx = ctx.merge(g3[['arm_id', 'user_segment', 'device_type', 'biz', 'r', 'f']].rename(columns={'r': 'r3', 'f': 'f3'}), on=['arm_id', 'user_segment', 'device_type', 'biz'], how='left')
[?2004l[?2004h> ctx = ctx.merge(g2[['arm_id', 'user_segment', 'device_type', 'r', 'f']].rename(columns={'r': 'r2', 'f': 'f2'}), on=['arm_id', 'user_segment', 'device_type'], how='left')
[?2004l[?2004h> ctx['rate'] = ctx.r3.fillna(ctx.r2).fillna(ctx.arm_id.map(r1))
[?2004l[?2004h> ctx['f_use'] = ctx.f3.fillna(ctx.f2).fillna(1.0)
[?2004l[?2004h> avgval = m[m.conv == 1].groupby('arm_id').val.mean()
[?2004l[?2004h> ctx['val'] = ctx.arm_id.map(avgval)
[?2004l[?2004h> ctx['ev'] = ctx.rate * ctx.val
[?2004l[?2004h> ctx['se'] = np.sqrt(ctx.rate * (1 - ctx.rate) / ctx.f_use.clip(lower=1.0))
[?2004l[?2004h> z = 1.2815515655
[?2004l[?2004h> ctx['lo'] = np.maximum(0.0, ctx.rate - z * ctx.se) * ctx.val
[?2004l[?2004h> ctx['hi'] = (ctx.rate + z * ctx.se) * ctx.val
[?2004l[?2004h> best = ctx.sort_values('ev', ascending=False).drop_duplicates('context_id')
[?2004l[?2004h> best = best.set_index('context_id').loc[tc.context_id].reset_index()
[?2004l[?2004h> out = pd.DataFrame({'context_id': best.context_id, 'selected_arm': best.arm_id.astype(int), 'expected_reward': best.ev, 'confidence_lower': best.lo, 'confidence_upper': best.hi})
[?2004l[?2004h> out.to_csv('/app/output/predictions.csv', index=False)
[?2004l[?2004h> ast = pd.DataFrame({'arm_id': range(narms)})
[?2004l[?2004h> ast['estimated_conversion_rate'] = ast.arm_id.map(r1)
[?2004l[?2004h> ast['estimated_avg_value'] = ast.arm_id.map(avgval)
[?2004l[?2004h> ast['total_impressions'] = ast.arm_id.map(m.groupby('arm_id').size()).astype(int)
[?2004l[?2004h> ast['total_conversions'] = ast.arm_id.map(m.groupby('arm_id').conv.sum()).astype(int)
[?2004l[?2004h> ast.to_csv('/app/output/arm_statistics.csv', index=False)
[?2004l[?2004h> tot_c = float(m.conv.sum())
[?2004l[?2004h> tot_f = float(m.p.sum())
[?2004l[?2004h> dm = {'distribution_type': 'lognormal', 'parameters': {'mu': mu, 'sigma': sg}, 'median_delay_hours': math.exp(mu), 'p90_delay_hours': math.exp(mu + z * sg), 'conversion_rate_estimate': tot_c / tot_f}
[?2004l[?2004h> json.dump(dm, open('/app/output/delay_model.json', 'w'), indent=2)
[?2004l[?2004h> print(ast.to_string())
[?2004l[?2004h> print(json.dumps(dm, indent=2))
[?2004l[?2004h> print(out.shape, out.selected_arm.value_counts().to_dict())
