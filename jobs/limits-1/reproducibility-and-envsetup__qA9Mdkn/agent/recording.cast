[26.155179, "i", "cat > /app/work/repro.sh <<'EOF'\n#!/usr/bin/env bash\nset -euo pipefail\n\nPROJ=/app/work/project\nmkdir -p /output/run1 /output/run2\n\nrm -rf /tmp/repro-venv1 /tmp/repro-venv2\npython3 -m venv /tmp/repro-venv1\npython3 -m venv /tmp/repro-venv2\nVENV1=/tmp/repro-venv1\nVENV2=/tmp/repro-venv2\n\n\"$VENV1/bin/python\" -m pip install --quiet -r \"$PROJ/requirements.txt\"\n\"$VENV2/bin/python\" -m pip install --quiet -r \"$PROJ/requirements.txt\"\n\ncd \"$PROJ\"\nOUTPUT_PATH=/output/run1/model.npy \"$VENV1/bin/python\" train.py\nOUTPUT_PATH=/output/run2/model.npy \"$VENV2/bin/python\" train.py\n\n\"$VENV1/bin/python\" /app/work/write_hashes.py\nEOF\nchmod +x /app/work/repro.sh && cat /app/work/project/env.lock.json /app/work/project/requirements.txt\n"]
