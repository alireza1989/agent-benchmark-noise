[23.887981, "o", "\u001b[?2004hroot@29eed6c626fb:/app/work/project# "]
[25.660721, "i", "cat > /app/work/write_hashes.py <<'EOF'\nimport hashlib, json, platform\nimport numpy\nP = '/app/work/project'\n\ndef sha(p):\n    return hashlib.sha256(open(p, 'rb').read()).hexdigest()\n\nr1 = sha('/output/run1/model.npy')\nr2 = sha('/output/run2/model.npy')\nout = {\n    'run1': r1,\n    'run2': r2,\n    'match': r1 == r2,\n    'python_version': platform.python_version(),\n    'numpy_version': numpy.__version__,\n    'train_script_sha256': sha(P + '/train.py'),\n    'env_lock_sha256': sha(P + '/env.lock.json'),\n    'requirements_sha256': sha(P + '/requirements.txt'),\n}\nwith open('/output/hashes.json', 'w') as f:\n    json.dump(out, f, indent=2)\nprint(json.dumps(out, indent=2))\nEOF\n"]
[25.660965, "o", "cat > /app/work/write_hashes.py <<'EOF'\r\n\u001b[?2004l\r"]
