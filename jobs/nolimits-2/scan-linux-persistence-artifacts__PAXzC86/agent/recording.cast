[100.314048, "i", "cat > /app/scan_persistence.sh <<'EOF'\n#!/bin/bash\n# scan_persistence.sh - read-only scanner for Linux persistence artifacts.\n# Writes a JSON report to /app/persistence_report.json. Always exits 0.\n\nOUT=/app/persistence_report.json\nWHITELIST=/app/ssh_known_keys.txt\nTMP=$(mktemp -d 2>/dev/null) || TMP=/tmp/scan_persistence.$$\nmkdir -p \"$TMP\" 2>/dev/null\ntrap 'rm -rf \"$TMP\"' EXIT\nREC=\"$TMP/records.jsonl\"\n: > \"$REC\"\nOWNED=\"$TMP/owned.txt\"\ncat /var/lib/dpkg/info/*.list 2>/dev/null | sort -u > \"$OWNED\"\nBASES=(\"\")\nif [ -d /app_target ]; then BASES=(/app_target \"\"); fi\n\nsha_of() {\n  sha256sum -- \"$1\" 2>/dev/null | cut -c1-64\n}\n\ntrim() {\n  local s=\"$1\"\n  s=\"${s#\"${s%%[![:space:]]*}\"}\"\n  s=\"${s%\"${s##*[![:space:]]}\"}\"\n  printf '%s' \"$s\"\n}\n\nemit() {\n  jq -c -n --arg type \"$1\" --arg path \"$2\" --arg sha \"$3\" --arg line \"$4\" --arg preview \"$5\" --arg user \"$6\" '{type: $type, path: $path, sha256: $sha, details: {line_number: (if $line == \"\" then null else ($line | tonumber) end), content_preview: $preview, user: (if $user ="]
[100.315942, "o", "cat > /app/scan_persistence.sh <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #!/bin/bash\r\n\u001b[?2004l\r\u001b[?2004h> # scan_persistence.sh - read-only scanner for Linux persistence artifacts.\r\n\u001b[?2004l\r\u001b[?2004h> # Writes a JSON report to /app/persistence_report.json. Always exits 0.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> OUT=/app/persistence_report.json\r\n\u001b[?2004l\r\u001b[?2004h> WHITELIST=/app/ssh_known_keys.txt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.318582, "i", "= \"\" then null else $user end)}}' >> \"$REC\" 2>/dev/null\n}\n\ncron_suspicious() {\n  local l=\"$1\" tok\n  if printf '%s' \"$l\" | grep -Eq '/tmp/|/var/tmp|/dev/shm|/app_target|/home/|/root/|/[.]'; then return 0; fi\n  if printf '%s' \"$l\" | grep -Eqi 'base64|eval|wget |curl |(^|[^a-z])nc( |$)|ncat|netcat|/dev/tcp|bash -i|python[0-9.]* -c|perl -e|[|] *(ba)?sh'; then return 0; fi\n  for tok in $(printf '%s' \"$l\" | grep -oE '/[^[:space:];|&]+'); do\n    case \"$tok\" in\n      /usr/bin/*|/bin/*|/sbin/*|/usr/sbin/*) ;;\n      *.sh|*.py|*.pl) return 0 ;;\n    esac\n  done\n  if printf '%s' \"$l\" | grep -Eq '^([*]|[*]/[1-5]) ([*]|[*]/[1-5]) [*] [*] [*]'; then return 0; fi\n  return 1\n}\n\nexec_suspicious() {\n  cron_suspicious \"$1\" && return 0\n  printf '%s' \"$1\" | grep -Eqi 'socket|subprocess|while true|/bin/(ba)?sh -c|python[0-9.]* -c'\n}\n\nscan_cron_file() {\n  local f=\"$1\" real sha n=0 line t\n  [ -f \"$f\" ] && [ -r \"$f\" ] || return 0\n  real=$(realpath -e -- \"$f\" 2>/dev/null) || return 0\n  sha=$(sha_of \"$real\")\n  [ -n \"$sha\" ] || return 0\n "]
