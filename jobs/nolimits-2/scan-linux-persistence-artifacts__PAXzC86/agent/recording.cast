[100.326232, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   return 0\r\n\u001b[?2004l\r"]
[100.32626, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.326327, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> scan_ssh_file() {\r\n\u001b[?2004l\r"]
[100.326357, "o", "\u001b[?2004h> "]
[100.326417, "o", "  local f=\"$1\" user=\"$2\" real sha n=0 line t body\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.326523, "o", "  [ -f \"$f\" ] && [ -r \"$f\" ] || return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.326588, "o", "  real=$(realpath -e -- \"$f\" 2>/dev/null) || return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.326668, "o", "  sha=$(sha_of \"$real\")\r\n\u001b[?2004l\r\u001b[?2004h>   [ -n \"$sha\" ] || return 0\r\n\u001b[?2004l\r"]
[100.326705, "o", "\u001b[?2004h> "]
[100.326771, "o", "  while IFS= read -r line || [ -n \"$line\" ]; do\r\n"]
[100.326845, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[100.326865, "o", "    n=$((n + 1))\r\n\u001b[?2004l\r"]
[100.326901, "o", "\u001b[?2004h> "]
[100.326989, "o", "    t=$(trim \"$line\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.327042, "o", "    case \"$t\" in\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.327119, "o", ">       \"\"|'#'*) continue ;;\r\n\u001b[?2004l\r"]
[100.327257, "o", "\u001b[?2004h>     esac\r\n\u001b[?2004l\r"]
[100.327279, "o", "\u001b[?2004h> "]
[100.327342, "o", "    body=$(printf '%s' \"$t\" | awk '{print $2}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.327434, "o", "    if [ -f \"$WHITELIST\" ] && [ -n \"$body\" ] && grep -qxF -- \"$body\" \"$WHITELIST\" 2>/dev/null; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.327466, "o", "      continue\r\n\u001b[?2004l\r\u001b[?2004h>     fi\r\n\u001b[?2004l\r"]
[100.327537, "o", "\u001b[?2004h> "]
[100.327616, "o", "    emit ssh_key \"$real\" \"$sha\" \"$n\" \"$(printf '%s' \"$t\" | cut -c1-100)\" \"$user\"\r\n\u001b[?2004l\r\u001b[?2004h>   done < \"$real\" 2>/dev/null\r\n\u001b[?2004l\r"]
[100.327696, "o", "\u001b[?2004h>   return 0\r\n\u001b[?2004l\r"]
[100.327706, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.327776, "o", "for base in \"${BASES[@]}\"; do\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.32789, "o", "  for f in \"$base\"/etc/cron.d/*; do scan_cron_file \"$f\"; done\r\n\u001b[?2004l\r\u001b[?2004h>   scan_cron_file \"$base/etc/crontab\"\r\n\u001b[?2004l\r"]
[100.327988, "o", "\u001b[?2004h> "]
[100.328026, "o", "  for f in \"$base\"/var/spool/cron/crontabs/*; do scan_cron_file \"$f\"; done\r\n\u001b[?2004l\r"]
[100.328154, "o", "\u001b[?2004h>   for d in etc/systemd/system usr/lib/systemd/system run/systemd/system; do\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.328262, "o", "    for f in \"$base/$d\"/* \"$base/$d\"/.[!.]*; do scan_unit_file \"$f\"; done\r\n\u001b[?2004l\r\u001b[?2004h>   done\r\n\u001b[?2004l\r"]
[100.328328, "o", "\u001b[?2004h>   scan_rc_file \"$base/etc/rc.local\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.32845, "o", "  scan_rc_file \"$base/etc/rc.d/rc.local\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.328485, "o", "  scan_ssh_file \"$base/root/.ssh/authorized_keys\" root\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.328542, "o", "> "]
[100.328564, "o", "  for h in \"$base\"/home/*; do\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.328609, "o", ">     [ -d \"$h\" ] || continue\r\n\u001b[?2004l\r"]
[100.32863, "o", "\u001b[?2004h"]
[100.328734, "o", ">     scan_ssh_file \"$h/.ssh/authorized_keys\" \"$(basename -- \"$h\")\"\r\n\u001b[?2004l\r"]
[100.328755, "o", "\u001b[?2004h>   done\r\n\u001b[?2004l\r"]
[100.328805, "o", "\u001b[?2004h> done\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[100.328831, "o", "> "]
[100.328894, "o", "RPT=\"$TMP/report.json\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.329285, "o", "jq -s 'unique | sort_by(.type, .path, (.details.line_number // 0)) | {summary: {total_artifacts: length, cron_jobs: (map(select(.type == \"cron_job\")) | length), systemd_units: (map(select(.type == \"systemd_unit\")) | length), rc_local_modifications: (map(select(.type == \"rc_local\")) | length), ssh_keys: (map(select(.type == \"ssh_key\")) | length)}, artifacts: .}' \"$REC\" > \"$RPT\" 2>/dev/null\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.329306, "o", "> "]
[100.329359, "o", "if [ ! -s \"$RPT\" ]; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.32954, "o", "  echo '{\"summary\":{\"total_artifacts\":0,\"cron_jobs\":0,\"systemd_units\":0,\"rc_local_modifications\":0,\"ssh_keys\":0},\"artifacts\":[]}' > \"$RPT\"\r\n\u001b[?2004l\r"]
[100.329566, "o", "\u001b[?2004h> fi\r\n\u001b[?2004l\r"]
[100.329635, "o", "\u001b[?2004h> mkdir -p /app 2>/dev/null\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.329713, "o", "cp \"$RPT\" \"$OUT\" 2>/dev/null\r\n\u001b[?2004l\r\u001b[?2004h> exit 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.32983, "o", "EOF\r\n\u001b[?2004l\r"]
[100.332487, "o", "\u001b[?2004hroot@8474ace6fd53:/app# "]
[100.332598, "o", "chmod +x /app/scan_persistence.sh && echo SCRIPT_WRITTEN\r\n\u001b[?2004l\r"]
[100.333526, "o", "SCRIPT_WRITTEN\r\n"]
[100.333594, "o", "\u001b[?2004hroot@8474ace6fd53:/app# "]
[101.298887, "i", "bash /app/scan_persistence.sh; echo rc=$?; sha256sum /app/persistence_report.json; bash /app/scan_persistence.sh; echo rc=$?; sha256sum /app/persistence_report.json\n"]
[101.299344, "o", "bash /app/scan_persistence.sh; echo rc=$?; sha256sum /app/persistence_report.json; bash /app/scan_persistence.sh; echo rc=$?; sha256sum /app/persistence_report.json\r\n\u001b[?2004l\r"]
[104.269315, "i", "jq . /app/persistence_report.json | head -150\n"]
[104.269372, "o", "jq . /app/persistence_report.json | head -150\r\n"]
