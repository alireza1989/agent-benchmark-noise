[7.066982, "o", "#!/bin/bash\r\nexec python3 /app/bandit.pyc \"$@\"\r\n"]
[7.067086, "o", "\r\n\u001b[?2004hroot@a0229566dd46:/app# "]
[7.386644, "i", "echo 0 | timeout 5 /app/bandit --seed 42 | head -20\n"]
[7.386984, "o", "echo 0 | timeout 5 /app/bandit --seed 42 | head -20\r\n\u001b[?2004l\r"]
[7.507087, "o", "BANDIT n_arms=10 horizon=1500 seed=42\r\nREADY\r\nTURN 1\r\nREWARD 0.386451\r\nTURN 2\r\nERROR: No input received\r\n"]
[7.511803, "o", "\u001b[?2004hroot@a0229566dd46:/app# "]
[19.755135, "i", "cat > /tmp/play.py << 'EOF'\nimport subprocess, math\nfrom collections import deque\n\nW = 40\nC = 0.5\nN_ARMS = 10\n\ndef choose(hist):\n    for a in range(N_ARMS):\n        if len(hist[a]) == 0:\n            return a\n    counts = [len(h) for h in hist]\n    total = sum(counts)\n    scale = math.log(min(total, W) + 1)\n    best, best_v = 0, -1e9\n    for a in range(N_ARMS):\n        n = counts[a]\n        mean = sum(hist[a]) / n\n        v = mean + C * math.sqrt(scale / n)\n        if v > best_v:\n            best, best_v = a, v\n    return best\n\ndef run(seed):\n    p = subprocess.Popen(['/app/bandit', '--seed', str(seed)],\n                         stdin=subprocess.PIPE, stdout=subprocess.PIPE,\n                         stderr=subprocess.PIPE, text=True, bufsize=1)\n    hist = [deque(maxlen=W) for _ in range(N_ARMS)]\n    done = None\n    for t in range(1, 1501):\n        line = p.stdout.readline().strip()\n        while line and not line.startswith('TURN') and not line.startswith('DONE'):\n            line = p.stdout.readline().strip()\n        if not line or line.startswith('DONE'):\n            done = line\n            break\n        a = choose(hist)\n        p.stdin.write(str(a) + '\\n')\n        p.stdin.flush()\n        rl = p.stdout.readline().strip()\n        while rl and not rl.startswith('REWARD'):\n            rl = p.stdout.readline().strip()\n        r = float(rl.split()[1])\n        hist[a].append(r)\n    if done is None or not done.startswith('DONE'):\n        line = p.stdout.readline().strip()\n        while line and not line.startswith('DONE'):\n            line = p.stdout.readline().strip()\n        done = line\n    p.stdin.close()\n    p.wait()\n    print(seed, done, flush=True)\n    fields = dict(kv.split('=') for kv in done.split()[1:])\n    return float(fields['total_reward']), float(fields['regret'])\n\nres = [run(s) for s in (42, 43, 44)]\navg_total = sum(r[0] for r in res) / len(res)\navg_regret = sum(r[1] for r in res) / len(res)\nwith open('/app/answer.txt', 'w') as f:\n    f.write('total_reward=%.3f\\nregret=%.3f\\n' % (avg_total, avg_regret))\nprint(open('/app/answer.txt').read())\nEOF\n"]
