[15.437004, "i", "cd /app && python3 -c \"import pandas as pd, numpy as np; imp=pd.read_csv('data/impressions.csv'); conv=pd.read_csv('data/conversions.csv'); print(imp.describe(include='all').T.to_string()); print(conv.describe().T.to_string()); print('dup imp', imp.impression_id.duplicated().sum(), 'dup conv', conv.impression_id.duplicated().sum()); print('conv not in imp', (~conv.impression_id.isin(imp.impression_id)).sum()); d=conv.delay_hours; l=np.log(d); print('mu', l.mean(), 'sigma', l.std(ddof=0), 'median', d.median(), 'p90', d.quantile(0.9), 'max', d.max()); print(imp.arm_id.value_counts().sort_index().to_string()); m=imp.merge(conv, on='impression_id', how='left'); m['conv']=m.conversion_value.notna().astype(int); m['val']=m.conversion_value.fillna(0); print(m.groupby('arm_id').agg(n=('conv','size'), rate=('conv','mean'), val=('val','sum')).to_string()); print(m.groupby('user_segment').conv.mean().to_string()); print(m.groupby('device_type').conv.mean().to_string()); print(m.groupby('day_of_week').conv.mean().to_stri"]
