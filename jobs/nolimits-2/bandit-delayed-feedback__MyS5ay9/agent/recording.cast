[29.854817, "i", "cd /app && python3 -c \"import pandas as pd, numpy as np; imp=pd.read_csv('data/impressions.csv'); conv=pd.read_csv('data/conversions.csv'); m=conv.merge(imp,on='impression_id'); print('delay==72', (conv.delay_hours>=72).sum(), 'delay>=71', (conv.delay_hours>=71).sum()); r=m.conversion_timestamp-m.timestamp-m.delay_hours*3600; print('resid', r.describe().to_string()); print(np.histogram(conv.delay_hours,bins=[0,1,2,4,8,12,24,36,48,60,72.01])); cut=conv.conversion_timestamp.max(); print('cut', cut); age=(cut-imp.timestamp)/3600; print('age>72 frac', (age>72).mean(), 'age<72 n', (age<72).sum()); print(imp.assign(age=age).groupby(pd.cut(age,[-1,24,48,72,96,120,400])).size().to_string())\"\n"]
[29.856308, "o", "cd /app && python3 -c \"import pandas as pd, numpy as np; imp=pd.read_csv('data/impressions.csv'); conv=pd.read_csv('data/conversions.csv'); m=conv.merge(imp,on='impression_id'); print('delay==72', (conv.delay_hours>=72).sum(), 'delay>=71', (conv.delay_hours>=71).sum()); r=m.conversion_timestamp-m.timestamp-m.delay_hours*3600; print('resid', r.describe().to_string()); print(np.histogram(conv.delay_hours,bins=[0,1,2,4,8,12,24,36,48,60,72.01])); cut=conv.conversion_timestamp.max(); print('cut', cut); age=(cut-imp.timestamp)/3600; print('age>72 frac', (age>72).mean(), 'age<72 n', (age<72).sum()); print(imp.assign(age=age).groupby(pd.cut(age,[-1,24,48,72,96,120,400])).size().to_string())\"\r\n\u001b[?2004l\r"]
