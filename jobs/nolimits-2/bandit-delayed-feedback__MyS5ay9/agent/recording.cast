[179.838326, "i", "cd /app && cat > heterogeneity.py << 'EOF'\nimport pandas as pd, numpy as np\nimp = pd.read_csv('data/impressions.csv')\nconv = pd.read_csv('data/conversions.csv')\nctx = pd.read_csv('data/test_contexts.csv')\nm = imp.merge(conv[['impression_id','conversion_value']], on='impression_id', how='left')\nm['cf'] = m.conversion_value.notna().astype(int)\nm['real'] = m.conversion_value.fillna(0)\nvals = m[m.cf==1].groupby('arm_id').real.mean()\nSEG = {'young':0,'middle':1,'senior':2}; DEV = {'mobile':0,'desktop':1,'tablet':2}\ndef keys(df):\n    return list(zip(np.digitize(df.hour_of_day.values,[6,10,16,20]), df.user_segment.map(SEG).values, df.device_type.map(DEV).values))\nm['key'] = keys(m); ctx['key'] = keys(ctx)\ng = m.groupby(['key','arm_id']).agg(n=('cf','size'), rate=('cf','mean'), real=('real','mean')).reset_index()\ng = g[g.n>=100]\ng['ev'] = g.real\nbest = g.loc[g.groupby('key').ev.idxmax()].set_index('key')\narm7 = m[m.arm_id==7].groupby('key').real.mean()\nprint('cells with best arm', len(best), 'best arm counts', best.a"]
[179.839296, "o", "cd /app && cat > heterogeneity.py << 'EOF'\r\n"]
[179.839336, "i", "rm_id.value_counts().to_dict())\nsel = ctx.key.map(lambda k: best.arm_id.get(k, 7))\nev_best = ctx.key.map(lambda k: best.ev.get(k, arm7.get(k, 0)))\nev7 = ctx.key.map(lambda k: arm7.get(k, np.nan))\nprint('mean EV oracle-cell on test ctx', round(float(np.nanmean(ev_best)),4), 'arm7 EV', round(float(np.nanmean(ev7)),4), 'ratio', round(float(np.nanmean(ev_best)/np.nanmean(ev7)),3))\nprint('frac ctx where best != 7', round(float((sel!=7).mean()),3))\nEOF\npython3 heterogeneity.py\n"]
