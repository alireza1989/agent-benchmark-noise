[144.544325, "i", "cd /app && cat > logit_model.py << 'EOF'\nimport numpy as np, pandas as pd\nfrom scipy.optimize import minimize\nfrom scipy.special import expit\nimp = pd.read_csv('data/impressions.csv')\nconv = pd.read_csv('data/conversions.csv')\nctx = pd.read_csv('data/test_contexts.csv')\nm = imp.merge(conv[['impression_id','conversion_value']], on='impression_id', how='left')\nm['cf'] = m.conversion_value.notna().astype(int)\nm['real'] = m.conversion_value.fillna(0)\nSEG = {'young':0,'middle':1,'senior':2}; DEV = {'mobile':0,'desktop':1,'tablet':2}\ndef feat(df, arm):\n    n = len(df); X = np.zeros((n, 10+24+3+3+1+2))\n    X[np.arange(n), arm] = 1\n    X[np.arange(n), 10 + df.hour_of_day.values] = 1\n    X[np.arange(n), 34 + df.user_segment.map(SEG).values] = 1\n    X[np.arange(n), 37 + df.device_type.map(DEV).values] = 1\n    X[:, 40] = (df.day_of_week.values >= 5).astype(float)\n    X[:, 41] = df.context_feature_1.values\n    X[:, 42] = df.context_feature_2.values\n    return X\ndef fit(df, lam=1.0):\n    X = feat(df, df.arm_id.values); y "]
[144.545052, "o", "cd /app && cat > logit_model.py << 'EOF'\r\n\u001b[?2004l\r"]
[144.545106, "i", "= df.cf.values.astype(float)\n    def f(w):\n        z = X @ w\n        loss = np.sum(np.logaddexp(0, z) - y * z) + 0.5 * lam * w @ w\n        g = X.T @ (expit(z) - y) + lam * w\n        return loss, g\n    res = minimize(f, np.zeros(X.shape[1]), jac=True, method='L-BFGS-B', options={'maxiter': 2000})\n    return res.x\ndef prob_all(w, df):\n    return np.column_stack([expit(feat(df, np.full(len(df), a)) @ w) for a in range(10)])\ndef values(df):\n    return df[df.cf == 1].groupby('arm_id').real.mean().reindex(range(10)).values\n# holdout\nrng = np.random.default_rng(0)\nmask = rng.random(len(m)) < 0.5\ntr, te = m[mask], m[~mask]\nw = fit(tr); v = values(tr); r = tr.groupby('arm_id').cf.mean().reindex(range(10)).values\nP = prob_all(w, te) * v[None, :]\nidx = np.arange(len(te)); shown = te.arm_id.values\nprint('ALL test rows: shown-arm predicted', P[idx, shown].mean().round(4), 'realized', te.real.mean().round(4), 'ratio', (P[idx, shown].mean() / te.real.mean()).round(3))\nbest = P.argmax(1); match = shown == best\nprint('policy "]
[144.545134, "i", "matched rows', match.sum(), 'pred', P[idx, best][match].mean().round(4), 'realized', te.real.values[match].mean().round(4), 'ratio', (P[idx, best][match].mean() / te.real.values[match].mean()).round(3))\nprint('policy choice counts', np.bincount(best, minlength=10))\n# full fit and predictions\nwf = fit(m); vf = values(m)\nPc = prob_all(wf, ctx) * vf[None, :]\nbc = Pc.argmax(1); ii = np.arange(len(ctx))\nnarm = m.groupby('arm_id').size().reindex(range(10)).values\npc = prob_all(wf, ctx)[ii, bc]\nse = np.sqrt(np.clip(pc*(1-pc), 1e-9, None) / narm[bc]) * vf[bc]\nout = pd.DataFrame({'context_id': ctx.context_id, 'selected_arm': bc, 'expected_reward': Pc[ii, bc], 'confidence_lower': np.maximum(Pc[ii, bc] - 1.2816*se, 0), 'confidence_upper': Pc[ii, bc] + 1.2816*se})\nout.to_csv('output/predictions_logit.csv', index=False)\nprint('full-fit choice counts', np.bincount(bc, minlength=10), 'mean expected', out.expected_reward.mean().round(4))\nprint('values', np.round(vf, 3))\nEOF\npython3 logit_model.py\n"]
[144.546295, "o", "= df.cf.values.astype(float)\r\n    def f(w):\r\n        z = X @ w\r\n        loss = np.sum(np.logaddexp(0, z) - y * z) + 0.5 * lam * w @ w\r\n        g = X.T @ (expit(z) - y) + lam * w\r\n        return loss, g\r\n    res = minimize(f, np.zeros(X.shape[1]), jac=True, method='L-BFGS-B', options={'maxiter': 2000})\r\n    return res.x\r\ndef prob_all(w, df):\r\n    return np.column_stack([expit(feat(df, np.full(len(df), a)) @ w) for a in range(10)])\r\ndef values(df):\r\n    return df[df.cf == 1].groupby('arm_id').real.mean().reindex(range(10)).values\r\n# holdout\r\nrng = np.random.default_rng(0)\r\nmask = rng.random(len(m)) < 0.5\r\ntr, te = m[mask], m[~mask]\r\nw = fit(tr); v = values(tr); r = tr.groupby('arm_id').cf.mean().reindex(range(10)).values\r\nP = prob_all(w, te) * v[None, :]\r\nidx = np.arange(len(te)); shown = te.arm_id.values\r\nprint('ALL test rows: shown-arm predicted', P[idx, shown].mean().round(4), 'realized', te.real.mean().round(4), 'ratio', (P[idx, shown].mean() / te.real.mean()).round(3))\r\nbest = P.argmax(1); match = shown =="]
[144.546328, "o", " best\r\nprint('policy matched rows', match.sum(), 'pred', P[idx, best][match].mean().round(4), 'realized', te.real.values[match].mean().round(4), 'ratio', (P[idx, best][match].mean() / te.real.values[match].mean()).round(3))\r\nprint('policy choice counts', np.bincount(best, minlength=10))\r\n# full fit and predictions\r\nwf = fit(m); vf = values(m)\r\nPc = prob_all(wf, ctx) * vf[None, :]\r\nbc = Pc.argmax(1); ii = np.arange(len(ctx))\r\nnarm = m.groupby('arm_id').size().reindex(range(10)).values\r\npc = prob_all(wf, ctx)[ii, bc]\r\nse = np.sqrt(np.clip(pc*(1-pc), 1e-9, None) / narm[bc]) * vf[bc]\r\nout = pd.DataFrame({'context_id': ctx.context_id, 'selected_arm': bc, 'expected_reward': Pc[ii, bc], 'confidence_lower': np.maximum(Pc[ii, bc] - 1.2816*se, 0), 'confidence_upper': Pc[ii, bc] + 1.2816*se})\r\nout.to_csv('output/predictions_logit.csv', index=False)\r\nprint('full-fit choice counts', np.bincount(bc, minlength=10), 'mean expected', out.expected_reward.mean().round(4))\r\nprint('values', np.round(vf, 3))\r\nEOF\r\npython3 logit_mo"]
