[198.186327, "i", "cd /app && cat > ips_check.py << 'EOF'\nimport pandas as pd, numpy as np\nimp = pd.read_csv('data/impressions.csv')\nconv = pd.read_csv('data/conversions.csv')\nm = imp.merge(conv[['impression_id','conversion_value']], on='impression_id', how='left')\nm['cf'] = m.conversion_value.notna().astype(int)\nm['real'] = m.conversion_value.fillna(0)\nSEG = {'young':0,'middle':1,'senior':2}; DEV = {'mobile':0,'desktop':1,'tablet':2}\nhb = np.digitize(m.hour_of_day.values,[6,10,16,20])\nm['cid'] = hb*9 + m.user_segment.map(SEG).values*3 + m.device_type.map(DEV).values\nprop = m.groupby('arm_id').size().reindex(range(10)).values / len(m)\nrng = np.random.default_rng(1)\nmask = rng.random(len(m)) < 0.5\ntr, te = m[mask], m[~mask]\nS = np.zeros((45,10)); N = np.zeros((45,10))\nnp.add.at(S, (tr.cid.values, tr.arm_id.values), tr.real.values)\nnp.add.at(N, (tr.cid.values, tr.arm_id.values), 1)\nam = tr.groupby('arm_id').real.mean().reindex(range(10)).values\nshown = te.arm_id.values; y = te.real.values; pi = prop[shown]\ndef ips(choice):\n    t "]
[198.186382, "i", "= y * (shown == choice) / pi\n    return t.mean(), t.std(ddof=1)/np.sqrt(len(t))\nv7, se7 = ips(np.full(len(te), 7))\nprint('arm7 IPS', round(v7,4), 'se', round(se7,4))\nfor k in [50.0, 200.0, 1000.0]:\n    est = (S + k*am[None,:]) / (N + k)\n    choice = est[te.cid.values].argmax(1)\n    v, se = ips(choice)\n    print('k', k, 'cell policy IPS', round(v,4), 'se', round(se,4), 'ratio vs arm7', round(v/v7,3), 'arm counts', np.bincount(choice, minlength=10).tolist())\nEOF\npython3 ips_check.py\n"]
