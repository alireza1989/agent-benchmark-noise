[82.784003, "i", "cd /app && cat > make_outputs.py << 'EOF'\nimport os, json\nimport pandas as pd, numpy as np\nfrom scipy import stats, optimize\nos.makedirs('output', exist_ok=True)\nimp = pd.read_csv('data/impressions.csv')\nconv = pd.read_csv('data/conversions.csv')\nctx = pd.read_csv('data/test_contexts.csv')\n# 1. censored lognormal delay model\nd = conv.delay_hours.values\ncens = d >= 72 - 1e-9\nlog_unc = np.log(d[~cens])\nnc = cens.sum()\ndef nll(p):\n    mu, ls = p\n    s = np.exp(ls)\n    ll = stats.norm.logpdf(log_unc, mu, s).sum() - log_unc.sum()\n    lc = nc * stats.norm.logsf(np.log(72.0), mu, s)\n    return -(ll + lc)\nres = optimize.minimize(nll, [2.5, np.log(0.9)], method='Nelder-Mead', options={'xatol':1e-8,'fatol':1e-8,'maxiter':5000})\nmu_c, s_c = res.x[0], float(np.exp(res.x[1]))\n# 2. IPW rates\ncut = conv.conversion_timestamp.max()\nage = (cut - imp.timestamp.values) / 3600.0\nz = (np.log(np.clip(age, 1e-9, None)) - mu_c) / s_c\nF = np.clip(np.where(age >= 72, 1.0, stats.norm.cdf(z)), 1e-3, 1.0)\nimp['w'] = 1.0 / F\nimp['conv'] = "]
[82.78559, "o", "cd /app && cat > make_outputs.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.785624, "i", "imp.impression_id.isin(conv.impression_id).astype(int)\nm = imp.merge(conv[['impression_id','conversion_value']], on='impression_id', how='left')\nm['val'] = m.conversion_value.fillna(0)\noverall_rate = (m.conv * m.w).sum() / m.w.sum()\nrows = []\nfor a, g in m.groupby('arm_id'):\n    r = (g.conv * g.w).sum() / g.w.sum()\n    v = g.loc[g.conv == 1, 'conversion_value'].mean()\n    rows.append((int(a), float(r), float(v), int(len(g)), int(g.conv.sum())))\narm_df = pd.DataFrame(rows, columns=['arm_id','estimated_conversion_rate','estimated_avg_value','total_impressions','total_conversions'])\narm_df.to_csv('output/arm_statistics.csv', index=False)\nprint(arm_df.round(4).to_string(index=False))\ndelay = {'distribution_type': 'lognormal', 'parameters': {'mu': float(mu_c), 'sigma': s_c}, 'median_delay_hours': float(np.exp(mu_c)), 'p90_delay_hours': float(np.exp(mu_c + 1.2815515655 * s_c)), 'conversion_rate_estimate': float(overall_rate)}\njson.dump(delay, open('output/delay_model.json', 'w'), indent=2)\nprint(json.dumps(delay, i"]
[82.785666, "o", "import os, json\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd, numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from scipy import stats, optimize\r\n\u001b[?2004l\r\u001b[?2004h> os.makedirs('output', exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.785697, "i", "ndent=2))\n# 3. shrunken cell rates\nseg_map = {'young':0, 'middle':1, 'senior':2}\ndev_map = {'mobile':0, 'desktop':1, 'tablet':2}\ndef prep(df):\n    return (np.digitize(df.hour_of_day.values, [6,10,16,20]), df.user_segment.map(seg_map).values, df.device_type.map(dev_map).values)\nhb, s, dv = prep(imp)\narm = imp.arm_id.values.astype(int)\ncn = np.zeros((10,5,3,3)); cc = np.zeros((10,5,3,3))\nnp.add.at(cn, (arm,hb,s,dv), 1)\nnp.add.at(cc, (arm,hb,s,dv), imp.conv.values)\nr_arm = arm_df.estimated_conversion_rate.values\nv_arm = arm_df.estimated_avg_value.values\nk = 30.0\n# 4. score contexts\nhbc, sc, dc = prep(ctx)\nA = np.arange(10)[None, :]\nH = hbc[:, None]; S = sc[:, None]; D = dc[:, None]\nn_c = cn[A, H, S, D]; c_c = cc[A, H, S, D]\na_post = c_c + k * r_arm[None, :]\nb_post = (n_c - c_c) + k * (1 - r_arm[None, :])\np = a_post / (a_post + b_post)\nexp_r = p * v_arm[None, :]\nlo_r = stats.beta.ppf(0.10, a_post, b_post) * v_arm[None, :]\nhi_r = stats.beta.ppf(0.90, a_post, b_post) * v_arm[None, :]\nbest = exp_r.argmax(axis=1)\nidx"]
[82.78607, "o", "imp = pd.read_csv('data/impressions.csv')\r\n\u001b[?2004l\r\u001b[?2004h> conv = pd.read_csv('data/conversions.csv')\r\n\u001b[?2004l\r\u001b[?2004h> ctx = pd.read_csv('data/test_contexts.csv')\r\n\u001b[?2004l\r\u001b[?2004h> # 1. censored lognormal delay model\r\n\u001b[?2004l\r\u001b[?2004h> d = conv.delay_hours.values\r\n\u001b[?2004l\r\u001b[?2004h> cens = d >= 72 - 1e-9\r\n\u001b[?2004l\r\u001b[?2004h> log_unc = np.log(d[~cens])\r\n\u001b[?2004l\r\u001b[?2004h> nc = cens.sum()\r\n\u001b[?2004l\r\u001b[?2004h> def nll(p):\r\n\u001b[?2004l\r\u001b[?2004h>     mu, ls = p\r\n\u001b[?2004l\r\u001b[?2004h>     s = np.exp(ls)\r\n\u001b[?2004l\r\u001b[?2004h>     ll = stats.norm.logpdf(log_unc, mu, s).sum() - log_unc.sum()\r\n\u001b[?2004l\r\u001b[?2004h>     lc = nc * stats.norm.logsf(np.log(72.0), mu, s)\r\n\u001b[?2004l\r\u001b[?2004h>     return -(ll + lc)\r\n\u001b[?2004l\r\u001b[?2004h> res = optimize.minimize(nll, [2.5, np.log(0.9)], method='Nelder-Mead', options={'xatol':1e-8,'fatol':1e-8,'maxiter':5000})\r\n\u001b[?2004l\r\u001b[?2004h> mu_c, s_c = res.x[0], float(np.exp(res.x[1]))\r\n\u001b[?2004l\rimp.impression_id.isin(conv.impression_id).astype(int)\r\nm = imp.merge(conv[['impression_id','conversio"]
[82.78621, "i", " = np.arange(len(ctx))\npred = pd.DataFrame({'context_id': ctx.context_id, 'selected_arm': best, 'expected_reward': exp_r[idx, best], 'confidence_lower': lo_r[idx, best], 'confidence_upper': hi_r[idx, best]})\npred['expected_reward'] = pred.expected_reward.clip(lower=0)\npred['confidence_lower'] = np.minimum(pred.confidence_lower, pred.expected_reward)\npred['confidence_upper'] = np.maximum(pred.confidence_upper, pred.expected_reward)\npred.to_csv('output/predictions.csv', index=False)\nprint('arm selection counts:'); print(pred.selected_arm.value_counts().sort_index().to_string())\nprint('mean expected reward', pred.expected_reward.mean(), 'rows', len(pred))\nEOF\npython3 make_outputs.py && head -3 output/predictions.csv && wc -l output/predictions.csv output/arm_statistics.csv\n"]
