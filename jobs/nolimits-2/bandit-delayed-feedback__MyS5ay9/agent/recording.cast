[120.065633, "i", "cd /app && cat > holdout_policy.py << 'EOF'\nimport pandas as pd, numpy as np\nimp = pd.read_csv('data/impressions.csv')\nconv = pd.read_csv('data/conversions.csv')\nm = imp.merge(conv[['impression_id','conversion_value']], on='impression_id', how='left')\nm['cf'] = m.conversion_value.notna().astype(int)\nm['real'] = m.conversion_value.fillna(0)\nseg_map = {'young':0,'middle':1,'senior':2}\ndev_map = {'mobile':0,'desktop':1,'tablet':2}\nm['hb'] = np.digitize(m.hour_of_day.values, [6,10,16,20])\nm['s'] = m.user_segment.map(seg_map).values\nm['dv'] = m.device_type.map(dev_map).values\nrng = np.random.default_rng(0)\nmask = rng.random(len(m)) < 0.5\ntr, te = m[mask], m[~mask]\ndef fit(df):\n    cn = np.zeros((10,5,3,3)); cc = np.zeros((10,5,3,3))\n    np.add.at(cn,(df.arm_id.values,df.hb.values,df.s.values,df.dv.values),1)\n    np.add.at(cc,(df.arm_id.values,df.hb.values,df.s.values,df.dv.values),df.cf.values)\n    am = df.groupby('arm_id').agg(r=('cf','mean'))\n    val = df[df.cf==1].groupby('arm_id').real.mean()\n    return cn, cc"]
[120.065847, "i", ", am.r.values, val.reindex(range(10)).values\ncn, cc, r, v = fit(tr)\nk = 30.0\nP = np.zeros((len(te),10))\nfor a in range(10):\n    n = cn[a][te.hb.values, te.s.values, te.dv.values]\n    c = cc[a][te.hb.values, te.s.values, te.dv.values]\n    P[:,a] = (c + k*r[a])/(n + k) * v[a]\nbest = P.argmax(1)\nmatch = te.arm_id.values == best\nprint('test rows', len(te), 'matched rows', match.sum())\nprint('policy predicted mean (all test rows)', P[np.arange(len(te)),best].mean().round(4))\nprint('policy matched realized mean', te.real.values[match].mean().round(4), 'matched predicted', P[np.arange(len(te)),best][match].mean().round(4))\narm_best = (r*v).argmax()\nmatch2 = te.arm_id.values == arm_best\nprint('arm-only best arm', arm_best, 'matched rows', match2.sum(), 'matched realized mean', te.real.values[match2].mean().round(4), 'arm-level predicted', (r*v)[arm_best].round(4))\nEOF\npython3 holdout_policy.py\n"]
