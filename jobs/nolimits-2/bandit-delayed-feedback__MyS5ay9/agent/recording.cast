[103.290663, "i", "cd /app && cat > check_calib.py << 'EOF'\nimport pandas as pd, numpy as np\nfrom scipy import stats\nimp = pd.read_csv('data/impressions.csv')\nconv = pd.read_csv('data/conversions.csv')\narm_df = pd.read_csv('output/arm_statistics.csv')\nm = imp.merge(conv[['impression_id','conversion_value']], on='impression_id', how='left')\nm['real'] = m.conversion_value.fillna(0)\nseg_map = {'young':0,'middle':1,'senior':2}\ndev_map = {'mobile':0,'desktop':1,'tablet':2}\nhb = np.digitize(m.hour_of_day.values, [6,10,16,20]); s = m.user_segment.map(seg_map).values; dv = m.device_type.map(dev_map).values\narm = m.arm_id.values.astype(int)\ncn = np.zeros((10,5,3,3)); cc = np.zeros((10,5,3,3))\nconv_flag = m.conversion_value.notna().astype(int).values\nnp.add.at(cn,(arm,hb,s,dv),1); np.add.at(cc,(arm,hb,s,dv),conv_flag)\nr = arm_df.estimated_conversion_rate.values; v = arm_df.estimated_avg_value.values\nfor k in [30.0, 300.0, 3000.0]:\n    n = cn[arm,hb,s,dv]; c = cc[arm,hb,s,dv]\n    p = (c + k*r[arm]) / (n + k)\n    pred = p * v[arm]\n    prin"]
[103.290727, "i", "t('k', k, 'mean pred shown arm', pred.mean().round(4), 'realized', m.real.mean().round(4), 'ratio', (pred.mean()/m.real.mean()).round(3))\nprint('arm-only pred', (r[arm]*v[arm]).mean().round(4))\nEOF\npython3 check_calib.py\n"]
