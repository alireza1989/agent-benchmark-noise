[30.142153, "o", "\u001b[?2004hroot@a341c7dbec7e:/app# "]
[51.518754, "i", "cd /app && cat > fit_delay.py << 'EOF'\nimport pandas as pd, numpy as np\nfrom scipy import stats, optimize\nimp = pd.read_csv('data/impressions.csv')\nconv = pd.read_csv('data/conversions.csv')\nd = conv.delay_hours.values\ncens = d >= 72 - 1e-9\nunc = d[~cens]\nnc = cens.sum()\nlog_unc = np.log(unc)\ndef nll(p):\n    mu, ls = p\n    s = np.exp(ls)\n    ll = stats.norm.logpdf(log_unc, mu, s).sum() - log_unc.sum()\n    lc = nc * stats.norm.logsf(np.log(72.0), mu, s)\n    return -(ll + lc)\nres = optimize.minimize(nll, [2.5, np.log(0.9)], method='Nelder-Mead', options={'xatol':1e-8,'fatol':1e-8,'maxiter':5000})\nmu_c, s_c = res.x[0], np.exp(res.x[1])\nprint('naive mu', np.log(d).mean(), 'sigma', np.log(d).std(ddof=0))\nprint('censored mu', mu_c, 'sigma', s_c, 'n_cens', nc, 'converged', res.success)\nprint('median', np.exp(mu_c), 'p90', np.exp(mu_c + 1.2815515655 * s_c))\nprint('frac observed <72 from fitted model', stats.norm.cdf((np.log(72)-mu_c)/s_c))\ncut = conv.conversion_timestamp.max()\nage = (cut - imp.timestamp.values) / 360"]
[51.518994, "i", "0.0\nz = (np.log(np.clip(age, 1e-9, None)) - mu_c) / s_c\nF = np.where(age >= 72, 1.0, stats.norm.cdf(z))\nF = np.clip(F, 1e-3, 1.0)\nimp['F'] = F\nm = imp.merge(conv[['impression_id','conversion_value']], on='impression_id', how='left')\nm['conv'] = m.conversion_value.notna().astype(int)\nm['val'] = m.conversion_value.fillna(0)\nm['w'] = 1.0 / m.F\nrows = []\nfor a, g in m.groupby('arm_id'):\n    raw = g.conv.mean()\n    ipw = (g.conv * g.w).sum() / g.w.sum()\n    mv = g.loc[g.conv == 1, 'conversion_value'].mean()\n    rows.append((a, len(g), raw, ipw, mv))\nout = pd.DataFrame(rows, columns=['arm','n','raw_rate','ipw_rate','mean_value'])\nprint(out.round(4).to_string(index=False))\nprint('overall raw', m.conv.mean(), 'overall ipw', (m.conv*m.w).sum()/m.w.sum())\nEOF\npython3 fit_delay.py\n"]
[51.519189, "o", "cd /app && cat > fit_delay.py << 'EOF'\r\n\u001b[?2004l\r0.0\r\nz = (np.log(np.clip(age, 1e-9, None)) - mu_c) / s_c\r\nF = np.where(age >= 72, 1.0, stats.norm.cdf(z))\r\nF = np.clip(F, 1e-3, 1.0)\r\nimp['F'] = F\r\nm = imp.merge(conv[['impression_id','conversion_value']], on='impression_id', how='left')\r\nm['conv'] = m.conversion_value.notna().astype(int)\r\nm['val'] = m.conversion_value.fillna(0)\r\nm['w'] = 1.0 / m.F\r\nrows = []\r\nfor a, g in m.groupby('arm_id'):\r\n    raw = g.conv.mean()\r\n    ipw = (g.conv * g.w).sum() / g.w.sum()\r\n    mv = g.loc[g.conv == 1, 'conversion_value'].mean()\r\n    rows.append((a, len(g), raw, ipw, mv))\r\nout = pd.DataFrame(rows, columns=['arm','n','raw_rate','ipw_rate','mean_value'])\r\nprint(out.round(4).to_string(index=False))\r\nprint('overall raw', m.conv.mean(), 'overall ipw', (m.conv*m.w).sum()/m.w.sum())\r\nEOF\r\npython3 fit_delay.py\r\n"]
