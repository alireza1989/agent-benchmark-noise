[?2004hroot@a341c7dbec7e:/app# cd /app && cat > ips_check.py << 'EOF'
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> imp = pd.read_csv('data/impressions.csv')
[?2004l[?2004h> conv = pd.read_csv('data/conversions.csv')
[?2004l[?2004h> m = imp.merge(conv[['impression_id','conversion_value']], on='impression_id', how='left')
[?2004l[?2004h> m['cf'] = m.conversion_value.notna().astype(int)
[?2004l[?2004h> m['real'] = m.conversion_value.fillna(0)
[?2004l[?2004h> SEG = {'young':0,'middle':1,'senior':2}; DEV = {'mobile':0,'desktop':1,'tablet':2}
[?2004l[?2004h> hb = np.digitize(m.hour_of_day.values,[6,10,16,20])
[?2004l[?2004h> m['cid'] = hb*9 + m.user_segment.map(SEG).values*3 + m.device_type.map(DEV).values
[?2004l[?2004h> prop = m.groupby('arm_id').size().reindex(range(10)).values / len(m)
[?2004l[?2004h> rng = np.random.default_rng(1)
[?2004l[?2004h> mask = rng.random(len(m)) < 0.5
[?2004l[?2004h> tr, te = m[mask], m[~mask]
[?2004l[?2004h> S = np.zeros((45,10)); N = np.zeros((45,10))
[?2004l[?2004h> np.add.at(S, (tr.cid.values, tr.arm_id.values), tr.real.values)
[?2004l[?2004h> np.add.at(N, (tr.cid.values, tr.arm_id.values), 1)
[?2004l[?2004h> am = tr.groupby('arm_id').real.mean().reindex(range(10)).values
[?2004l[?2004h> shown = te.arm_id.values; y = te.real.values; pi = prop[shown]
[?2004l[?2004h> def ips(choice):
[?2004l[?2004h>     t = y * (shown == choice) / pi
[?2004l[?2004h>     return t.mean(), t.std(ddof=1)/np.sqrt(len(t))
[?2004l[?2004h> v7, se7 = ips(np.full(len(te), 7))
[?2004l[?2004h> print('arm7 IPS', round(v7,4), 'se', round(se7,4))
[?2004l[?2004h> for k in [50.0, 200.0, 1000.0]:
[?2004l[?2004h>     est = (S + k*am[None,:]) / (N + k)
[?2004l[?2004h>     choice = est[te.cid.values].argmax(1)
[?2004l[?2004h>     v, se = ips(choice)
[?2004l[?2004h>     print('k', k, 'cell policy IPS', round(v,4), 'se', round(se,4), 'ratio vs arm7', round(v/v7,3), 'arm counts', np.bincount(choice, minlength=10).tolist())
