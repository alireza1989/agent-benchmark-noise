python3 fit_delay.py
[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from scipy import stats, optimize
[?2004l[?2004h> imp = pd.read_csv('data/impressions.csv')
[?2004l[?2004h> conv = pd.read_csv('data/conversions.csv')
[?2004l[?2004h> d = conv.delay_hours.values
[?2004l[?2004h> cens = d >= 72 - 1e-9
[?2004l[?2004h> unc = d[~cens]
[?2004l[?2004h> nc = cens.sum()
[?2004l[?2004h> log_unc = np.log(unc)
[?2004l[?2004h> def nll(p):
[?2004l[?2004h>     mu, ls = p
[?2004l[?2004h>     s = np.exp(ls)
[?2004l[?2004h>     ll = stats.norm.logpdf(log_unc, mu, s).sum() - log_unc.sum()
[?2004l[?2004h>     lc = nc * stats.norm.logsf(np.log(72.0), mu, s)
[?2004l[?2004h>     return -(ll + lc)
[?2004l[?2004h> res = optimize.minimize(nll, [2.5, np.log(0.9)], method='Nelder-Mead', options={'xatol':1e-8,'fatol':1e-8,'maxiter':5000})
[?2004l[?2004h> mu_c, s_c = res.x[0], np.exp(res.x[1])
[?2004l[?2004h> print('naive mu', np.log(d).mean(), 'sigma', np.log(d).std(ddof=0))
[?2004l[?2004h> print('censored mu', mu_c, 'sigma', s_c, 'n_cens', nc, 'converged', res.success)
[?2004l[?2004h> print('median', np.exp(mu_c), 'p90', np.exp(mu_c + 1.2815515655 * s_c))
[?2004l[?2004h> print('frac observed <72 from fitted model', stats.norm.cdf((np.log(72)-mu_c)/s_c))
