[?2004l[?2004h> ctx = pd.read_csv('data/test_contexts.csv')
[?2004l[?2004h> # 1. censored lognormal delay model
[?2004l[?2004h> d = conv.delay_hours.values
[?2004l[?2004h> cens = d >= 72 - 1e-9
[?2004l[?2004h> log_unc = np.log(d[~cens])
[?2004l[?2004h> nc = cens.sum()
