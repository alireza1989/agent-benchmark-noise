[?2004l0.0
z = (np.log(np.clip(age, 1e-9, None)) - mu_c) / s_c
F = np.where(age >= 72, 1.0, stats.norm.cdf(z))
F = np.clip(F, 1e-3, 1.0)
imp['F'] = F
m = imp.merge(conv[['impression_id','conversion_value']], on='impression_id', how='left')
m['conv'] = m.conversion_value.notna().astype(int)
m['val'] = m.conversion_value.fillna(0)
m['w'] = 1.0 / m.F
rows = []
for a, g in m.groupby('arm_id'):
    raw = g.conv.mean()
    ipw = (g.conv * g.w).sum() / g.w.sum()
    mv = g.loc[g.conv == 1, 'conversion_value'].mean()
    rows.append((a, len(g), raw, ipw, mv))
out = pd.DataFrame(rows, columns=['arm','n','raw_rate','ipw_rate','mean_value'])
print(out.round(4).to_string(index=False))
print('overall raw', m.conv.mean(), 'overall ipw', (m.conv*m.w).sum()/m.w.sum())
