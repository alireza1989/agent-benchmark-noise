[?2004l[?2004h>   "service": "$SERVICE",
[?2004l[?2004h>   "time_window": "$WINDOW_LABEL",
[?2004l[?2004h>   "restarts": $RESTARTS,
[?2004l[?2004h>   "errors": $ERRORS,
[?2004l[?2004h>   "restart_loop_detected": $RESTART_LOOP,
