[?2004l[?2004h>         level = 'WARN' if record.levelname == 'WARNING' else record.levelname
[?2004l[?2004h>         payload = {
[?2004l[?2004h>             'timestamp': ts.strftime('%Y-%m-%dT%H:%M:%SZ'),
[?2004l[?2004h>             'level': level,
[?2004l[?2004h>             'message': record.getMessage(),
[?2004l[?2004h>             'service': 'myapp',
[?2004l[?2004h>         }
[?2004l[?2004h>         # compact separators so that the output matches '"level":"ERROR"' patterns
[?2004l[?2004h>         return json.dumps(payload, separators=(',', ':'))
