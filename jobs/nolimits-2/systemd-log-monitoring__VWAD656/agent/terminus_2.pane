[?2004l[?2004h> #!/bin/bash
[?2004l[?2004h> # Analyzes the systemd journal for myapp over the last 5 minutes and prints a JSON report.
[?2004l[?2004h> SERVICE="myapp"
[?2004l[?2004h> WINDOW_LABEL="5 minutes"
[?2004l[?2004h> RESTART_THRESHOLD=3
[?2004l[?2004h> 
[?2004l[?2004h> LOGS="$(journalctl -u "${SERVICE}.service" --since "5 minutes ago" -o cat --no-pager 2>/dev/null)"
[?2004l[?2004h> 
[?2004l[?2004h> # A service start is logged by the app as 'Service started'
[?2004l[?2004h> RESTARTS="$(printf '%s\n' "$LOGS" | grep -c 'Service started')"
[?2004l[?2004h> ERRORS="$(printf '%s\n' "$LOGS" | grep -c '"level":"ERROR"')"
[?2004l[?2004h> 
[?2004l[?2004h> RESTART_LOOP=false
