[44.641459, "i", "cat > /etc/rsyslog.d/50-myapp.conf << 'EOF'\n# Extract myapp JSON events from journald into structured files\nmodule(load=\"imjournal\" StateFile=\"imjournal.state\")\n\n$FileOwner myapp\n$FileGroup myapp\n$FileCreateMode 0644\n\n# ERROR events go to the errors file (and also to the events file below)\nif $programname == 'myapp' and $msg contains '\"level\":\"ERROR\"' then /var/log/app_errors.log\n# All events (INFO, WARN, ERROR) go to the events file\nif $programname == 'myapp' then /var/log/app_events.log\nEOF\n"]
[44.641779, "o", "cat > /etc/rsyslog.d/50-myapp.conf << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.641835, "o", "# Extract myapp JSON events from journald into structured files\r\n\u001b[?2004l\r\u001b[?2004h> module(load=\"imjournal\" StateFile=\"imjournal.state\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.641913, "o", "$FileOwner myapp\r\n\u001b[?2004l\r\u001b[?2004h> $FileGroup myapp\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.641939, "o", "> $FileCreateMode 0644\r\n\u001b[?2004l\r"]
