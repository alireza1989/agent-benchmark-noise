[45.101937, "i", "cat > /etc/logrotate.d/myapp << 'EOF'\n/var/log/app_events.log /var/log/app_errors.log {\n    daily\n    rotate 7\n    compress\n    delaycompress\n    missingok\n    notifempty\n    create 0644 myapp myapp\n    sharedscripts\n    postrotate\n        /usr/bin/systemctl kill -s HUP rsyslog.service >/dev/null 2>&1 || true\n    endscript\n}\nEOF\n"]
