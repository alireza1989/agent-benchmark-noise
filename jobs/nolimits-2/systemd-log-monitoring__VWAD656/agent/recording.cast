[77.533524, "i", "cat > /usr/local/bin/check_service_health.sh << 'EOF'\n#!/bin/bash\n# Analyzes myapp logs for the last 5 minutes and prints a JSON report.\nSERVICE=\"myapp\"\nWINDOW_LABEL=\"5 minutes\"\nRESTART_THRESHOLD=3\nEVENTS_FILE=\"/var/log/app_events.log\"\nCUTOFF=\"$(date -u -d '5 minutes ago' +%Y-%m-%dT%H:%M:%SZ)\"\n\nif command -v journalctl >/dev/null 2>&1 && journalctl -u \"${SERVICE}.service\" -n 1 --no-pager >/dev/null 2>&1; then\n    LOGS=\"$(journalctl -u \"${SERVICE}.service\" --since '5 minutes ago' -o cat --no-pager 2>/dev/null)\"\nelse\n    # Fallback when journald is unreachable: use the structured events file\n    LOGS=\"$(awk -v c=\"$CUTOFF\" -F'\"timestamp\":\"' 'NF>1 { split($2, a, \"\\\"\"); if (a[1] >= c) print }' \"$EVENTS_FILE\" 2>/dev/null)\"\nfi\n\nRESTARTS=$(printf '%s\\n' \"$LOGS\" | grep -c 'Service started')\nERRORS=$(printf '%s\\n' \"$LOGS\" | grep -c '\"level\":\"ERROR\"')\n\nRESTART_LOOP=false\nif [ \"$RESTARTS\" -gt \"$RESTART_THRESHOLD\" ]; then\n    RESTART_LOOP=true\nfi\n\nTIMESTAMP=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"\n\ncat <<REPORT\n{\n  \"service\": \"$S"]
[77.533773, "i", "ERVICE\",\n  \"time_window\": \"$WINDOW_LABEL\",\n  \"restarts\": $RESTARTS,\n  \"errors\": $ERRORS,\n  \"restart_loop_detected\": $RESTART_LOOP,\n  \"timestamp\": \"$TIMESTAMP\"\n}\nREPORT\nEOF\nchmod 755 /usr/local/bin/check_service_health.sh && bash -n /usr/local/bin/check_service_health.sh && echo SCRIPT_OK\n"]
