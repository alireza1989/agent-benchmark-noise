[45.597416, "i", "cat > /usr/local/bin/check_service_health.sh << 'EOF'\n#!/bin/bash\n# Analyzes the systemd journal for myapp over the last 5 minutes and prints a JSON report.\nSERVICE=\"myapp\"\nWINDOW_LABEL=\"5 minutes\"\nRESTART_THRESHOLD=3\n\nLOGS=\"$(journalctl -u \"${SERVICE}.service\" --since \"5 minutes ago\" -o cat --no-pager 2>/dev/null)\"\n\n# A service start is logged by the app as 'Service started'\nRESTARTS=\"$(printf '%s\\n' \"$LOGS\" | grep -c 'Service started')\"\nERRORS=\"$(printf '%s\\n' \"$LOGS\" | grep -c '\"level\":\"ERROR\"')\"\n\nRESTART_LOOP=false\nif [ \"$RESTARTS\" -gt \"$RESTART_THRESHOLD\" ]; then\n    RESTART_LOOP=true\nfi\n\nTIMESTAMP=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"\n\ncat <<REPORT\n{\n  \"service\": \"$SERVICE\",\n  \"time_window\": \"$WINDOW_LABEL\",\n  \"restarts\": $RESTARTS,\n  \"errors\": $ERRORS,\n  \"restart_loop_detected\": $RESTART_LOOP,\n  \"timestamp\": \"$TIMESTAMP\"\n}\nREPORT\nEOF\nchmod 755 /usr/local/bin/check_service_health.sh && bash -n /usr/local/bin/check_service_health.sh && echo SCRIPT_OK\n"]
[45.597598, "o", "cat > /usr/local/bin/check_service_health.sh << 'EOF'\r\n\u001b[?2004l\r"]
[45.597612, "o", "\u001b[?2004h"]
[45.59779, "o", "> #!/bin/bash\r\n\u001b[?2004l\r\u001b[?2004h> # Analyzes the systemd journal for myapp over the last 5 minutes and prints a JSON report.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.597817, "o", "SERVICE=\"myapp\"\r\n\u001b[?2004l\r"]
[45.597921, "o", "\u001b[?2004h> "]
[45.59799, "o", "WINDOW_LABEL=\"5 minutes\"\r\n\u001b[?2004l\r\u001b[?2004h> RESTART_THRESHOLD=3\r\n\u001b[?2004l\r"]
[45.598142, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.59823, "o", "LOGS=\"$(journalctl -u \"${SERVICE}.service\" --since \"5 minutes ago\" -o cat --no-pager 2>/dev/null)\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.59842, "o", "# A service start is logged by the app as 'Service started'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.59866, "o", "RESTARTS=\"$(printf '%s\\n' \"$LOGS\" | grep -c 'Service started')\"\r\n\u001b[?2004l\r\u001b[?2004h> ERRORS=\"$(printf '%s\\n' \"$LOGS\" | grep -c '\"level\":\"ERROR\"')\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[45.598924, "o", "\u001b[?2004h> RESTART_LOOP=false\r\n\u001b[?2004l\r\u001b[?2004h> if [ \"$RESTARTS\" -gt \"$RESTART_THRESHOLD\" ]; then\r\n\u001b[?2004l\r\u001b[?2004h>     RESTART_LOOP=true\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> TIMESTAMP=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.599051, "o", "cat <<REPORT\r\n\u001b[?2004l\r\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h>   \"service\": \"$SERVICE\","]
[45.599144, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
