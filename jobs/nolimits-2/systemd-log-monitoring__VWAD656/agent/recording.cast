[42.592976, "i", "cat > /opt/myapp/app.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"myapp: emits JSON-formatted log events to stdout.\"\"\"\nimport argparse\nimport datetime\nimport json\nimport logging\nimport sys\nimport time\n\nLEVEL_MAP = {'INFO': logging.INFO, 'WARN': logging.WARNING, 'ERROR': logging.ERROR}\n\n\nclass JsonFormatter(logging.Formatter):\n    def format(self, record):\n        ts = datetime.datetime.fromtimestamp(record.created, datetime.timezone.utc)\n        level = 'WARN' if record.levelname == 'WARNING' else record.levelname\n        payload = {\n            'timestamp': ts.strftime('%Y-%m-%dT%H:%M:%SZ'),\n            'level': level,\n            'message': record.getMessage(),\n            'service': 'myapp',\n        }\n        # compact separators so that the output matches '\"level\":\"ERROR\"' patterns\n        return json.dumps(payload, separators=(',', ':'))\n\n\ndef parse_args(argv):\n    parser = argparse.ArgumentParser(description='myapp JSON event logger')\n    parser.add_argument('--log-level', type=lambda s: s.upper(), default='IN"]
[42.593024, "i", "FO',\n                        choices=['INFO', 'WARN', 'ERROR'])\n    parser.add_argument('--interval', type=float, default=10.0,\n                        help='seconds between heartbeat events')\n    return parser.parse_args(argv)\n\n\ndef main(argv=None):\n    args = parse_args(argv)\n    handler = logging.StreamHandler(sys.stdout)\n    handler.setFormatter(JsonFormatter())\n    logger = logging.getLogger('myapp')\n    logger.handlers = [handler]\n    logger.propagate = False\n    logger.setLevel(LEVEL_MAP[args.log_level])\n\n    logger.info('Service started')\n    counter = 0\n    while True:\n        time.sleep(args.interval)\n        counter += 1\n        logger.info('Heartbeat %d', counter)\n        if counter % 3 == 0:\n            logger.warning('Queue depth above threshold')\n        if counter % 6 == 0:\n            logger.error('Simulated processing failure')\n        sys.stdout.flush()\n\n\nif __name__ == '__main__':\n    try:\n        main(sys.argv[1:])\n    except KeyboardInterrupt:\n        sys.exit(0)\nEOF\n"]
