[44.114052, "i", "cat > /etc/systemd/system/myapp.service << 'EOF'\n[Unit]\nDescription=myapp JSON event logger\nAfter=network.target systemd-journald.service\n\n[Service]\nType=simple\nUser=myapp\nGroup=myapp\nWorkingDirectory=/opt/myapp\nExecStart=/opt/myapp/app.py --log-level=INFO\nRestart=on-failure\nRestartSec=5\nSyslogIdentifier=myapp\nEnvironment=PYTHONUNBUFFERED=1\nStandardOutput=journal\nStandardError=journal\n\n[Install]\nWantedBy=multi-user.target\nEOF\n"]
