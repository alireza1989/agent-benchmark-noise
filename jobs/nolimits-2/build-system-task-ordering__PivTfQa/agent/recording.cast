[46.00013, "i", "cat > /app/solution.py << 'EOF'\nimport heapq\nimport json\nimport sys\n\nALLOWED = {'Depends', 'Before', 'After', 'Needs', 'Requires', 'Alias', 'Phony'}\n\n\nclass _ParseError(Exception):\n    pass\n\n\ndef _parse(lines):\n    blocks = []\n    cur = None\n    for raw in lines:\n        line = raw.strip()\n        if not line or line.startswith('#'):\n            continue\n        if line.startswith('[') and line.endswith(']'):\n            continue\n        tokens = line.split()\n        head = tokens[0]\n        if head == 'TARGET':\n            if len(tokens) != 2:\n                raise _ParseError()\n            cur = {'kind': 'T', 'name': tokens[1], 'id': None, 'dirs': []}\n            blocks.append(cur)\n        elif head == 'OVERRIDE':\n            if len(tokens) != 3:\n                raise _ParseError()\n            cur = {'kind': 'O', 'name': tokens[1], 'id': tokens[2], 'dirs': []}\n            blocks.append(cur)\n        else:\n            if cur is None:\n                raise _ParseError()\n            if line.count('=') != 1:\n   "]
[46.000623, "o", "cat > /app/solution.py << 'EOF'\r\n\u001b[?2004l\r"]
[46.000674, "i", "             raise _ParseError()\n            key, val = line.split('=', 1)\n            key = key.strip()\n            val = val.strip()\n            if key not in ALLOWED:\n                raise _ParseError()\n            if key == 'Phony':\n                if val not in ('yes', 'no'):\n                    raise _ParseError()\n                cur['dirs'].append(('Phony', val))\n            else:\n                cur['dirs'].append((key, val.split()))\n    return blocks\n\n\ndef _solve(lines):\n    blocks = _parse(lines)\n    if not blocks:\n        return '{\"order\":[],\"cycles\":[]}'\n\n    defined = set()\n    referenced = set()\n    parent = {}\n\n    def find(x):\n        parent.setdefault(x, x)\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(a, b):\n        ra = find(a)\n        rb = find(b)\n        if ra == rb:\n            return\n        if ra < rb:\n            parent[rb] = ra\n        else:\n            parent[ra] = rb\n\n    for b in blocks:\n        de"]
[46.001896, "o", "\u001b[?2004h> import heapq\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ALLOWED = {'Depends', 'Before', 'After', 'Needs', 'Requires', 'Alias', 'Phony'}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class _ParseError(Exception):\r\n\u001b[?2004l\r\u001b[?2004h>     pass\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _parse(lines):\r\n\u001b[?2004l\r\u001b[?2004h>     blocks = []\r\n\u001b[?2004l\r\u001b[?2004h>     cur = None\r\n\u001b[?2004l\r\u001b[?2004h>     for raw in lines:\r\n\u001b[?2004l\r\u001b[?2004h>         line = raw.strip()\r\n\u001b[?2004l\r\u001b[?2004h>         if not line or line.startswith('#'):\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.002014, "i", "fined.add(b['name'])\n        find(b['name'])\n        for key, vals in b['dirs']:\n            if key == 'Alias':\n                for v in vals:\n                    referenced.add(v)\n                    union(b['name'], v)\n            elif key != 'Phony':\n                for v in vals:\n                    referenced.add(v)\n\n    def canon(x):\n        return find(x)\n\n    nodes = set()\n    for n in defined | referenced:\n        nodes.add(canon(n))\n\n    tblocks = [b for b in blocks if b['kind'] == 'T']\n    oblocks = sorted([b for b in blocks if b['kind'] == 'O'], key=lambda b: b['id'])\n\n    adj = {n: set() for n in nodes}\n    phony = {}\n\n    for b in tblocks + oblocks:\n        u = canon(b['name'])\n        for key, vals in b['dirs']:\n            if key == 'Phony':\n                phony[u] = vals\n                continue\n            if key == 'Alias':\n                continue\n            for v in vals:\n                cv = canon(v)\n                if key in ('Depends', 'After'):\n                    adj[cv].add(u)\n   "]
[46.002069, "o", "        if line.startswith('[') and line.endswith(']'):\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.002081, "i", "             else:\n                    adj[u].add(cv)\n\n    index = {}\n    low = {}\n    stack = []\n    onstack = set()\n    sccs = []\n    counter = [0]\n\n    def strong(v):\n        index[v] = counter[0]\n        low[v] = counter[0]\n        counter[0] += 1\n        stack.append(v)\n        onstack.add(v)\n        for w in sorted(adj[v]):\n            if w not in index:\n                strong(w)\n                low[v] = min(low[v], low[w])\n            elif w in onstack:\n                low[v] = min(low[v], index[w])\n        if low[v] == index[v]:\n            comp = []\n            while True:\n                w = stack.pop()\n                onstack.discard(w)\n                comp.append(w)\n                if w == v:\n                    break\n            sccs.append(sorted(comp))\n\n    sys.setrecursionlimit(max(10000, 10 * len(nodes) + 1000))\n    for v in sorted(nodes):\n        if v not in index:\n            strong(v)\n\n    comp_of = {}\n    for i, c in enumerate(sccs):\n        for n in c:\n            comp_of[n] = i\n\n    cad"]
