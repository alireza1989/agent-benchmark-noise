[46.002585, "i", "j = {i: set() for i in range(len(sccs))}\n    for u in nodes:\n        for v in adj[u]:\n            if comp_of[u] != comp_of[v]:\n                cadj[comp_of[u]].add(comp_of[v])\n    indeg = {i: 0 for i in range(len(sccs))}\n    for i in cadj:\n        for j in cadj[i]:\n            indeg[j] += 1\n\n    heap = [(sccs[i][0], i) for i in range(len(sccs)) if indeg[i] == 0]\n    heapq.heapify(heap)\n    order = []\n    while heap:\n        _, i = heapq.heappop(heap)\n        order.extend(sccs[i])\n        for j in cadj[i]:\n            indeg[j] -= 1\n            if indeg[j] == 0:\n                heapq.heappush(heap, (sccs[j][0], j))\n\n    cycles = []\n    for c in sccs:\n        if len(c) >= 2 or (c[0] in adj[c[0]]):\n            cycles.append(sorted(c))\n    cycles.sort()\n\n    return json.dumps({'order': order, 'cycles': cycles}, separators=(',', ':'))\n\n\ndef solve(lines):\n    try:\n        return _solve(lines)\n    except _ParseError:\n        return 'PARSE_ERROR'\n\n\nif __name__ == '__main__':\n    print(solve(sys.stdin.read().splitlines"]
