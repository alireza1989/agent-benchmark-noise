[46.01366, "o", "\u001b[?2004h> "]
[46.013775, "o", "    return json.dumps({'order': order, 'cycles': cycles}, separators=(',', ':'))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[46.01386, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
