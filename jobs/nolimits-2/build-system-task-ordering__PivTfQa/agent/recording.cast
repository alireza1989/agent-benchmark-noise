[46.011752, "o", "    cadj = {i: set() for i in range(len(sccs))}\r\n\u001b[?2004l\r\u001b[?2004h>     for u in nodes:\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.011779, "o", "> "]
[46.011855, "o", "        for v in adj[u]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.011946, "o", "            if comp_of[u] != comp_of[v]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.012014, "o", "                cadj[comp_of[u]].add(comp_of[v])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.012095, "o", "    indeg = {i: 0 for i in range(len(sccs))}\r\n\u001b[?2004l\r\u001b[?2004h>     for i in cadj:\r\n\u001b[?2004l\r"]
[46.012201, "o", "\u001b[?2004h>         for j in cadj[i]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.012362, "o", "            indeg[j] += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.012379, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.012453, "o", "    heap = [(sccs[i][0], i) for i in range(len(sccs)) if indeg[i] == 0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.012534, "o", "> "]
[46.012558, "o", "    heapq.heapify(heap)\r\n\u001b[?2004l\r"]
[46.01263, "o", "\u001b[?2004h>     order = []\r\n\u001b[?2004l\r\u001b[?2004h>     while heap:\r\n\u001b[?2004l\r"]
[46.012711, "o", "\u001b[?2004h> "]
[46.012744, "o", "        _, i = heapq.heappop(heap)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.012825, "o", "        order.extend(sccs[i])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.01291, "o", "        for j in cadj[i]:\r\n\u001b[?2004l\r\u001b[?2004h>             indeg[j] -= 1\r\n\u001b[?2004l\r"]
[46.013077, "o", "\u001b[?2004h>             if indeg[j] == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.013157, "o", "                heapq.heappush(heap, (sccs[j][0], j))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[46.013181, "o", "\u001b[?2004l\r"]
[46.013284, "o", "\u001b[?2004h>     cycles = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.013579, "o", "    for c in sccs:\r\n\u001b[?2004l\r\u001b[?2004h>         if len(c) >= 2 or (c[0] in adj[c[0]]):\r\n\u001b[?2004l\r\u001b[?2004h>             cycles.append(sorted(c))\r\n\u001b[?2004l\r\u001b[?2004h>     cycles.sort()\r\n\u001b[?2004l\r"]
