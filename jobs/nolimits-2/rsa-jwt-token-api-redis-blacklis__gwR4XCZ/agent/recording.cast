[86.380811, "i", " = load_tokens()\n    if data is None:\n        return fail('no tokens file; run acquire first')\n    types = ['access', 'refresh'] if a.type == 'all' else [a.type]\n    rc = 0\n    for t in types:\n        token = data.get(t + '_token')\n        if not token:\n            rc = fail('no %s token stored' % t)\n            continue\n        try:\n            resp = http('POST', '/auth/revoke', json={'token': token})\n        except requests.RequestException as e:\n            rc = fail('cannot reach API: %s' % e)\n            continue\n        if resp.status_code != 200:\n            rc = fail('revoke %s failed (%d): %s' % (t, resp.status_code, body_error(resp)))\n            continue\n        data.setdefault('revoked', {})[t] = True\n        print('Revoked %s token jti=%s' % (t, resp.json().get('jti')))\n    save_tokens(data)\n    return rc\n\n\ndef cmd_retry(a):\n    data = load_tokens()\n    if data is not None and data.get('access_token'):\n        status, _ = check(data['access_token'])\n        if status == 200:\n            print('A"]
