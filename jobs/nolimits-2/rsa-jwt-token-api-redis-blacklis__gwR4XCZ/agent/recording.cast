[86.388264, "o", "    save_tokens(data)\r\n\u001b[?2004l\rt=D\u001b[?2004h> "]
[86.388495, "o", "    print('Tokens acquired for %s and saved to %s' % (a.username, TOKENS_FILE))\r\n\u001b[?2004l\r"]
[86.388613, "o", "\u001b[?2004h>     return 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\raults(func=cmd"]
[86.388695, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[86.388748, "o", "_\u001b[?2004h> def cmd_validate(a):\r\n\u001b[?2004l\rretry)\r\n    return p\r\n\r\n\u001b[?2004h"]
[86.388822, "o", ">     data = load_tokens()\r\n\u001b[?2004l\r\r\nif __name__ == '__main__"]
[86.388948, "o", "\u001b[?2004h> "]
[86.389071, "o", "    if data is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.389266, "o", "        return fail('no tokens file; run acquire first')\r\n\u001b[?2004l\rF\r\n\u001b[?2004h> "]
[86.389501, "o", "    token = data.get(a.type + '_token')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.389598, "o", "    if not token:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.389668, "o", "        return fail('no %s token stored' % a.type)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.389691, "o", "    status, info = check(token)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.389774, "o", "    if status == 200:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.389896, "o", "        print('VALID %s token: %s' % (a.type, json.dumps(info)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.39011, "o", ">         return 0\r\n\u001b[?2004l\r\u001b[?2004h>     if status == 401 and 'expired' in str(info):\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.390164, "o", "> "]
[86.390251, "o", "        log.warning('%s token expired', a.type)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.39039, "o", "        print('EXPIRED: %s token expired. Run: python3 /app/cli.py retry' % a.type)\r\n\u001b[?2004l\r"]
[86.390413, "o", "\u001b[?2004h> "]
[86.390481, "o", "        return 2\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.39051, "o", "> "]
[86.390709, "o", "    if status == 403:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.390738, "o", "        log.warning('%s token revoked', a.type)\r\n\u001b[?2004l\r"]
[86.390816, "o", "\u001b[?2004h> "]
[86.390889, "o", "        print('REVOKED: %s token has been revoked' % a.type)\r\n\u001b[?2004l\r\u001b[?2004h>         return 3\r\n\u001b[?2004l\r"]
[86.390953, "o", "\u001b[?2004h> "]
[86.391074, "o", "    return fail('validation failed (%s): %s' % (status, info), 4)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[86.391095, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[86.391142, "o", "\u001b[?2004h> "]
[86.391171, "o", "def cmd_revoke(a):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.391255, "o", "    data = load_tokens()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.391294, "o", "    if data is None:\r\n\u001b[?2004l\r"]
[86.391381, "o", "\u001b[?2004h> "]
[86.391503, "o", "        return fail('no tokens file; run acquire first')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.391721, "o", "    types = ['access', 'refresh'] if a.type == 'all' else [a.type]\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.39175, "o", ">     rc = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.39182, "o", "> "]
[86.391842, "o", "    for t in types:\r\n\u001b[?2004l\r"]
[86.391958, "o", "\u001b[?2004h>         token = data.get(t + '_token')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.391981, "o", "        if not token:\r\n\u001b[?2004l\r"]
[86.392133, "o", "\u001b[?2004h>             rc = fail('no %s token stored' % t)\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.392201, "o", ">             continue\r\n\u001b[?2004l\r"]
[86.392341, "o", "\u001b[?2004h>         try:"]
[86.392358, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.392473, "o", "            resp = http('POST', '/auth/revoke', json={'token': token})\r\n\u001b[?2004l\r\u001b[?2004h>         except requests.RequestException as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.392591, "o", "            rc = fail('cannot reach API: %s' % e)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.392658, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.392736, "o", "        if resp.status_code != 200:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.392821, "o", "            rc = fail('revoke %s failed (%d): %s' % (t, resp.status_code, body_error(resp)))\r\n\u001b[?2004l\r"]
[86.392908, "o", "\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.393008, "o", "        data.setdefault('revoked', {})[t] = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.393108, "o", "        print('Revoked %s token jti=%s' % (t, resp.json().get('jti')))\r\n\u001b[?2004l\r\u001b[?2004h>     save_tokens(data)\r\n\u001b[?2004l\r"]
[86.393186, "o", "\u001b[?2004h>     return rc\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.393272, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[86.393385, "o", "> def cmd_retry(a):\r\n\u001b[?2004l\r"]
[86.393455, "o", "\u001b[?2004h>     data = load_tokens()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.39358, "o", "    if data is not None and data.get('access_token'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.393683, "o", "        status, _ = check(data['access_token'])\r\n\u001b[?2004l\r\u001b[?2004h>         if status == 200:\r\n\u001b[?2004l\r"]
[86.393702, "o", "\u001b[?2004h> "]
[86.393833, "o", "            print('Access token still valid; nothing to retry')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.393916, "o", "            return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.394012, "o", "        if data.get('refresh_token') and status == 401:\r\n\u001b[?2004l\r\u001b[?2004h>             try:\r\n\u001b[?2004l\r"]
[86.394191, "o", "\u001b[?2004h>                 resp = http('POST', '/auth/refresh', json={'refresh_token': data['refresh_token']})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.394275, "o", "                if resp.status_code == 200:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.394379, "o", "                    data['access_token'] = resp.json()['access_token']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.394506, "o", "                    data['acquired_at'] = int(time.time())\r\n\u001b[?2004l\r\u001b[?2004h>                     save_tokens(data)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.394627, "o", "                    print('Access token refreshed via refresh token')\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.394644, "o", "> "]
[86.394742, "o", "                    return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.394799, "o", "            except requests.RequestException:\r\n\u001b[?2004l\r\u001b[?2004h>                 pass\r\n"]
[86.394845, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[86.394949, "o", "    username = data.get('username', a.username) if data else a.username\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.395031, "o", "    password = a.password\r\n\u001b[?2004l\r\u001b[?2004h>     last = 'unknown error'\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.395146, "o", "> "]
[86.395178, "o", "    for attempt in range(1, a.attempts + 1):"]
[86.395256, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.395372, "o", "        new, err = login(username, password)\r\n\u001b[?2004l\r\u001b[?2004h>         if not err:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.395442, "o", "            save_tokens(new)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.395519, "o", "            print('Tokens re-acquired on attempt %d' % attempt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.395622, "o", "            return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.395681, "o", "        last = err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.395752, "o", "        log.warning('retry attempt %d failed: %s', attempt, err)\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.395815, "o", "> "]
[86.395893, "o", "        print('Attempt %d failed: %s' % (attempt, err), file=sys.stderr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.396008, "o", "        if attempt < a.attempts:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.396033, "o", "            time.sleep(min(2 ** attempt, 10))\r\n\u001b[?2004l\r"]
[86.39608, "o", "\u001b[?2004h> "]
[86.396158, "o", "    return fail('all %d attempts failed: %s' % (a.attempts, last), 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.396171, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[86.396287, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> def build_parser():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.396371, "o", "    p = argparse.ArgumentParser(description='JWT auth CLI')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.396472, "o", "    sub = p.add_subparsers(dest='command', required=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.3966, "o", "    s = sub.add_parser('acquire', help='login and save tokens')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.396669, "o", "    s.add_argument('--username', default=DEFAULT_USER)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.396788, "o", "    s.add_argument('--password', default=DEFAULT_PASS)\r\n\u001b[?2004l\r\u001b[?2004h>     s.set_defaults(func=cmd_acquire)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[86.396813, "o", "\u001b[?2004h> "]
[86.396911, "o", "    s = sub.add_parser('validate', help='validate stored token')\r\n\u001b[?2004l\r"]
[86.396935, "o", "\u001b[?2004h> "]
[86.397046, "o", "    s.add_argument('--type', choices=['access', 'refresh'], default='access')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.39717, "o", "    s.set_defaults(func=cmd_validate)\r\n\u001b[?2004l\r"]
[86.397184, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.3973, "o", "    s = sub.add_parser('revoke', help='revoke stored token(s)')\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.397312, "o", "> "]
[86.397434, "o", "    s.add_argument('--type', choices=['access', 'refresh', 'all'], default='all')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.397511, "o", "    s.set_defaults(func=cmd_revoke)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.397629, "o", "    s = sub.add_parser('retry', help='refresh or re-acquire tokens if expired')\r\n\u001b[?2004l\r"]
[86.397691, "o", "\u001b[?2004h> "]
[86.397753, "o", "    s.add_argument('--username', default=DEFAULT_USER)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.397845, "o", "    s.add_argument('--password', default=DEFAULT_PASS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.397925, "o", "    s.add_argument('--attempts', type=int, default=3)\r\n\u001b[?2004l\r\u001b[?2004h>     s.set_defaults(func=cmd_retry)\r\n\u001b[?2004l\r"]
[86.397946, "o", "\u001b[?2004h>     return p\r\n\u001b[?2004l\r"]
[86.398003, "o", "\u001b[?2004h"]
[86.398027, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[86.398072, "o", "\u001b[?2004h> "]
[86.398215, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     args = build_parser().parse_args()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.398283, "o", "    sys.exit(args.func(args))\r\n\u001b[?2004l\r"]
[86.398353, "o", "\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[86.399137, "o", "\u001b[?2004hroot@6e47e4737225:/app# "]
