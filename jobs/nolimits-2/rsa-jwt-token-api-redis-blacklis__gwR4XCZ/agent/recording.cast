[85.487214, "i", "cat > /app/api.py <<'PYEOF'\nimport os\nimport uuid\nimport json\nimport time\nimport logging\nimport datetime as dt\n\nimport bcrypt\nimport jwt\nimport redis\nfrom flask import Flask, request, jsonify, Response\n\nISSUER = 'rsa-jwt-api'\nACCESS_TTL = dt.timedelta(minutes=15)\nREFRESH_TTL = dt.timedelta(days=7)\nPRIVATE_KEY_PATH = '/app/keys/private.pem'\nPUBLIC_KEY_PATH = '/app/keys/public.pem'\nLOG_PATH = '/app/logs/app.log'\n\nos.makedirs('/app/logs', exist_ok=True)\nlogging.basicConfig(filename=LOG_PATH, level=logging.INFO,\n                    format='%(asctime)s %(levelname)s api %(message)s')\nlog = logging.getLogger('api')\n\nwith open(PRIVATE_KEY_PATH) as f:\n    PRIVATE_KEY = f.read()\nwith open(PUBLIC_KEY_PATH) as f:\n    PUBLIC_KEY = f.read()\n\nUSERS = {'admin': bcrypt.hashpw(b'password123', bcrypt.gensalt())}\n\nREDIS = redis.Redis(host=os.environ.get('REDIS_HOST', 'localhost'),\n                    port=int(os.environ.get('REDIS_PORT', '6379')),\n                    db=0, decode_responses=True)\n\napp = Flask(__name__)\n\n\ndef now"]
[85.487386, "i", "_utc():\n    return dt.datetime.now(dt.timezone.utc)\n\n\ndef issue(sub, ttype, ttl):\n    t = now_utc()\n    claims = {'iss': ISSUER, 'sub': sub, 'iat': t, 'exp': t + ttl,\n              'jti': str(uuid.uuid4()), 'type': ttype}\n    return jwt.encode(claims, PRIVATE_KEY, algorithm='RS256')\n\n\ndef err(code, msg):\n    log.warning('%s %s', code, msg)\n    return jsonify(error=msg), code\n\n\ndef decode(token, verify_exp=True):\n    return jwt.decode(token, PUBLIC_KEY, algorithms=['RS256'], issuer=ISSUER,\n                      options={'verify_exp': verify_exp,\n                               'require': ['exp', 'iat', 'jti', 'sub', 'iss']})\n\n\ndef is_revoked(jti):\n    return REDIS.exists('blacklist:' + jti) == 1\n\n\n@app.get('/auth/public-key')\ndef public_key():\n    return Response(PUBLIC_KEY, mimetype='text/plain')\n\n\n@app.get('/health')\ndef health():\n    return jsonify(status='ok', redis=bool(REDIS.ping()))\n\n\n@app.post('/auth/login')\ndef login():\n    data = request.get_json(silent=True) or {}\n    username = str(data.get('usernam"]
