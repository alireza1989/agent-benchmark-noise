[101.652095, "i", "RT=$(python3 -c \"import json;print(json.load(open('/app/tokens.json'))['refresh_token'])\"); curl -s -o /dev/null -w 'refresh HTTP %{http_code}\\n' -X POST -H 'Content-Type: application/json' -d \"{\\\"refresh_token\\\":\\\"$RT\\\"}\" http://127.0.0.1:5000/auth/refresh; curl -s -w ' HTTP %{http_code}\\n' -H 'Authorization: Bearer garbage.token.here' http://127.0.0.1:5000/auth/validate; curl -s -o /dev/null -w 'private key route HTTP %{http_code}\\n' http://127.0.0.1:5000/keys/private.pem; curl -s -o /dev/null -w 'public key route HTTP %{http_code}\\n' http://127.0.0.1:5000/auth/public-key\n"]
[101.653563, "o", "RT=$(python3 -c \"import json;print(json.load(open('/app/tokens.json'))['refresh_token'])\"); curl -s -o /dev/null -w 'refresh HTTP %{http_code}\\n' -X POST -H 'Content-Type: application/json' -d \"{\\\"refresh_token\\\":\\\"$RT\\\"}\" http://127.0.0.1:5000/auth/refresh; curl -s -w ' HTTP %{http_code}\\n' -H 'Authorization: Bearer garbage.token.here' http://127.0.0.1:5000/auth/validate; curl -s -o /dev/null -w 'private key route HTTP %{http_code}\\n' http://127.0.0.1:5000/keys/private.pem; curl -s -o /dev/null -w 'public key route HTTP %{http_code}\\n' http://127.0.0.1:5000/auth/public-key\r\n\u001b[?2004l\r"]
