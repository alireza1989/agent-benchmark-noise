[86.380042, "i", "cat > /app/cli.py <<'PYEOF'\n#!/usr/bin/env python3\nimport argparse\nimport json\nimport logging\nimport os\nimport sys\nimport time\n\nimport requests\n\nAPI = os.environ.get('API_URL', 'http://127.0.0.1:5000')\nTOKENS_FILE = '/app/tokens.json'\nLOG_PATH = '/app/logs/app.log'\nDEFAULT_USER = 'admin'\nDEFAULT_PASS = 'password123'\n\nos.makedirs('/app/logs', exist_ok=True)\nlogging.basicConfig(filename=LOG_PATH, level=logging.INFO,\n                    format='%(asctime)s %(levelname)s cli %(message)s')\nlog = logging.getLogger('cli')\n\n\ndef fail(msg, code=1):\n    log.error(msg)\n    print('ERROR: ' + msg, file=sys.stderr)\n    return code\n\n\ndef load_tokens():\n    if not os.path.exists(TOKENS_FILE):\n        return None\n    with open(TOKENS_FILE) as f:\n        return json.load(f)\n\n\ndef save_tokens(data):\n    with open(TOKENS_FILE, 'w') as f:\n        json.dump(data, f, indent=2)\n\n\ndef http(method, path, **kw):\n    kw.setdefault('timeout', 10)\n    return requests.request(method, API + path, **kw)\n\n\ndef body_error(resp):\n    try:\n     "]
[86.380216, "i", "   return resp.json().get('error', resp.text)\n    except ValueError:\n        return resp.text\n\n\ndef login(username, password):\n    try:\n        resp = http('POST', '/auth/login', json={'username': username, 'password': password})\n    except requests.RequestException as e:\n        return None, 'cannot reach API: %s' % e\n    if resp.status_code != 200:\n        return None, 'login failed (%d): %s' % (resp.status_code, body_error(resp))\n    d = resp.json()\n    return {'username': username,\n            'access_token': d['access_token'],\n            'refresh_token': d['refresh_token'],\n            'acquired_at': int(time.time()),\n            'revoked': {'access': False, 'refresh': False}}, None\n\n\ndef check(token):\n    try:\n        resp = http('GET', '/auth/validate', headers={'Authorization': 'Bearer ' + token})\n    except requests.RequestException as e:\n        return 0, 'cannot reach API: %s' % e\n    if resp.status_code == 200:\n        return 200, resp.json()\n    return resp.status_code, body_error(resp)\n\n\ndef cm"]
[86.380489, "o", "cat > /app/cli.py <<'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.380516, "i", "d_acquire(a):\n    data, err = login(a.username, a.password)\n    if err:\n        return fail(err)\n    save_tokens(data)\n    print('Tokens acquired for %s and saved to %s' % (a.username, TOKENS_FILE))\n    return 0\n\n\ndef cmd_validate(a):\n    data = load_tokens()\n    if data is None:\n        return fail('no tokens file; run acquire first')\n    token = data.get(a.type + '_token')\n    if not token:\n        return fail('no %s token stored' % a.type)\n    status, info = check(token)\n    if status == 200:\n        print('VALID %s token: %s' % (a.type, json.dumps(info)))\n        return 0\n    if status == 401 and 'expired' in str(info):\n        log.warning('%s token expired', a.type)\n        print('EXPIRED: %s token expired. Run: python3 /app/cli.py retry' % a.type)\n        return 2\n    if status == 403:\n        log.warning('%s token revoked', a.type)\n        print('REVOKED: %s token has been revoked' % a.type)\n        return 3\n    return fail('validation failed (%s): %s' % (status, info), 4)\n\n\ndef cmd_revoke(a):\n    data"]
