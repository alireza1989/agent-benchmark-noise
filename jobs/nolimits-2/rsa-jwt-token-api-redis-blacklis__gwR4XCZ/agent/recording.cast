[86.381022, "i", "iled: %s', attempt, err)\n        print('Attempt %d failed: %s' % (attempt, err), file=sys.stderr)\n        if attempt < a.attempts:\n            time.sleep(min(2 ** attempt, 10))\n    return fail('all %d attempts failed: %s' % (a.attempts, last), 1)\n\n\ndef build_parser():\n    p = argparse.ArgumentParser(description='JWT auth CLI')\n    sub = p.add_subparsers(dest='command', required=True)\n\n    s = sub.add_parser('acquire', help='login and save tokens')\n    s.add_argument('--username', default=DEFAULT_USER)\n    s.add_argument('--password', default=DEFAULT_PASS)\n    s.set_defaults(func=cmd_acquire)\n\n    s = sub.add_parser('validate', help='validate stored token')\n    s.add_argument('--type', choices=['access', 'refresh'], default='access')\n    s.set_defaults(func=cmd_validate)\n\n    s = sub.add_parser('revoke', help='revoke stored token(s)')\n    s.add_argument('--type', choices=['access', 'refresh', 'all'], default='all')\n    s.set_defaults(func=cmd_revoke)\n\n    s = sub.add_parser('retry', help='refresh or re-acquire"]
[86.381042, "i", " tokens if expired')\n    s.add_argument('--username', default=DEFAULT_USER)\n    s.add_argument('--password', default=DEFAULT_PASS)\n    s.add_argument('--attempts', type=int, default=3)\n    s.set_defaults(func=cmd_retry)\n    return p\n\n\nif __name__ == '__main__':\n    args = build_parser().parse_args()\n    sys.exit(args.func(args))\nPYEOF\npython3 -m py_compile /app/cli.py && echo CLI_OK\n"]
