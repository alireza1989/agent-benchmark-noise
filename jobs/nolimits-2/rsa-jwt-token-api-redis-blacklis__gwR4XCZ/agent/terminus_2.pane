@app.post('/auth/revoke')
def revoke():
    data = request.get_json(silent=True) or {}
    token = data.get('token', '')
    try:
        claims = decode(token, verify_exp=False)
    except jwt.PyJWTError as e:
        return err(401, 'invalid token: %s' % e)
    ttl = int(claims['exp'] - time.time())
    if ttl < 1:
        ttl = 1
    REDIS.set('blacklist:' + claims['jti'],
              json.dumps({'sub': claims['sub'], 'type': claims.get('type')}), ex=ttl)
    log.info('revoked jti=%s type=%s ttl=%s', claims['jti'], claims.get('type'), ttl)
    return jsonify(revoked=True, jti=claims['jti'], type=claims.get('type'), ttl=ttl)


