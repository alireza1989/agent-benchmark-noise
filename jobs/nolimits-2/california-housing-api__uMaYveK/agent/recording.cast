[72.653468, "i", "cat > /app/api_test.py << 'EOF'\nimport json\nimport pickle\nimport numpy as np\nimport pandas as pd\nimport requests\nfrom sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n\ndf = pd.read_csv('/app/data/train.csv').reset_index(drop=True)\nsplit = json.load(open('/app/output/split_info.json'))\nval_idx = split['validation_indices']\nfeats = [c for c in df.columns if c != 'target']\nval_df = df.iloc[val_idx]\nX_val = val_df[feats].values\ny_val = val_df['target'].values\n\nurl = 'http://localhost:8000/predict'\npreds = []\nfor row in X_val:\n    r = requests.post(url, json={'features': [float(v) for v in row]})\n    r.raise_for_status()\n    preds.append(r.json()['prediction'])\npreds = np.array(preds)\n\nout = pd.DataFrame({\n    'sample_index': np.arange(len(y_val)),\n    'y_true': y_val,\n    'y_pred': preds,\n    'absolute_error': np.abs(y_val - preds),\n})\nout.to_csv('/app/output/api_predictions.csv', index=False)\n\nmse = mean_squared_error(y_val, preds)\nmetrics = {\n    'sample_count': int(len(y_val)),\n    'mae"]
[72.653515, "i", "': float(mean_absolute_error(y_val, preds)),\n    'mse': float(mse),\n    'rmse': float(np.sqrt(mse)),\n    'r2_score': float(r2_score(y_val, preds)),\n}\njson.dump(metrics, open('/app/output/api_metrics.json', 'w'), indent=2)\nprint(metrics)\n\nmodel = pickle.load(open('/app/models/best_model.pkl', 'rb'))\ndirect = model.predict(X_val)\nprint('max abs diff API vs direct:', float(np.max(np.abs(direct - preds))))\nEOF\ncd /app && python3 api_test.py\n"]
