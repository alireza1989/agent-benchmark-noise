[57.934231, "i", "cat > /app/api/app.py << 'EOF'\nimport pickle\nfrom contextlib import asynccontextmanager\nfrom typing import List\n\nfrom fastapi import FastAPI\nfrom pydantic import BaseModel, Field\n\nMODEL_NAME = 'best_model'\nmodel = None\nmodel_type = None\n\n\n@asynccontextmanager\nasync def lifespan(app):\n    global model, model_type\n    with open('/app/models/best_model.pkl', 'rb') as f:\n        model = pickle.load(f)\n    model_type = type(model).__name__\n    yield\n\n\napp = FastAPI(lifespan=lifespan)\n\n\nclass PredictRequest(BaseModel):\n    features: List[float] = Field(..., min_length=8, max_length=8)\n\n\nclass BatchRequest(BaseModel):\n    features_list: List[List[float]]\n\n\n@app.post('/predict')\ndef predict(req: PredictRequest):\n    pred = model.predict([req.features])[0]\n    return {'prediction': float(pred), 'model_name': MODEL_NAME}\n\n\n@app.get('/health')\ndef health():\n    return {'status': 'healthy', 'model_loaded': model is not None}\n\n\n@app.get('/model-info')\ndef model_info():\n    return {'model_name': MODEL_NAME, 'model_type': m"]
[57.935584, "o", "cat > /app/api/app.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import pickle\r\n\u001b[?2004l\r\u001b[?2004h> from contextlib import asynccontextmanager\r\n\u001b[?2004l\r\u001b[?2004h> from typing import List\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from fastapi import FastAPI\r\n\u001b[?2004l\r\u001b[?2004h> from pydantic import BaseModel, Field\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> MODEL_NAME = 'best_model'\r\n\u001b[?2004l\r\u001b[?2004h> model = None\r\n\u001b[?2004l\r\u001b[?2004h> model_type = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @asynccontextmanager\r\n\u001b[?2004l\r\u001b[?2004h> async def lifespan(app):\r\n\u001b[?2004l\r\u001b[?2004h>     global model, model_type\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.935641, "i", "odel_type, 'features_count': 8}\n\n\n@app.post('/predict-batch')\ndef predict_batch(req: BatchRequest):\n    for row in req.features_list:\n        if len(row) != 8:\n            from fastapi import HTTPException\n            raise HTTPException(status_code=422, detail='Each inner array must have exactly 8 features')\n    preds = model.predict(req.features_list)\n    return {'predictions': [float(p) for p in preds], 'model_name': MODEL_NAME, 'count': len(preds)}\nEOF\ncd /app && (nohup uvicorn api.app:app --host 0.0.0.0 --port 8000 > /app/output/uvicorn.log 2>&1 &) && sleep 5 && curl -s http://localhost:8000/health && echo\n"]
