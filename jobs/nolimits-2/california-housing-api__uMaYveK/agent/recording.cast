[22.967096, "i", "cat > /app/train.py << 'EOF'\nimport json, pickle, shutil\nimport numpy as np\nimport pandas as pd\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.linear_model import LinearRegression, Ridge\nfrom sklearn.ensemble import RandomForestRegressor\nfrom sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n\ndf = pd.read_csv('/app/data/train.csv').reset_index(drop=True)\nfeats = [c for c in df.columns if c != 'target']\nidx = np.arange(len(df))\ntr_idx, va_idx = train_test_split(idx, test_size=0.2, random_state=42)\ntr_idx = np.sort(tr_idx)\nva_idx = np.sort(va_idx)\ntrain_df = df.iloc[tr_idx]\nval_df = df.iloc[va_idx]\nX_train, y_train = train_df[feats], train_df['target']\nX_val, y_val = val_df[feats], val_df['target']\n\nsplit_info = {\n    'train_size': int(len(tr_idx)),\n    'validation_size': int(len(va_idx)),\n    'random_state': 42,\n    'test_size': 0.2,\n    'train_indices': [int(i) for i in tr_idx],\n    'validation_indices': [int(i) for i in va_idx],\n}\njson.dump(split_info, open('/app/out"]
[22.967163, "i", "put/split_info.json', 'w'))\n\nmodels = {\n    'linear_regression': LinearRegression(),\n    'ridge': Ridge(alpha=1.0),\n    'random_forest': RandomForestRegressor(n_estimators=200, random_state=42, n_jobs=-1),\n}\nresults = []\nfitted = {}\nfor name, m in models.items():\n    m.fit(X_train, y_train)\n    pred_val = m.predict(X_val)\n    mse = mean_squared_error(y_val, pred_val)\n    results.append({\n        'model_name': name,\n        'train_r2': float(r2_score(y_train, m.predict(X_train))),\n        'val_r2': float(r2_score(y_val, pred_val)),\n        'mae': float(mean_absolute_error(y_val, pred_val)),\n        'mse': float(mse),\n        'rmse': float(np.sqrt(mse)),\n    })\n    fitted[name] = m\n    with open('/app/models/%s.pkl' % name, 'wb') as f:\n        pickle.dump(m, f)\n    print(results[-1])\n\nbest = max(results, key=lambda r: r['val_r2'])\nbest_name = best['model_name']\nshutil.copy('/app/models/%s.pkl' % best_name, '/app/models/best_model.pkl')\njson.dump({'models': results, 'best_model_name': best_name}, open('/app/outp"]
[22.967323, "i", "ut/model_comparison.json', 'w'), indent=2)\nprint('BEST', best_name)\nEOF\ncd /app && python3 train.py\n"]
