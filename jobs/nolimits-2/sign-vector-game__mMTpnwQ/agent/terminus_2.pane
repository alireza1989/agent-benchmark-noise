[?2004l[?2004h> import math
[?2004l[?2004h> S = [list(map(int, l.split())) for l in open('signs.txt') if l.strip()]
[?2004l[?2004h> v = list(map(float, open('sum.txt').read().split()))
[?2004l[?2004h> n = len(S)
[?2004l[?2004h> d = len(v)
[?2004l[?2004h> 
[?2004l[?2004h> def dot(a, b):
[?2004l[?2004h>     return sum(x * y for x, y in zip(a, b))
[?2004l[?2004h> 
[?2004l[?2004h> def solve(A, b):
[?2004l[?2004h>     m = len(b)
[?2004l[?2004h>     M = [A[i][:] + [b[i]] for i in range(m)]
[?2004l[?2004h>     for c in range(m):
[?2004l[?2004h>         p = max(range(c, m), key=lambda r: abs(M[r][c]))
[?2004l[?2004h>         if abs(M[p][c]) < 1e-12:
[?2004l[?2004h>             return [0.0] * m
[?2004l[?2004h>         M[c], M[p] = M[p], M[c]
[?2004l[?2004h>         for r in range(m):
[?2004l[?2004h>             if r != c:
[?2004l[?2004h>                 f = M[r][c] / M[c][c]
[?2004l[?2004h>                 for k in range(c, m + 1):
[?2004l[?2004h>                     M[r][k] -= f * M[c][k]
[?2004l[?2004h>     return [M[i][m] / M[i][i] for i in range(m)]
[?2004l[?2004h> 
[?2004l[?2004h> def fit(sel):
[?2004l[?2004h>     G = [[dot(S[a], S[b]) for b in sel] for a in sel]
[?2004l[?2004h>     bb = [dot(S[a], v) for a in sel]
[?2004l[?2004h>     x = solve(G, bb)
[?2004l[?2004h>     r = [v[t] - sum(x[j] * S[sel[j]][t] for j in range(len(sel))) for t in range(d)]
[?2004l[?2004h>     return math.sqrt(sum(q * q for q in r)), x, r
[?2004l[?2004h> 
[?2004l[?2004h> sel = []
[?2004l[?2004h> r = v[:]
[?2004l[?2004h> for step in range(16):
[?2004l[?2004h>     best, bc = None, -1.0
[?2004l[?2004h>     for i in range(n):
[?2004l[?2004h>         if i in sel:
[?2004l[?2004h>             continue
[?2004l[?2004h>         c = abs(dot(S[i], r))
[?2004l[?2004h>         if c > bc:
[?2004l[?2004h>             bc, best = c, i
[?2004l[?2004h>     sel.append(best)
[?2004l[?2004h>     res, x, r = fit(sel)
[?2004l[?2004h>     print('step', step + 1, 'added', best + 1, 'residual', res)
[?2004l[?2004h> 
[?2004l[?2004h> print('final residual', res)
