[6.372354, "o", "\u001b[?2004hroot@baadd6ad8ba5:/app# "]
[22.512276, "i", "cat > solve.py << 'EOF'\nimport math\nS = [list(map(int, l.split())) for l in open('signs.txt') if l.strip()]\nv = list(map(float, open('sum.txt').read().split()))\nn = len(S)\nd = len(v)\n\ndef dot(a, b):\n    return sum(x * y for x, y in zip(a, b))\n\ndef solve(A, b):\n    m = len(b)\n    M = [A[i][:] + [b[i]] for i in range(m)]\n    for c in range(m):\n        p = max(range(c, m), key=lambda r: abs(M[r][c]))\n        if abs(M[p][c]) < 1e-12:\n            return [0.0] * m\n        M[c], M[p] = M[p], M[c]\n        for r in range(m):\n            if r != c:\n                f = M[r][c] / M[c][c]\n                for k in range(c, m + 1):\n                    M[r][k] -= f * M[c][k]\n    return [M[i][m] / M[i][i] for i in range(m)]\n\ndef fit(sel):\n    G = [[dot(S[a], S[b]) for b in sel] for a in sel]\n    bb = [dot(S[a], v) for a in sel]\n    x = solve(G, bb)\n    r = [v[t] - sum(x[j] * S[sel[j]][t] for j in range(len(sel))) for t in range(d)]\n    return math.sqrt(sum(q * q for q in r)), x, r\n\nsel = []\nr = v[:]\nfor step in range(16):\n    best, bc = None, -1.0\n    for i in range(n):\n        if i in sel:\n            continue\n        c = abs(dot(S[i], r))\n        if c > bc:\n            bc, best = c, i\n    sel.append(best)\n    res, x, r = fit(sel)\n    print('step', step + 1, 'added', best + 1, 'residual', res)\n\nprint('final residual', res)\nout = sorted(i + 1 for i in sel)\nprint(out)\nopen('players.txt', 'w').write('\\n'.join(map(str, out)) + '\\n')\nEOF\n"]
[22.514256, "o", "cat > solve.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import math\r\n\u001b[?2004l\r\u001b[?2004h> S = [list(map(int, l.split())) for l in open('signs.txt') if l.strip()]\r\n\u001b[?2004l\r\u001b[?2004h> "]
