each API: %s' % e\n    if resp.status_code == 200:\n        return 200, resp.json()\n    return resp.status_code, body_error(resp)\n\n\ndef cmd_acquire(a):\n    data, err = login(a.username, a.password)\n    if err:\n        return fail(err)\n    save_tokens(data)\n    print('Tokens acquired for %s and saved to %s' % (a.username, TOKENS_FILE))\n    return 0\n\n\ndef cmd_validate(a):\n    data = load_tokens()\n    if data is None:\n        return fail('no tokens file; run acquire first')\n    token = data.get(a.type + '_token')\n    if not token:\n        return fail('no %s token stored' % a.type)\n    status, info = check(token)\n    if status == 200:\n        print('VALID %s token: %s' % (a.type, json.dumps(info)))\n        return 0\n    if status == 401 and 'expired' in str(info):\n        log.warning('%s token expired', a.type)\n        print('EXPIRED: %s token expired. Run: python3 /app/cli.py retry' % a.type)\n        return 2\n    if status == 403:\n        log.warning('%s token revoked', a.type)\n        print('REVOKED: %s token has been revoked' % a.type)\n        return 3\n    return fail('validation failed (%s): %s' % (status, info), 4)\n\n\ndef cmd_revoke(a):\n    data = load_tokens()\n    if data is None:\n        return fail('no tokens file; run acquire first')\n    types = ['access', 'refresh'] if a.type == 'all' else [a.type]\n    rc = 0\n    for t in types:\n        token = data.get(t + '_token')\n        if not token:\n            rc = fail('no %s token stored' % t)\n            continue\n        try:\n            resp = http('POST', '/auth/revoke', json={'token': token})\n        except requests.RequestException as e:\n            rc = fail('cannot reach API: %s' % e)\n            continue\n        if resp.status_code != 200:\n            rc = fail('revoke %s failed (%d): %s' % (t, resp.status_code, body_error(resp)))\n            continue\n        data.setdefault('revoked', {})[t] = True\n        print('Revoked %s token jti=%s' % (t, resp.json().g