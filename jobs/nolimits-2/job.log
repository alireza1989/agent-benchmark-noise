DIS.ping()))\n\n\n@app.post('/auth/login')\ndef login():\n    data = request.get_json(silent=True) or {}\n    username = str(data.get('username', ''))\n    password = str(data.get('password', ''))\n    hashed = USERS.get(username)\n    if not hashed or not bcrypt.checkpw(password.encode(), hashed):\n        return err(401, 'invalid credentials')\n    access = issue(username, 'access', ACCESS_TTL)\n    refresh = issue(username, 'refresh', REFRESH_TTL)\n    log.info('login ok user=%s', username)\n    return jsonify(access_token=access, refresh_token=refresh, token_type='Bearer',\n                   access_expires_in=int(ACCESS_TTL.total_seconds()),\n                   refresh_expires_in=int(REFRESH_TTL.total_seconds()))\n\n\n@app.post('/auth/refresh')\ndef refresh():\n    data = request.get_json(silent=True) or {}\n    token = data.get('refresh_token', '')\n    try:\n        claims = decode(token)\n    except jwt.ExpiredSignatureError:\n        return err(401, 'refresh token expired')\n    except jwt.PyJWTError as e:\n        return err(401, 'invalid refresh token: %s' % e)\n    if claims.get('type') != 'refresh':\n        return err(401, 'not a refresh token')\n    if is_revoked(claims['jti']):\n        return err(403, 'token revoked')\n    access = issue(claims['sub'], 'access', ACCESS_TTL)\n    return jsonify(access_token=access, token_type='Bearer',\n                   access_expires_in=int(ACCESS_TTL.total_seconds()))\n\n\n@app.post('/auth/revoke')\ndef revoke():\n    data = request.get_json(silent=True) or {}\n    token = data.get('token', '')\n    try:\n        claims = decode(token, verify_exp=False)\n    except jwt.PyJWTError as e:\n        return err(401, 'invalid token: %s' % e)\n    ttl = int(claims['exp'] - time.time())\n    if ttl < 1:\n        ttl = 1\n    REDIS.set('blacklist:' + claims['jti'],\n              json.dumps({'sub': claims['sub'], 'type': claims.get('type')}), ex=ttl)\n    log.info('revoked jti=%s type=%s ttl=%s', claims['jti'], claims.get(