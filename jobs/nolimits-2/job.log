Sending keys: ['cat > /app/solution.py << \'EOF\'\nimport heapq\nimport json\nimport sys\n\nALLOWED = {\'Depends\', \'Before\', \'After\', \'Needs\', \'Requires\', \'Alias\', \'Phony\'}\n\n\nclass _ParseError(Exception):\n    pass\n\n\ndef _parse(lines):\n    blocks = []\n    cur = None\n    for raw in lines:\n        line = raw.strip()\n        if not line or line.startswith(\'#\'):\n            continue\n        if line.startswith(\'[\') and line.endswith(\']\'):\n            continue\n        tokens = line.split()\n        head = tokens[0]\n        if head == \'TARGET\':\n            if len(tokens) != 2:\n                raise _ParseError()\n            cur = {\'kind\': \'T\', \'name\': tokens[1], \'id\': None, \'dirs\': []}\n            blocks.append(cur)\n        elif head == \'OVERRIDE\':\n            if len(tokens) != 3:\n                raise _ParseError()\n            cur = {\'kind\': \'O\', \'name\': tokens[1], \'id\': tokens[2], \'dirs\': []}\n            blocks.append(cur)\n        else:\n            if cur is None:\n                raise _ParseError()\n            if line.count(\'=\') != 1:\n                raise _ParseError()\n            key, val = line.split(\'=\', 1)\n            key = key.strip()\n            val = val.strip()\n            if key not in ALLOWED:\n                raise _ParseError()\n            if key == \'Phony\':\n                if val not in (\'yes\', \'no\'):\n                    raise _ParseError()\n                cur[\'dirs\'].append((\'Phony\', val))\n            else:\n                cur[\'dirs\'].append((key, val.split()))\n    return blocks\n\n\ndef _solve(lines):\n    blocks = _parse(lines)\n    if not blocks:\n        return \'{"order":[],"cycles":[]}\'\n\n    defined = set()\n    referenced = set()\n    parent = {}\n\n    def find(x):\n        parent.setdefault(x, x)\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(a, b):\n        ra = find(a)\n        rb = find(b)\n        if ra == rb:\n            return\n        if ra < rb:\n            parent[rb] = ra\n        else:\n            parent[ra] = rb\n\n    for b in blocks:\n        defined.add(b[\'name\'])\n        find(b[\'name\'])\n        for key, vals in b[\'dirs\']:\n            if key == \'Alias\':\n                for v in vals:\n                    referenced.add(v)\n                    union(b[\'name\'], v)\n            elif key != \'Phony\':\n                for v in vals:\n                    referenced.add(v)\n\n    def canon(x):\n        return find(x)\n\n    nodes = set()\n    for n in defined | referenced:\n        nodes.add(canon(n))\n\n    tblocks = [b for b in blocks if b[\'kind\'] == \'T\']\n    oblocks = sorted([b for b in blocks if b[\'kind\'] == \'O\'], key=lambda b: b[\'id\'])\n\n    adj = {n: set() for n in nodes}\n    phony = {}\n\n    for b in tblocks + oblocks:\n        u = canon(b[\'name\'])\n        for key, vals in b[\'dirs\']:\n            if key == \'Phony\':\n                phony[u] = vals\n                continue\n            if key == \'Alias\':\n                continue\n            for v in vals:\n                cv = canon(v)\n                if key in (\'Depends\', \'After\'):\n                    adj[cv].add(u)\n                else:\n                    adj[u].add(cv)\n\n    index = {}\n    low = {}\n    stack = []\n    onstack = set()\n    sccs = []\n    counter = [0]\n\n    def strong(v):\n        index[v] = counter[0]\n        low[v] = counter[0]\n        counter[0] += 1\n        stack.append(v)\n        onstack.add(v)\n        for w in sorted(adj[v]):\n            if w not in index:\n                strong(w)\n                low[v] = min(low[v], low[w])\n            elif w in onstack:\n                low[v] = min(low[v], index[w])\n        if low[v] == index[v]:\n            comp = []\n            while True:\n                w = stack.pop()\n                onstack.discard(w)\n                comp.append(w)\n                if w == v:\n                    break\n            sccs.append(sorted(comp))\n\n    sys.setrecursionlimit(max(10000, 10 * len(nodes) + 1000))\n    for v in sorted(nodes):\n        if v not in index:\n            strong(v)\n\n    comp_of = {}\n    for i, c in enumerate(sccs):\n        for n in c:\n            comp_of[n] = i\n\n    cadj = {i: set() for i in range(len(sccs))}\n    for u in nodes:\n        for v in adj[u]:\n            if comp_of[u] != comp_of[v]:\n                cadj[comp_of[u]].add(comp_of[v])\n    indeg = {i: 0 for i in range(len(sccs))}\n    for i in cadj:\n        for j in cadj[i]:\n            indeg[j] += 1\n\n    heap = [(sccs[i][0], i) for i in range(len(sccs)) if indeg[i] == 0]\n    heapq.heapify(heap)\n    order = []\n    while heap:\n        _, i = heapq.heappop(heap)\n        order.extend(sccs[i])\n        for j in cadj[i]:\n            indeg[j] -= 1\n            if indeg[j] == 0:\n                heapq.heappush(heap, (sccs[j][0], j))\n\n    cycles = []\n    for c in sccs:\n        if len(c) >= 2 or (c[0] in adj[c[0]]):\n            cycles.append(sorted(c))\n    cycles.sort()\n\n    return json.dumps({\'order\': order, \'cycles\': cycles}, separators=(\',\', \':\'))\n\n\ndef solve(lines):\n    try:\n        return _solve(lines)\n    except _ParseError:\n        return \'PARSE_ERROR\'\n\n\nif __name__ == \'__main__\':\n    print(solve(sys.stdin.read().splitlines()))\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
