--type', choices=['access', 'refresh'], default='access')\n    s.set_defaults(func=cmd_validate)\n\n    s = sub.add_parser('revoke', help='revoke stored token(s)')\n    s.add_argument('--type', choices=['access', 'refresh', 'all'], default='all')\n    s.set_defaults(func=cmd_revoke)\n\n    s = sub.add_parser('retry', help='refresh or re-acquire tokens if expired')\n    s.add_argument('--username', default=DEFAULT_USER)\n    s.add_argument('--password', default=DEFAULT_PASS)\n    s.add_argument('--attempts', type=int, default=3)\n    s.set_defaults(func=cmd_retry)\n    return p\n\n\nif __name__ == '__main__':\n    args = build_parser().parse_args()\n    sys.exit(args.func(args))\nPYEOF\npython3 -m py_compile /app/cli.py && echo CLI_OK\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
