Sending keys: ['cat > /app/service.py << \'EOF\'\nimport csv\nimport os\nimport shutil\nfrom collections import defaultdict\nfrom typing import List, Dict, Tuple\nfrom fastapi import FastAPI, HTTPException, Query\nfrom pydantic import BaseModel\n\napp = FastAPI()\n\nDATA_PATH = \'/app/data.csv\'\nCHUNK_DIR = \'/app/chunks\'\nFIELDNAMES = [\'Type1\', \'Type2\', \'Text\', \'ID\']\n\n# (Type1, Type2) -> path of chunk file\nchunk_index: Dict[Tuple[str, str], str] = {}\nall_type1_values = set()\nall_type2_values = set()\ntotal_records = 0\n\nlast_loaded_type1_values = set()\nlast_loaded_type2_values = set()\n\n\nclass Record(BaseModel):\n    Type1: str\n    Type2: str\n    Text: str\n    ID: int\n\n\ndef build_chunks():\n    """Split data.csv into one CSV chunk file per (Type1, Type2) combination."""\n    global total_records\n    chunk_index.clear()\n    all_type1_values.clear()\n    all_type2_values.clear()\n    total_records = 0\n\n    if os.path.isdir(CHUNK_DIR):\n        shutil.rmtree(CHUNK_DIR)\n    os.makedirs(CHUNK_DIR)\n\n    groups = defaultdict(list)\n    with open(DATA_PATH, \'r\', newline=\'\') as f:\n        for row in csv.DictReader(f):\n            groups[(row[\'Type1\'], row[\'Type2\'])].append({\n                \'Type1\': row[\'Type1\'],\n                \'Type2\': row[\'Type2\'],\n                \'Text\': row[\'Text\'],\n                \'ID\': int(row[\'ID\'])\n            })\n\n    for n, key in enumerate(sorted(groups), start=1):\n        rows = sorted(groups[key], key=lambda r: r[\'ID\'])\n        path = os.path.join(CHUNK_DIR, f\'chunk_{n:04d}.csv\')\n        with open(path, \'w\', newline=\'\') as f:\n            writer = csv.DictWriter(f, fieldnames=FIELDNAMES)\n            writer.writeheader()\n            writer.writerows(rows)\n        chunk_index[key] = path\n        all_type1_values.add(key[0])\n        all_type2_values.add(key[1])\n        total_records += len(rows)\n\n    print(f\'Wrote {len(chunk_index)} chunks for {total_records} records into {CHUNK_DIR}\')\n\n\ndef load_chunk(path: str) -> List[dict]:\n    """Load exactly one chunk file into memory."""\n    with open(path, \'r\', newline=\'\') as f:\n        return [\n            {\n                \'Type1\': r[\'Type1\'],\n                \'Type2\': r[\'Type2\'],\n                \'Text\': r[\'Text\'],\n                \'ID\': int(r[\'ID\'])\n            }\n            for r in csv.DictReader(f)\n        ]\n\n\n@app.on_event(\'startup\')\nasync def startup_event():\n    """Build chunk files on startup"""\n    build_chunks()\n\n\n@app.get(\'/\')\nasync def root():\n    """Health check endpoint"""\n    return {\'status\': \'healthy\', \'message\': \'Service is running\'}\n\n\n@app.get(\'/query\')\nasync def query_records(\n    type1: str = Query(..., description=\'Type1 value to filter by\'),\n    type2: str = Query(..., description=\'Type2 value to filter by\')\n) -> List[Record]:\n    """\n    Query records by Type1 and Type2.\n    Both parameters are required.\n    """\n    global last_loaded_type1_values, last_loaded_type2_values\n\n    if not type1 or not type2:\n        raise HTTPException(status_code=400, detail=\'Both type1 and type2 are required\')\n\n    # Reset tracking\n    last_loaded_type1_values = set()\n    last_loaded_type2_values = set()\n\n    path = chunk_index.get((type1, type2))\n    if path is None:\n        return []\n\n    results = []\n    for row in load_chunk(path):\n        results.append(Record(**row))\n        last_loaded_type1_values.add(row[\'Type1\'])\n        last_loaded_type2_values.add(row[\'Type2\'])\n\n    return results\n\n\n@app.get(\'/get_all_loaded_types_and_subtypes\')\nasync def get_all_loaded_types_and_subtypes() -> dict:\n    """\n    Returns the Type1 and Type2 values from the most recent query\'s loaded chunk.\n    """\n    return {\n        \'type1_values\': sorted(last_loaded_type1_values),\n        \'type2_values\': sorted(last_loaded_type2_values)\n    }\n\n\n@app.get(\'/get_all_available_types_and_subtypes\')\nasync def get_all_available_types_and_subtypes() -> dict:\n    """\n    Returns ALL unique Type1 and Type2 values that exist in the storage system.\n    """\n    return {\n        \'type1_values\': sorted(all_type1_values),\n        \'type2_values\': sorted(all_type2_values)\n    }\n\n\n@app.get(\'/stats\')\nasync def get_stats():\n    """Get storage statistics"""\n    return {\n        \'total_records\': total_records,\n        \'unique_type1\': len(all_type1_values),\n        \'unique_type2\': len(all_type2_values),\n        \'storage_backend\': \'chunked_csv\'\n    }\n\n\nif __name__ == \'__main__\':\n    import uvicorn\n    uvicorn.run(app, host=\'0.0.0.0\', port=8000, log_level=\'info\')\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
