      'total_storage_bytes': total,\n        'deduplicated_storage_bytes': dedup,\n        'storage_savings_percent': savings,\n        'cache_hit_ratio': chr_\n    },\n    'advanced_metrics': {\n        'compressed_storage_bytes': comp,\n        'monthly_storage_cost_usd': cost,\n        'network_transfer_time_seconds': net,\n        'average_layer_age_days': avg_age,\n        'access_frequency_std_dev': sd\n    },\n    'top_layers_by_size': top_out,\n    'recent_access_summary': {\n        'layers_accessed_last_7_days': l7,\n        'most_recent_layers': mr\n    },\n    'shared_layer_analysis': {\n        'images_with_shared_layers': shared_imgs,\n        'total_shared_layer_count': len(shared_shas)\n    }\n}\n\nwith open('output.json', 'w') as f:\n    json.dump(out, f, indent=2)\nprint(json.dumps(out, indent=2))\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
