Sending keys: ["cat > /app/src/padding.py << 'EOF'\nimport numpy as np\n\n\ndef zero_pad(x, pad):\n    x = np.asarray(x, dtype=np.float64)\n    if pad == 0:\n        return x.copy()\n    return np.pad(x, ((0, 0), (pad, pad), (pad, pad), (0, 0)), mode='constant', constant_values=0.0).astype(np.float64)\n\n\ndef get_output_shape(input_shape, kernel_size, stride, padding, dilation=1):\n    h, w = input_shape\n\n    def _out(i):\n        return (i + 2 * padding - dilation * (kernel_size - 1) - 1) // stride + 1\n\n    return (int(_out(h)), int(_out(w)))\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/src/conv.py << 'EOF'\nimport math\nimport numpy as np\nfrom .base import BaseLayer\nfrom .padding import zero_pad, get_output_shape\n\n\nclass Conv2D(BaseLayer):\n    def __init__(self, in_channels, out_channels, kernel_size, stride=1, padding=0, dilation=1):\n        super().__init__()\n        self.in_channels = int(in_channels)\n        self.out_channels = int(out_channels)\n        self.kernel_size = int(kernel_size)\n        self.stride = int(stride)\n        self.padding = int(padding)\n        self.dilation = int(dilation)\n        k = self.kernel_size\n        fan_in = self.in_channels * k * k\n        fan_out = self.out_channels * k * k\n        limit = math.sqrt(6.0 / (fan_in + fan_out))\n        self.weights = np.random.uniform(-limit, limit, size=(self.out_channels, self.in_channels, k, k)).astype(np.float64)\n        self.bias = np.zeros((self.out_channels,), dtype=np.float64)\n\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        N, H, W, C = x.shape\n        k, s, p, d = self.kernel_size, self.stride, self.padding, self.dilation\n        xp = zero_pad(x, p)\n        oh, ow = get_output_shape((H, W), k, s, p, d)\n        out = np.zeros((N, oh, ow, self.out_channels), dtype=np.float64)\n        for i in range(k):\n            for j in range(k):\n                hs = i * d\n                ws = j * d\n                patch = xp[:, hs:hs + s * (oh - 1) + 1:s, ws:ws + s * (ow - 1) + 1:s, :]\n                out += np.tensordot(patch, self.weights[:, :, i, j], axes=([3], [1]))\n        out += self.bias\n        return out.astype(np.float64)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/src/conv_transpose.py << 'EOF'\nimport math\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass Conv2DTranspose(BaseLayer):\n    def __init__(self, in_channels, out_channels, kernel_size, stride=1, padding=0):\n        super().__init__()\n        self.in_channels = int(in_channels)\n        self.out_channels = int(out_channels)\n        self.kernel_size = int(kernel_size)\n        self.stride = int(stride)\n        self.padding = int(padding)\n        k = self.kernel_size\n        fan_in = self.in_channels * k * k\n        fan_out = self.out_channels * k * k\n        limit = math.sqrt(6.0 / (fan_in + fan_out))\n        self.weights = np.random.uniform(-limit, limit, size=(self.in_channels, self.out_channels, k, k)).astype(np.float64)\n        self.bias = np.zeros((self.out_channels,), dtype=np.float64)\n\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        N, H, W, C = x.shape\n        k, s, p = self.kernel_size, self.stride, self.padding\n        Hf = (H - 1) * s + k\n        Wf = (W - 1) * s + k\n        full = np.zeros((N, Hf, Wf, self.out_channels), dtype=np.float64)\n        for i in range(k):\n            for j in range(k):\n                contrib = np.tensordot(x, self.weights[:, :, i, j], axes=([3], [0]))\n                full[:, i:i + s * (H - 1) + 1:s, j:j + s * (W - 1) + 1:s, :] += contrib\n        full += self.bias\n        if p > 0:\n            full = full[:, p:Hf - p, p:Wf - p, :]\n        return np.ascontiguousarray(full, dtype=np.float64)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/src/pooling.py << 'EOF'\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass _Pool2D(BaseLayer):\n    def __init__(self, kernel_size, stride=None):\n        super().__init__()\n        self.kernel_size = int(kernel_size)\n        self.stride = int(stride) if stride is not None else self.kernel_size\n\n    def _windows(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        N, H, W, C = x.shape\n        k, s = self.kernel_size, self.stride\n        oh = (H - k) // s + 1\n        ow = (W - k) // s + 1\n        for i in range(k):\n            for j in range(k):\n                yield x[:, i:i + s * (oh - 1) + 1:s, j:j + s * (ow - 1) + 1:s, :]\n\n\nclass MaxPool2D(_Pool2D):\n    def forward(self, x):\n        out = None\n        for patch in self._windows(x):\n            out = patch.copy() if out is None else np.maximum(out, patch)\n        return out.astype(np.float64)\n\n\nclass AvgPool2D(_Pool2D):\n    def forward(self, x):\n        total = None\n        for patch in self._windows(x):\n            total = patch.copy() if total is None else total + patch\n        return (total / (self.kernel_size * self.kernel_size)).astype(np.float64)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/src/normalization.py << 'EOF'\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass BatchNorm2D(BaseLayer):\n    def __init__(self, num_features, eps=1e-5, momentum=0.1):\n        super().__init__()\n        self.num_features = int(num_features)\n        self.eps = eps\n        self.momentum = momentum\n        self.gamma = np.ones((self.num_features,), dtype=np.float64)\n        self.beta = np.zeros((self.num_features,), dtype=np.float64)\n        self.running_mean = np.zeros((self.num_features,), dtype=np.float64)\n        self.running_var = np.ones((self.num_features,), dtype=np.float64)\n\n    def forward(self, x, training=True):\n        x = np.asarray(x, dtype=np.float64)\n        if training:\n            axes = (0, 1, 2)\n            mean = x.mean(axis=axes)\n            var = x.var(axis=axes)\n            self.running_mean = (1 - self.momentum) * self.running_mean + self.momentum * mean\n            self.running_var = (1 - self.momentum) * self.running_var + self.momentum * var\n        else:\n            mean = self.running_mean\n            var = self.running_var\n        x_hat = (x - mean) / np.sqrt(var + self.eps)\n        return (self.gamma * x_hat + self.beta).astype(np.float64)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/src/activation.py << 'EOF'\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass ReLU(BaseLayer):\n    def __init__(self):\n        super().__init__()\n\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        return np.maximum(0.0, x).astype(np.float64)\n\n\nclass LeakyReLU(BaseLayer):\n    def __init__(self, negative_slope=0.01):\n        super().__init__()\n        self.negative_slope = float(negative_slope)\n\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        return np.where(x > 0, x, self.negative_slope * x).astype(np.float64)\n\n\nclass Sigmoid(BaseLayer):\n    def __init__(self):\n        super().__init__()\n\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        out = np.empty_like(x, dtype=np.float64)\n        pos = x >= 0\n        out[pos] = 1.0 / (1.0 + np.exp(-x[pos]))\n        ex = np.exp(x[~pos])\n        out[~pos] = ex / (1.0 + ex)\n        return out\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
