 Architectures Evaluated: 200')\nL2.append('')\nL2.append('Mathematical Verification:')\nL2.append('  Constraint satisfaction proof: each architecture was checked for RF >= 0.25, IF >= 0.80, gradient_flow = true, 1000 <= memory <= 100000000, FLOPs <= 1e9, 1000 <= params <= 5000000.')\nL2.append('  Constraint violations found: %d' % cv)\nL2.append('  Architecture rules enforced: exactly one terminal Dense layer; every Conv2D followed by BatchNorm then MaxPool2D or Conv2D; no Dropout; spatial size >= 7x7.')\nL2.append('  Diversity: minimum pairwise Hamming distance among top 5 = %d (required >= 2).' % min_ham)\nL2.append('  Hypervolume: Monte Carlo estimate over 3000 fixed samples in [0,1]^3, all values in [0,1].')\nL2.append('  Pareto front analysis: rank-1 front sizes listed in Evolution Summary.')\nL2.append('')\nL2.append('Top 5 Pareto-Optimal Architectures:')\nfor b in best:\n    o = b['objectives']\n    L2.append('  %s rank=%d crowding=%.4f accuracy=%.4f efficiency=%.4f diversity=%.4f' % (b['id'], o['pareto_rank'], o['crowding_distance'], o['accuracy'], o['efficiency'], o['diversity']))\n    L2.append('    layers: ' + ', '.join(b['layers']))\nopen('/app/evolution_report.txt', 'w').write('\\n'.join(L2) + '\\n')\n\nprint('search_results.json, best_architectures.json, evolution_report.txt written')\nprint('constraint_violations=%d total=%d min_hamming=%d' % (cv, len(ARCHIVE), min_ham))\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
