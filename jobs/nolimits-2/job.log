Sending keys: ['cat > /app/canonicalize.py << \'EOF\'\nimport re\n\nMETHODS = {"GET", "POST", "PUT", "DELETE", "PATCH"}\nPERMS = {"ALLOW", "DENY"}\nVAR = re.compile("\\\\{[A-Za-z0-9_-]+\\\\}")\n\n\ndef norm(p):\n    return VAR.sub("{var}", p)\n\n\ndef segs(p):\n    return [s for s in p.split("/") if s]\n\n\ndef is_proper_prefix(q, p):\n    qs, ps = segs(q), segs(p)\n    return len(qs) < len(ps) and ps[:len(qs)] == qs\n\n\ndef main():\n    with open("/app/input.txt") as f:\n        lines = [l.rstrip("\\r") for l in f.read().split("\\n")]\n\n    i = 0\n    ep_lines = []\n    while i < len(lines) and lines[i].strip() != "":\n        ep_lines.append(lines[i])\n        i += 1\n    while i < len(lines) and lines[i].strip() == "":\n        i += 1\n    block = []\n    while i < len(lines) and lines[i].strip() != "":\n        block.append(lines[i])\n        i += 1\n    rest = lines[i:]\n    if block and block[0].split()[0].lower() in ("base", "exclude"):\n        meta = block\n        plan_lines = rest\n    else:\n        meta = []\n        plan_lines = block + rest\n\n    base = None\n    excl = set()\n    for line in meta:\n        parts = line.split()\n        if not parts:\n            continue\n        if parts[0].lower() == "base" and len(parts) >= 2 and base is None:\n            base = parts[1]\n        elif parts[0].lower() == "exclude":\n            excl.update(parts[1:])\n\n    endpoints = []\n    for line in ep_lines:\n        parts = line.split()\n        if len(parts) != 4:\n            break\n        path, method, role, perm = parts\n        m = method.upper()\n        pm = perm.upper()\n        if not path or m not in METHODS or pm not in PERMS or not role:\n            break\n        endpoints.append((path, m, role, pm))\n\n    plan = []\n    for line in plan_lines:\n        if not line.strip():\n            continue\n        parts = line.split()\n        if len(parts) != 2:\n            break\n        path, method = parts\n        m = method.upper()\n        if not path or m not in METHODS:\n            break\n        plan.append((norm(path), m))\n\n    def ok_path(p):\n        return base is None or p.startswith(base)\n\n    elig = [e for e in endpoints if ok_path(e[0])]\n\n    canon = {}\n    for path, m, role, pm in elig:\n        canon.setdefault(norm(path), path)\n\n    if not plan:\n        keep_fn = lambda e: e[2] not in excl\n    else:\n        planset = set(plan)\n        planned_norms = {norm(e[0]) for e in elig if (norm(e[0]), e[1]) in planset}\n        all_norms = {norm(e[0]) for e in elig}\n        parents = {q for q in all_norms if any(is_proper_prefix(q, p) for p in planned_norms)}\n        parents_with_nonex = {norm(e[0]) for e in elig if e[2] not in excl and norm(e[0]) in parents}\n\n        def keep_fn(e):\n            n = norm(e[0])\n            excluded = e[2] in excl\n            if not excluded and (n, e[1]) in planset:\n                return True\n            if n in parents:\n                if n in parents_with_nonex:\n                    return not excluded\n                return True\n            return False\n\n    seen = set()\n    out = []\n    for e in elig:\n        if not keep_fn(e):\n            continue\n        n = norm(e[0])\n        key = (n, e[1], e[2])\n        if key in seen:\n            continue\n        seen.add(key)\n        out.append((canon[n], e[1], e[2], e[3]))\n\n    out.sort(key=lambda t: (-len(segs(t[0])), t[1], t[2], t[3]))\n\n    if out:\n        text = "".join(" ".join(t) + "\\n" for t in out)\n    else:\n        text = "\\n"\n    with open("/app/output.txt", "w") as f:\n        f.write(text)\n\n\nif __name__ == "__main__":\n    main()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
