Sending keys: ["cat > /app/kiln_firmware.py << 'EOF'\nimport csv\nimport json\n\nBEAM = 200\n\n\ndef run_firing_cycle(schedule_path, specs_path):\n    with open(specs_path) as f:\n        s = json.load(f)\n    P = float(s['gas_burner_power_c'])\n    D = float(s['damper_cooling_c'])\n    A = float(s['ambient_loss_c'])\n    with open(schedule_path) as f:\n        target = [float(r['target_temp']) for r in csv.DictReader(f)]\n    n = len(target)\n    T0 = target[0]\n    # beam entry: (err, T, last_gas, prev_gas)\n    beam = [(0.0, T0, 0, 0)]\n    hist = []\n    for t in range(n):\n        tgt = target[t + 1] if t + 1 < n else target[-1]\n        best = {}\n        for bi, (err, T, last, prev) in enumerate(beam):\n            for g in range(6):\n                gain = (0.1 * g + 0.3 * last + 0.6 * prev) * P\n                for d in range(6):\n                    Tn = T + gain - (d * D + A)\n                    if Tn < T - 5.0:\n                        continue\n                    e = err + abs(Tn - tgt) + 0.02 * g\n                    key = (round(Tn, 2), g, last)\n                    if key not in best or e < best[key][0]:\n                        best[key] = (e, bi, g, d, Tn)\n        items = sorted(best.values(), key=lambda x: x[0])[:BEAM]\n        beam = [(e, Tn, g, beam[bi][2]) for (e, bi, g, d, Tn) in items]\n        hist.append([(bi, g, d) for (e, bi, g, d, Tn) in items])\n    idx = min(range(len(beam)), key=lambda i: beam[i][0])\n    actions = [None] * n\n    for t in range(n - 1, -1, -1):\n        bi, g, d = hist[t][idx]\n        actions[t] = {'gas': int(g), 'damper': int(d)}\n        idx = bi\n    return actions\n\n\nif __name__ == '__main__':\n    import sys\n    sched = '/app/firing_schedule.csv'\n    specs = '/app/kiln_specs.json'\n    acts = run_firing_cycle(sched, specs)\n    with open(specs) as f:\n        s = json.load(f)\n    P = s['gas_burner_power_c']; D = s['damper_cooling_c']; A = s['ambient_loss_c']\n    with open(sched) as f:\n        target = [float(r['target_temp']) for r in csv.DictReader(f)]\n    g1 = g2 = 0\n    T = target[0]\n    err = 0.0\n    total_gas = 0\n    maxdrop = 0.0\n    for t in range(len(target)):\n        err += abs(T - target[t])\n        g = acts[t]['gas']; d = acts[t]['damper']\n        total_gas += g\n        geff = 0.1 * g + 0.3 * g1 + 0.6 * g2\n        Tn = T + geff * P - (d * D + A)\n        maxdrop = max(maxdrop, T - Tn)\n        g2, g1 = g1, g\n        T = Tn\n    print('steps', len(acts), 'total_gas', total_gas, 'abs_error', round(err, 2), 'max_drop', round(maxdrop, 3))\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
