[17.874891, "i", "cat > /workspace/do_merge.py <<'EOF'\nimport json\nimport pandas as pd\n\nOUT = \"/workspace/merged_records.csv\"\nrecords = {}\n\n\ndef norm(v):\n    if v is None:\n        return \"\"\n    if isinstance(v, float) and pd.isna(v):\n        return \"\"\n    return str(v).strip()\n\n\ndef add(email, phone, status):\n    e = norm(email).lower()\n    if not e:\n        return\n    r = records.setdefault(e, {\"email\": e, \"phone\": \"\", \"status\": \"\"})\n    if not r[\"phone\"] and norm(phone):\n        r[\"phone\"] = norm(phone)\n    if not r[\"status\"] and norm(status):\n        r[\"status\"] = norm(status)\n\n\n# users.csv\nusers = pd.read_csv(\"/workspace/users.csv\", dtype=str, keep_default_na=False)\nfor row in users.to_dict(\"records\"):\n    add(row.get(\"email\"), row.get(\"phone\"), row.get(\"status\"))\n\n# records.jsonl\nwith open(\"/workspace/records.jsonl\", encoding=\"utf-8\") as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        rec = json.loads(line)\n        other = rec.get(\"other_info\") or {}\n        add(rec.get(\"email\"), rec.get(\"phone\") or other.get(\"phone\"), rec.get(\"status\"))\n\n# profiles.json\nwith open(\"/workspace/profiles.json\", encoding=\"utf-8\") as f:\n    prof = json.load(f)\nif isinstance(prof, dict):\n    items = list(prof.items())\nelse:\n    items = [(None, p) for p in prof]\nfor key, rec in items:\n    if not isinstance(rec, dict):\n        continue\n    other = rec.get(\"other_info\") or {}\n    add(rec.get(\"email\") or key, rec.get(\"phone\") or other.get(\"phone\"), rec.get(\"status\"))\n\nout = pd.DataFrame(list(records.values()), columns=[\"email\", \"phone\", \"status\"])\nout.to_csv(OUT, index=False)\nprint(len(out), \"unique users written to\", OUT)\nEOF\n"]
