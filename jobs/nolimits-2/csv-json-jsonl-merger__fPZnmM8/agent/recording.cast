[37.216357, "i", "python3 -c \"import json,pandas as pd; out=set(pd.read_csv('/workspace/merged_records.csv',dtype=str).email); u=pd.read_csv('/workspace/users.csv',dtype=str,keep_default_na=False); r=[json.loads(l) for l in open('/workspace/records.jsonl') if l.strip()]; p=json.load(open('/workspace/profiles.json')); print('keys in records', sorted(set(k for x in r for k in x))); print('keys in profiles entries', sorted(set(k for v in p.values() for k in v))); print('users emails', len(set(u.email.str.lower())), 'missing', set(u.email.str.lower())-out); print('records emails', len(r), 'missing', set(x['email'].lower() for x in r)-out); print('profiles emails', len(p), 'missing', set(k.lower() for k in p)-out)\"\n"]
[37.217682, "o", "python3 -c \"import json,pandas as pd; out=set(pd.read_csv('/workspace/merged_records.csv',dtype=str).email); u=pd.read_csv('/workspace/users.csv',dtype=str,keep_default_na=False); r=[json.loads(l) for l in open('/workspace/records.jsonl') if l.strip()]; p=json.load(open('/workspace/profiles.json')); print('keys in records', sorted(set(k for x in r for k in x))); print('keys in profiles entries', sorted(set(k for v in p.values() for k in v))); print('users emails', len(set(u.email.str.lower())), 'missing', set(u.email.str.lower())-out); print('records emails', len(r), 'missing', set(x['email'].lower() for x in r)-out); print('profiles emails', len(p), 'missing', set(k.lower() for k in p)-out)\"\r\n\u001b[?2004l\r"]
