[?2004l[?2004h>         return
[?2004l[?2004h>     r = records.setdefault(e, {"email": e, "phone": "", "status": ""})
[?2004l[?2004h>     if not r["phone"] and norm(phone):
[?2004l[?2004h>         r["phone"] = norm(phone)
[?2004l[?2004h>     if not r["status"] and norm(status):
[?2004l[?2004h>         r["status"] = norm(status)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> # users.csv
[?2004l[?2004h> users = pd.read_csv("/workspace/users.csv", dtype=str, keep_default_na=False)
[?2004l[?2004h> for row in users.to_dict("records"):
[?2004l[?2004h>     add(row.get("email"), row.get("phone"), row.get("status"))
[?2004l[?2004h> 
[?2004l[?2004h> # records.jsonl
[?2004l[?2004h> with open("/workspace/records.jsonl", encoding="utf-8") as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line = line.strip()
[?2004l[?2004h>         if not line:
[?2004l[?2004h>             continue
[?2004l[?2004h>         rec = json.loads(line)
[?2004l[?2004h>         other = rec.get("other_info") or {}
[?2004l[?2004h>         add(rec.get("email"), rec.get("phone") or other.get("phone"), rec.get("status"))
[?2004l[?2004h> 
[?2004l[?2004h> # profiles.json
[?2004l[?2004h> with open("/workspace/profiles.json", encoding="utf-8") as f:
[?2004l[?2004h>     prof = json.load(f)
[?2004l[?2004h> if isinstance(prof, dict):
[?2004l[?2004h>     items = list(prof.items())
[?2004l[?2004h> else:
[?2004l[?2004h>     items = [(None, p) for p in prof]
[?2004l[?2004h> for key, rec in items:
[?2004l[?2004h>     if not isinstance(rec, dict):
[?2004l[?2004h>         continue
[?2004l[?2004h>     other = rec.get("other_info") or {}
[?2004l[?2004h>     add(rec.get("email") or key, rec.get("phone") or other.get("phone"), rec.get("status"))
