[?2004l[?2004h> records = {}
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def norm(v):
[?2004l[?2004h>     if v is None:
[?2004l[?2004h>         return ""
[?2004l[?2004h>     if isinstance(v, float) and pd.isna(v):
[?2004l[?2004h>         return ""
[?2004l[?2004h>     return str(v).strip()
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def add(email, phone, status):
