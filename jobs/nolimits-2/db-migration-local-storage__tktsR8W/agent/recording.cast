[29.268937, "o", "    groups = defaultdict(list)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.269039, "o", "    with open(DATA_PATH, 'r', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.269117, "o", "        for row in csv.DictReader(f):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.269274, "o", "            groups[(row['Type1'], row['Type2'])].append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.269393, "o", "                'Type1': row['Type1'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.269448, "o", "                'Type2': row['Type2'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.269616, "o", "                'Text': row['Text'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.26972, "o", "                'ID': int(row['ID'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.269825, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.269952, "o", "    for n, key in enumerate(sorted(groups), start=1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.270087, "o", "        rows = sorted(groups[key], key=lambda r: r['ID'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.270212, "o", "        path = os.path.join(CHUNK_DIR, f'chunk_{n:04d}.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.27034, "o", "        with open(path, 'w', newline='') as f:"]
[29.270361, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.270453, "o", "> "]
[29.27054, "o", "            writer = csv.DictWriter(f, fieldnames=FIELDNAMES)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.270634, "o", "            writer.writeheader()"]
[29.270672, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.27075, "o", "            writer.writerows(rows)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.270854, "o", "        chunk_index[key] = path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.270985, "o", "        all_type1_values.add(key[0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.271125, "o", "        all_type2_values.add(key[1])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.271209, "o", "        total_records += len(rows)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.271313, "o", "\u001b[?2004h> "]
[29.271424, "o", "    print(f'Wrote {len(chunk_index)} chunks for {total_records} records into {CHUNK_DIR}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.271529, "o", "> \r\n"]
[29.27162, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.271725, "o", "\u001b[?2004h> "]
[29.27182, "o", "def load_chunk(path: str) -> List[dict]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.271953, "o", "    \"\"\"Load exactly one chunk file into memory.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.272041, "o", "    with open(path, 'r', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         return ["]
[29.272119, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.272246, "o", "                'Type1': r['Type1'],\r\n\u001b[?2004l\r"]
[29.27236, "o", "\u001b[?2004h> "]
[29.272424, "o", "                'Type2': r['Type2'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.272572, "o", "                'Text': r['Text'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.272691, "o", "                'ID': int(r['ID'])\r\n\u001b[?2004l\r"]
[29.272781, "o", "\u001b[?2004h"]
[29.272873, "o", "> "]
[29.272971, "o", "            }\r\n\u001b[?2004l\r"]
[29.273051, "o", "\u001b[?2004h> "]
[29.273088, "o", "            for r in csv.DictReader(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.273175, "o", "        ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.273269, "o", "\u001b[?2004h> @app.on_event('startup')\r\n"]
[29.273396, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[29.273499, "o", "async def startup_event():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.273665, "o", "    \"\"\"Build chunk files on startup\"\"\"\r\n"]
[29.273741, "o", "\u001b[?2004l\r\u001b[?2004h>     build_chunks()\r\n\u001b[?2004l\r"]
[29.273812, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.273887, "o", "\u001b[?2004h"]
[29.274034, "o", "> @app.get('/')\r\n"]
[29.274135, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[29.274203, "o", "async def root():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.274357, "o", "    \"\"\"Health check endpoint\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.274533, "o", "    return {'status': 'healthy', 'message': 'Service is running'}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.274601, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.274702, "o", "@app.get('/query')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.274778, "o", "async def query_records(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.274895, "o", "    type1: str = Query(..., description='Type1 value to filter by'),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.274979, "o", "    type2: str = Query(..., description='Type2 value to filter by')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.275133, "o", ") -> List[Record]:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.275249, "o", "    Query records by Type1 and Type2."]
[29.275343, "o", "\r\n\u001b[?2004l\r"]
[29.275451, "o", "\u001b[?2004h> "]
[29.275557, "o", "    Both parameters are required.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.275702, "o", "    global last_loaded_type1_values, last_loaded_type2_values\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[29.275784, "o", ">     if not type1 or not type2:\r\n\u001b[?2004l\r"]
[29.275869, "o", "\u001b[?2004h> "]
[29.276037, "o", "        raise HTTPException(status_code=400, detail='Both type1 and type2 are required')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[29.276071, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[29.276156, "o", "    # Reset tracking\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.27624, "o", "    last_loaded_type1_values = set()\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.276343, "o", "> "]
[29.276446, "o", "    last_loaded_type2_values = set()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.276573, "o", "\u001b[?2004h> "]
[29.276757, "o", "    path = chunk_index.get((type1, type2))\r\n\u001b[?2004l\r\u001b[?2004h>     if path is None:"]
[29.276892, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         return []\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.276993, "o", "> "]
[29.277075, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.277174, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.277204, "o", "    for row in load_chunk(path):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.277328, "o", "        results.append(Record(**row))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.277488, "o", "        last_loaded_type1_values.add(row['Type1'])\r\n\u001b[?2004l\r"]
[29.277514, "o", "\u001b[?2004h> "]
[29.27766, "o", "        last_loaded_type2_values.add(row['Type2'])"]
[29.277741, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     return results\r\n\u001b[?2004l\r"]
[29.277882, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.278059, "o", "@app.get('/get_all_loaded_types_and_subtypes')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.278195, "o", "async def get_all_loaded_types_and_subtypes() -> dict:\r\n\u001b[?2004l\r"]
[29.278259, "o", "\u001b[?2004h> "]
[29.278373, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.278471, "o", "    Returns the Type1 and Type2 values from the most recent query's loaded chunk.\r\n\u001b[?2004l\r"]
[29.278509, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.278572, "o", "    return {\r\n\u001b[?2004l\r"]
[29.278652, "o", "\u001b[?2004h> "]
[29.278753, "o", "        'type1_values': sorted(last_loaded_type1_values),\r\n\u001b[?2004l\r"]
[29.278779, "o", "\u001b[?2004h> "]
[29.278884, "o", "        'type2_values': sorted(last_loaded_type2_values)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[29.278977, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.27905, "o", "\u001b[?2004h> "]
[29.279145, "o", "@app.get('/get_all_available_types_and_subtypes')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.279303, "o", "async def get_all_available_types_and_subtypes() -> dict:"]
[29.279407, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r"]
[29.279514, "o", "\u001b[?2004h> "]
[29.279678, "o", "    Returns ALL unique Type1 and Type2 values that exist in the storage system.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\""]
[29.279774, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     return {\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.279859, "o", "> "]
[29.279945, "o", "        'type1_values': sorted(all_type1_values),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.280028, "o", "        'type2_values': sorted(all_type2_values)\r\n\u001b[?2004l\r"]
[29.280134, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.280205, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.280293, "o", "@app.get('/stats')\r\n\u001b[?2004l\r\u001b[?2004h> async def get_stats():\r\n\u001b[?2004l\r"]
[29.280444, "o", "\u001b[?2004h> "]
[29.280546, "o", "    \"\"\"Get storage statistics\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     return {\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.28063, "o", "> "]
[29.280728, "o", "        'total_records': total_records,\r\n\u001b[?2004l\r"]
[29.280797, "o", "\u001b[?2004h"]
[29.280884, "o", "> "]
[29.280969, "o", "        'unique_type1': len(all_type1_values),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.281096, "o", "        'unique_type2': len(all_type2_values),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.28121, "o", "        'storage_backend': 'chunked_csv'\r\n\u001b[?2004l\r"]
[29.281304, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.281378, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
