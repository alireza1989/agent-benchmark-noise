[24.643566, "o", "        out = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[24.643639, "o", "> "]
[24.643732, "o", "        for patch in self._windows(x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.643815, "o", "            out = patch.copy() if out is None else np.maximum(out, patch)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.643834, "o", "        return out.astype(np.float64)"]
[24.643839, "o", "\r\n\u001b[?2004l\r"]
