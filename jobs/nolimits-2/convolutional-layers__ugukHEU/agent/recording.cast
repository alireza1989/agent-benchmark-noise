[23.627424, "i", "cat > /app/src/padding.py << 'EOF'\nimport numpy as np\n\n\ndef zero_pad(x, pad):\n    x = np.asarray(x, dtype=np.float64)\n    if pad == 0:\n        return x.copy()\n    return np.pad(x, ((0, 0), (pad, pad), (pad, pad), (0, 0)), mode='constant', constant_values=0.0).astype(np.float64)\n\n\ndef get_output_shape(input_shape, kernel_size, stride, padding, dilation=1):\n    h, w = input_shape\n\n    def _out(i):\n        return (i + 2 * padding - dilation * (kernel_size - 1) - 1) // stride + 1\n\n    return (int(_out(h)), int(_out(w)))\nEOF\n"]
[23.627608, "o", "cat > /app/src/padding.py << 'EOF'\r\n"]
[23.627651, "o", "\u001b[?2004l\r"]
[23.627659, "o", "\u001b[?2004h> "]
