[24.644161, "o", "class AvgPool2D(_Pool2D):\r\n\u001b[?2004l\r\u001b[?2004h>     def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h>         total = None\r\n\u001b[?2004l\r\u001b[?2004h>         for patch in self._windows(x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.644319, "o", "            total = patch.copy() if total is None else total + patch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.644344, "o", "        return (total / (self.kernel_size * self.kernel_size)).astype(np.float64)\r\n"]
[24.64446, "o", "\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
