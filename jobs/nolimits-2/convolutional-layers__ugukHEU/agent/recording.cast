[24.641798, "i", "cat > /app/src/pooling.py << 'EOF'\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass _Pool2D(BaseLayer):\n    def __init__(self, kernel_size, stride=None):\n        super().__init__()\n        self.kernel_size = int(kernel_size)\n        self.stride = int(stride) if stride is not None else self.kernel_size\n\n    def _windows(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        N, H, W, C = x.shape\n        k, s = self.kernel_size, self.stride\n        oh = (H - k) // s + 1\n        ow = (W - k) // s + 1\n        for i in range(k):\n            for j in range(k):\n                yield x[:, i:i + s * (oh - 1) + 1:s, j:j + s * (ow - 1) + 1:s, :]\n\n\nclass MaxPool2D(_Pool2D):\n    def forward(self, x):\n        out = None\n        for patch in self._windows(x):\n            out = patch.copy() if out is None else np.maximum(out, patch)\n        return out.astype(np.float64)\n\n\nclass AvgPool2D(_Pool2D):\n    def forward(self, x):\n        total = None\n        for patch in self._windows(x):\n            total = patch.copy("]
[24.64194, "i", ") if total is None else total + patch\n        return (total / (self.kernel_size * self.kernel_size)).astype(np.float64)\nEOF\n"]
