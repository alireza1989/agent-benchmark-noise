[39.465652, "i", "cd /app && python3 -c \"\nimport numpy as np\nfrom src import *\nnp.random.seed(0)\nx=np.random.randn(2,7,6,3)\nc=Conv2D(3,4,3,stride=2,padding=1,dilation=2)\nxp=np.pad(x,((0,0),(1,1),(1,1),(0,0)))\noh,ow=c.forward(x).shape[1:3]\nref=np.zeros((2,oh,ow,4))\nfor n in range(2):\n for a in range(oh):\n  for b in range(ow):\n   for o in range(4):\n    s=c.bias[o]\n    for i in range(3):\n     for j in range(3):\n      s+=np.sum(xp[n,a*2+i*2,b*2+j*2,:]*c.weights[o,:,i,j])\n    ref[n,a,b,o]=s\nprint('conv maxerr',np.abs(c.forward(x)-ref).max())\nt=Conv2DTranspose(3,4,3,stride=2,padding=1)\ny=np.random.randn(2,4,5,3)\nH,W=y.shape[1:3]\nfull=np.zeros((2,(H-1)*2+3,(W-1)*2+3,4))\nfor n in range(2):\n for a in range(H):\n  for b in range(W):\n   for i in range(3):\n    for j in range(3):\n     full[n,a*2+i,b*2+j]+=y[n,a,b]@t.weights[:,:,i,j]\nfull=full[:,1:-1,1:-1,:]+t.bias\nprint('convT maxerr',np.abs(t.forward(y)-full).max(), t.forward(y).shape)\nm=MaxPool2D(2); print('max', np.allclose(m.forward(x)[0,0,0], x[0,0:2,0:2].max(axis=(0,1))))\na=AvgPool2D("]
[39.465729, "i", "2); print('avg', np.allclose(a.forward(x)[0,0,0], x[0,0:2,0:2].mean(axis=(0,1))))\nb=BatchNorm2D(3); z=b.forward(x); print('bn mean0', np.allclose(z.mean(axis=(0,1,2)),0,atol=1e-7), np.allclose(z.std(axis=(0,1,2)),1,atol=1e-3))\nprint('bn eval', b.forward(x,training=False).shape, b.running_mean.shape)\nprint('sig', Sigmoid().forward(np.array([-1000.,0.,1000.])))\nprint('lrelu', LeakyReLU(0.1).forward(np.array([-2.,3.])))\n\" 2>&1\n"]
