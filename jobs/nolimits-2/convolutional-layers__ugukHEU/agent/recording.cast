[24.302534, "i", "cat > /app/src/conv_transpose.py << 'EOF'\nimport math\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass Conv2DTranspose(BaseLayer):\n    def __init__(self, in_channels, out_channels, kernel_size, stride=1, padding=0):\n        super().__init__()\n        self.in_channels = int(in_channels)\n        self.out_channels = int(out_channels)\n        self.kernel_size = int(kernel_size)\n        self.stride = int(stride)\n        self.padding = int(padding)\n        k = self.kernel_size\n        fan_in = self.in_channels * k * k\n        fan_out = self.out_channels * k * k\n        limit = math.sqrt(6.0 / (fan_in + fan_out))\n        self.weights = np.random.uniform(-limit, limit, size=(self.in_channels, self.out_channels, k, k)).astype(np.float64)\n        self.bias = np.zeros((self.out_channels,), dtype=np.float64)\n\n    def forward(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        N, H, W, C = x.shape\n        k, s, p = self.kernel_size, self.stride, self.padding\n        Hf = (H - 1) * s + k\n        Wf = (W - 1"]
[24.30257, "i", ") * s + k\n        full = np.zeros((N, Hf, Wf, self.out_channels), dtype=np.float64)\n        for i in range(k):\n            for j in range(k):\n                contrib = np.tensordot(x, self.weights[:, :, i, j], axes=([3], [0]))\n                full[:, i:i + s * (H - 1) + 1:s, j:j + s * (W - 1) + 1:s, :] += contrib\n        full += self.bias\n        if p > 0:\n            full = full[:, p:Hf - p, p:Wf - p, :]\n        return np.ascontiguousarray(full, dtype=np.float64)\nEOF\n"]
