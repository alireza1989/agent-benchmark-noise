[23.628023, "o", "    return np.pad(x, ((0, 0), (pad, pad), (pad, pad), (0, 0)), mode='constant', constant_values=0.0).astype(np.float64)\r\n\u001b[?2004l\r"]
[23.628156, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def get_output_shape(input_shape, kernel_size, stride, padding, dilation=1):\r\n\u001b[?2004l\r"]
[23.628797, "o", "\u001b[?2004h>     h, w = input_shape\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def _out(i):\r\n\u001b[?2004l\r\u001b[?2004h>         return (i + 2 * padding - dilation * (kernel_size - 1) - 1) // stride + 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     return (int(_out(h)), int(_out(w)))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
