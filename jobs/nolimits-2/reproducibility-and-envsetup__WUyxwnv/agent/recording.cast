[26.55294, "i", "cat > /app/work/repro.sh <<'EOF'\n#!/usr/bin/env bash\nset -euo pipefail\nHERE=/app/work/project\nVENV1=/tmp/repro-venv1\nVENV2=/tmp/repro-venv2\nrm -rf \"$VENV1\" \"$VENV2\" /output/run1 /output/run2\nmkdir -p /output/run1 /output/run2\npython -m venv \"$VENV1\"\npython -m venv \"$VENV2\"\n\"$VENV1/bin/pip\" install --quiet -r \"$HERE/requirements.txt\"\n\"$VENV2/bin/pip\" install --quiet -r \"$HERE/requirements.txt\"\ncd \"$HERE\"\nOUTPUT_PATH=/output/run1/model.npy \"$VENV1/bin/python\" train.py\nOUTPUT_PATH=/output/run2/model.npy \"$VENV2/bin/python\" train.py\n\"$VENV1/bin/python\" - <<'PY'\nimport hashlib, json, os, sys\nimport numpy\ndef sha(p):\n    with open(p, 'rb') as f:\n        return hashlib.sha256(f.read()).hexdigest()\nhere = '/app/work/project'\nr1 = sha('/output/run1/model.npy')\nr2 = sha('/output/run2/model.npy')\nd = {\n    'run1': r1,\n    'run2': r2,\n    'match': r1 == r2,\n    'python_version': '%d.%d.%d' % sys.version_info[:3],\n    'numpy_version': numpy.__version__,\n    'train_script_sha256': sha(here + '/train.py'),\n    'env_lock_sha"]
[26.553007, "i", "256': sha(here + '/env.lock.json'),\n    'requirements_sha256': sha(here + '/requirements.txt'),\n}\nos.makedirs('/output', exist_ok=True)\nwith open('/output/hashes.json', 'w') as f:\n    json.dump(d, f, indent=2)\nprint(json.dumps(d, indent=2))\nPY\nEOF\nchmod +x /app/work/repro.sh && bash -n /app/work/repro.sh && echo SYNTAX_OK\n"]
